{
  "id": "job.merchant",
  "name": "Il mercante",
  "kind": "data",
  "version": "0.1.0",
  "description": "La giornata di chi compra e vende: prende dal deposito ciò che altri hanno portato e lo tiene al banco per chi passa.",
  "mestieri": [
    {
      "id": "merchant",
      "nomi": [
        "mercante",
        "mercantessa",
        "bottegaio",
        "bottegaia",
        "negoziante",
        "commerciante",
        "venditore",
        "venditrice",
        "ambulante",
        "rigattiere",
        "rigattiera",
        "droghiere",
        "droghiera"
      ],
      "giornata": {
        "morning": [
          {
            "fa": "take",
            "oggetto": "item.grano",
            "quante": 2,
            "dove": "square"
          },
          {
            "fa": "take",
            "oggetto": "item.pesce",
            "quante": 2,
            "dove": "square"
          }
        ],
        "day": [
          {
            "fa": "go",
            "dove": "square"
          },
          {
            "fa": "wait",
            "durata": 90,
            "posa": "trade",
            "dice": "Merce buona, prezzi giusti!"
          }
        ],
        "evening": [
          {
            "fa": "carry",
            "oggetto": "item.grano",
            "dove": "square"
          },
          {
            "fa": "carry",
            "oggetto": "item.pesce",
            "dove": "square"
          },
          {
            "fa": "chat"
          }
        ],
        "night": [
          {
            "fa": "go",
            "dove": "home"
          },
          {
            "fa": "rest"
          }
        ]
      }
    }
  ]
}
