{
  "id": "world.layouts",
  "name": "Ambienti",
  "kind": "data",
  "version": "0.1.0",
  "description": "Gli ambienti del mondo come programmi di riscrittura (stile MarkovJunior) applicati alla bozza del terreno. Li scrive il Cartografo; il kernel li prova prima di accettarli.",
  "layouts": {
    "borgo": {
      "name": "Borgo",
      "description": "case di pietra con porte sulla strada, orti e cortili",
      "environment": "misto",
      "program": {
        "type": "sequence",
        "children": [
          {
            "type": "prl",
            "rules": [
              {
                "in": "t",
                "out": "g",
                "p": 0.85
              },
              {
                "in": "w",
                "out": "g",
                "p": 0.6
              }
            ]
          },
          {
            "type": "one",
            "rules": [
              {
                "in": "[gpm][gpm][gpm][gpm][gpm][gpm]/[gpm][gpm][gpm][gpm][gpm][gpm]/[gpm][gpm][gpm][gpm][gpm][gpm]/[gpm][gpm][gpm][gpm][gpm][gpm]/[gpm][gpm][gpm][gpm][gpm][gpm]",
                "out": "hhhhhh/hffffh/hffffh/hffffh/hhdhhh"
              }
            ],
            "steps": 2
          },
          {
            "type": "one",
            "rules": [
              {
                "in": "ggg/ggg",
                "out": "mmm/mmm"
              }
            ],
            "steps": 2
          },
          {
            "type": "path",
            "from": "d",
            "to": "p",
            "on": "gm",
            "color": "p",
            "steps": 3
          }
        ]
      }
    },
