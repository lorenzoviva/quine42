<!-- ANIMAZIONE CICLICA "STUDIO" (8 frame, 1.2s)                       -->
<!-- 1. Respiro continuo delle lampade e raccordi neon pesca (p->q->r->t) -->
<!-- 2. Lampeggio intermittente del segnale di registrazione "ON AIR"  -->
<!-- ================================================================= -->
<animation name="studio" frames="8">
  <sequence>
    <!-- Ciclo neon pesca -->
    <all in="p" out="x"/>
    <all in="t" out="p"/>
    <all in="r" out="t"/>
    <all in="q" out="r"/>
    <all in="x" out="q"/>

    <!-- Lampeggio ON AIR (rosso attivo u <-> rosso spento w) -->
    <all in="u" out="y"/>
    <all in="w" out="u"/>
    <all in="y" out="w"/>
  </sequence>
</animation>
