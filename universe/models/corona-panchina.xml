<!--
Synthetic one-piece bench as a curved ribbon (corona): street furniture for the alleys, squares and lawns of the corona.
Written by Gemini CLI (Gemini 3.8 Flash, subscription), task T50a.
Box: 1.5 × 1 × 1 tiles, 12 × 8 × 8 voxels, 8 voxels per tile (vpt: 8).
Role: prop.
Design and sculptural concept:
- A fluid monolithic line as a continuous ribbon in dark graphite composite technopolymer (M, m);
- The ribbon starts from one side, shapes the low ergonomic horizontal seat (z=2), rises into the
  low backrest with a curved joint (z=3..5) and comes back down with winged side flanges and integrated armrests;
- Floating effect: it rests on a compact, strongly recessed central pedestal (x=4..7, y=2..3, z=0)
  in ultra-dark carbon (D) with anchoring bolts (S); the wide overhang on every side gives
  a marked sense of magnetic levitation;
- A lower magenta/pink neon blade (R, glow="True") recessed in the lower front (z=1, y=5), with a white laser
  core (W, glow="True"), housed in the dark optical bay (V) and shielded by acrylic diffusers (P);
- A comfort seat in graphite synthetic material (C, c) with a cascading ergonomic profile (waterfall front);
- On the back of the backrest (z=4, y=1), a horizontal neon ribbon slit (R, W, P) spreads light towards the back;
- Side armrests with inductive charging plates and cyan/cobalt telemetry indicators (E, e).
Animation "respiro" (6 frames):
- The lower neon blade pulses, widening and narrowing the central laser core (W, R);
- The telemetry and wireless charging lights on the armrests switch between cyan standby (E) and cobalt uplink (e).
-->
<sequence values="BMmDSsCcPVRWEeXYZ" size="12 8 8" symmetry="(x)" name="Panchina">
  <!-- Structural materials: dark graphite and titanium one-piece shell -->
  <color symbol="M" value="20222a" name="guscio monoblocco scuro"/>
  <color symbol="m" value="2e323f" name="titanio biselli scocca"/>
  <color symbol="D" value="141418" name="plinto centrale carbonio"/>

  <!-- Mechanics, metal joints and finishing profiles -->
  <color symbol="S" value="3d4354" name="ancoraggi metallo satinato"/>
  <color symbol="s" value="8a95ab" name="rifinitura argento cromo"/>

  <!-- Ergonomic comfort seat in synthetic elastomer -->
  <color symbol="C" value="495060" name="seduta comfort grafite"/>
  <color symbol="c" value="636c80" name="bisello seduta comfort chiaro"/>

  <!-- Optics and translucent acrylic diffusers -->
  <color symbol="V" value="1c2a3a" name="vano ottico incassato"/>
  <color symbol="P" value="ff7597" name="diffusore magenta traslucido"/>

  <!-- Active light sources (glow="True") for the neon bloom -->
  <color symbol="R" value="ff2a6d" glow="True" name="lama neon magenta"/>
  <color symbol="W" value="ffffff" glow="True" name="nucleo fotonico bianco"/>
  <color symbol="E" value="05d9e8" glow="True" name="led ricarica ciano"/>
  <color symbol="e" value="29adff" glow="True" name="led uplink cobalto"/>

  <!-- Invisible markers for the generative rules -->
  <color symbol="X" hidden="True" name="marker nastro terminale"/>
  <color symbol="Y" hidden="True" name="marker feritoia posteriore"/>
  <color symbol="Z" hidden="True" name="marker seduta comfort"/>

  <!-- ======================================================== -->
  <!-- 1. RECESSED CENTRAL FOUNDATION PLINTH (z = 0)            -->
  <!-- ======================================================== -->
  <!-- Compact central base in dark carbon D                    -->
  <box at="5.5 2.5 0" size="4 2 1" color="D"/>

  <!-- Satin corner bolts at the corners of the plinth          -->
  <box at="4 2 0" size="1 1 1" color="S"/>
  <box at="7 2 0" size="1 1 1" color="S"/>
  <box at="4 3 0" size="1 1 1" color="S"/>
  <box at="7 3 0" size="1 1 1" color="S"/>

  <!-- ======================================================== -->
  <!-- 2. SUSPENSION FRAME AND LOWER NEON BLADE (z = 1)         -->
  <!-- ======================================================== -->
  <!-- Central support beam in dark titanium M                  -->
  <box at="5.5 2.5 1" size="6 2 1" color="M"/>
  <box at="5.5 2.5 1" size="8 1 1" color="m"/>

  <!-- Dark recessed optical bay V                              -->
  <box at="5.5 4.0 1" size="8 1 1" color="V"/>

  <!-- Lower front magenta neon blade (y=5, x=2..9)             -->
  <box at="5.5 5.0 1" size="8 1 1" color="R"/>
  <!-- Central white laser photon core (x=4..7)                 -->
  <box at="5.5 5.0 1" size="4 1 1" color="W"/>
  <!-- Acrylic diffusers at the ends of the blade               -->
  <box at="2 5 1" size="1 1 1" color="P"/>
  <box at="9 5 1" size="1 1 1" color="P"/>

  <!-- Side flanges of the ribbon overhanging downwards         -->
  <box at="1 3.0 1" size="1 3 1" color="m"/>
  <box at="10 3.0 1" size="1 3 1" color="m"/>
  <box at="1 2 1" size="1 1 1" color="X"/>
  <box at="10 2 1" size="1 1 1" color="X"/>

  <!-- ======================================================== -->
  <!-- 3. LOW ERGONOMIC SEAT AND WATERFALL EDGE (z = 2)         -->
  <!-- ======================================================== -->
  <!-- Load-bearing one-piece shell (x=1..10, y=2..5)           -->
  <box at="5.5 3.5 2" size="10 4 1" color="M"/>

  <!-- Cascading front edge (waterfall y=5)                     -->
  <box at="5.5 5.0 2" size="8 1 1" color="c"/>
  <box at="1 5 2" size="1 1 1" color="m"/>
  <box at="10 5 2" size="1 1 1" color="m"/>

  <!-- Graphite ergonomic comfort cushion (x=2..9, y=2..4)      -->
  <box at="5.5 3.0 2" size="8 3 1" color="C"/>
  <box at="2 3.0 2" size="1 3 1" color="c"/>
  <box at="9 3.0 2" size="1 3 1" color="c"/>
  <box at="5.5 4.0 2" size="8 1 1" color="c"/>

  <!-- Back joint towards the backrest (y=1)                    -->
  <box at="5.5 1.0 2" size="10 1 1" color="M"/>

  <!-- Marker housing for the grain/stitching of the seat       -->
  <box at="5.5 3.0 2" size="2 1 1" color="Z"/>

  <!-- ======================================================== -->
  <!-- 4. RISING BACKREST AND WINGED ARMRESTS (z = 3)           -->
  <!-- ======================================================== -->
  <!-- One-piece rising backrest (x=1..10, y=1..2)              -->
  <box at="5.5 1.5 3" size="10 2 1" color="M"/>
  <!-- Lumbar comfort cushion on the front                      -->
  <box at="5.5 2.0 3" size="8 1 1" color="C"/>

  <!-- Aerodynamic armrests / side wings (x=1 and x=10, y=2..4)  -->
  <box at="1 3.0 3" size="1 3 1" color="M"/>
  <box at="10 3.0 3" size="1 3 1" color="M"/>
  <box at="1 2.5 3" size="1 2 1" color="s"/>
  <box at="10 2.5 3" size="1 2 1" color="s"/>

  <!-- Interface and Qi wireless charging terminals (y=4)       -->
  <box at="1 4 3" size="1 1 1" color="E"/>
  <box at="10 4 3" size="1 1 1" color="e"/>

  <!-- ======================================================== -->
  <!-- 5. BODY OF THE BACKREST AND GLOWING SLIT (z = 4)         -->
  <!-- ======================================================== -->
  <!-- Central block of the backrest                            -->
  <box at="5.5 1.5 4" size="10 2 1" color="M"/>
  <box at="5.5 2.0 4" size="8 1 1" color="c"/>

  <!-- Dark recessed optical bay at the back (y=1, x=2..9)      -->
  <box at="5.5 1.0 4" size="8 1 1" color="V"/>

  <!-- Horizontal magenta neon slit (x=3..8, y=1)               -->
  <box at="5.5 1.0 4" size="6 1 1" color="R"/>
  <!-- Central white laser photon core                          -->
  <box at="5.5 1.0 4" size="2 1 1" color="W"/>
  <!-- End acrylic diffusers                                    -->
  <box at="3 1 4" size="1 1 1" color="P"/>
  <box at="8 1 4" size="1 1 1" color="P"/>

  <!-- Housing for the variants of the generative slit          -->
  <box at="5.5 1.0 4" size="2 1 1" color="Y"/>

  <!-- ======================================================== -->
  <!-- 6. UPPER CROWNING OF THE BACKREST (z = 5)                -->
  <!-- ======================================================== -->
  <!-- Tapered ergonomic crest (x=2..9, y=1..2)                 -->
  <box at="5.5 1.5 5" size="8 2 1" color="m"/>
  <!-- Reflecting upper moulding in satin chrome                -->
  <box at="5.5 1.0 5" size="6 1 1" color="s"/>
  <box at="5.5 2.0 5" size="8 1 1" color="c"/>

  <!-- ======================================================== -->
  <!-- 7. GENERATIVE RULES: STOCHASTIC VARIANTS IN THE SEEDS    -->
  <!-- ======================================================== -->
  <!-- A) Resolution of the end of the side ribbon (X)          -->
  <one steps="1">
    <!-- Variant 1: a continuous aerodynamic winged joint in titanium -->
    <rule in="X" out="m" p="0.45"/>
    <!-- Variant 2: a satin chrome joint insert -->
    <rule in="X" out="s" p="0.30"/>
    <!-- Variant 3: an open, lightened slit -->
    <rule in="X" out="B" p="0.25"/>
  </one>
  <all in="X" out="m"/>

  <!-- B) Resolution of the photon core of the slit (Y)         -->
  <one steps="1">
    <!-- Variant 1: a concentrated white laser core -->
    <rule in="Y" out="W" p="0.50"/>
    <!-- Variant 2: a slit in full magenta spectrum -->
    <rule in="Y" out="R" p="0.50"/>
  </one>
  <all in="Y" out="W"/>

  <!-- C) Resolution of the grain of the comfort seat (Z)       -->
  <one steps="1">
    <!-- Variant 1: a central ventilation channel -->
    <rule in="Z" out="c" p="0.50"/>
    <!-- Variant 2: a solid, continuous comfort pad -->
    <rule in="Z" out="C" p="0.50"/>
  </one>
  <all in="Z" out="C"/>

  <!-- D) Ergonomic micro-grooves on the comfort seat           -->
  <prl steps="1" optional="True">
    <rule in="C C C" out="* c *" p="0.18"/>
  </prl>

  <!-- E) Reflecting facet on the upper crowning                -->
  <prl steps="1" optional="True">
    <rule in="B s" out="* s" p="0.15"/>
    <rule in="m s" out="* s" p="0.12"/>
  </prl>
</sequence>

<!-- ============================================================ -->
<!-- 8. BREATHING ANIMATION (6 FRAMES): PULSE OF THE BLADE AND LIGHTS -->
<!-- ============================================================ -->
<animation name="respiro" frames="6">
  <sequence>
    <!-- The white photon core W vibrates and swaps cells along the neon blade R -->
    <prl steps="1">
      <rule in="W R" out="R W" p="0.40"/>
      <rule in="R W" out="W R" p="0.40"/>
    </prl>

    <!-- The telemetry lights on the armrests pulse between cyan and cobalt blue -->
    <prl steps="1">
      <rule in="E" out="e" p="0.30"/>
      <rule in="e" out="E" p="0.30"/>
    </prl>
  </sequence>
</animation>
