  <box at="1 2 67" size="1 2 1" color="S"/>
  <box at="6 2 67" size="1 2 1" color="S"/>
  <box at="1 1 68" size="1 2 1" color="S"/>
  <box at="6 1 68" size="1 2 1" color="S"/>
  <box at="1 0.5 69" size="1 2 1" color="s"/>
  <box at="6 0.5 69" size="1 2 1" color="s"/>

  <!-- Outer lower fins (x = 0 and x = 7, z = 61..62) -->
  <box at="0 2 62" size="1 2 1" color="S"/>
  <box at="7 2 62" size="1 2 1" color="S"/>
  <box at="0 1 61" size="1 2 1" color="m"/>
  <box at="7 1 61" size="1 2 1" color="m"/>

  <!-- ======================================================== -->
  <!-- 5. MULTICOLOURED ENERGY COLUMN (z = 4..15)               -->
  <!-- ======================================================== -->
  <box at="3.5 4.5 15" size="4 2 1" color="T"/>
  <box at="2 5.0 15" size="1 2 1" color="G"/>
  <box at="5 5.0 15" size="1 2 1" color="G"/>

  <box at="3.5 4.5 15" size="2 2 1" color="#1"/>
  <box at="3.5 4.5 14" size="2 2 1" color="Y"/>
  <box at="3.5 4.5 13" size="2 2 1" color="U"/>
  <box at="3.5 5 12" size="2 1 1" color="R"/>
  <box at="3.5 4 11" size="2 1 1" color="Q"/>
  <box at="3.5 3 10" size="2 1 1" color="P"/>
  <box at="3.5 3 8" size="2 1 1" color="N"/>
  <box at="3.5 3 7" size="2 1 1" color="L"/>
  <box at="3.5 3 6" size="2 1 1" color="K"/>
  <box at="3.5 3 4" size="2 1 1" color="I"/>

  <!-- ======================================================== -->
  <!-- 6. GENERATIVE RULES: VARIANTS IN THE SEEDS               -->
  <!-- ======================================================== -->
  <one steps="1">
    <rule in="X" out="s" p="0.40"/>
    <rule in="X" out="m" p="0.30"/>
    <rule in="X" out="B" p="0.30"/>
  </one>
  <all in="X" out="s"/>

  <prl steps="1" optional="True">
    <rule in="B M M" out="* s *" p="0.25"/>
    <rule in="M M B" out="* s *" p="0.25"/>
    <rule in="M/M/M" out="*/m/*" p="0.15"/>
  </prl>

  <prl steps="1" optional="True">
    <rule in="T" out="G" p="0.25"/>
  </prl>
</sequence>

<!-- ============================================================ -->
<!-- 7. TELEMETRY ANIMATION (26 FRAMES): GLOBAL MJ LOGIC          -->
<!-- ============================================================ -->
<animation name="telemetria" frames="26">
  <sequence>
    <!-- 1. The cube 'p' rises 2 voxels per step in the cylinder B -->
    <one in="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp"
        out="pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB"
        steps="1" symmetry="(xy)"/>

    <!-- 2. Contact with the pattern *MM* at z=63 and the global change p -> c (magenta) -->
    <all in="****/*MM*/****/**** pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp pppp/pppp/pppp/pppp"
         out="****/*MM*/****/**** cccc/cccc/cccc/cccc cccc/cccc/cccc/cccc cccc/cccc/cccc/cccc cccc/cccc/cccc/cccc"
         steps="1" symmetry="(xy)"/>
    
    <!-- 3. Temporary removal of the 'm' bands in front of the 'v' guide (opens the B gaps at y=0) -->
    <all in="mm/vm" out="Bx/vm" symmetry="()"/>
    <all in="mm/mv" out="xB/mv" symmetry="()"/>

    <!-- 4. Gravity fall in the <markov> block down to the first non-empty brake 'b' -->
    <markov>
      <all in="*BB*/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/BBBB/BBBB/BBBB/BBBB"
           out="*BB*/****/BBBB/BBBB/BBBB/BBBB ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc"
           steps="1" symmetry="()"/>
    </markov>
    
    <!-- 5. Immediate restoring of the horizontal 'm' bands and a 1-voxel click on the brake 'b' -->
    <all in="Bx/vm" out="mm/vm" symmetry="()"/>
    <all in="xB/mv" out="mm/mv" symmetry="()"/>
    <all in="*bb*/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/BBBB/BBBB/BBBB/BBBB"
         out="*bb*/****/BBBB/BBBB/BBBB/BBBB ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc ****/****/cccc/cccc/cccc/cccc"
         steps="1" symmetry="()"/>

    <!-- 6. Diagnostic pulse of the lights at the base -->
    <prl steps="1">
      <rule in="E" out="e" p="0.30"/>
      <rule in="e" out="E" p="0.30"/>
    </prl>
  </sequence>

  <!-- Global chain of colour shift (26 stages: Cyan -> Cobalt -> Purple -> Magenta -> Off) -->
  <all in="Y" out="#1" steps="1" />
  <all in="U" out="Y" steps="1" />
  <all in="R" out="U" steps="1" />
  <all in="Q" out="R" steps="1" />
  <all in="P" out="Q" steps="1" />
  <all in="O" out="P" steps="1" />
  <all in="N" out="O" steps="1" />
  <all in="L" out="N" steps="1" />
  <all in="K" out="L" steps="1" />
  <all in="J" out="K" steps="1" />
  <all in="I" out="K" steps="1" />
  <all in="H" out="I" steps="1" />
  <all in="F" out="H" steps="1" />
  <all in="C" out="F" steps="1" />
  <all in="Z" out="C" steps="1" />
  <all in="A" out="Z" steps="1" />
  <all in="#0" out="A" steps="1" />
  <all in="#9" out="#0" steps="1" />
  <all in="#8" out="#9" steps="1" />
  <all in="#7" out="#8" steps="1" />
  <all in="#6" out="#7" steps="1" />
  <all in="#5" out="#6" steps="1" />
  <all in="#4" out="#5" steps="1" />
  <all in="#3" out="#4" steps="1" />
  <all in="#2" out="#3" steps="1" />
  <all in="#1" out="#2" steps="1" />
</animation>