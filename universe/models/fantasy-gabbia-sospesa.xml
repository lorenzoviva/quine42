  <box at="10 10 0" size="20 20 60" color="v"/>
  <all in="v" out="B"/>
  <box at="10 10 0" size="20 20 3" color="U"/>
  <box at="10 10 3" size="20 20 57" color="V"/>
  <one steps="1"><rule in="V" out="a"/><rule in="V" out="b"/><rule in="V" out="c"/><rule in="V" out="g"/></one>
  <one steps="1"><rule in="U" out="e"/><rule in="U" out="p"/><rule in="U" out="q"/></one>
  <all symmetry="(xyz)">
    <rule in="aV" out="aa"/><rule in="bV" out="bb"/><rule in="cV" out="cc"/><rule in="gV" out="gg"/>
    <rule in="eU" out="ee"/><rule in="pU" out="pp"/><rule in="qU" out="qq"/>
