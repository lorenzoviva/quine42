  <color symbol="d" value="5e5a52" name="pietra scura"/>
  <color symbol="K" value="1e1e24" name="corvo"/>
  <color symbol="F" value="7fd8ff" name="fiammella prigioniera" glow="True"/>
  <color symbol="J" hidden="True" name="ferro della gabbia in lavorazione"/>
  <color symbol="v" hidden="True" name="per mescolare il caso"/>
  <color symbol="V" hidden="True" name="spazio della forca"/>
  <color symbol="U" hidden="True" name="spazio della base"/>
  <color symbol="a" hidden="True" name="braccio a 52, gabbia tonda"/>
  <color symbol="b" hidden="True" name="braccio a 46, gabbia quadrata"/>
  <color symbol="c" hidden="True" name="braccio a 56, gabbia piccola e bassa"/>
  <color symbol="g" hidden="True" name="braccio a 42, gabbia alta e stretta"/>
  <color symbol="e" hidden="True" name="base di pietra"/>
  <color symbol="p" hidden="True" name="travi incrociate"/>
  <color symbol="q" hidden="True" name="mucchio di sassi"/>
