    <!-- 1. Quantum energy cycle of the data in the archives      -->
    <all in="#1" out="x"/>
    <all in="#2" out="#1"/>
    <all in="#3" out="#2"/>
    <all in="#4" out="#3"/>
    <all in="x" out="#4"/>

    <!-- 2. Wave of induction and magnetic repulsion on the pads  -->
    <all in="R" out="y"/>
    <all in="r" out="R"/>
    <all in="A" out="r"/>
    <all in="y" out="A"/>

    <!-- 3. Pulse of the route telemetry and the tail exhausts    -->
    <all in="T" out="z"/>
    <all in="t" out="T"/>
    <all in="z" out="t"/>
  </sequence>
</animation>
