  <line at="96 3 0" to="96 3 0" r="0" color="D"/>
  <line at="112 3 0" to="112 3 0" r="0" color="D"/>

  <!-- The harmony: the head walks 16 steps at a time and leaves a root; the seed picks the degree. -->
  <one>
    <rule in="****************B T****************" out="****************T R****************" p="3"/>
    <rule in="T**************** ****************B" out="R**************** ****************T" p="3"/>
    <rule in="T***************B" out="R***************T" p="2"/>
    <rule in="****************B ***************** ***************** T****************" out="****************T ***************** ***************** R****************"/>
    <rule in="T**************** ***************** ***************** ****************B" out="R**************** ***************** ***************** ****************T"/>
  </one>
  <all in="T" out="R"/>
  <all in="W" out="B"/>
  <all in="B/R" out="X/Y"/>

  <!-- The pad: one pattern per bar. -->
  <one>
    <rule in="**BB**BB****BBBB **************** **BB**BB****BBBB **************** X*BB**BB****BBBB" out="**NS**NS****NSSS **************** **NS**NS****NSSS **************** B*NS**NS****NSSS" p="2"/>
    <rule in="BBBB****BBBB**** **************** **************** **************** XBBB****BBBB****" out="NSSS****NSSS**** **************** **************** **************** NSSS****NSSS****" p="2"/>
    <rule in="BBBBBBBB******** **************** BBBBBBBB******** **************** XBBBBBBB********" out="NSSSSSSS******** **************** NSSSSSSS******** **************** NSSSSSSS********"/>
  </one>
  <!-- The bass on the root. -->
  <one>
    <rule in="******B*******B* Y*B*B***B*B*B***" out="******N*******N* A*N*N***A*N*N***" p="3"/>
    <rule in="*************BB* Y*BB*BB*B*BB****" out="*************NN* A*NN*NN*A*NN****" p="2"/>
    <rule in="********BB****** YB**BB******BB**" out="********NS****** AS**NS******NS**"/>
  </one>
  <!-- The drums: one pattern per bar. -->
  <one>
    <rule in="****B*******B*** **************** D**B****B*B*****" out="****C*******C*** **************** K**K****K*K*****" p="3"/>
    <rule in="****B*******B*BB **************** D*B***B*B*B*****" out="****C*******C*CC **************** K*K***K*K*K*****" p="2"/>
    <rule in="****B*******B*** **************** D******B**B***B*" out="****C*******C*** **************** K******K**K***K*" p="2"/>
    <rule in="****B*******BBBB **************** DB******BB******" out="****C*******CCCC **************** KK******KK******"/>
  </one>

  <!-- The melody: a head going forward in time and rising or falling. -->
  <one>
    <rule in="*B M*" out="*M N*" p="3"/>
    <rule in="M* *B" out="N* *M" p="3"/>
    <rule in="**B MB*" out="**M NS*" p="2"/>
    <rule in="MB* **B" out="NS* **M" p="2"/>
    <rule in="MBBB" out="ASSM"/>
    <rule in="*B ** M*" out="*M ** N*"/>
    <rule in="M* ** ** *B" out="N* ** ** *M"/>
    <rule in="MBB" out="B*M" p="2"/>
    <rule in="MB" out="BM" p="2"/>
  </one>
  <all in="M" out="B"/>
  <one in="N/*/*/*" out="A/*/*/*" steps="6"/>
  <all in="X" out="B"/>
  <all in="Y" out="B"/>
  <all in="Z" out="B"/>
  <all in="D" out="B"/>
</sequence>
