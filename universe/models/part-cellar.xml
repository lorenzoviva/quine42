<!--
The cellar (part-cellar): a part one lives in under the ground, included with <import file="part-cellar"/> after your floors have risen
and before part-stair, when the request asks for a cellar: the box then has that many voxels under the soil. You mark with D the first
layer under the soil, under the floor of the rooms the cellar goes under, before anything else is written there: <all in="h B" out="* D"/>
under a plan letter h on the soil, before it rises. D must hold 44 × 14 at least (44 along x) and room beside the stair, and stay
10 voxels back from your front wall: the floor opens over the upper treads (20 × 10 for a cellar of one tile), and one walks between them and the door. It digs the cellar down to the bottom of the box: D is its floor, V its
walls, two thick along its edge; from a landing of 5, its stair climbs along its front wall (the side of large y) toward large x by treads of 5 and risers of 3 until your floor, with 5 of floor past its top (a
deeper cellar needs a longer room: a tread more for every 3 voxels). Without room under the soil it does nothing. Its letters: D (yours, then
the floor of the cellar), V the walls, k the steps (give D, V and k your colours), #90-#93 its own markers; the union "=" is the letters of
your floors and slabs (<union symbol="=" values="…"/> in your program wins over this one).

Alone it builds a house of two storeys on the soil from its origin and digs its cellar, so that it is validated on its own (its entry has a cellar of one tile). Written by lab/banco/taglie/parti.mjs (T346, T354; ADR-0182, ADR-0183).
-->
<sequence values="BSDVk#90#91#92#93#94#95#96I#97" size="60 40 92" symmetry="()" origin="bottom" soil="#93">
  <union symbol="=" values="#96#95"/>
  <color symbol="D" value="6f655a" name="pavimento della cantina"/><color symbol="V" value="8a8172" name="muro della cantina"/><color symbol="k" value="9a7048" name="scala"/>
  <color symbol="S" value="7d766c" name="muro di prova"/><color symbol="#93" hidden="True" name="terreno di prova"/><color symbol="#96" value="8e6a44" name="pavimento di prova"/>
  <color symbol="#95" value="8e6a44" name="solaio di prova"/><color symbol="#94" value="7a4a26" name="porta di prova"/><color symbol="#97" hidden="True"/>
  <color symbol="#90" hidden="True"/><color symbol="#91" hidden="True"/><color symbol="#92" hidden="True"/><color symbol="I" hidden="True"/>

  <!-- 0. Alone (an include has no origin, so from S nothing happens there): a house of 55 × 35 from S, walls two thick, two storeys of 32 with the slab, a door of 11 × 30 at the front. -->
  <all in="S#93" out="*S" symmetry="(x)" steps="27"/>
  <all in="S/#93" out="*/S" symmetry="(y)" steps="17"/>
  <prl in="SSSSS/SSSSS/SSSSS/SSSSS/SSSSS" out="*****/*****/**#96**/*****/*****" steps="1"/>
  <all in="B S" out="S *" steps="63"/>
  <all in="B #96" out="I *" steps="1"/>
  <all in="B I" out="I *" steps="30"/>
  <all in="B I" out="#95 *" steps="1"/>
  <all in="B #95" out="I *" steps="1"/>
  <all in="B I" out="I *" steps="29"/>
  <all in="B I" out="S *" steps="1"/>
  <prl in="I" out="B" steps="1"/>
  <one in="SSSSSSSSSSSSS/BBBBBBBBBBBBB SSSSSSSSSSSSS/#93#93#93#93#93#93#93#93#93#93#93#93#93" out="*************/************* *#94#94#94#94#94#94#94#94#94#94#94*/*************" symmetry="()" steps="1"/>
  <all in="S/#94" out="#94/*" symmetry="()" steps="1"/>
  <all in="S #94" out="#94 *" steps="29"/>
  <prl in="#93" out="B" steps="1"/>
  <all in="#96 B" out="* D"/>

  <!-- 1. The cellar: D goes down to the bottom of the box; what has D under it is the room (#90), the bottom stays D, the floor. -->
  <all in="D B" out="* D"/>
  <prl in="D D" out="#90 *" steps="1"/>
  <!-- 2. The walls: the room's cells beside the earth (the air outside D) become V, two thick. -->
  <prl in="#90B" out="VB" steps="1" symmetry="(xy)"/>
  <prl in="#90V" out="VV" steps="1" symmetry="(xy)"/>
  <!-- 3. The strip of the stair, 40 × 10 of the room along its front wall (large y), just above the floor: the first 5 toward small x stay free (the landing), then the stair, then 5 free past its top. -->
  <one in="#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90#90/VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV " out="*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/*****#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91#91*****/**************************************** ****************************************/****************************************/****************************************/****************************************/****************************************/****************************************/****************************************/****************************************/****************************************/****************************************/****************************************" symmetry="()" steps="1"/>
  <!-- 4. The first tread: the first 5 cells of the strip, 3 high (the head on its last column); the rest of the strip waits. Every tread then
       goes 3 up and 5 forward through the room, until the floor above stops it (the last tread is one or two under it). -->
  <prl in="#91#91" out="*#92" steps="1"/>
  <all in="#90#90#90#90#90 #90#90#90#90#90 #91#92#92#92#92" out="kkkk#93 ***** kkkkk" symmetry="()" steps="1"/>
  <all in="*#90#90#90#90#90 *#90#90#90#90#90 *#90#90#90#90#90 #93*****" out="*kkkk#93 ****** ****** k*****" symmetry="()"/>
  <prl in="#93" out="k" steps="1"/>
  <!-- 5. Solid under the treads, down to the strip, which is their foot; the rest of the strip goes back to the room. -->
  <all in="k #90" out="* k"/>
  <prl in="k #92" out="* k" steps="1"/>
  <prl in="#92" out="#90" steps="1"/>
  <!-- 6. The opening: over every tread the room's air rises 10; where it meets the floor above, the floor opens, through all its layers. -->
  <all in="#90 k" out="#93 *"/>
  <all in="#90 #93" out="#93 *" steps="10"/>
  <all in="= #93" out="#93 *"/>
  <prl in="#93" out="B" steps="1"/>
  <prl in="#90" out="B" steps="1"/>
</sequence>
<action name="open" label="Apri la porta"><all><rule in="#94" out="#97"/></all></action>
<action name="close" label="Chiudi la porta"><all><rule in="#97" out="#94"/></all></action>
