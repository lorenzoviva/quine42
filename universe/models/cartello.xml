<!-- Signpost, procedural (Cantiere 2): post, board, border and carvings of the original (no writing: whoever passes reads it). The seed picks
     how tall the post is, how many boards it carries (one, or a second one lower down pointing to the other road) and which way each juts out, and whether
     the post is a little crooked. -->
<sequence values="BNLndhkrtaS" size="20 20 20" symmetry="(xy)" name="Cartello">
  <color symbol="N" value="6b4a2e" name="palo"/>
  <color symbol="L" value="c09a62" name="tavola"/>
  <color symbol="n" value="8a6a40" name="bordo"/>
  <color symbol="d" value="4a3420" name="incisione"/>
  <color symbol="h" hidden="True" name="altezze possibili"/>
  <color symbol="k" hidden="True" name="la quota scelta"/>
  <color symbol="r" hidden="True" name="la punta del palo"/>
  <color symbol="t" hidden="True" name="dove nasce una tavola"/>
  <color symbol="a" hidden="True" name="una tavola che si allunga"/>
  <color symbol="S" hidden="True" name="la cima"/>
  <!-- The post rises to the chosen height, perhaps bending once -->
  <box at="0 0 12" size="1 1 7" color="h"/>
  <one in="h" out="k" steps="1"/>
  <all in="h" out="B"/>
  <all in="kB" out="kk"/>
  <box at="10 10 0" size="1 1 1" color="r"/>
  <one steps="20">
    <rule in="B r" out="r N" p="1"/>
    <rule in="B* *r" out="r* *N" p="0.025"/>
  </one>
  <all in="r" out="S"/>
  <all in="k" out="B"/>
  <all in="NB" out="NN" steps="1" symmetry="()"/>
  <all in="N/B" out="N/N" steps="1" symmetry="()"/>
  <!-- The high board, under the top, and perhaps a second one lower down -->
  <all in="S/B" out="N/t" symmetry="()"/>
  <all in="* S" out="* N"/>
  <prl in="N/B" out="*/t" symmetry="()" p="0.04" steps="1"/>
  <all in="t/*/* */*/* */*/* */*/*" out="*/*/* */*/* */*/* */*/*" symmetry="()"/>
  <one steps="2" in="t" out="a"/>
  <all in="t" out="B"/>
  <!-- Every board: it stretches to the right or to the left or both ways, then gains height -->
  <one steps="2">
    <rule in="aB" out="aa"/>
    <rule in="Ba" out="aa"/>
  </one>
  <all symmetry="()">
    <rule in="aB" out="aa"/>
  </all>
  <prl steps="4" symmetry="()" in="aB" out="aa" p="0.8"/>
  <prl steps="4" symmetry="()" in="Ba" out="aa" p="0.8"/>
  <all symmetry="()" steps="3">
    <rule in="B a" out="a a"/>
  </all>
  <all symmetry="()" steps="2">
    <rule in="a B" out="a a"/>
  </all>
  <all in="B a" out="* n"/>
  <all in="a B" out="n *"/>
  <all in="a" out="L"/>
  <prl in="L/B" out="d/*" p="0.12" steps="1" symmetry="()"/>
</sequence>
