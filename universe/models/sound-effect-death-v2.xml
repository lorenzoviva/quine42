<!-- Il viaggio finisce: un colpo sordo e tre note gravi che scendono; il seme sceglie la strada della discesa, dove cade il basso e l'eco che resta. -->
<sequence name="Morte" values="BNSAGKHCTUVPM" size="16 2 9" symmetry="()">
  <sound bpm="80" scale="phrygian" root="43" swing="0" cutoff="2400" space="0.6">
    <track y="0" instrument="pad" volume="0.9"/>
    <track y="1" instrument="bass" volume="0.95"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="T" value="ec4899" name="Scelta" hidden="True"/>
  <color symbol="U" value="a855f7" name="Scelta" hidden="True"/>
  <color symbol="V" value="10b981" name="Scelta" hidden="True"/>
  <color symbol="P" value="64748b" name="Scelta" hidden="True"/>
  <color symbol="M" value="14b8a6" name="Scelta" hidden="True"/>

  <!-- Il colpo, sempre; un secondo colpo più lontano, a volte. -->
  <line at="0 1 0" to="0 1 0" r="0" color="K"/>
  <line at="12 1 0" to="12 1 0" r="0" color="P"/>
  <line at="14 1 0" to="14 1 0" r="0" color="P"/>
  <line at="13 1 0" to="13 1 0" r="0" color="P"/>
  <one in="P" out="K" steps="1"/>
  <all in="P" out="B"/>
  <!-- La discesa: da dove parte, dove passa, dove si posa (accento). -->
  <line at="0 0 6" to="0 0 6" r="0" color="T"/>
  <line at="0 0 7" to="0 0 7" r="0" color="T"/>
  <one in="T" out="N" steps="1"/>
  <all in="T" out="B"/>
  <line at="4 0 5" to="4 0 5" r="0" color="U"/>
  <line at="4 0 4" to="4 0 4" r="0" color="U"/>
  <line at="5 0 5" to="5 0 5" r="0" color="U"/>
  <one in="U" out="N" steps="1"/>
  <all in="U" out="B"/>
  <line at="8 0 3" to="8 0 3" r="0" color="V"/>
  <line at="8 0 2" to="8 0 2" r="0" color="V"/>
  <one in="V" out="A" steps="1"/>
  <all in="V" out="B"/>
  <!-- Il basso sotto l'ultima nota, o un'ottava più giù. -->
  <line at="8 1 3" to="8 1 3" r="0" color="M"/>
  <line at="8 1 1" to="8 1 1" r="0" color="M"/>
  <line at="9 1 2" to="9 1 2" r="0" color="M"/>
  <one in="M" out="N" steps="1"/>
  <all in="M" out="B"/>
  <!-- Le code: ogni nota tiene fino alla successiva, l'ultima a lungo. -->
  <all in="NBB" out="NSS"/>
  <all in="ABBBBB" out="ASSSSS"/>
  <!-- L'eco: un ghost che risale appena, in fondo. -->
  <line at="14 0 1" to="14 0 1" r="0" color="T"/>
  <line at="14 0 0" to="14 0 0" r="0" color="T"/>
  <line at="15 0 1" to="15 0 1" r="0" color="T"/>
  <one in="T" out="G" steps="1"/>
  <all in="T" out="B"/>
</sequence>
