<!--
corona-gerboa-attore: L'Interprete del Concilio (avatar della Corona).
Membro del Concilio in forma di Gerboa gigante attore di compagnia (scala 20 vpt, anatomia base con orecchie in avanti).
Manto lilla cenere con ventre chiaro. Indossa un grande cappello da moschettiere a tesa larga verde acqua (#5ce0c8, colore araldico
dell'Attore) con fascia e fibbia d'oro e una lunga piuma bianca che sale dietro le orecchie e ricade (la punta brilla: glow="True");
sul muso una mezza maschera da teatro, metà scura e metà chiara come il suo sigillo; al collo una gorgiera bianca a pieghe;
giubba verde scuro con bottoni d'oro; pennacchio caudale verde acqua.
Scatola: 1.6 × 2.2 × 2.1 caselle, 32 × 44 × 42 voxel, 20 voxel per casella (vpt: 20).
Ruolo: npc.
-->
<sequence values="BFfDCcTtUuNWEZRrOoGgPpaAKkJIHhSsVvLMmXxYyQq" size="32 44 42" symmetry="()" name="GerboaAttore">
  <!-- Manto lilla cenere del corpo e dorso -->
  <color symbol="F" value="9c8fb0" name="lilla cenere base dorso"/>
  <color symbol="f" value="b7abc9" name="lilla chiaro luce dorso"/>
  <color symbol="D" value="6f6485" name="lilla scuro ombra"/>

  <!-- Ventre, petto e gola chiari -->
  <color symbol="C" value="f0e8f7" name="chiaro ventre"/>
  <color symbol="c" value="d9cfe6" name="sfumatura pancia"/>

  <!-- Testa, musetto, tartufo e baffi (part="testa") -->
  <color symbol="T" value="9c8fb0" part="testa" name="testa lilla base"/>
  <color symbol="t" value="b7abc9" part="testa" name="guance lilla chiaro"/>
  <color symbol="U" value="f0e8f7" part="testa" name="musetto chiaro"/>
  <color symbol="u" value="d9cfe6" part="testa" name="sfumatura musetto"/>
  <color symbol="N" value="3a2c48" part="testa" name="tartufo scuro"/>
  <color symbol="W" value="5b4f6b" part="testa" name="baffetti vibrisse"/>
  <color symbol="E" value="14161d" part="testa" name="occhi scuri profondi"/>
  <color symbol="Z" value="ffffff" glow="True" part="testa" name="riflesso occhi vispo"/>

  <!-- Grandi orecchie a conchiglia (part="testa") -->
  <color symbol="O" value="9c8fb0" part="testa" name="dorso orecchio lilla"/>
  <color symbol="o" value="b7abc9" part="testa" name="bordo orecchio chiaro"/>
  <color symbol="R" value="f7bed0" part="testa" name="interno orecchio rosa"/>
  <color symbol="r" value="ffdbe5" part="testa" name="concavita orecchio rosa chiaro"/>

  <!-- Zampe posteriori bipedali piegate a Z (part="gamba") -->
  <color symbol="G" value="9c8fb0" part="gamba" name="coscia lilla"/>
  <color symbol="g" value="6f6485" part="gamba" name="stinco e garretto"/>
  <color symbol="P" value="f0e8f7" part="gamba" name="piede chiaro dita"/>
  <color symbol="p" value="c9b8d8" part="gamba" name="polpastrelli unghie"/>

  <!-- Zampette anteriori al petto (part="braccio") -->
  <color symbol="A" value="9c8fb0" part="braccio" name="braccino lilla"/>
  <color symbol="a" value="f0e8f7" part="braccio" name="manina chiara"/>

  <!-- Coda e pennacchio verde acqua (part="coda") -->
  <color symbol="K" value="9c8fb0" part="coda" name="fusto coda lilla"/>
  <color symbol="k" value="6f6485" part="coda" name="giunto fusto coda"/>
  <color symbol="J" value="2c7d70" part="coda" name="base pennacchio verde scuro"/>
  <color symbol="I" value="5ce0c8" part="coda" name="ciuffo pennacchio verde acqua"/>

  <!-- Accessori dell'Attore: cappello da moschettiere (part="testa") -->
  <color symbol="H" value="5ce0c8" part="testa" name="cappello verde acqua"/>
  <color symbol="h" value="8aefdc" part="testa" name="cupola cappello luce"/>
  <color symbol="S" value="f4c95d" part="testa" name="fascia oro"/>
  <color symbol="s" value="2c7d70" part="testa" name="sottotesa verde scuro"/>
  <color symbol="L" value="ffd700" glow="True" part="testa" name="fibbia oro"/>
  <color symbol="M" value="fffaf0" part="testa" name="piuma bianca"/>
  <color symbol="m" value="e6dfd0" part="testa" name="costa della piuma e pieghe"/>
  <color symbol="x" value="ffffff" glow="True" part="testa" name="punta della piuma"/>

  <!-- La mezza maschera da teatro (part="testa") -->
  <color symbol="V" value="1d2030" part="testa" name="maschera meta scura"/>
  <color symbol="v" value="f5f2ea" part="testa" name="maschera meta chiara"/>
  <color symbol="X" value="f4c95d" part="testa" name="profilo oro della maschera"/>

  <!-- Giubba verde scuro e gorgiera -->
  <color symbol="Y" value="2c7d70" name="giubba verde scuro"/>
  <color symbol="y" value="5ce0c8" name="bordi giubba verde acqua"/>
  <color symbol="Q" value="ffd700" glow="True" name="bottoni oro"/>
  <color symbol="q" value="fffaf0" name="gorgiera bianca"/>

  <!-- ======================================================== -->
  <!-- 1. LUNGHE ZAMPE POSTERIORI DA SALTATORE (part="gamba")   -->
  <!-- ======================================================== -->
  <!-- Piedone sinistro al suolo (x=10..12, y=15..28, z=0..1)   -->
  <box at="11 21.5 0" size="3 14 1" color="P"/>
  <box at="10 28 0" size="1 1 1" color="p"/>
  <box at="11 28 0" size="1 1 1" color="p"/>
  <box at="12 28 0" size="1 1 1" color="p"/>
  <box at="11 20 1" size="3 8 1" color="P"/>
  <box at="11 15.5 0" size="3 3 3" color="g"/>

  <!-- Piedone destro al suolo (x=19..21, y=15..28, z=0..1)     -->
  <box at="20 21.5 0" size="3 14 1" color="P"/>
  <box at="19 28 0" size="1 1 1" color="p"/>
  <box at="20 28 0" size="1 1 1" color="p"/>
  <box at="21 28 0" size="1 1 1" color="p"/>
  <box at="20 20 1" size="3 8 1" color="P"/>
  <box at="20 15.5 0" size="3 3 3" color="g"/>

  <!-- Lunghi stinchi inclinati in avanti dal garretto al ginocchio (z=2..12) -->
  <line at="11 15.5 2" to="11 24.5 11.5" r="1.1" color="g"/>
  <line at="20 15.5 2" to="20 24.5 11.5" r="1.1" color="g"/>

  <!-- Cosce muscolose alte piegate a Z che raccordano ginocchio e bacino -->
  <ellipsoid at="11 20 9.5" size="5 9 10" color="G"/>
  <ellipsoid at="20 20 9.5" size="5 9 10" color="G"/>

  <!-- ======================================================== -->
  <!-- 2. CORPO ALLUNGATO INCLINATO E PETTO CANDIDO             -->
  <!-- ======================================================== -->
  <!-- Groppa posteriore alta (si salda alle cosce e alla coda) -->
  <ellipsoid at="15.5 18 15" size="12 10 9" color="F"/>
  <ellipsoid at="15.5 18 14" size="10 8 5" color="D"/>
  <box at="15.5 20 18" size="4 4 1" color="f"/>

  <!-- Dorso medio allungato (inclinato verso il basso e in avanti) -->
  <ellipsoid at="15.5 24 14" size="11 10 8" color="F"/>

  <!-- Petto e spalle anteriori -->
  <ellipsoid at="15.5 29 14.5" size="10 8 8" color="F"/>

  <!-- Soffice ventre e pettorina chiaro panna (+y e parte inferiore) -->
  <ellipsoid at="15.5 24 11" size="8 9 5" color="C"/>
  <ellipsoid at="15.5 28 12.5" size="7 7 6" color="C"/>
  <ellipsoid at="15.5 31 14" size="6 5 5" color="c"/>


  <!-- ======================================================== -->
  <!-- 3. GIUBBA DA TEATRO ABBOTTONATA SUL PANCINO              -->
  <!-- ======================================================== -->
  <ellipsoid at="15.5 25 12" size="9.5 9.5 6.5" color="Y"/>
  <box at="15.5 26.5 11.5" size="8 7 5" color="Y"/>
  <line at="12 24 10" to="19 24 10" r="0.5" color="y"/>
  <line at="13 32 14" to="15.5 31 11" r="0.6" color="y"/>
  <line at="18 32 14" to="15.5 31 11" r="0.6" color="y"/>
  <box at="15.5 31.5 11" size="2 1 1" color="Q"/>
  <box at="15.5 32 12.5" size="2 1 1" color="Q"/>

  <!-- ======================================================== -->
  <!-- 4. ZAMPETTE ANTERIORI MINUSCOLE AL PETTO (part="braccio") -->
  <!-- ======================================================== -->
  <!-- Braccino sinistro e manina chiaro -->
  <line at="12 29 14" to="13.5 32 12" r="0.6" color="A"/>
  <box at="13.5 33 12" size="2 2 2" color="a"/>

  <!-- Braccino destro e manina chiaro -->
  <line at="19 29 14" to="17.5 32 12" r="0.6" color="A"/>
  <box at="17.5 33 12" size="2 2 2" color="a"/>

  <!-- ======================================================== -->
  <!-- 5. TESTA GRANDE, GUANCE, MUSETTO, OCCHI (part="testa")   -->
  <!-- ======================================================== -->
  <!-- Cranio principale lilla -->
  <ellipsoid at="15.5 31 19" size="13 11 10" color="T"/>

  <!-- Fronte tra gli occhi -->
  <box at="15.5 34 21" size="4 4 4" color="T"/>
  <box at="15.5 36 22" size="2 2 2" color="t"/>

  <!-- Guanciotte morbide ai lati del muso -->
  <ellipsoid at="10.5 34 18.5" size="5 5 5" color="t"/>
  <ellipsoid at="20.5 34 18.5" size="5 5 5" color="t"/>
  <box at="10 35 18" size="3 3 3" color="U"/>
  <box at="21 35 18" size="3 3 3" color="U"/>

  <!-- Musetto conico chiaro allungato in avanti -->
  <box at="15.5 37 18" size="5 4 3" color="U"/>
  <box at="15.5 39 18" size="3 3 2" color="U"/>
  <box at="15.5 38 17" size="2 1 1" color="u"/>
  <!-- Tartufo nasino rosa -->
  <box at="15.5 40 19" size="2 1 1" color="N"/>

  <!-- Sottili accenni di vibrisse discrete sul muso -->
  <box at="13 38 18" size="1 1 1" color="W"/>
  <box at="18 38 18" size="1 1 1" color="W"/>

  <!-- Occhio sinistro profondo (3x2x3 voxel) con vispo riflesso bianco Z -->
  <box at="11 34.5 20" size="3 2 3" color="E"/>
  <box at="10 35 22" size="1 1 1" color="Z"/>

  <!-- Occhio destro profondo (3x2x3 voxel) con vispo riflesso bianco Z -->
  <box at="20 34.5 20" size="3 2 3" color="E"/>
  <box at="21 35 22" size="1 1 1" color="Z"/>

  <!-- ======================================================== -->
  <!-- 6. GIGANTESCHE ORECCHIE A CONCHIGLIA (part="testa", z=25..39) -->
  <!-- ======================================================== -->
  <!-- Orecchio sinistro: guscio lilla posteriore/esterno -->
  <ellipsoid at="9.5 29 25" size="8 4 15" color="O"/>
  <!-- Padiglione interno concavo velluto rosa -->
  <ellipsoid at="9.5 30.5 26" size="6 3 13" color="R"/>
  <box at="9.5 31 27" size="4 1 8" color="r"/>
  <line at="6 30 28" to="9 30 38" r="0.5" color="o"/>

  <!-- Orecchio destro: guscio lilla posteriore/esterno -->
  <ellipsoid at="21.5 29 25" size="8 4 15" color="O"/>
  <!-- Padiglione interno concavo velluto rosa -->
  <ellipsoid at="21.5 30.5 26" size="6 3 13" color="R"/>
  <box at="21.5 31 27" size="4 1 8" color="r"/>
  <line at="25 30 28" to="22 30 38" r="0.5" color="o"/>

  <!-- ======================================================== -->
  <!-- 7. GORGIERA BIANCA A PIEGHE ATTORNO AL COLLO             -->
  <!-- ======================================================== -->
  <ellipsoid at="15.5 30.5 14.5" size="16 12 3" color="q"/>
  <box at="9 30 14.5" size="1 1 2" color="m"/>
  <box at="22 30 14.5" size="1 1 2" color="m"/>
  <box at="12 35 14.5" size="1 1 2" color="m"/>
  <box at="19 35 14.5" size="1 1 2" color="m"/>
  <box at="15.5 36 14.5" size="1 1 2" color="m"/>

  <!-- ======================================================== -->
  <!-- 8. MEZZA MASCHERA DA TEATRO: META SCURA, META CHIARA     -->
  <!-- ======================================================== -->
  <box at="13 36 21" size="5 1 3" color="V"/>
  <box at="18 36 21" size="5 1 3" color="v"/>
  <box at="15.5 36 23" size="10 1 1" color="X"/>

  <!-- ======================================================== -->
  <!-- 9. CAPPELLO DA MOSCHETTIERE A TESA LARGA (part="testa")  -->
  <!-- ======================================================== -->
  <!-- La tesa larga passa tra le orecchie: la sotto-tesa scura e sopra il verde acqua -->
  <cylinder at="15.5 29.5 25" size="16 15 1" color="s"/>
  <cylinder at="15.5 29.5 26" size="16 15 1" color="H"/>
  <!-- La cupola e la fascia d'oro con la fibbia -->
  <cylinder at="15.5 30 28" size="9 9 3" color="H"/>
  <ellipsoid at="15.5 30 30.5" size="8.5 8.5 4" color="h"/>
  <cylinder at="15.5 30 27" size="9.5 9.5 1" color="S"/>
  <box at="15.5 35 27" size="2 1 2" color="L"/>
  <!-- La lunga piuma: sale dalla fascia, passa dietro le orecchie e ricade -->
  <line at="19 29 28" to="20 24 36" r="1.3" color="M"/>
  <line at="20 24 36" to="18 15 39" r="1.2" color="M"/>
  <line at="18 15 39" to="15 8 36" r="0.9" color="M"/>
  <line at="20 24 37" to="18 15 40" r="0.4" color="m"/>
  <box at="15 8 36" size="2 2 2" color="x"/>

  <!-- ======================================================== -->
  <!-- 10. LUNGHISSIMA CODA E PENNACCHIO VERDE ACQUA (part="coda") -->
  <!-- ======================================================== -->
  <!-- Attacco alla groppa posteriore alta (y=15, z=16) -->
  <line at="15.5 15 16" to="15.5 10 9" r="1.1" color="K"/>
  <!-- Discesa sinuosa verso il terreno -->
  <line at="15.5 10 9" to="15.5 6 4" r="0.9" color="K"/>
  <line at="15.5 6 4" to="15.5 3.5 2.5" r="0.8" color="K"/>
  <!-- Risalita verso l'alto -->
  <line at="15.5 3.5 2.5" to="15.5 2.5 5.5" r="0.8" color="k"/>
  <line at="15.5 2.5 5.5" to="15.5 2.5 9" r="0.8" color="k"/>


  <!-- Pennacchio: base verde scuro e grande ciuffo verde acqua -->
  <ellipsoid at="15.5 2.5 9" size="5 4 5" color="J"/>
  <ellipsoid at="15.5 2.5 12" size="6 5 6" color="I"/>
  <ellipsoid at="15.5 2.5 16" size="4 4 5" color="I"/>
  <box at="15.5 2.5 18" size="2 2 2" color="I"/>

  <!-- ======================================================== -->
  <!-- 11. REGOLE GENERATIVE: SFUMATURE E PELO                  -->
  <!-- ======================================================== -->
  <prl steps="1" p="0.3" in="B F" out="B f"/>
  <prl steps="1" p="0.15" in="F/B" out="D/*"/>
  <prl steps="1" p="0.35" in="Y/C" out="*/c"/>
  <prl steps="1" p="0.25" in="t U" out="u *"/>
</sequence>
