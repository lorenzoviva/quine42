  <line at="4 1 4" to="4 1 4" r="0" color="U"/>
  <line at="5 1 6" to="5 1 6" r="0" color="U"/>
  <one in="T" out="N" steps="1"/>
  <all in="T" out="B"/>
  <one in="U" out="N" steps="1"/>
  <all in="U" out="B"/>
  <all in="NBBBBBBBB" out="NSSSSSSSS"/>
</sequence>
