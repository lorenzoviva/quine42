<!-- A teleport: a very fast arpeggio rising and vanishing into a suspended chord; the seed picks the steps and the top. -->
<sequence name="Teletrasporto" values="BNSAGKHCTUVPM" size="14 2 14" symmetry="()">
  <sound bpm="176" scale="hirajoshi" root="52" swing="0" cutoff="9000" space="0.7">
    <track y="0" instrument="lead" volume="0.5"/>
    <track y="1" instrument="pad" volume="0.6"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
