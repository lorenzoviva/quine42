<!-- Un allarme: due note che si alternano strette, su e giù come una sirena, con un colpo a ogni giro; il seme sceglie le due note e dove batte. -->
<sequence name="Allarme e sirena" values="BNSAGKHCTUVPM" size="12 2 12" symmetry="()">
  <sound bpm="150" scale="harmonic_minor" root="57" swing="0" cutoff="7000" space="0.25">
    <track y="0" instrument="lead" volume="0.5"/>
    <track y="1" instrument="bass" volume="0.65"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="T" value="ec4899" name="Scelta" hidden="True"/>
  <color symbol="U" value="a855f7" name="Scelta" hidden="True"/>
  <color symbol="V" value="10b981" name="Scelta" hidden="True"/>
  <color symbol="P" value="64748b" name="Scelta" hidden="True"/>
  <color symbol="M" value="14b8a6" name="Scelta" hidden="True"/>

  <!-- La nota alta e quella bassa, scelte una volta. -->
  <line at="0 0 6" to="0 0 6" r="0" color="T"/>
  <line at="0 0 7" to="0 0 7" r="0" color="T"/>
  <one in="T" out="A" steps="1"/>
  <all in="T" out="B"/>
  <line at="3 0 4" to="3 0 4" r="0" color="U"/>
  <line at="3 0 5" to="3 0 5" r="0" color="U"/>
  <one in="U" out="N" steps="1"/>
  <all in="U" out="B"/>
  <!-- Si ripetono: il passo dopo, la stessa altezza. -->
  <all in="ABBBBBB" out="ASSBBBN"/>
  <all in="NBBBBBB" out="NSSBBBN"/>
  <all in="NBB" out="NSS"/>
  <!-- Il colpo. -->
  <line at="0 1 0" to="0 1 0" r="0" color="K"/>
  <line at="6 1 2" to="6 1 2" r="0" color="V"/>
  <line at="6 1 0" to="6 1 0" r="0" color="V"/>
  <line at="9 1 2" to="9 1 2" r="0" color="V"/>
  <one in="V" out="C" steps="1"/>
  <all in="V" out="B"/>
  <line at="1 1 1" to="11 1 1" r="0" color="P"/>
  <one in="P" out="H" steps="3"/>
  <all in="P" out="B"/>
</sequence>
