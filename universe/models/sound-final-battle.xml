<!-- Dal SoundLab: forme solide scolpiscono un ostinato aggressivo e una batteria industriale, poi un markov inietta sincopi, accenti e ribattuti. -->
<sequence name="Boss Fight Cyber-Dungeon" values="BNSAGKHCRTMP" size="16 3 8" symmetry="()">
  <sound bpm="138" scale="phrygian" root="48" swing="0.12" cutoff="4800" space="0.35">
    <track y="0" instrument="lead" volume="0.82"/>
    <track y="1" instrument="pad" volume="0.75"/>
    <track y="2" instrument="bass" volume="0.9"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="T" value="ec4899" name="Meta" hidden="True"/>
  <color symbol="M" value="10b981" name="Motivo" hidden="True"/>
  <color symbol="P" value="64748b" name="Passaggio" hidden="True"/>

  <!-- Una rampa diagonale sulla melodia (y=0). -->
  <line at="0 0 1" to="15 0 6" r="0" color="M"/>
  <!-- L'ostinato del basso (y=2). -->
  <line at="0 2 0" to="15 2 0" r="0" color="R"/>
  <!-- Due pilastri di accordi sul pad (y=1). -->
  <box at="2 1 2" size="3 1 4" color="T"/>
  <box at="10 1 3" size="3 1 4" color="T"/>
  <!-- I blocchi grezzi diventano ritmo; quando non c'è altro da fare, sincopi e ribattuti. -->
  <markov>
    <all>
      <rule in="RRRR" out="KHKC"/>
      <rule in="TTT" out="ASS"/>
      <rule in="MM" out="AG"/>
    </all>
    <one steps="12" symmetry="(x)">
      <rule in="MB" out="NS"/>
      <rule in="BK" out="GK"/>
      <rule in="T" out="N"/>
    </one>
  </markov>
  <!-- I segni rimasti suonano. -->
  <all>
    <rule in="M" out="A"/>
    <rule in="R" out="K"/>
  </all>
</sequence>
