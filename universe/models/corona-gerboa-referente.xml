<!--
corona-gerboa-referente: L'Ambasciatore del Concilio (avatar della Corona).
Membro del Concilio in forma di Gerboa gigante referente diplomatico (scala 20 vpt, anatomia base con orecchie in avanti).
Manto candido bianco latte splendente con soffice pettorina e ventre panna puro, orecchie e nasino rosa pallido.
Indossa un berretto da concierge d'albergo d'alta classe cerimoniale bianco con fascia argentata e visiera bordata
in argento metallico riflettente con coccarda dorata araldica (glow="True"), sagomato tra le orecchie con asole sartoriali anatomiche;
auricolare diplomatico integrato con sottile visiera a display trasparente che scende davanti agli occhi proiettando
rune dorate fluttuanti (glow="True"); elegante gilet argentato broccato abbottonato sul pancino con bottoncini dorati gioiello
(glow="True") e papillon diplomatico di gala scuro sotto la gola, e sontuoso pennacchio caudale con batuffolo candido splendente.
Scatola: 1.6 × 2.2 × 2.1 caselle, 32 × 44 × 42 voxel, 20 voxel per casella (vpt: 20).
Ruolo: npc.
-->
<sequence values="BFfDCcTtUuNWEZRrOoGgPpaAKkJIHhSsVvLMmXxYyQq" size="32 44 42" symmetry="()" name="GerboaReferente">
  <!-- Manto candido bianco latte / argento perlato del corpo e dorso -->
  <color symbol="F" value="f4f5f7" name="bianco latte perla base dorso"/>
  <color symbol="f" value="ffffff" name="bianco candido puro luce dorso"/>
  <color symbol="D" value="d6dbe2" name="argento perlato tenue ombra"/>

  <!-- Ventre, petto e gola in morbido candido puro panna -->
  <color symbol="C" value="ffffff" name="candido puro panna ventre"/>
  <color symbol="c" value="eaedf1" name="sfumatura delicata pancia"/>

  <!-- Testa, musetto, tartufo e baffi (part="testa") -->
  <color symbol="T" value="f4f5f7" part="testa" name="testa candida base"/>
  <color symbol="t" value="ffffff" part="testa" name="guance candide soffici"/>
  <color symbol="U" value="ffffff" part="testa" name="musetto candido puro"/>
  <color symbol="u" value="eaedf1" part="testa" name="sfumatura musetto"/>
  <color symbol="N" value="f7a8b8" part="testa" name="tartufo nasino rosa pallido"/>
  <color symbol="W" value="c0c8d4" part="testa" name="baffetti vibrisse discrete"/>
  <color symbol="E" value="14161d" part="testa" name="occhi scuri profondi"/>
  <color symbol="Z" value="ffffff" glow="True" part="testa" name="riflesso occhi vispo"/>

  <!-- Grandi orecchie a conchiglia (part="testa") -->
  <color symbol="O" value="f4f5f7" part="testa" name="dorso orecchio bianco latte"/>
  <color symbol="o" value="ffffff" part="testa" name="bordo orecchio candido"/>
  <color symbol="R" value="f7bed0" part="testa" name="interno orecchio rosa pallido"/>
  <color symbol="r" value="ffdbe5" part="testa" name="concavita orecchio rosa chiarissimo"/>

  <!-- Zampe posteriori bipedali piegate a Z (part="gamba") -->
  <color symbol="G" value="f4f5f7" part="gamba" name="coscia candida"/>
  <color symbol="g" value="d6dbe2" part="gamba" name="stinco e garretto argento tenue"/>
  <color symbol="P" value="ffffff" part="gamba" name="piede candido dita"/>
  <color symbol="p" value="f7bed0" part="gamba" name="polpastrelli unghie rosa pallido"/>

  <!-- Zampette anteriori al petto (part="braccio") -->
  <color symbol="A" value="f4f5f7" part="braccio" name="braccino candido"/>
  <color symbol="a" value="ffffff" part="braccio" name="manina candida guantata"/>

  <!-- Coda sinuosa e maestoso pennacchio (part="coda") -->
  <color symbol="K" value="f4f5f7" part="coda" name="fusto coda bianco latte"/>
  <color symbol="k" value="d6dbe2" part="coda" name="giunto fusto coda argento"/>
  <color symbol="J" value="b0b8c4" part="coda" name="base pennacchio argento satinato"/>
  <color symbol="I" value="ffffff" part="coda" name="ciuffo pennacchio candido splendente"/>

  <!-- Accessori del Referente: Berretto Concierge d'alta classe (part="testa") -->
  <color symbol="H" value="ffffff" part="testa" name="berretto concierge bianco cerimonia"/>
  <color symbol="h" value="f0f2f5" part="testa" name="sommita berretto rilievo"/>
  <color symbol="S" value="c2c3c7" part="testa" name="fascia perimetrale argento satinato"/>
  <color symbol="s" value="8e9aa5" part="testa" name="bordo fascia e profilo scuro"/>
  <color symbol="V" value="2b303a" part="testa" name="visiera lucida scura cerimonia"/>
  <color symbol="v" value="f2f2f2" glow="True" part="testa" name="filetto visiera argento brillante glow"/>
  <color symbol="L" value="ffd700" glow="True" part="testa" name="coccarda stemma diplomatico oro glow"/>

  <!-- Hardware diplomatico: Auricolare e Visore HUD olografico (part="testa") -->
  <color symbol="M" value="8e9aa5" part="testa" name="titanio staffe auricolare"/>
  <color symbol="m" value="e0e4eb" part="testa" name="cromo lucido snodi auricolare"/>
  <color symbol="X" value="c0f0ff" glow="True" part="testa" name="visiera display trasparente olografica glow"/>
  <color symbol="x" value="ffd700" glow="True" part="testa" name="rune dorate proiettate glow"/>

  <!-- Elegante gilet argentato e papillon diplomatico -->
  <color symbol="Y" value="9aa3af" name="gilet argento broccato satinato"/>
  <color symbol="y" value="c2c3c7" name="bordi revers e spilla gilet argento"/>
  <color symbol="Q" value="ffd700" glow="True" name="bottoncini dorati gioiello glow"/>
  <color symbol="q" value="363e4a" name="papillon diplomatico gala grafite"/>

  <!-- ======================================================== -->
  <!-- 1. LUNGHE ZAMPE POSTERIORI DA SALTATORE (part="gamba")   -->
  <!-- ======================================================== -->
  <!-- Piedone sinistro al suolo (x=10..12, y=15..28, z=0..1)   -->
  <box at="11 21.5 0" size="3 14 1" color="P"/>
  <box at="10 28 0" size="1 1 1" color="p"/>
  <box at="11 28 0" size="1 1 1" color="p"/>
  <box at="12 28 0" size="1 1 1" color="p"/>
  <box at="11 20 1" size="3 8 1" color="P"/>
  <box at="11 15.5 0" size="3 3 3" color="g"/>

  <!-- Piedone destro al suolo (x=19..21, y=15..28, z=0..1)     -->
  <box at="20 21.5 0" size="3 14 1" color="P"/>
  <box at="19 28 0" size="1 1 1" color="p"/>
  <box at="20 28 0" size="1 1 1" color="p"/>
  <box at="21 28 0" size="1 1 1" color="p"/>
  <box at="20 20 1" size="3 8 1" color="P"/>
  <box at="20 15.5 0" size="3 3 3" color="g"/>

  <!-- Lunghi stinchi inclinati in avanti dal garretto al ginocchio (z=2..12) -->
  <line at="11 15.5 2" to="11 24.5 11.5" r="1.1" color="g"/>
  <line at="20 15.5 2" to="20 24.5 11.5" r="1.1" color="g"/>

  <!-- Cosce muscolose alte piegate a Z che raccordano ginocchio e bacino -->
  <ellipsoid at="11 20 9.5" size="5 9 10" color="G"/>
  <ellipsoid at="20 20 9.5" size="5 9 10" color="G"/>

  <!-- ======================================================== -->
  <!-- 2. CORPO ALLUNGATO INCLINATO E PETTO CANDIDO             -->
  <!-- ======================================================== -->
  <!-- Groppa posteriore alta (si salda alle cosce e alla coda) -->
  <ellipsoid at="15.5 18 15" size="12 10 9" color="F"/>
  <ellipsoid at="15.5 18 14" size="10 8 5" color="D"/>
  <box at="15.5 20 18" size="4 4 1" color="f"/>

  <!-- Dorso medio allungato (inclinato verso il basso e in avanti) -->
  <ellipsoid at="15.5 24 14" size="11 10 8" color="F"/>

  <!-- Petto e spalle anteriori -->
  <ellipsoid at="15.5 29 14.5" size="10 8 8" color="F"/>

  <!-- Soffice ventre e pettorina candida panna (+y e parte inferiore) -->
  <ellipsoid at="15.5 24 11" size="8 9 5" color="C"/>
  <ellipsoid at="15.5 28 12.5" size="7 7 6" color="C"/>
  <ellipsoid at="15.5 31 14" size="6 5 5" color="c"/>

  <!-- ======================================================== -->
  <!-- 3. ELEGANTE GILET ARGENTATO ABBOTTONATO SUL PANCINO      -->
  <!-- ======================================================== -->
  <!-- Sagomatura del gilet sul busto -->
  <ellipsoid at="15.5 25 12" size="9.5 9.5 6.5" color="Y"/>
  <box at="15.5 26.5 11.5" size="8 7 5" color="Y"/>

  <!-- Bordi e revers del gilet in argento satinato chiaro -->
  <line at="12.5 28 13.5" to="15.5 26 11.5" r="0.6" color="y"/>
  <line at="18.5 28 13.5" to="15.5 26 11.5" r="0.6" color="y"/>
  <line at="12 24 10" to="19 24 10" r="0.5" color="y"/>
  <line at="13 32 14" to="15.5 31 11" r="0.6" color="y"/>
  <line at="18 32 14" to="15.5 31 11" r="0.6" color="y"/>

  <!-- Bottoncini dorati gioiello scintillanti sul pancino (glow="True") -->
  <box at="15.5 31.5 11" size="2 1 1" color="Q"/>
  <box at="15.5 32 12.5" size="2 1 1" color="Q"/>
  <box at="15.5 32.5 14" size="2 1 1" color="Q"/>

  <!-- Papillon diplomatico di gala scuro e spilla al collo -->
  <box at="15.5 32 15" size="4 1 1.5" color="q"/>
  <box at="15.5 32.5 15" size="1.5 1 1.5" color="y"/>

  <!-- ======================================================== -->
  <!-- 4. ZAMPETTE ANTERIORI MINUSCOLE AL PETTO (part="braccio") -->
  <!-- ======================================================== -->
  <!-- Braccino sinistro e manina candida -->
  <line at="12 29 14" to="13.5 32 12" r="0.6" color="A"/>
  <box at="13.5 33 12" size="2 2 2" color="a"/>

  <!-- Braccino destro e manina candida -->
  <line at="19 29 14" to="17.5 32 12" r="0.6" color="A"/>
  <box at="17.5 33 12" size="2 2 2" color="a"/>

  <!-- ======================================================== -->
  <!-- 5. TESTA GRANDE, GUANCE, MUSETTO, OCCHI (part="testa")   -->
  <!-- ======================================================== -->
  <!-- Cranio principale bianco latte -->
  <ellipsoid at="15.5 31 19" size="13 11 10" color="T"/>

  <!-- Fronte tra gli occhi -->
  <box at="15.5 34 21" size="4 4 4" color="T"/>
  <box at="15.5 36 22" size="2 2 2" color="t"/>

  <!-- Guanciotte morbide ai lati del muso -->
  <ellipsoid at="10.5 34 18.5" size="5 5 5" color="t"/>
  <ellipsoid at="20.5 34 18.5" size="5 5 5" color="t"/>
  <box at="10 35 18" size="3 3 3" color="U"/>
  <box at="21 35 18" size="3 3 3" color="U"/>

  <!-- Musetto conico candido allungato in avanti -->
  <box at="15.5 37 18" size="5 4 3" color="U"/>
  <box at="15.5 39 18" size="3 3 2" color="U"/>
  <box at="15.5 38 17" size="2 1 1" color="u"/>
  <!-- Tartufo nasino rosa pallido confetto -->
  <box at="15.5 40 19" size="2 1 1" color="N"/>

  <!-- Sottili accenni di vibrisse argentee discrete sul muso -->
  <box at="13 38 18" size="1 1 1" color="W"/>
  <box at="18 38 18" size="1 1 1" color="W"/>

  <!-- Occhio sinistro profondo (3x2x3 voxel) con vispo riflesso bianco Z -->
  <box at="11 34.5 20" size="3 2 3" color="E"/>
  <box at="10 35 22" size="1 1 1" color="Z"/>

  <!-- Occhio destro profondo (3x2x3 voxel) con vispo riflesso bianco Z -->
  <box at="20 34.5 20" size="3 2 3" color="E"/>
  <box at="21 35 22" size="1 1 1" color="Z"/>

  <!-- ======================================================== -->
  <!-- 6. GIGANTESCHE ORECCHIE A CONCHIGLIA (part="testa", z=25..39) -->
  <!-- ======================================================== -->
  <!-- Orecchio sinistro: guscio bianco latte posteriore/esterno -->
  <ellipsoid at="9.5 29 25" size="8 4 15" color="O"/>
  <!-- Padiglione interno concavo velluto rosa pallido -->
  <ellipsoid at="9.5 30.5 26" size="6 3 13" color="R"/>
  <box at="9.5 31 27" size="4 1 8" color="r"/>
  <line at="6 30 28" to="9 30 38" r="0.5" color="o"/>

  <!-- Orecchio destro: guscio bianco latte posteriore/esterno -->
  <ellipsoid at="21.5 29 25" size="8 4 15" color="O"/>
  <!-- Padiglione interno concavo velluto rosa pallido -->
  <ellipsoid at="21.5 30.5 26" size="6 3 13" color="R"/>
  <box at="21.5 31 27" size="4 1 8" color="r"/>
  <line at="25 30 28" to="22 30 38" r="0.5" color="o"/>

  <!-- ======================================================== -->
  <!-- 7. BERRETTO DA CONCIERGE D'ALTA CLASSE (part="testa")    -->
  <!-- ======================================================== -->
  <!-- Fascia perimetrale argento satinato con asole sartoriali per le orecchie -->
  <cylinder at="15.5 32 25" size="8.5 8.5 1.5" color="S"/>
  <!-- Bordo posteriore coprinuca ribassato -->
  <box at="15.5 27 25" size="7 3 1.5" color="s"/>

  <!-- Calotta tonda da cerimonia bianco candido tra le orecchie -->
  <cylinder at="15.5 32 26.5" size="8 8 3" color="H"/>
  <ellipsoid at="15.5 32 27.5" size="7.5 7.5 4" color="H"/>

  <!-- Sommità berretto e bottone centrale argentato -->
  <cylinder at="15.5 32 29" size="6 6 1" color="h"/>
  <box at="15.5 32 29.5" size="3 3 1" color="S"/>

  <!-- Visiera cerimoniale rigida bordata in avanti sopra la fronte -->
  <box at="15.5 36.5 25" size="9 3 1" color="V"/>
  <box at="15.5 37.5 25" size="7 2 1" color="V"/>
  <!-- Filetto d'argento riflettente brillante sul bordo visiera (glow="True") -->
  <box at="15.5 38 25" size="7 1 1" color="v"/>

  <!-- Coccarda / stemma diplomatico dorato al centro fronte (glow="True") -->
  <box at="15.5 36 27" size="2 1 2" color="L"/>
  <box at="15.5 36.5 27" size="1 1 1" color="L"/>

  <!-- ======================================================== -->
  <!-- 8. AURICOLARE DIPLOMATICO & VISIERA OLOGRAFICA HUD       -->
  <!-- ======================================================== -->
  <!-- Archetto curvo in titanio che avvolge la radice dell'orecchio destro -->
  <line at="21.5 28 25" to="22 30 26.5" r="0.4" color="M"/>
  <line at="22 30 26.5" to="22 32.5 26" r="0.4" color="m"/>
  <line at="22 32.5 26" to="21.5 34.5 24" r="0.4" color="M"/>
  <!-- Braccetto microfonico cromato verso il musetto -->
  <line at="21.5 34.5 24" to="20 37 21" r="0.3" color="m"/>
  <box at="19 38 20" size="1 1 1" color="M"/>

  <!-- Guida / snodo di connessione in cromo lucido sopra la visiera HUD -->
  <line at="21 35 24" to="20 36 24" r="0.3" color="m"/>
  <box at="15.5 36 24" size="8 1 1" color="m"/>

  <!-- Sottile visiera display trasparente olografica davanti agli occhi (glow="True") -->
  <box at="15.5 36 21" size="8 1 3" color="X"/>

  <!-- Rune dorate fluttuanti proiettate sul visore olografico (glow="True") -->
  <box at="13 36 22" size="1 1 1" color="x"/>
  <box at="14 36 21" size="1 1 1" color="x"/>
  <box at="15.5 36 23" size="2 1 1" color="x"/>
  <box at="17 36 21" size="1 1 1" color="x"/>
  <box at="18 36 22" size="1 1 1" color="x"/>

  <!-- ======================================================== -->
  <!-- 9. LUNGHISSIMA CODA E PENNACCHIO CANDIDO (part="coda")   -->
  <!-- ======================================================== -->
  <!-- Attacco alla groppa posteriore alta (y=15, z=16) -->
  <line at="15.5 15 16" to="15.5 10 9" r="1.1" color="K"/>
  <!-- Discesa sinuosa verso il terreno -->
  <line at="15.5 10 9" to="15.5 6 4" r="0.9" color="K"/>
  <line at="15.5 6 4" to="15.5 3.5 2.5" r="0.8" color="K"/>
  <!-- Risalita verso l'alto -->
  <line at="15.5 3.5 2.5" to="15.5 2.5 5.5" r="0.8" color="k"/>
  <line at="15.5 2.5 5.5" to="15.5 2.5 9" r="0.8" color="k"/>

  <!-- Pennacchio: base argento satinato e grande ciuffo batuffoloso candido -->
  <ellipsoid at="15.5 2.5 9" size="5 4 5" color="J"/>
  <ellipsoid at="15.5 2.5 12" size="6 5 6" color="I"/>
  <ellipsoid at="15.5 2.5 16" size="4 4 5" color="I"/>
  <box at="15.5 2.5 18" size="2 2 2" color="I"/>

  <!-- ======================================================== -->
  <!-- 10. REGOLE GENERATIVE: SFUMATURE, PELO CANDIDO E ACCENTI -->
  <!-- ======================================================== -->
  <!-- Riflesso candido puro sommitale sul dorso -->
  <prl steps="1" p="0.3" in="B F" out="B f"/>
  <!-- Ombreggiatura delicata argento perlato nelle pieghe inferiori -->
  <prl steps="1" p="0.15" in="F/B" out="D/*"/>
  <!-- Transizione morbida tra gilet argento e ventre candido panna -->
  <prl steps="1" p="0.35" in="Y/C" out="*/c"/>
  <!-- Sfumatura delicata tra guance e musetto -->
  <prl steps="1" p="0.25" in="t U" out="u *"/>
</sequence>
