<!-- Un fuoco che scoppietta: un tepore basso che resta, schiocchi brevi e scintille acute dove il seme vuole. Una battuta che gira. -->
<sequence name="Fuoco scoppiettante" values="BNSAGKHCTUVPM" size="16 3 12" symmetry="()">
  <sound bpm="96" scale="dorian" root="45" swing="0" cutoff="6000" space="0.5">
    <track y="0" instrument="lead" volume="0.42"/>
    <track y="1" instrument="pad" volume="0.5"/>
    <track y="2" instrument="bass" volume="0.6"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="T" value="ec4899" name="Scelta" hidden="True"/>
  <color symbol="U" value="a855f7" name="Scelta" hidden="True"/>
  <color symbol="V" value="10b981" name="Scelta" hidden="True"/>
  <color symbol="P" value="64748b" name="Scelta" hidden="True"/>
  <color symbol="M" value="14b8a6" name="Scelta" hidden="True"/>

  <!-- Il tepore: una quinta del pad e il basso, che respirano a metà battuta. -->
  <line at="0 1 0" to="0 1 0" r="0" color="N"/>
  <line at="0 1 4" to="0 1 4" r="0" color="N"/>
  <line at="8 1 2" to="8 1 2" r="0" color="T"/>
  <line at="8 1 1" to="8 1 1" r="0" color="T"/>
  <line at="8 1 3" to="8 1 3" r="0" color="T"/>
  <one in="T" out="N" steps="1"/>
  <all in="T" out="B"/>
  <all in="NBBBBBBBBBBBBBB" out="NSSSSSSSSSSSSSS"/>
  <all in="NBBBBBBB" out="NSSSSSSS"/>
  <!-- Gli schiocchi: colpi chiusi e qualche rullante. -->
  <line at="0 2 1" to="15 2 1" r="0" color="U"/>
  <one in="U" out="H" steps="5"/>
  <all in="U" out="B"/>
  <line at="1 2 2" to="15 2 2" r="0" color="V"/>
  <one in="V" out="C" steps="2"/>
  <all in="V" out="B"/>
  <!-- Le scintille, su altezze diverse. -->
  <line at="0 0 6" to="15 0 6" r="0" color="P"/>
  <line at="0 0 8" to="15 0 8" r="0" color="P"/>
  <line at="0 0 9" to="15 0 9" r="0" color="P"/>
  <line at="0 0 11" to="15 0 11" r="0" color="P"/>
  <one in="P" out="G" steps="4"/>
  <all in="P" out="B"/>
  <line at="0 0 7" to="15 0 7" r="0" color="M"/>
  <one in="M" out="N" steps="2"/>
  <all in="M" out="B"/>
</sequence>
