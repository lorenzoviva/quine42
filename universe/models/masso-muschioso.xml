<!-- Masso muschioso, procedurale (Cantiere 2): la palette dell'originale (granito, luce, crepe, muschio vivace). Il seme traccia al suolo la
     spina del masso, un cammino a caso che decide quanto è lungo e verso dove, poi la massa cresce da lì e il muschio si allarga dalle
     chiazze sulla cima esposta. -->
<sequence values="BRSDMV" size="20 20 16" symmetry="(xy)" name="Masso muschioso">
  <color symbol="R" value="737785" name="granito grigio base"/>
  <color symbol="S" value="9da1ad" name="granito chiaro illuminato"/>
  <color symbol="D" value="474954" name="crepa e ombra pietra"/>
  <color symbol="M" value="488028" name="muschio vivace"/>
  <color symbol="V" hidden="True" name="dove corre la spina"/>
  <!-- La spina: un cammino a caso sul disco del suolo -->
  <ellipsoid at="10 10 0" size="13 13 1" color="V"/>
  <box at="10 10 0" size="1 1 1" color="R"/>
  <one steps="7" in="RV" out="RR"/>
  <prl steps="1" in="RV" out="*R" p="0.15"/>
  <all in="V" out="B"/>
  <!-- La massa: tonda e poi piatta, con un dorso che sale -->
  <one steps="760" symmetry="(xyz)" in="RB" out="*R"/>
  <one steps="200" in="RB" out="*R"/>
  <convolution neighborhood="Moore" steps="3">
    <rule in="B" out="R" values="R" sum="14..26"/>
    <rule in="R" out="B" values="R" sum="1..8"/>
  </convolution>
  <prl steps="1">
    <rule in="R" out="D" p="0.08"/>
    <rule in="R" out="S" p="0.12"/>
  </prl>
  <prl steps="1" in="B R" out="* S" p="0.65"/>
  <prl steps="1" in="B S" out="* M" p="0.15"/>
  <prl steps="1" in="B R" out="* M" p="0.05"/>
  <all steps="3" in="B/B M/R" out="*/* */M"/>
  <all steps="2" in="B M" out="* M"/>
  <prl steps="1" in="BB MR" out="** *M" p="0.5"/>
</sequence>
