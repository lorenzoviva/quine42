  <prl steps="1">
    <rule in="B [FD]" out="F *" p="0.12"/>
    <rule in="BF" out="FF" p="0.04"/>
  </prl>
  <prl steps="1">
    <rule in="B F" out="B H" p="0.65"/>
    <rule in="B D" out="B F" p="0.2"/>
    <rule in="B C" out="B H" p="0.4"/>
