<!-- Un traguardo: un rullo che cresce, una fanfara che sale per la triade e si posa in alto su un accordo pieno, coi piatti. Una battuta. -->
<sequence name="Salita di livello" values="BNSAGKHCTUVPM" size="16 4 16" symmetry="()">
  <sound bpm="128" scale="dorian" root="55" swing="0" cutoff="8000" space="0.5">
    <track y="0" instrument="lead" volume="0.55"/>
    <track y="1" instrument="pad" volume="0.55"/>
    <track y="2" instrument="bass" volume="0.6"/>
    <track y="3" instrument="bass" volume="0.6"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="T" value="ec4899" name="Scelta" hidden="True"/>
  <color symbol="U" value="a855f7" name="Scelta" hidden="True"/>
  <color symbol="V" value="10b981" name="Scelta" hidden="True"/>
  <color symbol="P" value="64748b" name="Scelta" hidden="True"/>
  <color symbol="M" value="14b8a6" name="Scelta" hidden="True"/>

  <!-- Il rullo: rullanti che si infittiscono, il seme ne aggiunge qualcuno. -->
  <line at="0 3 2" to="0 3 2" r="0" color="C"/>
  <line at="4 3 2" to="4 3 2" r="0" color="C"/>
  <line at="6 3 2" to="6 3 2" r="0" color="C"/>
  <line at="7 3 2" to="7 3 2" r="0" color="C"/>
  <line at="1 3 2" to="7 3 2" r="0" color="T"/>
  <one in="T" out="C" steps="2"/>
  <all in="T" out="B"/>
  <line at="8 3 0" to="8 3 0" r="0" color="K"/>
  <line at="8 3 4" to="8 3 4" r="0" color="H"/>
  <line at="10 3 1" to="15 3 1" r="0" color="U"/>
  <one in="U" out="H" steps="2"/>
  <all in="U" out="B"/>
  <!-- La fanfara: per gradi della triade, la cima scelta dal seme. -->
  <line at="0 0 0" to="0 0 0" r="0" color="N"/>
  <line at="2 0 2" to="2 0 2" r="0" color="N"/>
  <line at="4 0 4" to="4 0 4" r="0" color="N"/>
  <line at="6 0 5" to="6 0 5" r="0" color="V"/>
  <line at="6 0 6" to="6 0 6" r="0" color="V"/>
  <one in="V" out="N" steps="1"/>
  <all in="V" out="B"/>
  <line at="8 0 7" to="8 0 7" r="0" color="P"/>
  <line at="8 0 9" to="8 0 9" r="0" color="P"/>
  <one in="P" out="A" steps="1"/>
  <all in="P" out="B"/>
  <all in="NB" out="NS"/>
  <all in="ABBBBBB" out="ASSSSSS"/>
  <line at="13 0 4" to="13 0 4" r="0" color="M"/>
  <line at="13 0 7" to="13 0 7" r="0" color="M"/>
  <line at="14 0 9" to="14 0 9" r="0" color="M"/>
  <one in="M" out="G" steps="1"/>
  <all in="M" out="B"/>
  <!-- L'accordo pieno e il basso. -->
  <line at="8 1 0" to="8 1 0" r="0" color="N"/>
  <line at="8 1 2" to="8 1 2" r="0" color="N"/>
  <line at="8 1 4" to="8 1 4" r="0" color="N"/>
  <line at="8 1 7" to="8 1 7" r="0" color="T"/>
  <line at="8 1 6" to="8 1 6" r="0" color="T"/>
  <one in="T" out="N" steps="1"/>
  <all in="T" out="B"/>
  <all in="NBBBBBBB" out="NSSSSSSS"/>
  <line at="0 2 4" to="0 2 4" r="0" color="N"/>
  <line at="4 2 2" to="4 2 2" r="0" color="U"/>
  <line at="4 2 3" to="4 2 3" r="0" color="U"/>
  <one in="U" out="N" steps="1"/>
  <all in="U" out="B"/>
  <all in="NBBB" out="NSSS"/>
  <line at="8 2 0" to="8 2 0" r="0" color="A"/>
  <all in="ABBBBBBB" out="ASSSSSSS"/>
</sequence>
