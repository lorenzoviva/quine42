<!-- Una valvola sotto pressione: il soffio che si stringe in colpi sempre più fitti, un fischio che sale di semitono e scappa. -->
<sequence name="Vapore in pressione" values="BNSAGKHCTUVPM" size="12 3 12" symmetry="()">
  <sound bpm="132" scale="harmonic_minor" root="52" swing="0" cutoff="9000" space="0.4">
    <track y="0" instrument="lead" volume="0.55"/>
    <track y="1" instrument="bass" volume="0.6"/>
    <track y="2" instrument="pad" volume="0.4"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="T" value="ec4899" name="Scelta" hidden="True"/>
  <color symbol="U" value="a855f7" name="Scelta" hidden="True"/>
  <color symbol="V" value="10b981" name="Scelta" hidden="True"/>
  <color symbol="P" value="64748b" name="Scelta" hidden="True"/>
  <color symbol="M" value="14b8a6" name="Scelta" hidden="True"/>

  <!-- Il soffio che accelera, e lo sfogo aperto. -->
  <line at="0 1 1" to="0 1 1" r="0" color="H"/>
  <line at="5 1 1" to="5 1 1" r="0" color="H"/>
  <line at="7 1 1" to="7 1 1" r="0" color="H"/>
  <line at="1 1 1" to="6 1 1" r="0" color="P"/>
  <one in="P" out="H" steps="3"/>
  <all in="P" out="B"/>
  <line at="8 1 4" to="8 1 4" r="0" color="T"/>
  <line at="9 1 4" to="9 1 4" r="0" color="T"/>
  <line at="10 1 4" to="10 1 4" r="0" color="T"/>
  <one in="T" out="H" steps="1"/>
  <all in="T" out="B"/>
  <!-- Il fischio: sale per gradi della minore armonica, il seme sceglie dove si ferma. -->
  <line at="2 0 4" to="2 0 4" r="0" color="N"/>
  <line at="4 0 5" to="4 0 5" r="0" color="N"/>
  <line at="6 0 6" to="6 0 6" r="0" color="N"/>
  <line at="8 0 7" to="8 0 7" r="0" color="U"/>
  <line at="8 0 8" to="8 0 8" r="0" color="U"/>
  <line at="9 0 9" to="9 0 9" r="0" color="U"/>
  <one in="U" out="A" steps="1"/>
  <all in="U" out="B"/>
  <all in="NB" out="NS"/>
  <all in="ABBB" out="ASSS"/>
  <!-- La caldaia sotto. -->
  <line at="0 2 0" to="0 2 0" r="0" color="N"/>
  <line at="0 2 4" to="0 2 4" r="0" color="V"/>
  <line at="0 2 2" to="0 2 2" r="0" color="V"/>
  <one in="V" out="N" steps="1"/>
  <all in="V" out="B"/>
  <all in="NBBBBBBBBBB" out="NSSSSSSSSSS"/>
</sequence>
