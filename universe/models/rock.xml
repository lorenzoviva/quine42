<!-- Boulder, procedural (Cantiere 2): the palette and the class of the original (granite, cracks, moss). The seed picks the lobes on a disc on the
     ground, one perhaps tall like a shard, how much the boulder widens and where the moss grows. -->
<sequence values="BRSDMVkK" size="20 20 16" symmetry="(xy)" name="Masso">
  <color symbol="R" value="8c8d95" name="granito"/>
  <color symbol="S" value="a9aab2" name="granito chiaro"/>
  <color symbol="D" value="5d5e68" name="crepa"/>
  <color symbol="M" value="5a8a3c" name="muschio"/>
  <color symbol="V" hidden="True" name="dove nasce un lobo"/>
  <color symbol="k" hidden="True" name="dove può nascere la scheggia"/>
  <color symbol="K" hidden="True" name="la scheggia"/>
  <!-- The choices -->
  <ellipsoid at="10 10 0" size="11 11 1" color="V"/>
  <box at="10 10 0" size="1 1 1" color="R"/>
  <one in="V" out="R" steps="2"/>
  <ellipsoid at="10 10 0" size="7 7 1" color="k" on="V"/>
  <prl steps="1" in="k" out="K" p="0.06"/>
  <one in="K" out="R" steps="1"/>
  <all in="[VkK]" out="B"/>
  <!-- The shard: a point rising from a lobe, sometimes -->
  <prl steps="1" in="B R" out="K R" p="0.5"/>
  <one in="K" out="R" steps="1"/>
  <all in="K" out="B"/>
  <one steps="9" in="B R" out="R R"/>
  <!-- The mass -->
  <one steps="650" symmetry="(xyz)" in="RB" out="RR"/>
  <one steps="300" in="RB" out="RR"/>
  <convolution neighborhood="Moore" steps="3">
    <rule in="B" out="R" values="R" sum="14..26"/>
    <rule in="R" out="B" values="R" sum="1..7"/>
  </convolution>
  <prl steps="1">
    <rule in="R" out="S" p="0.1"/>
    <rule in="R" out="D" p="0.04"/>
  </prl>
  <prl steps="1" in="B [RSD]" out="B M" p="0.03"/>
  <one steps="160" in="BB M[RSD]" out="BB MM"/>
</sequence>
