<!-- The wind on the mountain tops: a long whistle wavering among a few notes, scattered gusts of breath, a drone underneath. A two-bar cycle. -->
<sequence name="Vento d'alta quota" values="BNSAGKHCTUVPM" size="32 3 12" symmetry="()">
  <sound bpm="72" scale="pentatonic_minor" root="50" swing="0" cutoff="5500" space="0.75">
    <track y="0" instrument="pad" volume="0.55"/>
    <track y="1" instrument="bass" volume="0.6"/>
    <track y="2" instrument="bass" volume="0.5"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="T" value="ec4899" name="Scelta" hidden="True"/>
  <color symbol="U" value="a855f7" name="Scelta" hidden="True"/>
  <color symbol="V" value="10b981" name="Scelta" hidden="True"/>
  <color symbol="P" value="64748b" name="Scelta" hidden="True"/>
  <color symbol="M" value="14b8a6" name="Scelta" hidden="True"/>

  <!-- The drone: two fifths, one per bar. -->
  <line at="0 1 0" to="0 1 0" r="0" color="A"/>
  <line at="16 1 0" to="16 1 0" r="0" color="N"/>
  <line at="16 1 3" to="16 1 3" r="0" color="T"/>
  <line at="16 1 2" to="16 1 2" r="0" color="T"/>
  <one in="T" out="N" steps="1"/>
  <all in="T" out="B"/>
  <all in="ABBBBBBBBBBBBBBB" out="ASSSSSSSSSSSSSSS"/>
  <all in="NBBBBBBBBBBBBBBB" out="NSSSSSSSSSSSSSSS"/>
  <!-- The whistle: a head wavering slowly. -->
  <line at="0 0 6" to="0 0 6" r="0" color="M"/>
  <one>
    <rule in="**B MBB" out="**M NSB" p="2"/>
    <rule in="MBB **B" out="NSB **M" p="2"/>
    <rule in="MBBBB" out="NSSSM"/>
    <rule in="***B MBBB" out="***M NSSB"/>
    <rule in="MBBB ***B" out="NSSB ***M"/>
    <rule in="MBBB" out="BBBM"/>
  </one>
  <all in="M" out="B"/>
  <!-- The gusts: open and closed breaths where the seed wants. -->
  <line at="1 2 4" to="31 2 4" r="0" color="U"/>
  <one in="U" out="H" steps="5"/>
  <all in="U" out="B"/>
  <line at="0 2 1" to="31 2 1" r="0" color="V"/>
  <one in="V" out="H" steps="4"/>
  <all in="V" out="B"/>
</sequence>
