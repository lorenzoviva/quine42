{
  "name": "quine42",
  "version": "0.2.0",
  "private": true,
  "description": "QUINE42 — un mondo in 3D fatto del proprio codice sorgente.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "vite-node --script tools/produzione/costruisci.ts",
    "serve": "node --env-file-if-exists=.env dist-server/server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sicurezza": "vitest run tests/sicurezza",
    "sicurezza:prove": "node tools/sicurezza/prove.mjs",
    "abbonamento": "vite-node --script tools/abbonamenti/servi.ts",
    "mancanze": "vite-node --script tools/mancanze/rapporto.ts",
    "universi:cloud": "vite-node --script lab/scripts/installa-universi-cloud.ts",
    "genera": "vite-node --script tools/generazione/genera.ts"
  },
  "author": "lorenzoviva <lorenzo.vaccaro@hotmail.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "three": "^0.186.1",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.13.6"
    }
  }
}
