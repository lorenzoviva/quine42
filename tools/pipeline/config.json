{
  "base": "3d",
  "orchestratore": "claude",
  "generazione": [
    { "universo": "orichalcum", "ambientazione": "steampunk", "tettoSettimana": 25 },
    { "universo": "neapolis", "ambientazione": "moderno", "tettoSettimana": 25 },
    { "universo": "sidera", "ambientazione": "futuristico", "tettoSettimana": 25 }
  ],
  "generatore": {
    "acceso": true,
    "provider": "claude",
    "minimo": 10,
    "sessioneMinima": 30,
    "sessioneArresto": 15,
    "comando": ["npm", "run", "genera", "--", "{universo}", "--tema", "{ambientazione}", "--partita", "{partita}", "--tetto", "{tetto}"],
    "coda": ["npm", "run", "abbonamento"]
  },
  "abbonamenti": {
    "claude": "max5x",
    "google": "pro"
  },
  "piani": {
    "claude": {
      "pro": {
        "moltiplicatoreStima": 5,
        "disponibili": [
          "claude",
          "sonnet",
          "haiku"
        ]
      },
      "max5x": {
        "moltiplicatoreStima": 1,
        "disponibili": [
          "claude",
          "sonnet",
          "haiku",
          "fable"
        ]
      },
      "max20x": {
        "moltiplicatoreStima": 0.25,
        "disponibili": [
          "claude",
          "sonnet",
          "haiku",
          "fable"
        ]
      },
      "nessuno": {
        "moltiplicatoreStima": 1,
        "disponibili": []
      }
    },
    "google": {
      "pro": {
        "moltiplicatoreStima": 2.5,
        "disponibili": [
          "gemini",
          "argon",
          "agy-opus",
          "agy-sonnet"
        ]
      },
      "ultra": {
        "moltiplicatoreStima": 1,
        "disponibili": [
          "gemini",
          "argon",
          "agy-opus",
          "agy-sonnet"
        ]
      },
      "nessuno": {
        "moltiplicatoreStima": 1,
        "disponibili": []
      }
    }
  },
  "maxParalleli": 5,
  "limiti": {
    "provider": {
      "claude": 3,
      "agy": 1
    },
    "modello": {
      "claude": 3,
      "sonnet": 1,
      "haiku": 1,
      "fable": 1,
      "gemini": 1,
      "argon": 1,
      "agy-opus": 1,
      "agy-sonnet": 1
    }
  },
  "giorniPrevisione": 3,
  "giorniStoria": 7,
  "turni": {
    "browser": {
      "massimoMinuti": 45
    },
    "test": {
      "massimoMinuti": 60,
      "worker": 6
    },
    "typecheck": {
      "massimoMinuti": 10
    },
    "build": {
      "massimoMinuti": 10
    }
  },
  "intervalloLanciMinuti": 10,
  "approvazione": "manuale",
  "sforzoPredefinito": "high",
  "riserva": 3,
  "sogliaUnSolo": 10,
  "attesaLimiteMinuti": 60,
  "controlloSecondi": 60,
  "providers": {
    "claude": {
      "modello": "Opus 5.5",
      "cmd": "claude",
      "args": [
        "--output-format",
        "json",
        "--dangerously-skip-permissions",
        "--chrome",
        "--model",
        "claude-opus-5-5"
      ],
      "resume": [
        "--resume",
        "{sessione}"
      ],
      "resetSettimanale": "gio 10:00",
      "contatori": "^(session|week .all models.)$",
      "sessioneNuova": [
        "--session-id",
        "{sessione}"
      ],
      "browser": true,
      "abbonamento": "claude",
      "orchestrabile": true,
      "ratioSessioneSettimana": 12
    },
    "sonnet": {
      "modello": "Sonnet 5.5",
      "cmd": "claude",
      "args": [
        "--output-format",
        "json",
        "--dangerously-skip-permissions",
        "--chrome",
        "--model",
        "claude-sonnet-5-5"
      ],
      "resume": [
        "--resume",
        "{sessione}"
      ],
      "resetSettimanale": "gio 10:00",
      "contatori": "^(session|week .all models.)$",
      "sessioneNuova": [
        "--session-id",
        "{sessione}"
      ],
      "browser": true,
      "orchestrabile": false,
      "stessoContoDi": "claude",
      "abbonamento": "claude",
      "ratioSessioneSettimana": 12
    },
    "haiku": {
      "modello": "Haiku 5.5",
      "cmd": "claude",
      "args": [
        "--output-format",
        "json",
        "--dangerously-skip-permissions",
        "--chrome",
        "--model",
        "claude-haiku-5-5"
      ],
      "resume": [
        "--resume",
        "{sessione}"
      ],
      "resetSettimanale": "gio 10:00",
      "contatori": "^(session|week .all models.)$",
      "sessioneNuova": [
        "--session-id",
        "{sessione}"
      ],
      "browser": true,
      "orchestrabile": false,
      "stessoContoDi": "claude",
      "abbonamento": "claude",
      "ratioSessioneSettimana": 12
    },
    "fable": {
      "modello": "Fable 5.1",
      "cmd": "claude",
      "args": [
        "--output-format",
        "json",
        "--dangerously-skip-permissions",
        "--chrome",
        "--model",
        "claude-fable-5-1"
      ],
      "resume": [
        "--resume",
        "{sessione}"
      ],
      "resetSettimanale": "gio 10:00",
      "contatori": "^(session|week .all models.|week .Fable.)$",
      "sessioneNuova": [
        "--session-id",
        "{sessione}"
      ],
      "browser": true,
      "orchestrabile": false,
      "stessoContoDi": "claude",
      "abbonamento": "claude",
      "ratioSessioneSettimana": 8
    },
    "gemini": {
      "modello": "Gemini 3.8 Flash",
      "cmd": "agy",
      "args": [
        "--output-format",
        "json",
        "--dangerously-skip-permissions",
        "--model",
        "gemini-3.8-flash-high"
      ],
      "resume": [
        "--conversation",
        "{sessione}"
      ],
      "resetSettimanale": "",
      "contatori": "^Gemini Models$",
      "browser": false,
      "abbonamento": "google",
      "orchestrabile": true,
      "ratioSessioneSettimana": 3.3
    },
    "argon": {
      "modello": "Gemini 4 Argon",
      "cmd": "agy",
      "args": [
        "--output-format",
        "json",
        "--dangerously-skip-permissions",
        "--model",
        "gemini-4-argon-high"
      ],
      "resume": [
        "--conversation",
        "{sessione}"
      ],
      "resetSettimanale": "",
      "contatori": "^Gemini 4 Argon",
      "finestra5h": false,
      "browser": false,
      "abbonamento": "google",
      "orchestrabile": true,
      "ratioSessioneSettimana": 1
    },
    "agy-opus": {
      "modello": "Opus 5.5 (agy)",
      "cmd": "agy",
      "args": [
        "--output-format",
        "json",
        "--dangerously-skip-permissions",
        "--model",
        "claude-opus-5-5-high"
      ],
      "resume": [
        "--conversation",
        "{sessione}"
      ],
      "resetSettimanale": "",
      "contatori": "^Claude and GPT models$",
      "browser": false,
      "orchestrabile": false,
      "abbonamento": "google",
      "ratioSessioneSettimana": 2
    },
    "agy-sonnet": {
      "modello": "Sonnet 5.5 (agy)",
      "cmd": "agy",
      "args": [
        "--output-format",
        "json",
        "--dangerously-skip-permissions",
        "--model",
        "claude-sonnet-5-5-high"
      ],
      "resume": [
        "--conversation",
        "{sessione}"
      ],
      "resetSettimanale": "",
      "contatori": "^Claude and GPT models$",
      "browser": false,
      "orchestrabile": false,
      "stessoContoDi": "agy-opus",
      "abbonamento": "google",
      "ratioSessioneSettimana": 2
    }
  },
  "prompt": "Lavora nel worktree `{dir}` (branch `{branch}`, nato da `{base}`). Leggi `.pipeline-task.md` (il blocco del task **{id}**, i dossier dei task da cui dipende o nasce, le regole dell'ambiente condiviso) e `AGENTS.md`, poi esegui il task seguendo il protocollo delle sessioni, con quelle regole: altri agenti lavorano in parallelo in altri worktree; non pianificare il to-do; **non leggere e non modificare `docs/plans/backlog.md`** (è enorme e sta già tutto in `.pipeline-task.md`; stato ed esito del task li scrive la pipeline quando lo integra, dalla tua riga ESITO); niente merge, push o modifiche fuori dal tuo worktree; non fare domande: se serve una decisione dell'autore scrivila in `docs/pipeline/domande/{id}.md`, committa e termina con `ESITO: in attesa`. Se ti serve un altro task oltre a quelli in `.pipeline-task.md`, leggi il suo dossier: `node tools/pipeline/pipeline.mjs dossier <Txx>`. Se il «Fatto quando» del task chiede una verifica nel browser (o il task cambia ciò che si vede), falla con lo strumento del browser che hai (Claude in Chrome in Claude Code; su agy non è disponibile: scrivi BROWSER: da verificare) seguendo `docs/architettura-dettagli.md#convalida-browser`: una porta libera, una scheda tua, chiudi scheda e preview alla fine; se lo strumento non c’è, non inventarla. Le operazioni pesanti hanno un turno in tutta la pipeline (ADR-0088): la suite intera dei test lanciala con `node tools/pipeline/pipeline.mjs turno test -- npm test` (un solo file di test anche senza turno); il typecheck con `node tools/pipeline/pipeline.mjs turno typecheck -- npm run typecheck`; la build con `node tools/pipeline/pipeline.mjs turno build -- npm run build`; la preview della verifica nel browser con `node tools/pipeline/pipeline.mjs turno browser -- npx vite preview --port <n> --strictPort`, in background: il browser è tuo finché la preview vive, fermarla lo lascia; aspettare il turno è normale, non aggirarlo. Test, typecheck e build stampano solo un riassunto (le ultime righe, o i blocchi di errore) e il percorso del log intero in `.pipeline/turno-<tipo>.log`: apri il log solo se il riassunto non basta. Alla fine committa sul tuo branch e chiudi la risposta con una riga `ESITO: fatto|in attesa|fallito — <cosa è cambiato, cosa manca, cosa non è provato>` e, se il task la chiede, una riga `BROWSER: verificato|da verificare — <cosa hai visto o perché manca>`.",
  "usoSecondi": 300,
  "orchestra": {
    "ordine": [
      "claude",
      "argon",
      "gemini"
    ],
    "finestra": {
      "claude": 200000,
      "fable": 200000,
      "argon": 1000000,
      "gemini": 1000000
    },
    "rotazione": 0.35,
    "chat": 20
  }
}
