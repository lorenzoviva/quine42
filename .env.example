# L'ambiente di un server di QUINE42 ospitato da te (T367, ADR-0201): copialo in `.env` e riempilo. Nessun valore qui è vero, e nessuno deve
# esserlo: `.env` resta sulla tua macchina (git e l'immagine lo ignorano). La guida è docs/self-hosting.md; ogni variabile è in AGENTS.md («.env»).
# Un commento sta su una riga sua: questo file lo legge anche docker compose.

# ---- L'immagine (solo docker compose) ----
# La versione del kernel del codice che costruisci, quella di package.json (node -p "require('./package.json').version"). È l'etichetta dell'immagine.
QUINE_KERNEL=

# ---- Obbligatorie: senza, il server non parte ----
# I siti per cui il server risponde, separati da virgole: https://il.tuo.nome, o http://localhost:8080 solo per questa macchina.
QUINE_ORIGINI=http://localhost:8080
# Quanti proxy tuoi stanno davanti al server: 0 senza, 1 dietro Cloudflare, Railway, Fly o Caddy.
QUINE_PROXY_FIDATI=0
# La open beta: niente Stripe, niente commissione, niente ricariche.
QUINE_PAGAMENTI=spenti
# Chi verifica le identità. «inviti»: gli inviti del server, senza Firebase (allora FIREBASE_* restano vuote).
QUINE_ACCOUNT=inviti
# Almeno 32 caratteri casuali: firma ogni identità. Per farne uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUINE_SEGRETO_INVITI=

# ---- I modelli: i giocatori collegano la loro chiave di OpenRouter; una chiave tua paga le spese comuni, con un tetto in dollari al giorno ----
OPENROUTER_API_KEY=
OPENROUTER_TETTO_GIORNALIERO=
GEMINI_API_KEY=
GEMINI_TETTO_GIORNALIERO=
TYPESAFE_KEY=
TYPESAFE_TETTO_GIORNALIERO=

# ---- Firebase al posto degli inviti (con QUINE_ACCOUNT vuota) ----
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# ---- Quanto regge la macchina (vuote: i predefiniti) ----
# MB di heap di ogni mondo (1024), mondi accesi insieme (16), universi di cui un account può essere master (3).
QUINE_MONDO_MEMORIA=
QUINE_MONDI_MASSIMI=
QUINE_UNIVERSI_PER_ACCOUNT=

# ---- docker compose: dove si pubblica la porta (127.0.0.1: solo questa macchina; 0.0.0.0: chiunque la raggiunga) ----
QUINE_PUBBLICA_SU=127.0.0.1
QUINE_PUBBLICA_PORTA=8080
# Un Cloudflare Tunnel con nome (docker compose --profile tunnel up -d).
CLOUDFLARE_TUNNEL_TOKEN=
