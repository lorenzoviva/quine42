+describe('cliLimitText (T423)', () => {
+  it('ignora il testo della risposta e i metadati JSON anche se contengono «quota», «rate limit» o «429»', () => {
+    const log = [
+      JSON.stringify({ type: 'system', subtype: 'init', cwd: '/tmp/quota-429', session_id: 's-429' }),
+      JSON.stringify({ type: 'rate_limit_event', rate_limit_info: { status: 'allowed', resetsAt: 1761735600 } }),
+      JSON.stringify({ type: 'assistant', message: { content: [{ type: 'text', text: 'La quota è 429, rate limit nel testo.' }] } }),
+      JSON.stringify({ type: 'result', subtype: 'success', is_error: false, duration_ms: 429, total_cost_usd: 0.429, result: 'quota 429 rate limit usage limit', usage: { output_tokens: 429 } }),
+    ].join('\n');
+    expect(P.cliLimitText(log)).toBe('');
+    expect(P.usageLimit(P.cliLimitText({ stdout: log, stderr: '', code: 0 }))).toBeUndefined();
+    // Anche con codice non zero o null (processo seguito dopo riavvio), la risposta non è mai un limite.
+    expect(P.usageLimit(P.cliLimitText({ stdout: log, stderr: '', code: 1 }))).toBeUndefined();
+    expect(P.usageLimit(P.cliLimitText({ stdout: log, stderr: '', code: null }))).toBeUndefined();
+    // Stesso comportamento per il formato JSON di agy e per JSON indentato su più righe.
+    const agyOk = JSON.stringify({ status: 'SUCCESS', response: 'quota 429 rate limit', usage: { output_tokens: 429 } }, null, 2);
+    expect(P.usageLimit(P.cliLimitText(agyOk))).toBeUndefined();
+  });
+
+  it('legge il limite solo da stderr, eventi result/status di errore, messaggi di sistema e rate_limit_event respinti', () => {
+    const from = new Date(2026, 9, 29, 20, 15);
+    const errResult = JSON.stringify({ type: 'result', is_error: true, duration_ms: 429, result: "You've hit your 5-hour limit · resets 10pm (Europe/Rome)" });
+    expect(P.usageLimit(P.cliLimitText({ stdout: errResult, stderr: '', code: 0 }), from)).toEqual(new Date(2026, 9, 29, 22, 1));
+
+    const agyErr = JSON.stringify({ status: 'ERROR', error: 'Error 429: RESOURCE_EXHAUSTED' });
+    expect(P.usageLimit(P.cliLimitText(agyErr), from)).toBeDefined();
+    expect(P.readOutput(agyErr).error).toBe(true);
+
+    const sysErr = JSON.stringify({ type: 'system', subtype: 'error', message: 'Claude AI usage limit reached|1761735600' });
+    expect(P.usageLimit(P.cliLimitText({ stdout: sysErr, stderr: '', code: 1 }))).toEqual(new Date(1761735600 * 1000));
+
+    const rejected = JSON.stringify({ type: 'rate_limit_event', rate_limit_info: { status: 'rejected', resetsAt: 1761735600 } });
+    expect(P.usageLimit(P.cliLimitText({ stdout: rejected, stderr: '', code: 1 }))).toEqual(new Date(1761735600 * 1000));
+
+    // Un errore di altro tipo con 429 nei campi numerici non è un limite.
+    const otherErr = JSON.stringify({ type: 'result', is_error: true, duration_ms: 429, usage: { input_tokens: 429 }, result: 'Reached max turns' });
+    expect(P.usageLimit(P.cliLimitText(otherErr))).toBeUndefined();
+
+    // Un avviso su stderr prima di un risultato riuscito (codice 0) non ferma la chiamata.
+    const okResult = JSON.stringify({ type: 'result', is_error: false, result: 'tutto ok' });
+    expect(P.usageLimit(P.cliLimitText({ stdout: okResult, stderr: 'HTTP 429 rate limit, retrying...', code: 0 }))).toBeUndefined();
+    expect(P.usageLimit(P.cliLimitText({ stdout: '', stderr: 'HTTP 429 Too Many Requests', code: 1 }))).toBeDefined();
+  });
+});
