+/** Extracts plain diagnostic strings from a CLI error/system field, ignoring numbers and metadata. */
+function diagnosticStrings(value, out) {
+  if (typeof value === 'string') {
+    if (value.trim()) out.push(value);
+  } else if (Array.isArray(value)) {
+    for (const item of value) diagnosticStrings(item, out);
+  } else if (value && typeof value === 'object') {
+    for (const k of ['message', 'error', 'text', 'detail', 'reason']) {
+      if (k in value) diagnosticStrings(value[k], out);
+    }
+  }
+}
+
+/** Whether a parsed CLI JSON object represents an error (not a successful model answer). */
+function isCliErrorObject(obj) {
+  return Boolean(
+    obj.is_error === true ||
+    obj.status === 'ERROR' ||
+    obj.error ||
+    (Array.isArray(obj.errors) && obj.errors.length > 0) ||
+    (typeof obj.subtype === 'string' && obj.subtype.startsWith('error')),
+  );
+}
+
+/** Whether a parsed CLI JSON object represents a non-empty successful answer. */
+function isCliSuccessResult(obj) {
+  if (!obj || typeof obj !== 'object' || isCliErrorObject(obj)) return false;
+  if (obj.type === 'system' || obj.type === 'assistant' || obj.type === 'user' || obj.type === 'stream_event' || obj.type === 'rate_limit_event' || obj.type === 'error') {
+    return false;
+  }
+  const hasAnswer = obj.type === 'result' || 'result' in obj || 'response' in obj || (obj.type === undefined && 'text' in obj);
+  if (!hasAnswer) return false;
+  const text = obj.result ?? obj.response ?? obj.text;
+  return typeof text === 'string' && text.trim().length > 0;
+}
+
+/** Splits CLI output into JSON objects (single JSON, JSON array, NDJSON, or pretty-printed JSON mixed with lines) and non-JSON lines. */
+function parseCliStream(text) {
+  const events = [];
+  const plain = [];
+  const trimmed = String(text ?? '').trim();
+  if (!trimmed) return { events, plain };
+  try {
+    const whole = JSON.parse(trimmed);
+    if (Array.isArray(whole)) {
+      for (const item of whole) {
+        if (item && typeof item === 'object' && !Array.isArray(item)) events.push(item);
+      }
+      return { events, plain };
+    }
+    if (whole && typeof whole === 'object') return { events: [whole], plain };
+  } catch { /* line-by-line */ }
+
+  const lines = trimmed.split('\n');
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i].trim();
+    if (!line) continue;
+    try {
+      const v = JSON.parse(line);
+      if (v && typeof v === 'object' && !Array.isArray(v)) {
+        events.push(v);
+        continue;
+      }
+      if (typeof v === 'string') plain.push(v);
+      continue;
+    } catch { /* maybe multi-line pretty-printed JSON, or plain CLI output */ }
+
+    if (line.startsWith('{')) {
+      let acc = line;
+      let parsed;
+      let end = i;
+      for (let j = i + 1; j < lines.length; j++) {
+        acc += `\n${lines[j]}`;
+        if (lines[j].trim().endsWith('}')) {
+          try {
+            const v = JSON.parse(acc);
+            if (v && typeof v === 'object' && !Array.isArray(v)) {
+              parsed = v;
+              end = j;
+              break;
+            }
+          } catch { /* keep reading */ }
+        }
+      }
+      if (parsed) {
+        events.push(parsed);
+        i = end;
+        continue;
+      }
+    }
+    plain.push(line);
+  }
+  return { events, plain };
+}
+
+/** Extracts only CLI-originated diagnostic/error text from one JSON event, never model response content or metadata (T423). */
+function extractEventDiagnostics(obj, out) {
+  if (!obj || typeof obj !== 'object') return;
+  if (obj.type === 'user' || obj.type === 'stream_event') return;
+  if (obj.type === 'assistant') {
+    if (typeof obj.error === 'string' && obj.error.trim()) {
+      out.push(obj.error === 'rate_limit' ? 'rate limit' : obj.error);
+    } else if (obj.error && typeof obj.error === 'object') {
+      diagnosticStrings(obj.error, out);
+    }
+    return;
+  }
+  if (obj.type === 'rate_limit_event') {
+    const info = obj.rate_limit_info;
+    if (info && typeof info === 'object' && info.status === 'rejected') {
+      const reset = Number(info.resetsAt);
+      if (Number.isFinite(reset) && reset > 0) {
+        const epochSec = reset > 1e12 ? Math.round(reset / 1000) : Math.round(reset);
+        out.push(`Claude AI usage limit reached|${epochSec}`);
+      } else {
+        out.push('rate limit');
+      }
+      diagnosticStrings(info.message ?? info.reason, out);
+    }
+    return;
+  }
+  if (obj.type === 'system') {
