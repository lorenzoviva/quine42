  <color symbol="x" hidden="True" name="volume del tetto"/>
  <color symbol="N" value="5a3e23" name="telai e pali"/>
  <color symbol="U" value="86b8c8" alpha="0.6" name="vetro"/>
  <color symbol="i" hidden="True" name="spazio fra le finestre"/>
