<!-- Futuristico, il pericolo: una batteria in dodici sopra un basso in sedici, la poliritmia che si sfalsa, allarmi frigi nel lead. -->
<sequence name="Futuristico, tensione e pericolo" values="BNSAGKHCMQTWRXYZD" size="96 4 16" symmetry="()">
  <sound bpm="150" scale="phrygian" root="42" swing="0" cutoff="5500" space="0.28">
    <track y="0" instrument="lead" volume="0.42"/>
    <track y="1" instrument="pad" volume="0.4"/>
    <track y="2" instrument="bass" volume="0.6"/>
    <track y="3" instrument="bass" volume="0.6"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="M" value="10b981" name="Testa della melodia" hidden="True"/>
  <color symbol="Q" value="14b8a6" name="Testa del controcanto" hidden="True"/>
  <color symbol="T" value="ec4899" name="Testa degli accordi" hidden="True"/>
  <color symbol="W" value="334155" name="Soffitto degli accordi" hidden="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="X" value="c084fc" name="Segno del pad" hidden="True"/>
  <color symbol="Y" value="7c3aed" name="Segno del basso" hidden="True"/>
  <color symbol="Z" value="e879f9" name="Segno dell'arpeggio" hidden="True"/>
  <color symbol="D" value="475569" name="Battuta" hidden="True"/>

  <!-- The heads, at the start of the cycle; the ceiling keeps the chords in the low register. -->
  <line at="0 0 7" to="0 0 7" r="0" color="M"/>
  <line at="0 2 0" to="0 2 0" r="0" color="T"/>
  <line at="0 2 4" to="95 2 4" r="0" color="W"/>
  <line at="0 2 5" to="95 2 5" r="0" color="W"/>
  <line at="0 2 6" to="95 2 6" r="0" color="W"/>
  <line at="0 2 7" to="95 2 7" r="0" color="W"/>
  <line at="0 2 8" to="95 2 8" r="0" color="W"/>
  <line at="0 2 9" to="95 2 9" r="0" color="W"/>
  <line at="0 2 10" to="95 2 10" r="0" color="W"/>
  <line at="0 2 11" to="95 2 11" r="0" color="W"/>
  <line at="0 2 12" to="95 2 12" r="0" color="W"/>
  <line at="0 2 13" to="95 2 13" r="0" color="W"/>
  <line at="0 2 14" to="95 2 14" r="0" color="W"/>
  <line at="0 2 15" to="95 2 15" r="0" color="W"/>
  <line at="0 3 0" to="0 3 0" r="0" color="D"/>
  <line at="12 3 0" to="12 3 0" r="0" color="D"/>
  <line at="24 3 0" to="24 3 0" r="0" color="D"/>
  <line at="36 3 0" to="36 3 0" r="0" color="D"/>
  <line at="48 3 0" to="48 3 0" r="0" color="D"/>
  <line at="60 3 0" to="60 3 0" r="0" color="D"/>
  <line at="72 3 0" to="72 3 0" r="0" color="D"/>
  <line at="84 3 0" to="84 3 0" r="0" color="D"/>

  <!-- The harmony: the head walks 16 steps at a time and leaves a root; the seed picks the degree. -->
  <one>
    <rule in="****************B T****************" out="****************T R****************" p="3"/>
    <rule in="T**************** ****************B" out="R**************** ****************T" p="3"/>
    <rule in="T***************B" out="R***************T"/>
    <rule in="****************B ***************** ***************** T****************" out="****************T ***************** ***************** R****************"/>
    <rule in="T**************** ***************** ***************** ****************B" out="R**************** ***************** ***************** ****************T"/>
  </one>
  <all in="T" out="R"/>
  <all in="W" out="B"/>
  <all in="B/R" out="X/Y"/>

  <!-- The pad: one pattern per bar. -->
  <one>
    <rule in="BBBB****BBBB**** **************** **************** BBBB****BBBB**** XBBB****BBBB****" out="NSSS****NSSS**** **************** **************** NSSS****NSSS**** NSSS****NSSS****" p="2"/>
    <rule in="****BBBB****BBBB **************** **************** **************** X***BBBB****BBBB" out="****NSSS****NSSS **************** **************** **************** B***NSSS****NSSS" p="2"/>
  </one>
  <!-- The bass on the root. -->
  <one>
    <rule in="***********B***B YB*BBB*BBB**BB**" out="***********N***N AN*NAN*NAN**AN**" p="3"/>
    <rule in="*************BB* **************** **************** **************** Y*BB*BB*B*BB****" out="*************NN* **************** **************** **************** A*NN*NN*A*NN****" p="2"/>
  </one>
  <!-- The drums: one pattern per bar. -->
  <one>
    <rule in="***B*****B** **B**B**B**B D*****B*****" out="***C*****C** **H**H**H**H K*****K*****" p="3"/>
    <rule in="******B**B** **B**B**B**B D**B********" out="******C**C** **H**H**H**H K**K********" p="2"/>
    <rule in="***B*****BBB *BB*BB*BB*** D*****B*****" out="***C*****CCC *HH*HH*HH*** K*****K*****"/>
  </one>

  <!-- The melody: a head going forward in time and rising or falling. -->
  <one>
    <rule in="*B M*" out="*M N*" p="2"/>
    <rule in="M* *B" out="N* *M" p="2"/>
    <rule in="**B MB*" out="**M NS*"/>
    <rule in="MBBB" out="ASSM"/>
    <rule in="*B ** ** M*" out="*M ** ** N*"/>
    <rule in="M* ** ** *B" out="N* ** ** *M"/>
    <rule in="MBB" out="B*M" p="2"/>
    <rule in="MB" out="BM" p="2"/>
  </one>
  <all in="M" out="B"/>
  <one in="N/*/*/*" out="A/*/*/*" steps="5"/>
  <all in="X" out="B"/>
  <all in="Y" out="B"/>
  <all in="Z" out="B"/>
  <all in="D" out="B"/>
</sequence>
