<!-- An explosion and the collapse: the low bang, the snare splitting, then the rubble falling where the seed wants. -->
<sequence name="Esplosione e crollo" values="BNSAGKHCTUVPM" size="12 3 8" symmetry="()">
  <sound bpm="110" scale="phrygian" root="33" swing="0" cutoff="3000" space="0.5">
    <track y="0" instrument="bass" volume="0.85"/>
    <track y="1" instrument="pad" volume="0.55"/>
    <track y="2" instrument="bass" volume="0.7"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="T" value="ec4899" name="Scelta" hidden="True"/>
  <color symbol="U" value="a855f7" name="Scelta" hidden="True"/>
  <color symbol="V" value="10b981" name="Scelta" hidden="True"/>
  <color symbol="P" value="64748b" name="Scelta" hidden="True"/>
  <color symbol="M" value="14b8a6" name="Scelta" hidden="True"/>

  <!-- The bang: an accent on the lowest bass is also a kick. -->
  <line at="0 0 0" to="0 0 0" r="0" color="A"/>
  <all in="ABBBBBBB" out="ASSSSSSS"/>
  <line at="0 2 2" to="0 2 2" r="0" color="C"/>
  <line at="0 2 4" to="0 2 4" r="0" color="H"/>
  <!-- The rumble of the collapse: low, empty fourths and fifths. -->
  <line at="0 1 0" to="0 1 0" r="0" color="N"/>
  <line at="0 1 3" to="0 1 3" r="0" color="N"/>
  <line at="1 1 4" to="1 1 4" r="0" color="T"/>
  <line at="2 1 7" to="2 1 7" r="0" color="T"/>
  <line at="1 1 2" to="1 1 2" r="0" color="T"/>
  <one in="T" out="N" steps="1"/>
  <all in="T" out="B"/>
  <all in="NBBBBBB" out="NSSSSSS"/>
  <!-- The rubble: scattered hits. -->
  <line at="2 2 1" to="11 2 1" r="0" color="U"/>
  <one in="U" out="H" steps="3"/>
  <all in="U" out="B"/>
  <line at="3 2 0" to="10 2 0" r="0" color="V"/>
  <one in="V" out="K" steps="2"/>
  <all in="V" out="B"/>
  <line at="4 2 2" to="10 2 2" r="0" color="P"/>
  <one in="P" out="C" steps="1"/>
  <all in="P" out="B"/>
</sequence>
