    <rule in="MBB* **** ***B" out="NSS* **** ***M"/>
    <rule in="MBB" out="B*M" p="3"/>
    <rule in="MBBBB" out="B***M"/>
  </one>
  <all in="M" out="B"/>
  <one in="N/*/*/*" out="A/*/*/*" steps="4"/>
  <all in="X" out="B"/>
  <all in="Y" out="B"/>
  <all in="Z" out="B"/>
  <all in="D" out="B"/>
</sequence>
