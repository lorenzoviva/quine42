  </one>
  <!-- The bass on the root. -->
  <one>
    <rule in="**B***B***B***B* **************** **************** **************** **************** **************** **************** Y***B***B***B***" out="**N***N***N***N* **************** **************** **************** **************** **************** **************** A***A***A***A***" p="3"/>
    <rule in="**B***B***B***B* **************** **************** *************B** **************** **************** **************** Y**B*B**B**B****" out="**N***N***N***N* **************** **************** *************N** **************** **************** **************** A**N*N**A**N****" p="2"/>
    <rule in="******B********* **************** **************** **************B* **************** **************** **************** Y**B****B**B****" out="******N********* **************** **************** **************N* **************** **************** **************** A**N****A**N****"/>
  </one>
  <!-- The drums: one pattern per bar. -->
  <one>
    <rule in="**B***B***B***B* D***B***B***B***" out="**H***H***H***H* K***K***K***K***" p="3"/>
    <rule in="*****B*******B** **B***B***B***B* D***B***B***B***" out="*****C*******C** **H***H***H***H* K***K***K***K***" p="2"/>
    <rule in="**************B* **************** **************** **BB**B***BB**** D***B***B***B***" out="**************H* **************** **************** **HH**H***HH**** K***K***K***K***"/>
  </one>

  <!-- The melody: a head going forward in time and rising or falling. -->
  <one>
    <rule in="**B MB*" out="**M NS*" p="2"/>
    <rule in="MB* **B" out="NS* **M" p="2"/>
    <rule in="*B M*" out="*M N*" p="2"/>
