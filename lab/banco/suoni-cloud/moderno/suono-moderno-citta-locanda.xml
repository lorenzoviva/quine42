<!-- Moderno, il locale: cassa in quattro, accordi di piano in levare, un basso che pompa le ottave, la voce di un synth. -->
<sequence name="Moderno, città e locale" values="BNSAGKHCMQTWRXYZD" size="128 4 16" symmetry="()">
