  <!-- The heads, at the start of the cycle; the ceiling keeps the chords in the low register. -->
  <line at="0 0 7" to="0 0 7" r="0" color="M"/>
  <line at="0 2 0" to="0 2 0" r="0" color="T"/>
  <line at="0 2 6" to="127 2 6" r="0" color="W"/>
  <line at="0 2 7" to="127 2 7" r="0" color="W"/>
  <line at="0 2 8" to="127 2 8" r="0" color="W"/>
  <line at="0 2 9" to="127 2 9" r="0" color="W"/>
  <line at="0 2 10" to="127 2 10" r="0" color="W"/>
  <line at="0 2 11" to="127 2 11" r="0" color="W"/>
  <line at="0 2 12" to="127 2 12" r="0" color="W"/>
  <line at="0 2 13" to="127 2 13" r="0" color="W"/>
  <line at="0 2 14" to="127 2 14" r="0" color="W"/>
  <line at="0 2 15" to="127 2 15" r="0" color="W"/>
  <line at="0 3 0" to="0 3 0" r="0" color="D"/>
  <line at="16 3 0" to="16 3 0" r="0" color="D"/>
  <line at="32 3 0" to="32 3 0" r="0" color="D"/>
  <line at="48 3 0" to="48 3 0" r="0" color="D"/>
  <line at="64 3 0" to="64 3 0" r="0" color="D"/>
  <line at="80 3 0" to="80 3 0" r="0" color="D"/>
  <line at="96 3 0" to="96 3 0" r="0" color="D"/>
  <line at="112 3 0" to="112 3 0" r="0" color="D"/>

  <!-- The harmony: the head walks 16 steps at a time and leaves a root; the seed picks the degree. -->
  <one>
    <rule in="****************B ***************** ***************** T****************" out="****************T ***************** ***************** R****************" p="3"/>
    <rule in="T**************** ***************** ***************** ****************B" out="R**************** ***************** ***************** ****************T" p="3"/>
    <rule in="****************B ***************** ***************** ***************** T****************" out="****************T ***************** ***************** ***************** R****************" p="2"/>
    <rule in="T**************** ***************** ***************** ***************** ****************B" out="R**************** ***************** ***************** ***************** ****************T" p="2"/>
    <rule in="****************B ***************** ***************** ***************** ***************** T****************" out="****************T ***************** ***************** ***************** ***************** R****************"/>
    <rule in="T**************** ***************** ****************B" out="R**************** ***************** ****************T"/>
  </one>
  <all in="T" out="R"/>
  <all in="W" out="B"/>
  <all in="B/R" out="X/Y"/>

  <!-- The pad: one pattern per bar. -->
  <one>
    <rule in="BBBBBB**BBBBBB** **************** BBBBBB**BBBBBB** **************** XBBBBB**BBBBBB**" out="NSSSSS**NSSSSS** **************** NSSSSS**NSSSSS** **************** NSSSSS**NSSSSS**" p="2"/>
    <rule in="**BB**BB**BB**** **************** **BB**BB**BB**** **************** X*BB**BB**BB****" out="**NS**NS**NS**** **************** **NS**NS**NS**** **************** B*NS**NS**NS****" p="2"/>
    <rule in="BBBBBBBBBBBBBB** **************** BBBBBBBBBBBBBB** **************** BBBBBBBBBBBBBB** **************** XBBBBBBBBBBBBB**" out="NSSSSSSSSSSSSS** **************** NSSSSSSSSSSSSS** **************** NSSSSSSSSSSSSS** **************** NSSSSSSSSSSSSS**"/>
  </one>
  <!-- The bass on the root. -->
  <one>
    <rule in="******B********* **************** ************B*** **************** Y**B****B*****B*" out="******N********* **************** ************N*** **************** A**N****A*****N*" p="3"/>
    <rule in="**************B* **************** **************** *******B*B****** **************** **************** **************** Y*B**B*****B****" out="**************N* **************** **************** *******N*N****** **************** **************** **************** A*N**N*****N****" p="2"/>
    <rule in="************BB** **************** **************** **************** YB*B**B**B******" out="************NS** **************** **************** **************** AS*N**A**N******"/>
  </one>
  <!-- The drums: one pattern per bar. -->
  <one>
    <rule in="**B***B***B***B* D***B***B***B***" out="**H***H***H***H* K***K***K***K***" p="3"/>
    <rule in="**B***BB**B***B* D***B***B***B***" out="**H***HH**H***H* K***K***K***K***" p="2"/>
    <rule in="*****B*******B** **B***B***B***BB D***B***B***B***" out="*****C*******C** **H***H***H***HH K***K***K***K***"/>
    <rule in="**B***B***B***B* D*******B*******" out="**H***H***H***H* K*******K*******"/>
  </one>

  <!-- The melody: a head going forward in time and rising or falling. -->
  <one>
    <rule in="**B MB*" out="**M NS*" p="2"/>
    <rule in="MB* **B" out="NS* **M" p="2"/>
    <rule in="*B ** M*" out="*M ** N*" p="2"/>
    <rule in="M* ** *B" out="N* ** *M" p="2"/>
    <rule in="MBBB" out="NSSM"/>
    <rule in="MBB" out="B*M" p="3"/>
    <rule in="MBBBB" out="B***M" p="2"/>
    <rule in="*B M*" out="*M G*"/>
  </one>
  <all in="M" out="B"/>
  <one in="N/*/*/*" out="A/*/*/*" steps="4"/>
  <all in="X" out="B"/>
  <all in="Y" out="B"/>
  <all in="Z" out="B"/>
  <all in="D" out="B"/>
</sequence>
