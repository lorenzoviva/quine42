<!-- Moderno, il pericolo: mezzo tempo pesante, hi-hat a raffica, un basso lungo che trema e un richiamo frigio. -->
<sequence name="Moderno, tensione e pericolo" values="BNSAGKHCMQTWRXYZD" size="128 4 16" symmetry="()">
  <sound bpm="140" scale="phrygian" root="40" swing="0" cutoff="4000" space="0.3">
    <track y="0" instrument="lead" volume="0.42"/>
    <track y="1" instrument="pad" volume="0.4"/>
    <track y="2" instrument="bass" volume="0.65"/>
    <track y="3" instrument="bass" volume="0.6"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="M" value="10b981" name="Testa della melodia" hidden="True"/>
  <color symbol="Q" value="14b8a6" name="Testa del controcanto" hidden="True"/>
  <color symbol="T" value="ec4899" name="Testa degli accordi" hidden="True"/>
  <color symbol="W" value="334155" name="Soffitto degli accordi" hidden="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="X" value="c084fc" name="Segno del pad" hidden="True"/>
  <color symbol="Y" value="7c3aed" name="Segno del basso" hidden="True"/>
  <color symbol="Z" value="e879f9" name="Segno dell'arpeggio" hidden="True"/>
  <color symbol="D" value="475569" name="Battuta" hidden="True"/>

  <!-- Le teste, all'inizio del ciclo; il soffitto tiene gli accordi nel registro grave. -->
  <line at="0 0 7" to="0 0 7" r="0" color="M"/>
  <line at="0 2 0" to="0 2 0" r="0" color="T"/>
  <line at="0 2 4" to="127 2 4" r="0" color="W"/>
  <line at="0 2 5" to="127 2 5" r="0" color="W"/>
  <line at="0 2 6" to="127 2 6" r="0" color="W"/>
  <line at="0 2 7" to="127 2 7" r="0" color="W"/>
  <line at="0 2 8" to="127 2 8" r="0" color="W"/>
  <line at="0 2 9" to="127 2 9" r="0" color="W"/>
  <line at="0 2 10" to="127 2 10" r="0" color="W"/>
  <line at="0 2 11" to="127 2 11" r="0" color="W"/>
  <line at="0 2 12" to="127 2 12" r="0" color="W"/>
  <line at="0 2 13" to="127 2 13" r="0" color="W"/>
  <line at="0 2 14" to="127 2 14" r="0" color="W"/>
  <line at="0 2 15" to="127 2 15" r="0" color="W"/>
  <line at="0 3 0" to="0 3 0" r="0" color="D"/>
  <line at="16 3 0" to="16 3 0" r="0" color="D"/>
  <line at="32 3 0" to="32 3 0" r="0" color="D"/>
  <line at="48 3 0" to="48 3 0" r="0" color="D"/>
  <line at="64 3 0" to="64 3 0" r="0" color="D"/>
  <line at="80 3 0" to="80 3 0" r="0" color="D"/>
  <line at="96 3 0" to="96 3 0" r="0" color="D"/>
  <line at="112 3 0" to="112 3 0" r="0" color="D"/>

  <!-- L'armonia: la testa cammina di 16 in 16 passi e lascia una radice; il seme sceglie il grado. -->
  <one>
    <rule in="****************B T****************" out="****************T R****************" p="3"/>
    <rule in="T**************** ****************B" out="R**************** ****************T" p="3"/>
    <rule in="T***************B" out="R***************T" p="2"/>
    <rule in="****************B ***************** ***************** T****************" out="****************T ***************** ***************** R****************"/>
  </one>
  <all in="T" out="R"/>
  <all in="W" out="B"/>
  <all in="B/R" out="X/Y"/>

  <!-- Il pad: un disegno per battuta. -->
  <one>
    <rule in="BBBBBBBB******** **************** **************** **************** XBBBBBBB********" out="NSSSSSSS******** **************** **************** **************** NSSSSSSS********" p="2"/>
    <rule in="********BBBBBBBB **************** **************** ********BBBBBBBB X*******BBBBBBBB" out="********NSSSSSSS **************** **************** ********NSSSSSSS B*******NSSSSSSS"/>
    <rule in="BBBB************ **************** **************** BBBB************ XBBB************" out="NSSS************ **************** **************** NSSS************ NSSS************" p="2"/>
  </one>
  <!-- Il basso sulla radice. -->
  <one>
    <rule in="************BBBB YBBBBBBBBB******" out="************NSSS ASSSSSSSSS******" p="3"/>
    <rule in="YBBBBB**BBBBBB**" out="ASSSSS**ASSSSS**" p="2"/>
    <rule in="YBB*BBB***BBBBB*" out="ASS*ASS***ASSSS*"/>
  </one>
  <!-- La batteria: un disegno per battuta. -->
  <one>
    <rule in="********B******* **BBB*BB**BBBBBB D***************" out="********C******* **HHH*HH**HHHHHH K***************" p="3"/>
    <rule in="********B******* **B*BBB***BB**BB D***********B***" out="********C******* **H*HHH***HH**HH K***********K***" p="2"/>
    <rule in="********B******* **BBBBBB**B*BB*B D*************B*" out="********C******* **HHHHHH**H*HH*H K*************K*"/>
    <rule in="********B******* **B*B*****B*BBBB D*****B*********" out="********C******* **H*H*****H*HHHH K*****K*********"/>
  </one>

  <!-- La melodia: una testa che va avanti nel tempo e sale o scende. -->
  <one>
    <rule in="*B M*" out="*M N*" p="2"/>
    <rule in="M* *B" out="N* *M" p="2"/>
    <rule in="MBBB" out="NSSM"/>
    <rule in="**B MB*" out="**M AS*"/>
    <rule in="MB* *** *** **B" out="NS* *** *** **M"/>
    <rule in="MBB" out="B*M" p="3"/>
    <rule in="MBBBBBB" out="B*****M"/>
  </one>
  <all in="M" out="B"/>
  <one in="N/*/*/*" out="A/*/*/*" steps="4"/>
  <all in="X" out="B"/>
  <all in="Y" out="B"/>
  <all in="Z" out="B"/>
  <all in="D" out="B"/>
</sequence>
