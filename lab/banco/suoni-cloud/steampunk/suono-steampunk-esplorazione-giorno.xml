    <track y="0" instrument="lead" volume="0.48"/>
    <track y="1" instrument="pad" volume="0.42"/>
    <track y="2" instrument="lead" volume="0.3"/>
    <track y="3" instrument="bass" volume="0.6"/>
    <track y="4" instrument="bass" volume="0.5"/>
    <track y="5" instrument="pad" volume="0.36"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="M" value="10b981" name="Testa della melodia" hidden="True"/>
  <color symbol="Q" value="14b8a6" name="Testa del controcanto" hidden="True"/>
  <color symbol="T" value="ec4899" name="Testa degli accordi" hidden="True"/>
  <color symbol="W" value="334155" name="Soffitto degli accordi" hidden="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="X" value="c084fc" name="Segno del pad" hidden="True"/>
  <color symbol="Y" value="7c3aed" name="Segno del basso" hidden="True"/>
  <color symbol="Z" value="e879f9" name="Segno dell'arpeggio" hidden="True"/>
  <color symbol="D" value="475569" name="Battuta" hidden="True"/>

  <!-- The heads, at the start of the cycle; the ceiling keeps the chords in the low register. -->
  <line at="0 0 7" to="0 0 7" r="0" color="M"/>
  <line at="8 5 3" to="8 5 3" r="0" color="Q"/>
  <line at="0 3 0" to="0 3 0" r="0" color="T"/>
  <line at="0 3 6" to="127 3 6" r="0" color="W"/>
  <line at="0 3 7" to="127 3 7" r="0" color="W"/>
  <line at="0 3 8" to="127 3 8" r="0" color="W"/>
  <line at="0 3 9" to="127 3 9" r="0" color="W"/>
  <line at="0 3 10" to="127 3 10" r="0" color="W"/>
  <line at="0 3 11" to="127 3 11" r="0" color="W"/>
  <line at="0 3 12" to="127 3 12" r="0" color="W"/>
  <line at="0 3 13" to="127 3 13" r="0" color="W"/>
  <line at="0 3 14" to="127 3 14" r="0" color="W"/>
  <line at="0 3 15" to="127 3 15" r="0" color="W"/>
  <line at="0 3 16" to="127 3 16" r="0" color="W"/>
  <line at="0 3 17" to="127 3 17" r="0" color="W"/>
  <line at="0 4 0" to="0 4 0" r="0" color="D"/>
  <line at="16 4 0" to="16 4 0" r="0" color="D"/>
  <line at="32 4 0" to="32 4 0" r="0" color="D"/>
  <line at="48 4 0" to="48 4 0" r="0" color="D"/>
  <line at="64 4 0" to="64 4 0" r="0" color="D"/>
  <line at="80 4 0" to="80 4 0" r="0" color="D"/>
  <line at="96 4 0" to="96 4 0" r="0" color="D"/>
  <line at="112 4 0" to="112 4 0" r="0" color="D"/>

  <!-- The harmony: the head walks 16 steps at a time and leaves a root; the seed picks the degree. -->
  <one>
    <rule in="****************B ***************** ***************** T****************" out="****************T ***************** ***************** R****************" p="2"/>
    <rule in="T**************** ***************** ***************** ****************B" out="R**************** ***************** ***************** ****************T" p="2"/>
    <rule in="****************B ***************** ***************** ***************** T****************" out="****************T ***************** ***************** ***************** R****************" p="3"/>
    <rule in="T**************** ***************** ***************** ***************** ****************B" out="R**************** ***************** ***************** ***************** ****************T" p="3"/>
    <rule in="****************B ***************** ***************** ***************** ***************** T****************" out="****************T ***************** ***************** ***************** ***************** R****************"/>
    <rule in="T**************** ***************** ****************B" out="R**************** ***************** ****************T"/>
    <rule in="****************B T****************" out="****************T R****************"/>
  </one>
  <all in="T" out="R"/>
  <all in="W" out="B"/>
  <all in="B/B/R" out="X/Z/Y"/>

  <!-- The pad: one pattern per bar. -->
  <one>
    <rule in="BBBB**BBBB**BBBB **************** BBBB**BBBB**BBBB **************** XBBB**BBBB**BBBB" out="NSSS**NSSS**NSSS **************** NSSS**NSSS**NSSS **************** NSSS**NSSS**NSSS" p="2"/>
    <rule in="BBBBBBBBBBBBBBBB **************** BBBBBBBBBBBBBBBB **************** XBBBBBBBBBBBBBBB" out="NSSSSSSSNSSSSSSS **************** NSSSSSSSNSSSSSSS **************** NSSSSSSSNSSSSSSS" p="2"/>
    <rule in="B*B***B*B***B*** **************** B*B***B*B***B*** **************** X*B***B*B***B***" out="N*N***N*N***N*** **************** N*N***N*N***N*** **************** N*N***N*N***N***"/>
  </one>
  <!-- The arpeggio above the root. -->
  <one>
    <rule in="**B***B***B***** **************** *B*B*B*B*B*B**** **************** B***B***B***B*** **************** **************** **************** **************** **************** **************** Z***************" out="**N***N***N***** **************** *N*N*N*N*N*N**** **************** N***N***N***N*** **************** **************** **************** **************** **************** **************** B***************" p="2"/>
    <rule in="****B*********** **************** **B***B*******B* **************** B*******B***B*** **************** **************** **********B***** **************** **************** **************** Z***************" out="****N*********** **************** **N***N*******N* **************** N*******N***N*** **************** **************** **********N***** **************** **************** **************** B***************" p="2"/>
    <rule in="B***********B*** **************** **B*******B***** **************** ****B***B******* **************** **************** ******B********* **************** **************** **************** Z***************" out="N***********N*** **************** **N*******N***** **************** ****N***N******* **************** **************** ******N********* **************** **************** **************** B***************"/>
  </one>
  <!-- The bass on the root. -->
  <one>
    <rule in="****B*******B*** **************** **************B* **************** Y*B***B*B*B*****" out="****N*******N*** **************** **************N* **************** A*N***N*A*N*****" p="3"/>
    <rule in="****B*******B*** **************** **************** **B***B***B***B* **************** **************** **************** Y*******B*******" out="****N*******N*** **************** **************** **N***N***N***N* **************** **************** **************** A*******A*******" p="2"/>
    <rule in="****BB********B* **************** ************BB** **************** YBB***B*BBB*****" out="****NS********N* **************** ************NS** **************** ASN***N*ASN*****"/>
  </one>
  <!-- The drums: one pattern per bar. -->
  <one>
    <rule in="****B*******B*** *B*B*B*B*B*B*B*B D*******B*******" out="****C*******C*** *H*H*H*H*H*H*H*H K*******K*******" p="3"/>
    <rule in="****B*******B*B* *B*B*B*B*B*B*B*B D*B*****B*******" out="****C*******C*C* *H*H*H*H*H*H*H*H K*K*****K*******" p="2"/>
    <rule in="**************B* **************** ****B*******B*** *B*B*B*B*B*B**** D*******B*B*****" out="**************H* **************** ****C*******C*** *H*H*H*H*H*H**** K*******K*K*****"/>
  </one>

  <!-- The melody: a head going forward in time and rising or falling. -->
  <one>
    <rule in="**B MB*" out="**M NS*" p="3"/>
    <rule in="MB* **B" out="NS* **M" p="3"/>
    <rule in="*B M*" out="*M N*" p="2"/>
    <rule in="M* *B" out="N* *M" p="2"/>
    <rule in="****B ***** MBBB*" out="****M ***** NSSS*"/>
    <rule in="MBBB* ***** ****B" out="NSSS* ***** ****M"/>
    <rule in="MBB" out="B*M" p="2"/>
    <rule in="MBBBBBB" out="B*****M"/>
  </one>
  <all in="M" out="B"/>
  <!-- Il controcanto, più lento. -->
  <one>
    <rule in="********B QBBBBBBB*" out="********Q NSSSSSSS*" p="2"/>
    <rule in="QBBBBBBB* ********B" out="NSSSSSSS* ********Q" p="2"/>
    <rule in="****B ***** QBBB*" out="****Q ***** NSSS*"/>
    <rule in="QBBB* ***** ****B" out="NSSS* ***** ****Q"/>
    <rule in="QBBBBBBBB" out="B*******Q"/>
  </one>
  <all in="Q" out="B"/>
  <one in="N/*/*/*/*/*" out="A/*/*/*/*/*" steps="4"/>
  <all in="X" out="B"/>
  <all in="Y" out="B"/>
  <all in="Z" out="B"/>
  <all in="D" out="B"/>
</sequence>
