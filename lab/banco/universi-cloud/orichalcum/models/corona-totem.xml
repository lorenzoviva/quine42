<!--
Totem informativo / cartello olografico di settore (corona): arredo urbano e punto informazioni per viali e incroci della corona.
Scritto da Gemini CLI (Gemini 3.8 Flash, abbonamento), task T50a.
Scatola: 1 × 1 × 2.5 caselle, 8 × 8 × 20 voxel, 8 voxel per casella (vpt: 8).
Ruolo: prop.
Design e concetto scultoreo:
- Stele tecnologica slanciata ancorata al suolo su plinto di fondazione ottagonale in cemento grafite e titanio (P, D)
  con quattro massicce bullonature cromate agli angoli (s);
- Zoccolo rastremato in titanio scuro cybernetico (M, m) con indicatori di telemetria bus ciano (E) e spia di settore ambra (e);
- Pilastro montante metallico ultra-scuro in carbonio grafite (D, M) che sale fino a mezza altezza (z=7), dotato sul retro
  di alette verticali di dissipazione termica (m, S) e sui fianchi di canaline bus dati cromate (S);
- A quota z=6..7 il montante si allarga in una culla a forcella che alloggia l'emettitore laser inferiore in vetro scuro (V)
  con fessura di proiezione fotonica ciano elettrico (E, W, glow="True");
- Schermo olografico volumetrico verticale semitrasparente (z=8..15, x=2..5, y=3..4) racchiuso tra due piloni laterali
  di confinamento magnetico (x=1 e x=6 in m, S):
  - Il display sfrutta una tecnica pittorica di semitrasparenza volumetrica con reticolo di particelle e micro-vuoti d'aria (B);
  - Le trame di circuiti e le colonne di rune binarie / dati fotonici sono generate stocasticamente con regole MarkovJunior
    a partire da marcatori (X, Y, Z): linee di scansione ciano (N, glow="True"), ponti quantistici cobalto (C, glow="True")
    e pacchetti dati / bit bianchi laser (W, glow="True");
  - Ogni seme (seed 1, 2, 3...) produce una configurazione di dati, diagrammi e testi runici nettamente differente;
- Coronamento superiore (z=16..18):
  - Traversa superiore emettitrice a scansione di fase (z=16) in titanio (m, M) con raccordi cromati (S);
  - Cupola rastremata del sensore telemetrico e ottiche di scansione (z=17);
  - Cuspide d'antenna ricetrasmittente ad ago in argento cromo lucido (s, z=18), sormontata da un beacon omnidirezionale
    di settore ambra dorata (e, glow="True");
  - Quota z=19 lasciata libera come margine aereo per evitare tagli al soffitto.
Animazione "dati" (6 fotogrammi):
- I pacchetti di bit fotonici bianchi (W) scorrono e vibrano lungo le linee di circuito e le colonne di rune ciano/cobalto (N, C);
- L'emettitore laser inferiore e il proiettore a scansione modulano la luminosità (E, N);
- Il beacon d'antenna (e) sulla cuspide cromata pulsa regolarmente senza interferire con lo schermo.
-->
<sequence values="BMmDPSsVTCNWEeXYZH" size="8 8 20" symmetry="(x)" name="Totem">
  <!-- Materiali strutturali: titanio cybernetico scuro, carbonio e grafite plinto -->
  <color symbol="M" value="20222a" name="titanio scuro scocca"/>
  <color symbol="m" value="2e323f" name="titanio secondario biselli"/>
  <color symbol="D" value="141418" name="carbonio ultra-scuro montante"/>
  <color symbol="P" value="3a3a40" name="plinto fondazione grafite"/>

  <!-- Meccanica, snodi, tiranti e rifiniture cromate -->
  <color symbol="S" value="83769c" name="cromo satinato giunti e bus"/>
  <color symbol="s" value="c2c3c7" name="argento cromo lucido antenna e bulloni"/>

  <!-- Ottiche, guide riflettenti e display olografico -->
  <color symbol="V" value="1c2a3a" name="vano ottico vetro scuro"/>
  <color symbol="T" value="3d5a78" name="guida d'onda ardesia riflettente"/>

  <!-- Fonti luminose attive (glow="True") per bloom neon -->
  <color symbol="C" value="29adff" glow="True" name="ologramma azzurro cobalto"/>
  <color symbol="N" value="00ffff" glow="True" name="fascio neon ciano puro"/>
  <color symbol="W" value="ffffff" glow="True" name="dati fotonici e rune bianche"/>
  <color symbol="E" value="05d9e8" glow="True" name="laser proiettore ciano elettrico"/>
  <color symbol="e" value="ffa300" glow="True" name="beacon antenna ambra dorata"/>

  <!-- Marcatori invisibili per regole generative -->
  <color symbol="X" hidden="True" name="marker circuito bus"/>
  <color symbol="Y" hidden="True" name="marker runa binaria"/>
  <color symbol="Z" hidden="True" name="marker matrice quantistica"/>
  <color symbol="H" hidden="True" name="marker aletta dissipatore"/>

  <!-- ======================================================== -->
  <!-- 1. PLINTO DI FONDAZIONE OTTAGONALE AL SUOLO (z = 0)      -->
  <!-- ======================================================== -->
  <!-- Piastra base ottagonale in cemento titanico grafite P    -->
  <box at="3.5 3.5 0" size="4 6 1" color="P"/>
  <box at="3.5 3.5 0" size="6 4 1" color="P"/>
  <!-- Nucleo centrale di massa in carbonio scuro D             -->
  <box at="3.5 3.5 0" size="4 4 1" color="D"/>

  <!-- 4 bulloni d'ancoraggio cromati esagonali agli angoli     -->
  <box at="2 1 0" size="1 1 1" color="s"/>
  <box at="5 1 0" size="1 1 1" color="s"/>
  <box at="2 6 0" size="1 1 1" color="s"/>
  <box at="5 6 0" size="1 1 1" color="s"/>

  <!-- Alette laterali di scarico statico in titanio m           -->
  <box at="1 3.5 0" size="1 2 1" color="m"/>
  <box at="6 3.5 0" size="1 2 1" color="m"/>

  <!-- ======================================================== -->
  <!-- 2. ZOCCOLO RASTREMATO E TELEMETRIA PLINTO (z = 1)        -->
  <!-- ======================================================== -->
  <!-- Zoccolo a gradino in titanio cybernetico M                -->
  <box at="3.5 3.5 1" size="4 4 1" color="M"/>
  <!-- Biselli d'angolo rastremati in titanio chiaro m          -->
  <box at="2 2 1" size="1 1 1" color="m"/>
  <box at="5 2 1" size="1 1 1" color="m"/>
  <box at="2 5 1" size="1 1 1" color="m"/>
  <box at="5 5 1" size="1 1 1" color="m"/>

  <!-- Spie telemetriche frontali di stato (y=5)                -->
  <box at="3 5 1" size="1 1 1" color="E"/>
  <box at="4 5 1" size="1 1 1" color="e"/>

  <!-- Vano posteriore condotto cavi (y=2)                      -->
  <box at="3.5 2.0 1" size="2 1 1" color="V"/>

  <!-- ======================================================== -->
  <!-- 3. COLLARE DI ANCORAGGIO DEL PILASTRO (z = 2)            -->
  <!-- ======================================================== -->
  <box at="3.5 3.5 2" size="4 2 1" color="m"/>
  <box at="3.5 3.5 2" size="2 4 1" color="m"/>
  <box at="3.5 3.5 2" size="2 2 1" color="M"/>
  <!-- Giunti e fascette cromate satinato S                    -->
  <box at="2 3.5 2" size="1 2 1" color="S"/>
  <box at="5 3.5 2" size="1 2 1" color="S"/>
  <box at="3.5 2.0 2" size="2 1 1" color="S"/>

  <!-- ======================================================== -->
  <!-- 4. PILASTRO VERTICALE E DISSIPATORI POSTERIORI (z = 3..5) -->
  <!-- ======================================================== -->
  <!-- Anima centrale del pilone in carbonio ultra-nero D       -->
  <box at="3.5 3.5 3" size="2 2 3" color="D"/>

  <!-- Dorso posteriore con alloggiamento dissipatore (y=2)     -->
  <box at="3.5 2.0 3" size="2 1 3" color="H"/>

  <!-- Canali bus laterali in cromo satinato S (z=3..4)         -->
  <box at="2 3.5 3" size="1 2 2" color="S"/>
  <box at="5 3.5 3" size="1 2 2" color="S"/>

  <!-- Supporti laterali a forcella in titanio m (z=5)          -->
  <box at="2 3.5 5" size="1 2 1" color="m"/>
  <box at="5 3.5 5" size="1 2 1" color="m"/>

  <!-- Fronte del montante con scanalatura centrale (y=4)       -->
  <box at="3.5 4.0 3" size="2 1 3" color="M"/>
  <box at="3.5 4.0 4" size="2 1 1" color="m"/>

  <!-- ======================================================== -->
  <!-- 5. CULLA A FORCELLA E VASSOIO PROIETTORE LASER (z = 6..7) -->
  <!-- ======================================================== -->
  <!-- Mensola di supporto allargata a quota z=6                -->
  <box at="3.5 3.5 6" size="4 3 1" color="M"/>
  <box at="1 3.5 6" size="1 2 1" color="m"/>
  <box at="6 3.5 6" size="1 2 1" color="m"/>
  <box at="2 2 6" size="1 1 1" color="S"/>
  <box at="5 2 6" size="1 1 1" color="S"/>

  <!-- Vassoio ottico dell'emettitore laser inferiore a quota z=7 -->
  <box at="3.5 3.5 7" size="4 2 1" color="V"/>
  <box at="3.5 3.5 7" size="2 2 1" color="E"/>
  <box at="3 3 7" size="1 1 1" color="W"/>
  <box at="4 4 7" size="1 1 1" color="W"/>
  <box at="2 3.5 7" size="1 2 1" color="m"/>
  <box at="5 3.5 7" size="1 2 1" color="m"/>
  <box at="1 3.5 7" size="1 2 1" color="m"/>
  <box at="6 3.5 7" size="1 2 1" color="m"/>

  <!-- ======================================================== -->
  <!-- 6. PILONI LATERALI DI CONFINAMENTO (z = 8..15)           -->
  <!-- ======================================================== -->
  <!-- Colonne sottili di contenimento magnetico a x=1 e x=6    -->
  <box at="1 3.5 8" size="1 2 8" color="m"/>
  <box at="6 3.5 8" size="1 2 8" color="m"/>

  <!-- Raccordi cromati satinati S a z=10 e z=13                -->
  <box at="1 3.5 10" size="1 2 1" color="S"/>
  <box at="6 3.5 10" size="1 2 1" color="S"/>
  <box at="1 3.5 13" size="1 2 1" color="S"/>
  <box at="6 3.5 13" size="1 2 1" color="S"/>

  <!-- Micro-emettitori di campo cobalto C sui piloni           -->
  <box at="1 4 10" size="1 1 1" color="C"/>
  <box at="6 4 10" size="1 1 1" color="C"/>
  <box at="1 4 13" size="1 1 1" color="C"/>
  <box at="6 4 13" size="1 1 1" color="C"/>

  <!-- ======================================================== -->
  <!-- 7. SCHERMO OLOGRAFICO VERTICALE (z = 8..15, x = 2..5)     -->
  <!-- ======================================================== -->
  <!-- Base di proiezione fotonica ascendente (z=8..9)           -->
  <box at="3.5 3.5 8" size="2 2 2" color="N"/>
  <box at="2 3.5 8" size="1 2 2" color="C"/>
  <box at="5 3.5 8" size="1 2 2" color="C"/>
  <box at="3.5 4.0 8" size="2 1 1" color="W"/>

  <!-- Reticolo del display centrale semitrasparente (z=10..13) -->
  <!-- Piano posteriore (y=3): substrato di guida d'onda e riflessi T, Z -->
  <box at="3.5 3.0 10" size="4 1 4" color="T"/>
  <box at="3.5 3.0 11" size="2 1 2" color="Z"/>
  <box at="2 3 12" size="1 1 1" color="B"/>
  <box at="5 3 12" size="1 1 1" color="B"/>

  <!-- Piano anteriore (y=4): matrice attiva con marker X e Y   -->
  <box at="3.5 4.0 10" size="4 1 4" color="X"/>
  <box at="3.5 4.0 11" size="2 1 3" color="Y"/>
  <box at="2 4 10" size="1 1 1" color="N"/>
  <box at="5 4 10" size="1 1 1" color="N"/>
  <box at="3 4 13" size="1 1 1" color="W"/>
  <box at="4 4 13" size="1 1 1" color="W"/>
  <box at="2 4 12" size="1 1 1" color="B"/>
  <box at="5 4 12" size="1 1 1" color="B"/>

  <!-- Coronamento dell'ologramma verso l'emettitore (z=14..15) -->
  <box at="3.5 3.5 14" size="4 2 1" color="C"/>
  <box at="3.5 4.0 14" size="2 1 1" color="W"/>
  <box at="3.5 3.5 15" size="2 2 1" color="N"/>
  <box at="2 3.5 15" size="1 2 1" color="T"/>
  <box at="5 3.5 15" size="1 2 1" color="T"/>

  <!-- ======================================================== -->
  <!-- 8. TRAVERSA SUPERIORE A SCANSIONE DI FASE (z = 16)        -->
  <!-- ======================================================== -->
  <box at="3.5 3.5 16" size="6 2 1" color="m"/>
  <box at="3.5 3.5 16" size="2 2 1" color="M"/>
  <box at="1 3.5 16" size="1 2 1" color="S"/>
  <box at="6 3.5 16" size="1 2 1" color="S"/>
  <box at="3.5 4.0 16" size="2 1 1" color="N"/>

  <!-- ======================================================== -->
  <!-- 9. SENSORE TELEMETRICO E CUSPIDE ANTENNA (z = 17..18)    -->
  <!-- ======================================================== -->
  <!-- Pod del sensore telemetrico a quota z=17                 -->
  <box at="3.5 3.5 17" size="2 2 1" color="S"/>
  <box at="3 4 17" size="1 1 1" color="m"/>
  <box at="4 4 17" size="1 1 1" color="m"/>
  <box at="3.5 4.0 17" size="2 1 1" color="E"/>

  <!-- Cuspide d'antenna e beacon di settore a quota z=18       -->
  <box at="3 3 18" size="1 1 1" color="s"/>
  <box at="4 3 18" size="1 1 1" color="s"/>
  <box at="3.5 4.0 18" size="2 1 1" color="e"/>

  <!-- ======================================================== -->
  <!-- 10. REGOLE GENERATIVE: VARIANTI STOCASTICHE NEI SEMI     -->
  <!-- ======================================================== -->
  <!-- A) Dissipatore di calore posteriore (H)                  -->
  <one steps="3">
    <rule in="H" out="m" p="0.45"/>
    <rule in="H" out="S" p="0.30"/>
    <rule in="H" out="B" p="0.25"/>
  </one>
  <all in="H" out="m" optional="True"/>

  <!-- B) Risoluzione del bus circuitale sul display (X)        -->
  <!-- Formazione di linee e giunzioni circuitali orizzontali -->
  <prl steps="1" optional="True">
    <rule in="X X" out="N C" p="0.45"/>
    <rule in="X B" out="N *" p="0.30"/>
  </prl>
  <one steps="6">
    <rule in="X" out="N" p="0.45"/>
    <rule in="X" out="C" p="0.35"/>
    <rule in="X" out="W" p="0.20"/>
  </one>
  <all in="X" out="N" optional="True"/>

  <!-- C) Risoluzione delle rune binarie e testi olografici (Y) -->
  <!-- Formazione di sequenze verticali di bit runici (1/0 fotonici) -->
  <prl steps="1" optional="True">
    <rule in="Y Y" out="W B" p="0.40"/>
    <rule in="Y N" out="W *" p="0.30"/>
  </prl>
  <one steps="6">
    <rule in="Y" out="W" p="0.50"/>
    <rule in="Y" out="N" p="0.30"/>
    <rule in="Y" out="B" p="0.20"/>
  </one>
  <all in="Y" out="W" optional="True"/>

  <!-- D) Risoluzione della guida d'onda e densità quantistica (Z) -->
  <one steps="3">
    <rule in="Z" out="C" p="0.40"/>
    <rule in="Z" out="T" p="0.35"/>
    <rule in="Z" out="B" p="0.25"/>
  </one>
  <all in="Z" out="C" optional="True"/>

  <!-- E) Ramificazione stocastica dei circuiti fotonici         -->
  <prl steps="1" optional="True">
    <rule in="N B" out="N C" p="0.22"/>
    <rule in="C B" out="C T" p="0.18"/>
    <rule in="W N" out="W W" p="0.15"/>
  </prl>

  <!-- F) Sfoltimento per garantire la semitrasparenza volumetrica -->
  <prl steps="1" optional="True">
    <rule in="C C C" out="* B *" p="0.18"/>
  </prl>
</sequence>

<!-- ============================================================ -->
<!-- 11. ANIMAZIONE DATI (6 FRAMES): FLUSSO BIT E PULSAZIONE      -->
<!-- ============================================================ -->
<animation name="dati" frames="6">
  <sequence>
    <!-- Scorrimento dei pacchetti dati bianchi W lungo i canali ciano N e cobalto C -->
    <prl steps="1">
      <rule in="W N" out="N W" p="0.40"/>
      <rule in="N W" out="W N" p="0.40"/>
      <rule in="W C" out="C W" p="0.35"/>
      <rule in="C W" out="W C" p="0.35"/>
    </prl>

    <!-- Modulazione della fessura laser inferiore e fascio olografico -->
    <prl steps="1">
      <rule in="E N" out="N E" p="0.30"/>
      <rule in="N E" out="E N" p="0.30"/>
    </prl>

    <!-- Pulsazione telemetrica della cuspide d'antenna: solo dove sotto c'è l'asta cromata s -->
    <!-- in="e s" significa layer superiore e sopra layer inferiore s -->
    <prl steps="1">
      <rule in="e s" out="W *" p="0.35"/>
      <rule in="W s" out="e *" p="0.35"/>
    </prl>
  </sequence>
</animation>
