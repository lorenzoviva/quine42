<!-- Binari alti (orichalcum): il treno del minerale sul viadotto; un automa cellulare fa crescere le note attorno ai semi, come le traversine sotto le ruote. -->
<sequence name="Binari alti" values="BANSGKHCRTMP" size="16 3 8" symmetry="()" origin="True">
  <sound bpm="140" scale="pentatonic_minor" root="50" swing="0.1" cutoff="5000" space="0.3">
    <track y="0" instrument="lead" volume="0.8"/>
    <track y="1" instrument="pad" volume="0.72"/>
    <track y="2" instrument="bass" volume="0.9"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="T" value="ec4899" name="Meta" hidden="True"/>
  <color symbol="M" value="10b981" name="Motivo" hidden="True"/>
  <color symbol="P" value="64748b" name="Passaggio" hidden="True"/>

  <one in="B" out="M" steps="6" symmetry="(x)"/>
  <convolution neighborhood="VonNeumann" periodic="True" steps="3">
    <rule in="B" out="N" values="MA" sum="1,2" p="0.6"/>
    <rule in="M" out="A" values="N" sum="1,2,3"/>
    <rule in="N" out="G" values="N" sum="3,4"/>
  </convolution>
  <all>
    <rule in="NN" out="NS"/>
    <rule in="M" out="N"/>
  </all>
  <all symmetry="(x)">
    <rule in="B/B/N" out="B/B/K"/>
    <rule in="B/B/G" out="B/B/H"/>
    <rule in="B/B/A" out="B/B/C"/>
  </all>
</sequence>
