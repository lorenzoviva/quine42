  <color symbol="k" hidden="True" name="la quota scelta"/>
  <color symbol="s" hidden="True" name="le spalle"/>
  <color symbol="w" hidden="True" name="la pancia possibile"/>
  <color symbol="m" hidden="True" name="il dado della pancia"/>
  <color symbol="X" hidden="True" name="pancia sì"/>
  <color symbol="Y" hidden="True" name="pancia no"/>
  <!-- Le gambe e i piedi -->
