  <box at="10 11 12" size="1 1 1" color="A"/>
  <box at="10 2 12" size="1 3 1" color="O"/>
  <box at="10 0 11" size="5 1 3" color="O"/>
  <box at="10 0 12" size="3 1 1" color="E"/>
