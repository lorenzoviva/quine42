  <cylinder at="10 7 9" size="11 9 16" color="w" on="B"/>
  <box at="10 3 9" size="1 1 1" color="m"/>
  <cylinder at="10 7 10" size="10 8 1" color="O" on="B"/>
  <cylinder at="10 7 14" size="10 8 1" color="O" on="B"/>
  <box at="10 7 8" size="1 1 18" color="Q"/>
  <box at="0 0 16" size="1 1 6" color="h"/>
  <one in="h" out="k" steps="1"/>
  <all in="h" out="B"/>
  <all in="kB" out="kk"/>
  <all in="k[COQwm]" out="kk"/>
  <all in="[BCOQwmk] k" out="k k"/>
  <all in="k" out="B"/>
  <!-- Snello o panciuto -->
  <one steps="1"><rule in="m" out="X"/><rule in="m" out="Y"/></one>
  <all in="Xw" out="XX" symmetry="(xyz)"/>
  <all in="X" out="C"/>
  <all in="[wY]" out="B"/>
  <all in="B C" out="B O"/>
