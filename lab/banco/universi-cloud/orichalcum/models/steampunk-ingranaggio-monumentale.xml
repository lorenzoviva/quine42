  <color symbol="e" hidden="True" name="ruota davanti"/>
  <color symbol="f" hidden="True" name="pilastro davanti"/>
  <color symbol="p" hidden="True" name="dado dietro"/>
  <color symbol="q" hidden="True" name="dado al centro"/>
  <color symbol="u" hidden="True" name="dado davanti"/>
  <color symbol="S" hidden="True" name="la scelta"/>
  <color symbol="X" hidden="True" name="ottone scelto"/>
  <color symbol="Y" hidden="True" name="ghisa scelta"/>
  <color symbol="r" hidden="True" name="ribattino possibile"/>
  <!-- Lo zoccolo a gradini -->
  <box at="10 10 0" size="18 20 2" color="G"/>
  <box at="10 10 2" size="14 18 1" color="G"/>
  <!-- Tre ruote possibili, ognuna col suo pilastro, a profondità e altezze diverse -->
  <!-- Candidato a y=4, mozzo a z=27 -->
  <box at="10 4 3" size="4 3 24" color="b"/>
  <ellipsoid at="10 3 19" size="17 1 17" color="a"/>
  <ellipsoid at="10 4 19" size="17 1 17" color="a"/>
