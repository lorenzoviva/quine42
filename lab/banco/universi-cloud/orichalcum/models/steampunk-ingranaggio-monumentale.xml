  <one in="[pqu]" out="S" steps="1"/>
  <all symmetry="(xyz)">
    <rule in="[SXY][ace]" out="*X"/>
    <rule in="[SXY][bdf]" out="*Y"/>
  </all>
  <all in="[abcdefpqu]" out="B"/>
  <all in="X" out="O"/>
  <all in="[YS]" out="D"/>
