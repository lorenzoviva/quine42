<!-- Fonderia notturna (orichalcum): quattro battute di forni e incudini; la griglia grossa sceglie dove batte il martello e dove canta la colata, poi ogni cella diventa sedicesimi. -->
<sequence name="Fonderia notturna" values="BNSAGKHCRTMP" size="4 3 4" symmetry="()">
  <sound bpm="96" scale="harmonic_minor" root="45" swing="0.08" cutoff="4200" space="0.4">
    <track y="0" instrument="lead" volume="0.78"/>
    <track y="1" instrument="pad" volume="0.72"/>
    <track y="2" instrument="bass" volume="0.92"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="T" value="ec4899" name="Meta" hidden="True"/>
  <color symbol="M" value="10b981" name="Motivo" hidden="True"/>
  <color symbol="P" value="64748b" name="Passaggio" hidden="True"/>

  <!-- La prima colonna è sempre piena, così il forno c'è con ogni seme. -->
  <one in="B/B/B" out="R/M/K" steps="1"/>
  <one steps="3">
    <rule in="B/B/B" out="T/M/K"/>
    <rule in="B/B/B" out="R/B/C"/>
    <rule in="B/B/B" out="T/B/K"/>
  </one>
  <all in="B" out="P"/>
  <map scale="4 1 2" values="BNSAGKHCRTMP">
    <rule in="R" out="BNBG ABNB"/>
    <rule in="T" out="BGBB NSSA"/>
    <rule in="M" out="BBSS NSSS"/>
    <rule in="K" out="BBHB KBKH"/>
    <rule in="C" out="HBAB CBHB"/>
    <rule in="P" out="BBBB BBGB"/>
  </map>
</sequence>
