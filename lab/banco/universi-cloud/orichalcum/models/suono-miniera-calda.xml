    <rule in="B" out="N" values="M" sum="1" p="0.55"/>
    <rule in="M" out="A" values="N" sum="2,3"/>
    <rule in="N" out="G" values="N" sum="3,4"/>
  </convolution>
  <all>
    <rule in="NN" out="NS"/>
    <rule in="SN" out="SS"/>
    <rule in="M" out="N"/>
  </all>
  <all symmetry="(x)">
    <rule in="B/B/N" out="B/B/K"/>
    <rule in="B/B/A" out="B/B/C"/>
    <rule in="B/B/G" out="B/B/H"/>
  </all>
