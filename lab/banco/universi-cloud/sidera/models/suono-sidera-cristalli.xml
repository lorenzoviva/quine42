<!-- Nei canyon di cristallo, nei crateri e tra i relitti: lento e profondo, il basso lungo, poche note che risuonano tra le pareti. -->
<sequence name="Canyon di cristallo" values="BNSAGKHCRTMPD" size="128 3 12" symmetry="()">
  <sound bpm="60" scale="phrygian" root="40" swing="0" cutoff="1900" space="0.85">
    <track y="0" instrument="lead" volume="0.5"/>
    <track y="1" instrument="pad" volume="0.7"/>
    <track y="2" instrument="bass" volume="0.65"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Tenuta" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Nota leggera" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Cassa" glow="True"/>
  <color symbol="H" value="fde047" name="Piatto" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="T" value="ec4899" name="Testa degli accordi" hidden="True"/>
  <color symbol="M" value="10b981" name="Testa della melodia" hidden="True"/>
  <color symbol="P" value="64748b" name="Testa del ritmo" hidden="True"/>
  <color symbol="D" value="475569" name="Battuta" hidden="True"/>

  <!-- Le teste, all'inizio del giro. -->
  <line at="0 0 6" to="0 0 6" r="0" color="M"/>
  <line at="0 1 2" to="0 1 2" r="0" color="T"/>
  <line at="0 2 0" to="0 2 0" r="0" color="P"/>

  <!-- Il ritmo (y=2, quota 0): una testa segna le battute, ognuna ha il suo disegno. -->
  <one in="PBBBBBBBBBBBBBBBB" out="DBBBBBBBBBBBBBBBP"/>
  <all in="P" out="D"/>
  <all>
    <rule in="DBBBBBBBBBBBBBBB" out="KBBBBBBBBBBBBBBB" p="3"/>
    <rule in="DBBBBBBBBBBBBBBB" out="KBBBBBBBBBBKBBBB" p="2"/>
    <rule in="DBBBBBBBBBBBBBBB" out="BBBBBBBBKBBBBBBB" p="1"/>
  </all>

  <!-- L'armonia (y=1): la testa cammina di battuta in battuta e lascia una radice. -->
  <one>
    <rule in="TBBBBBBBBBBBBBBBB" out="RBBBBBBBBBBBBBBBT" p="3"/>
    <rule in="BBBBBBBBBBBBBBBBB TBBBBBBBBBBBBBBBB" out="BBBBBBBBBBBBBBBBT RBBBBBBBBBBBBBBBB"/>
    <rule in="TBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB" out="RBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBT"/>
    <rule in="BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB TBBBBBBBBBBBBBBBB" out="BBBBBBBBBBBBBBBBT BBBBBBBBBBBBBBBBB RBBBBBBBBBBBBBBBB"/>
    <rule in="TBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB" out="RBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBT"/>
  </one>
  <all in="T" out="R"/>
  <!-- Il basso (y=2) suona la radice dell'accordo. -->
  <all in="R/B" out="*/A"/>
  <!-- Il pad: le note dell'accordo sopra la radice, tenute. -->
  <all in="B B B B R" out="N * N * N"/>
  <all in="R" out="N"/>
  <all in="NBBBBBBBBBBBBBB" out="NSSSSSSSSSSSSSS"/>
  <!-- Il disegno del basso nella battuta. -->
  <all>
    <rule in="ABBBBBBBBBBBBBBB" out="ASSSSSSSSSSSSSSS" p="3"/>
    <rule in="ABBBBBBBBBBBBBBB" out="ASSSSSSSBBBBNSSS" p="2"/>
  </all>

  <!-- La melodia (y=0): una testa che va avanti nel tempo e sale o scende. -->
  <one>
    <rule in="MBB" out="NBM" p="1"/>
    <rule in="MBBBB" out="NSSBM" p="3"/>
    <rule in="MBBBBBBBB" out="BBBBBBBBM" p="5"/>
    <rule in="BBB MBB" out="BBM NBB" p="2"/>
    <rule in="MBB BBB" out="NBB BBM" p="2"/>
    <rule in="BBB BBB MBB" out="BBM BBB NBB" p="1"/>
    <rule in="MBB BBB BBB" out="NBB BBB BBM" p="1"/>
  </one>
  <all in="M" out="B"/>
  <!-- Qualche accento. -->
  <one in="N/*/*" out="A/*/*" steps="2"/>
</sequence>
