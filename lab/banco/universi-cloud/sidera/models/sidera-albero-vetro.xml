<!-- Albero di vetro di Sidera: un tronco di cristallo scuro che si assottiglia, rami sottili e una chioma di gemme sfaccettate,
     ciano e magenta. Quali rami portano una gemma, e quanto è grande, lo decide il seme: ogni albero del bosco è diverso. Cantiere 4C, a mano (Claude Code). -->
<sequence values="BTtRSsGgHhPMN" size="40 40 60" symmetry="()" name="Albero di vetro">
  <color symbol="T" value="3a2f55" name="tronco di cristallo"/>
  <color symbol="t" value="574a7e" name="venature del tronco"/>
  <color symbol="R" value="4b3f6e" name="rami"/>
  <color symbol="S" hidden="True" name="gemma grande che cresce"/>
  <color symbol="s" hidden="True" name="gemma piccola che cresce"/>
  <color symbol="G" value="6fe9ff" alpha="0.75" name="faccia di gemma al sole"/>
  <color symbol="g" value="2fa9d6" alpha="0.8" name="faccia di gemma in ombra"/>
  <color symbol="H" value="ff6fd2" alpha="0.75" glow="True" name="gemma magenta"/>
  <color symbol="h" value="b53a9a" alpha="0.8" name="gemma magenta in ombra"/>
  <color symbol="P" hidden="True" name="ramo possibile"/>
  <color symbol="M" hidden="True" name="segno di una gemma grande"/>
  <color symbol="N" hidden="True" name="segno di una gemma piccola"/>

  <!-- I rami possibili, ognuno con la sua gemma in punta. -->
  <line at="20 20 24" to="11 13 34" r="0.5" color="P"/>
  <line at="20 20 26" to="30 12 36" r="0.5" color="P"/>
  <line at="20 20 28" to="12 29 39" r="0.5" color="P"/>
  <line at="20 20 22" to="29 28 32" r="0.5" color="P"/>
  <line at="20 20 30" to="31 20 43" r="0.5" color="P"/>
  <line at="20 20 30" to="8 20 43" r="0.5" color="P"/>
  <line at="20 20 18" to="20 9 27" r="0.5" color="P"/>
  <line at="20 20 20" to="20 32 29" r="0.5" color="P"/>
  <line at="20 20 34" to="26 26 47" r="0.5" color="P"/>
  <line at="20 20 34" to="14 14 48" r="0.5" color="P"/>
  <box at="11 13 34" size="1 1 1" color="M"/>
  <box at="30 12 36" size="1 1 1" color="M"/>
  <box at="12 29 39" size="1 1 1" color="M"/>
  <box at="29 28 32" size="1 1 1" color="M"/>
  <box at="31 20 43" size="1 1 1" color="N"/>
  <box at="8 20 43" size="1 1 1" color="N"/>
  <box at="20 9 27" size="1 1 1" color="N"/>
  <box at="20 32 29" size="1 1 1" color="N"/>
  <box at="26 26 47" size="1 1 1" color="N"/>
  <box at="14 14 48" size="1 1 1" color="N"/>

  <!-- Il tronco, sempre, e la gemma di cima. -->
  <cone at="20 20 0" size="9 9 46" color="T"/>
  <cylinder at="20 20 0" size="11 11 2" color="T"/>
  <box at="20 20 0" size="1 11 40" color="t" on="T"/>
  <box at="20 20 0" size="11 1 34" color="t" on="T"/>
  <box at="20 20 45" size="1 1 1" color="S"/>

  <!-- Il seme sceglie i rami: almeno uno grande. -->
  <one steps="1" in="M" out="S"/>
  <prl steps="1">
    <rule in="M" out="S" p="0.45"/>
    <rule in="N" out="s" p="0.5"/>
  </prl>
  <all symmetry="(xyz)">
    <rule in="SP" out="SR"/>
    <rule in="sP" out="sR"/>
  </all>
  <all in="RP" out="RR" symmetry="(xyz)"/>
  <all>
    <rule in="P" out="B"/>
    <rule in="M" out="B"/>
    <rule in="N" out="B"/>
  </all>

  <!-- Le gemme crescono a facce piane: un ottaedro attorno a ogni punta. -->
  <all steps="7" in="S[BR]" out="*S" symmetry="(xyz)"/>
  <all steps="4" in="s[BR]" out="*s" symmetry="(xyz)"/>
  <all>
    <rule in="B S" out="B G"/>
    <rule in="B s" out="B H"/>
  </all>
  <all>
    <rule in="S" out="g"/>
    <rule in="s" out="h"/>
  </all>
</sequence>
