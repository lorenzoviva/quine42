<!--
corona-gerboa-artista: Il Maestro d'Arte del Concilio (avatar della Corona).
Membro del Concilio in forma di Gerboa gigante pittore bohémien (scala 20 vpt, anatomia base con orecchie in avanti).
Manto candido e grigio perla lucente con guanciotte rosate, ventre e pettorina bianco puro.
Indossa un grande basco morbido di panno/velluto rosa magenta (#ff8ad8, colore araldico dell'Artista)
inclinato vezzosamente sull'orecchio sinistro con picciolo centrale cabillou,
uno stilo/pennello da scultura digitale in legno nobile infilato nel bordo del basco con la punta
gocciolante di colore ciano fluorescente luminoso (#00f5ff glow),
e un elegante colletto a balze con morbido foulard d'artista rosa magenta annodato sul petto.
Scatola: 1.6 × 2.2 × 2.1 caselle, 32 × 44 × 42 voxel, 20 voxel per casella (vpt: 20).
Ruolo: npc.
-->
<sequence values="BFfDCcTtUuXxNWEZRrOoGgPpaAKkJIHhSsMmVvYyLl" size="32 44 42" symmetry="()" name="GerboaArtista">
  <!-- Manto grigio perla lucente con sfumature chiare del corpo e dorso -->
  <color symbol="F" value="d0d6e5" name="grigio perla base dorso"/>
  <color symbol="f" value="e8edf7" name="bianco perlaceo luce dorso"/>
  <color symbol="D" value="9ea7be" name="perla ardesia ombra"/>

  <!-- Ventre, petto e gola in morbido candido puro -->
  <color symbol="C" value="ffffff" name="candido puro ventre"/>
  <color symbol="c" value="f0ebf5" name="crema perla sfumatura"/>

  <!-- Testa, musetto, tartufo e guance rosate (part="testa") -->
  <color symbol="T" value="d0d6e5" part="testa" name="testa perla base"/>
  <color symbol="t" value="e8edf7" part="testa" name="testa perla chiaro guance"/>
  <color symbol="U" value="ffffff" part="testa" name="musetto candido"/>
  <color symbol="u" value="f0ebf5" part="testa" name="sfumatura musetto"/>
  <color symbol="X" value="ff9ebd" part="testa" name="guance rosate blush"/>
  <color symbol="x" value="ffb8cf" part="testa" name="blush cipria sfumato"/>
  <color symbol="N" value="5a2238" part="testa" name="tartufo naso mora rosata"/>
  <color symbol="W" value="7b7086" part="testa" name="baffetti vibrisse"/>
  <color symbol="E" value="15141c" part="testa" name="occhi scuri profondi"/>
  <color symbol="Z" value="ffffff" glow="True" part="testa" name="riflesso occhi vispo"/>

  <!-- Grandi orecchie a conchiglia (part="testa") -->
  <color symbol="O" value="d0d6e5" part="testa" name="dorso orecchio perla"/>
  <color symbol="o" value="e8edf7" part="testa" name="bordo orecchio chiaro"/>
  <color symbol="R" value="ffaec0" part="testa" name="interno orecchio rosa"/>
  <color symbol="r" value="ffd6e2" part="testa" name="concavita orecchio rosa chiaro"/>

  <!-- Zampe posteriori bipedali piegate a Z (part="gamba") -->
  <color symbol="G" value="d0d6e5" part="gamba" name="coscia perla"/>
  <color symbol="g" value="9ea7be" part="gamba" name="stinco e garretto"/>
  <color symbol="P" value="ffffff" part="gamba" name="piede candido dita"/>
  <color symbol="p" value="f0c2d2" part="gamba" name="polpastrelli rosati"/>

  <!-- Zampette anteriori sul petto (part="braccio") -->
  <color symbol="A" value="e8edf7" part="braccio" name="braccino perla"/>
  <color symbol="a" value="ffffff" part="braccio" name="manina candida"/>

  <!-- Coda sinuosa e pennacchio bicolore (part="coda") -->
  <color symbol="K" value="d0d6e5" part="coda" name="fusto coda perla"/>
  <color symbol="k" value="9ea7be" part="coda" name="giunto fusto coda"/>
  <color symbol="J" value="2b1f30" part="coda" name="base pennacchio mora scura"/>
  <color symbol="I" value="ffffff" part="coda" name="punta pennacchio nuvola candida"/>

  <!-- Accessori dell'Artista: Basco bohémien rosa magenta, Stilo da scultura digitale (part="testa") -->
  <color symbol="H" value="ff8ad8" part="testa" name="basco velluto magenta artista"/>
  <color symbol="h" value="c7469a" part="testa" name="basco pieghe ombra velluto"/>
  <color symbol="S" value="ffa8e4" part="testa" name="basco luce velluto"/>
  <color symbol="s" value="8f1e68" part="testa" name="bordo e cabillou basco"/>
  <color symbol="M" value="e6ba7e" part="testa" name="fusto stilo legno acero"/>
  <color symbol="m" value="c2c6d4" part="testa" name="ghiera metallica stilo"/>
  <color symbol="V" value="00d4e6" part="testa" name="setole colore ciano"/>
  <color symbol="v" value="00f5ff" glow="True" part="testa" name="goccia ciano fluorescente glow"/>

  <!-- Foulard d'artista e colletto a balze (part="testa") -->
  <color symbol="Y" value="ff8ad8" part="testa" name="foulard collo magenta artista"/>
  <color symbol="y" value="c7469a" part="testa" name="pieghe ombra foulard"/>
  <color symbol="L" value="ffffff" part="testa" name="balza pizzo candido colletto"/>
  <color symbol="l" value="f0ebf5" part="testa" name="balza pizzo sfumatura"/>

  <!-- ======================================================== -->
  <!-- 1. LUNGHE ZAMPE POSTERIORI DA SALTATORE (part="gamba")   -->
  <!-- ======================================================== -->
  <!-- Piedone sinistro al suolo (x=10..12, y=15..28, z=0..1)   -->
  <box at="11 21.5 0" size="3 14 1" color="P"/>
  <box at="10 28 0" size="1 1 1" color="p"/>
  <box at="11 28 0" size="1 1 1" color="p"/>
  <box at="12 28 0" size="1 1 1" color="p"/>
  <box at="11 20 1" size="3 8 1" color="P"/>
  <box at="11 15.5 0" size="3 3 3" color="g"/>

  <!-- Piedone destro al suolo (x=19..21, y=15..28, z=0..1)     -->
  <box at="20 21.5 0" size="3 14 1" color="P"/>
  <box at="19 28 0" size="1 1 1" color="p"/>
  <box at="20 28 0" size="1 1 1" color="p"/>
  <box at="21 28 0" size="1 1 1" color="p"/>
  <box at="20 20 1" size="3 8 1" color="P"/>
  <box at="20 15.5 0" size="3 3 3" color="g"/>

  <!-- Lunghi stinchi inclinati in avanti dal garretto al ginocchio (z=2..12) -->
  <line at="11 15.5 2" to="11 24.5 11.5" r="1.1" color="g"/>
  <line at="20 15.5 2" to="20 24.5 11.5" r="1.1" color="g"/>

  <!-- Cosce muscolose alte piegate a Z che raccordano ginocchio e bacino -->
  <ellipsoid at="11 20 9.5" size="5 9 10" color="G"/>
  <ellipsoid at="20 20 9.5" size="5 9 10" color="G"/>

  <!-- ======================================================== -->
  <!-- 2. CORPO ALLUNGATO INCLINATO E VENTRE CANDIDO (z = 10..22) -->
  <!-- ======================================================== -->
  <!-- Groppa posteriore alta (si salda alle cosce e alla coda) -->
  <ellipsoid at="15.5 18 15" size="12 10 9" color="F"/>

  <!-- Dorso medio allungato (inclinato verso il basso e in avanti) -->
  <ellipsoid at="15.5 24 14" size="11 10 8" color="F"/>

  <!-- Petto e spalle anteriori -->
  <ellipsoid at="15.5 29 14.5" size="10 8 8" color="F"/>

  <!-- Soffice ventre e pettorina bianco puro (+y e parte inferiore) -->
  <ellipsoid at="15.5 24 11" size="8 9 5" color="C"/>
  <ellipsoid at="15.5 28 12.5" size="7 7 6" color="C"/>
  <ellipsoid at="15.5 31 14" size="6 5 5" color="c"/>

  <!-- ======================================================== -->
  <!-- 3. ZAMPETTE ANTERIORI MINUSCOLE AL PETTO (part="braccio") -->
  <!-- ======================================================== -->
  <!-- Braccino sinistro e manina candida -->
  <line at="12 29 14" to="13.5 32 12" r="0.6" color="A"/>
  <box at="13.5 33 12" size="2 1 1" color="a"/>

  <!-- Braccino destro e manina candida -->
  <line at="19 29 14" to="17.5 32 12" r="0.6" color="A"/>
  <box at="17.5 33 12" size="2 1 1" color="a"/>

  <!-- ======================================================== -->
  <!-- 4. TESTA GRANDE, GUANCE ROSATE, MUSETTO (part="testa")   -->
  <!-- ======================================================== -->
  <!-- Cranio principale -->
  <ellipsoid at="15.5 31 19" size="13 11 10" color="T"/>

  <!-- Ponte frontale perla tra gli occhi -->
  <box at="15.5 34 21" size="4 4 4" color="T"/>
  <box at="15.5 36 22" size="2 2 2" color="t"/>

  <!-- Guanciotte paffute e morbide perla/candide ai lati del viso -->
  <ellipsoid at="10.5 34 18.5" size="5 5 5" color="t"/>
  <ellipsoid at="20.5 34 18.5" size="5 5 5" color="t"/>
  <box at="10 35 18" size="3 3 3" color="U"/>
  <box at="21 35 18" size="3 3 3" color="U"/>

  <!-- Delicato blush rosato sulle guanciotte -->
  <box at="9.5 35.5 18" size="2 2 2" color="X"/>
  <box at="21.5 35.5 18" size="2 2 2" color="X"/>
  <box at="9 36 19" size="1 1 1" color="x"/>
  <box at="22 36 19" size="1 1 1" color="x"/>

  <!-- Musetto conico allungato in avanti candido (+y, z=18..19) -->
  <box at="15.5 37 18" size="5 4 3" color="U"/>
  <box at="15.5 39 18" size="3 3 2" color="U"/>
  <!-- Tartufo nasino mora rosata -->
  <box at="15.5 40 19" size="2 1 1" color="N"/>

  <!-- Sottili accenni di vibrisse laterali sul muso -->
  <box at="13 38 18" size="1 1 1" color="W"/>
  <box at="18 38 18" size="1 1 1" color="W"/>

  <!-- Grandi occhi scuri espressivi (3x2x3 voxel a z=20..22, y=34..35) -->
  <box at="11 34.5 20" size="3 2 3" color="E"/>
  <box at="20 34.5 20" size="3 2 3" color="E"/>

  <!-- Punti luce bianchi riflesso vispo (Z, glow="True") in alto a sx -->
  <box at="10 35 22" size="1 1 1" color="Z"/>
  <box at="19 35 22" size="1 1 1" color="Z"/>

  <!-- ======================================================== -->
  <!-- 5. FOULARD D'ARTISTA E COLLETTO A BALZE (part="testa")   -->
  <!-- ======================================================== -->
  <!-- Balza di pizzo candida attorno al collo -->
  <cylinder at="15.5 32 15" size="9 8 1" color="L"/>
  <box at="15.5 35 14.5" size="5 2 1" color="l"/>

  <!-- Collare foulard rosa magenta sopra la balza -->
  <cylinder at="15.5 32 16" size="8 7 1.6" color="Y"/>
  <!-- Nodo artistico elegante sotto la gola -->
  <box at="15.5 35 15.5" size="3 1.5 2" color="y"/>
  <!-- Drappeggio dei lembi di seta sul petto tra le zampine -->
  <box at="14.5 34.5 13.5" size="2 1.5 2.5" color="Y"/>
  <box at="16.5 34.2 12" size="1.5 1 2.5" color="y"/>
  <box at="14.5 34 11.5" size="1.5 1 1.5" color="S"/>

  <!-- ======================================================== -->
  <!-- 6. GIGANTESCHE ORECCHIE A CONCHIGLIA (part="testa", z=25..39) -->
  <!-- ======================================================== -->
  <!-- Orecchio sinistro: guscio perla posteriore/esterno -->
  <ellipsoid at="9.5 29 25" size="8 4 15" color="O"/>
  <!-- Padiglione interno concavo velluto rosa carne -->
  <ellipsoid at="9.5 30.5 26" size="6 3 13" color="R"/>
  <box at="9.5 31 27" size="4 1 8" color="r"/>
  <line at="6 30 28" to="9 30 38" r="0.5" color="o"/>

  <!-- Orecchio destro: completamente eretta e maestosa -->
  <ellipsoid at="21.5 29 25" size="8 4 15" color="O"/>
  <!-- Padiglione interno concavo velluto rosa carne -->
  <ellipsoid at="21.5 30.5 26" size="6 3 13" color="R"/>
  <box at="21.5 31 27" size="4 1 8" color="r"/>
  <line at="25 30 28" to="22 30 38" r="0.5" color="o"/>

  <!-- ======================================================== -->
  <!-- 7. BASCO BOHÉMIEN INCLINATO IN VELLUTO MAGENTA           -->
  <!-- ======================================================== -->
  <!-- Bordo e alloggiamento anatomico tra le radici delle orecchie -->
  <cylinder at="15.5 32 25.5" size="8 8 1.2" color="s"/>
  <box at="15.5 35 25.5" size="5 2 1" color="h"/>

  <!-- Calotta svasata e morbida del basco, inclinata vezzosamente verso sx -->
  <ellipsoid at="14 32 27" size="10.5 10.5 3.5" color="H"/>
  <ellipsoid at="13.2 32 28.5" size="9 9 3" color="H"/>

  <!-- Pieghe e morbida caduta del panno contro la radice dell'orecchio sinistro -->
  <box at="10.5 32 26.5" size="2 4 1.5" color="h"/>
  <box at="14 27.5 26.5" size="5 2 1.5" color="h"/>

  <!-- Luce sommitale e cupola superiore del basco -->
  <ellipsoid at="13.5 32 29.5" size="7.5 7.5 2" color="S"/>
  <box at="13.5 32 30.5" size="3 3 1" color="S"/>

  <!-- Bottoncino cabillou caratteristico sulla sommita del basco -->
  <cylinder at="13.5 32 31.5" size="2 2 1" color="h"/>
  <box at="13.5 32 32" size="1 1 1" color="s"/>

  <!-- ======================================================== -->
  <!-- 8. STILO / PENNELLO DIGITALE CON GOCCIA CIANO LUMINOSA   -->
  <!-- ======================================================== -->
  <!-- Fusto dello stilo in legno acero infilato nel bordo del basco a destra -->
  <line at="19 28 28" to="17 35 27" r="0.6" color="M"/>
  <box at="19 28 28" size="1 1 1" color="m"/>

  <!-- Ghiera metallica dello stilo -->
  <box at="17 35 27" size="1 1 1" color="m"/>

  <!-- Setole del pennello intinte di ciano -->
  <box at="16.5 36 26" size="2 1 1" color="V"/>

  <!-- Punta viva gocciolante di ciano fluorescente glow -->
  <box at="16 37 26" size="1 1 1" color="v"/>
  <box at="16 37 25" size="1 1 1" color="v"/>

  <!-- ======================================================== -->
  <!-- 9. LUNGHISSIMA CODA E PENNACCHIO BICOLORE (part="coda")  -->
  <!-- ======================================================== -->
  <!-- Attacco alla groppa posteriore alta (y=15, z=16) -->
  <line at="15.5 15 16" to="15.5 10 9" r="1.1" color="K"/>
  <!-- Discesa sinuosa verso il terreno -->
  <line at="15.5 10 9" to="15.5 6 4" r="0.9" color="K"/>
  <line at="15.5 6 4" to="15.5 3.5 2.5" r="0.8" color="K"/>
  <!-- Risalita verso l'alto -->
  <line at="15.5 3.5 2.5" to="15.5 2.5 5.5" r="0.8" color="k"/>
  <line at="15.5 2.5 5.5" to="15.5 2.5 9" r="0.8" color="k"/>

  <!-- Spettacolare pennacchio bicolore: collare scuro e grande batuffolo bianco saldato -->
  <ellipsoid at="15.5 2.5 9" size="5 4 5" color="J"/>
  <ellipsoid at="15.5 2.5 12" size="6 5 6" color="I"/>
  <ellipsoid at="15.5 2.5 16" size="4 4 5" color="I"/>
  <box at="15.5 2.5 18" size="2 2 2" color="I"/>

  <!-- ======================================================== -->
  <!-- 10. REGOLE GENERATIVE: SFUMATURE, PELO E TEXTURE         -->
  <!-- ======================================================== -->
  <!-- Illuminazione sommitale del dorso e delle spalle -->
  <prl steps="1" p="0.3" in="B F" out="B f"/>
  <!-- Ombreggiatura naturale nelle pieghe inferiori del dorso -->
  <prl steps="1" p="0.15" in="F/B" out="D/*"/>
  <!-- Transizione morbida tra pancia candida e fianchi perla -->
  <prl steps="1" p="0.35" in="F/C" out="*/c"/>
  <prl steps="1" p="0.25" in="FC" out="Fc" symmetry="(x)"/>
  <!-- Sfumatura delicata tra guance perla e musetto -->
  <prl steps="1" p="0.25" in="t U" out="u *"/>
  <!-- Trama vellutata e morbida sul panno del basco -->
  <prl steps="1" p="0.2" in="B H" out="B S"/>
</sequence>
