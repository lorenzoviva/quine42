<!-- Edicola: il chiosco verde di lamiera con la tettoia che sporge e le riviste esposte; la tettoia sta più in alto o più in basso a ogni seme. -->
<sequence values="BZHTRVMNP" size="25 25 24" symmetry="(xy)" name="Edicola">
  <color symbol="Z" hidden="True"/><color symbol="H" hidden="True"/>
  <color symbol="T" value="3a8a4a" name="lamiera verde"/><color symbol="R" value="2a6a3a" name="tettoia"/><color symbol="V" value="b8d8e0" name="vetro" alpha="0.6"/>
  <color symbol="M" value="e86a8a" name="riviste rosa"/><color symbol="N" value="f0e040" name="riviste gialle"/><color symbol="P" value="e8e4d8" name="giornali"/>
  <box at="12 12 0" size="15 11 20" color="Z"/>
  <box at="12 12 0" size="15 11 9" color="T"/>
  <box at="12 12 9" size="1 1 1" color="H"/>
  <one>
    <rule in="Z H" out="H T" p="5"/>
    <rule in="H" out="T" p="1"/>
  </one>
  <all in="TZ" out="TT" symmetry="(xy)"/>
  <all in="Z" out="B"/>
  <all in="B T" out="R T"/>
  <all in="RB" out="RR" steps="2"/>
  <box at="12 17 4" size="7 1 4" color="V" on="T"/>
  <box at="6 17 3" size="3 1 3" color="M" on="T"/>
  <box at="18 17 3" size="3 1 3" color="N" on="T"/>
  <box at="12 18 0" size="9 2 2" color="P"/>
</sequence>
