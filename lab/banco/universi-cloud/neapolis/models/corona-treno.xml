  <color symbol="r" value="ff7597" glow="True" name="lama neon magenta secondaria"/>
  <color symbol="A" value="ffa3c4" glow="True" name="picco induzione laser magenta"/>

  <!-- Propulsione e scarichi vettoriali di coda (glow="True") -->
  <color symbol="T" value="ff0055" glow="True" name="plasma vettoriale coda primario"/>
  <color symbol="t" value="ff5277" glow="True" name="plasma vettoriale coda secondario"/>

  <!-- Archivi dati interni illuminati (glow="True") -->
  <color symbol="1" value="ffec27" glow="True" name="cubetti dati oro brillante"/>
  <color symbol="2" value="ffa300" glow="True" name="pacchetti logici ambra"/>
  <color symbol="3" value="ffe27a" glow="True" name="cubi quantistici panna-oro"/>
  <color symbol="4" value="ff7700" glow="True" name="cristalli archivio arancio vivo"/>
