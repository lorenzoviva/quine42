  <box at="14 3 2" size="1 1 1" color="C"/>
  <box at="14 4 2" size="1 1 1" color="c"/>

  <!-- Muso e carenatura frontale inferiore (x=16..18)          -->
  <box at="16.5 3.5 2" size="2 4 1" color="S"/>
  <box at="18 3.5 2" size="1 2 1" color="s"/>
  <box at="18 3 2" size="1 1 1" color="W"/>
  <box at="18 4 2" size="1 1 1" color="W"/>

  <!-- ======================================================== -->
