  <box at="16 3.5 5" size="1 4 1" color="S"/>

  <!-- ======================================================== -->
  <!-- 7. CARENATURA DORSALE E GRIGLIE SCORRIMENTO (z = 6)      -->
  <!-- ======================================================== -->
