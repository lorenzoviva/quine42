  <box at="3 6 2" size="1 1 1" color="S"/>

  <!-- Pilastri carrozzeria e montanti laterali                 -->
  <box at="4 1 2" size="1 1 1" color="S"/>
  <box at="4 6 2" size="1 1 1" color="S"/>
  <box at="7 1 2" size="1 1 1" color="m"/>
