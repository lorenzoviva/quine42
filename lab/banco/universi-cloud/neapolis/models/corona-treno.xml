  <box at="3 3.5 3" size="1 6 1" color="S"/>
  <box at="3 3.5 3" size="1 2 1" color="D"/>

  <!-- Vetrate panoramiche e montanti riflettenti (y=1 e y=6)   -->
  <box at="9.5 1 3" size="12 1 1" color="V"/>
  <box at="9.5 6 3" size="12 1 1" color="V"/>
  <box at="4 1 3" size="1 1 1" color="S"/>
  <box at="4 6 3" size="1 1 1" color="S"/>
  <box at="7 1 3" size="1 1 1" color="v"/>
  <box at="7 6 3" size="1 1 1" color="v"/>
  <box at="11 1 3" size="1 1 1" color="v"/>
  <box at="11 6 3" size="1 1 1" color="v"/>
  <box at="15 1 3" size="1 1 1" color="S"/>
  <box at="15 6 3" size="1 1 1" color="S"/>

  <!-- Cubetti dati e archivi quantistici interni a z=3         -->
  <box at="5 2 3" size="1 1 1" color="2"/>
  <box at="6 2 3" size="1 1 1" color="1"/>
  <box at="5 5 3" size="1 1 1" color="1"/>
  <box at="6 5 3" size="1 1 1" color="Z"/>

  <box at="8 2 3" size="1 1 1" color="Y"/>
  <box at="9 2 3" size="1 1 1" color="3"/>
  <box at="10 2 3" size="1 1 1" color="4"/>
  <box at="8 5 3" size="1 1 1" color="G"/>
  <box at="9 5 3" size="1 1 1" color="1"/>
  <box at="10 5 3" size="1 1 1" color="2"/>

  <box at="12 2 3" size="1 1 1" color="1"/>
  <box at="13 2 3" size="1 1 1" color="X"/>
  <box at="12 5 3" size="1 1 1" color="3"/>
  <box at="13 5 3" size="1 1 1" color="1"/>

