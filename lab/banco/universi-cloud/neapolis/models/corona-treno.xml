  <!-- Rack 2 (centrale x=8..10)                                -->
  <box at="8 1 2" size="1 1 1" color="3"/>
  <box at="9 1 2" size="1 1 1" color="Y"/>
  <box at="10 1 2" size="1 1 1" color="G"/>
  <box at="8 2 2" size="1 1 1" color="3"/>
  <box at="9 2 2" size="1 1 1" color="Y"/>
  <box at="10 2 2" size="1 1 1" color="1"/>
  <box at="8 5 2" size="1 1 1" color="2"/>
  <box at="9 5 2" size="1 1 1" color="4"/>
  <box at="10 5 2" size="1 1 1" color="G"/>
  <box at="8 6 2" size="1 1 1" color="2"/>
  <box at="9 6 2" size="1 1 1" color="4"/>
  <box at="10 6 2" size="1 1 1" color="G"/>

  <!-- Rack 3 (anteriore x=12..14)                              -->
  <box at="12 1 2" size="1 1 1" color="X"/>
  <box at="13 1 2" size="1 1 1" color="1"/>
  <box at="14 1 2" size="1 1 1" color="4"/>
  <box at="12 2 2" size="1 1 1" color="X"/>
  <box at="13 2 2" size="1 1 1" color="1"/>
