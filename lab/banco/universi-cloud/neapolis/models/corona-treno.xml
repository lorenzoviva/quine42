  <!-- ======================================================== -->
  <!-- 9. REGOLE GENERATIVE: VARIANTI STOCASTICHE NEI SEMI      -->
  <!-- ======================================================== -->
  <!-- A) Risoluzione quantistica archivio 1 (X)                -->
  <one steps="4">
    <rule in="X" out="1" p="0.40"/>
    <rule in="X" out="3" p="0.30"/>
    <rule in="X" out="G" p="0.20"/>
    <rule in="X" out="2" p="0.10"/>
  </one>
  <all in="X" out="1" optional="True"/>

  <!-- B) Risoluzione pacchetti dati archivio 2 (Y)             -->
  <one steps="4">
    <rule in="Y" out="2" p="0.45"/>
    <rule in="Y" out="4" p="0.25"/>
    <rule in="Y" out="1" p="0.20"/>
    <rule in="Y" out="G" p="0.10"/>
  </one>
  <all in="Y" out="2" optional="True"/>

  <!-- C) Risoluzione cluster archivio 3 (Z)                    -->
  <one steps="4">
    <rule in="Z" out="G" p="0.35"/>
    <rule in="Z" out="1" p="0.35"/>
    <rule in="Z" out="3" p="0.20"/>
    <rule in="Z" out="4" p="0.10"/>
  </one>
  <all in="Z" out="G" optional="True"/>

  <!-- D) Dettagli carenatura dorsale (Q)                       -->
  <one steps="2">
    <rule in="Q" out="s" p="0.50"/>
    <rule in="Q" out="m" p="0.30"/>
    <rule in="Q" out="c" p="0.20"/>
  </one>
  <all in="Q" out="s" optional="True"/>
</sequence>

<!-- ============================================================ -->
<!-- 10. ANIMAZIONE LEVITAZIONE (4 FRAMES): MAGNETISMO E DATI     -->
<!-- ============================================================ -->
<animation name="levitazione" frames="4" symmetry="()">
  <sequence>
    <!-- 1. Ciclo energetico quantistico dei dati negli archivi   -->
    <all in="1" out="x"/>
    <all in="2" out="1"/>
    <all in="3" out="2"/>
    <all in="4" out="3"/>
    <all in="x" out="4"/>

    <!-- 2. Onda di induzione e repulsione magnetica sui pattini  -->
    <all in="R" out="y"/>
    <all in="r" out="R"/>
    <all in="A" out="r"/>
    <all in="y" out="A"/>

    <!-- 3. Pulsazione telemetria di rotta e scarichi coda        -->
    <all in="T" out="z"/>
    <all in="t" out="T"/>
    <all in="z" out="t"/>
  </sequence>
</animation>
