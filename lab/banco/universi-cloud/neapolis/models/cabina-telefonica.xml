<!-- Cabina telefonica: telaio grigio, vetri su quattro lati, tetto arancione, il telefono a gettoni dentro; alta quanto capita. -->
<sequence values="BZHTVRK" size="20 20 36" symmetry="(xy)" name="Cabina telefonica">
  <color symbol="Z" hidden="True"/><color symbol="H" hidden="True"/>
  <color symbol="T" value="9a9ca4" name="telaio grigio"/><color symbol="V" value="a8d0e0" name="vetro" alpha="0.5"/><color symbol="R" value="e8742a" name="tetto arancione"/><color symbol="K" value="2a2a30" name="telefono"/>
  <box at="10 10 0" size="8 8 1" color="T"/>
  <box at="10 10 1" size="8 8 30" color="Z"/>
  <box at="10 10 1" size="8 8 18" color="T"/>
  <box at="10 10 19" size="1 1 1" color="H"/>
  <one>
    <rule in="Z H" out="H T" p="6"/>
    <rule in="H" out="T" p="1"/>
  </one>
  <all in="TZ" out="TT" symmetry="(xy)"/>
  <all in="Z" out="B"/>
  <all in="B T" out="R T"/>
  <all in="RB" out="RR" steps="1"/>
  <box at="10 10 3" size="4 20 14" color="V" on="T"/>
  <box at="10 10 3" size="20 4 14" color="V" on="T"/>
  <box at="10 10 1" size="6 6 34" color="B" on="T"/>
  <box at="10 10 1" size="6 6 34" color="B" on="V"/>
  <box at="10 7 9" size="2 1 3" color="K"/>
</sequence>
