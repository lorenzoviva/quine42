<!-- Scaffale industriale (moderno): i montanti blu forati, le traverse arancio e i ripiani di lamiera di un magazzino, carichi di
     scatoloni e casse di plastica. Il seme sceglie se ha una campata o due, quanto è alto (due, tre o quattro ripiani) e dove stanno
     gli scatoloni, uno per uno. -->
<sequence values="BPOWEeAmXUhkc" size="20 20 20" symmetry="(xy)" name="Scaffale">
  <color symbol="P" value="2f5aa8" name="montanti blu"/>
  <color symbol="O" value="e87a1e" name="traverse arancio"/>
  <color symbol="W" value="9aa0a6" name="ripiani di lamiera"/>
  <color symbol="E" value="b88a52" name="scatolone"/>
  <color symbol="e" value="8e6436" name="nastro dello scatolone"/>
  <color symbol="A" value="3a8ac8" name="cassa di plastica"/>
  <color symbol="m" hidden="True" name="il dado"/>
  <color symbol="X" hidden="True" name="una campata"/>
  <color symbol="U" hidden="True" name="due campate"/>
  <color symbol="h" hidden="True" name="le altezze possibili"/>
  <color symbol="k" hidden="True" name="la quota del taglio"/>
  <color symbol="c" hidden="True" name="uno scatolone che nasce"/>
  <!-- Il dado si scuote prima di decidere -->
  <box at="1 0 0" size="3 1 1" color="m"/>
  <prl steps="1" in="m" out="B"/>
  <!-- Prima scelta: una campata o due -->
  <box at="0 0 0" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="X"/>
    <rule in="m" out="U"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="XB" out="XX"/>
    <rule in="UB" out="UU"/>
  </all>
  <!-- una campata -->
  <box at="4 6 0" size="1 1 19" color="P" on="X"/>
  <box at="15 6 0" size="1 1 19" color="P" on="X"/>
  <box at="4 13 0" size="1 1 19" color="P" on="X"/>
  <box at="15 13 0" size="1 1 19" color="P" on="X"/>
  <box at="9.5 13 1" size="10 1 1" color="O" on="X"/>
  <box at="9.5 13 7" size="10 1 1" color="O" on="X"/>
  <box at="9.5 13 13" size="10 1 1" color="O" on="X"/>
  <box at="9.5 13 18" size="10 1 1" color="O" on="X"/>
  <box at="9.5 6 1" size="10 1 1" color="O" on="X"/>
  <box at="9.5 6 7" size="10 1 1" color="O" on="X"/>
  <box at="9.5 6 13" size="10 1 1" color="O" on="X"/>
  <box at="9.5 6 18" size="10 1 1" color="O" on="X"/>
  <box at="9.5 9.5 1" size="10 6 1" color="W" on="X"/>
  <box at="9.5 9.5 7" size="10 6 1" color="W" on="X"/>
  <box at="9.5 9.5 13" size="10 6 1" color="W" on="X"/>
  <box at="9.5 9.5 18" size="10 6 1" color="W" on="X"/>
  <!-- due campate -->
  <box at="1 6 0" size="1 1 19" color="P" on="U"/>
  <box at="10 6 0" size="1 1 19" color="P" on="U"/>
  <box at="18 6 0" size="1 1 19" color="P" on="U"/>
  <box at="1 13 0" size="1 1 19" color="P" on="U"/>
  <box at="10 13 0" size="1 1 19" color="P" on="U"/>
  <box at="18 13 0" size="1 1 19" color="P" on="U"/>
  <box at="9.5 13 1" size="16 1 1" color="O" on="U"/>
  <box at="9.5 13 7" size="16 1 1" color="O" on="U"/>
  <box at="9.5 13 13" size="16 1 1" color="O" on="U"/>
  <box at="9.5 13 18" size="16 1 1" color="O" on="U"/>
  <box at="9.5 6 1" size="16 1 1" color="O" on="U"/>
  <box at="9.5 6 7" size="16 1 1" color="O" on="U"/>
  <box at="9.5 6 13" size="16 1 1" color="O" on="U"/>
  <box at="9.5 6 18" size="16 1 1" color="O" on="U"/>
  <box at="9.5 9.5 1" size="16 6 1" color="W" on="U"/>
  <box at="9.5 9.5 7" size="16 6 1" color="W" on="U"/>
  <box at="9.5 9.5 13" size="16 6 1" color="W" on="U"/>
  <box at="9.5 9.5 18" size="16 6 1" color="W" on="U"/>
  <all in="[XU]" out="B"/>
  <!-- Seconda scelta: l'altezza. Una quota fra tre, e tutto ciò che sta da lì in su sparisce -->
  <box at="19 0 8" size="1 1 1" color="h"/>
  <box at="19 0 14" size="1 1 1" color="h"/>
  <box at="19 0 19" size="1 1 1" color="h"/>
  <one in="h" out="k" steps="1"/>
  <all in="h" out="B"/>
  <all in="k[BPOW]" out="kk"/>
  <all in="[BPOW] k" out="k k" symmetry="()"/>
  <all in="k" out="B"/>
  <!-- Gli scatoloni sui ripiani: nascono a caso e crescono -->
  <prl steps="1" in="B W" out="c *" p="0.05" symmetry="()"/>
  <all in="cB" out="cc" symmetry="(x)" steps="1"/>
  <all in="cB" out="cc" symmetry="(y)" steps="1"/>
  <all in="B c" out="c c" symmetry="()" steps="3"/>
  <prl steps="1" in="c" out="A" p="0.03"/>
  <all in="Ac" out="AA" symmetry="(xyz)"/>
  <all in="c" out="E"/>
  <all in="B E" out="* e" symmetry="()"/>
  <all in="m" out="B"/>
</sequence>
