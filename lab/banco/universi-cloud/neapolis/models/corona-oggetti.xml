  <sequence>
    <all in="1" out="x"/>
    <all in="2" out="1"/>
    <all in="3" out="2"/>
    <all in="4" out="3"/>
    <all in="5" out="4"/>
    <all in="6" out="5"/>
    <all in="7" out="6"/>
    <all in="8" out="7"/>
    <all in="x" out="8"/>
  </sequence>
</animation>
