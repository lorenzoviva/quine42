<sequence values="BWKPD" size="12 12 12" symmetry="()" name="Conchiglia">
  <color symbol="W" value="f6eedb" name="crema"/>
  <color symbol="K" value="f09ab0" name="rosa conchiglia"/>
  <color symbol="P" value="c84868" name="rosa bocca"/>
  <color symbol="D" value="381622" name="ombra interno"/>

  <!-- Body whorl resting on the ground -->
  <ellipsoid at="6 5 0" size="7 7 6" color="W"/>
  <ellipsoid at="4 8 0" size="4 4 3" color="W"/>

  <!-- Spire whorls ascending to the apex -->
  <ellipsoid at="5 4 3" size="6 6 4" color="K"/>
  <ellipsoid at="4 3 5" size="5 5 4" color="W"/>
  <cone at="3 3 7" size="3 3 4" color="K"/>

  <!-- Shoulder spines -->
  <line at="2 4 4" to="1 4 4" r="0" color="W"/>
  <line at="4 2 4" to="4 1 4" r="0" color="W"/>
  <line at="7 3 3" to="8 2 3" r="0" color="W"/>

  <!-- Flared outer lip -->
  <ellipsoid at="8 6 0" size="5 7 4" color="K"/>
  <box at="9 5 0" size="2 4 2" color="K"/>

  <!-- Aperture lining, dark cavity and open mouth -->
  <ellipsoid at="7 6 0" size="4 5 4" color="P"/>
  <ellipsoid at="6 5 0" size="3 4 3" color="D"/>
  <ellipsoid at="7 7 1" size="3 4 3" color="B"/>

  <!-- Spiral ridges -->
  <line at="2 5 2" to="7 8 2" r="0" color="K"/>
  <line at="3 3 4" to="8 4 3" r="0" color="K"/>
  <line at="3 2 6" to="6 3 5" r="0" color="K"/>

  <!-- Lip margin refinement -->
  <all>
    <rule in="P/B" out="K/*"/>
  </all>
</sequence>
