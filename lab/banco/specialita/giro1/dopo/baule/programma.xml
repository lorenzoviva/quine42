<!-- Baule da viaggio: sculpted by gemini-3.1-flash-lite (step 9), the Artist's vote 6/10 -->
<sequence values="BNIKUlo" size="20 20 20" symmetry="(x)" name="Baule da viaggio">
  <color symbol="N" value="6b4a2e" name="legno"/>
  <color symbol="I" value="4a4f5a" name="ferro"/>
  <color symbol="U" value="8a5a30" name="coperchio"/>
  <color symbol="K" value="c8a040" name="serratura"/>
  <color symbol="l" hidden="True" name="coperchio_aperto"/>
  <color symbol="L" hidden="True" name="coperchio_chiuso"/>

  <!-- Corpo -->
  <box at="10 10 0" size="16 12 10" color="N"/>

  <!-- Coperchio bombato (base 16x12, si restringe verso l'alto) -->
  <box at="10 10 10" size="16 12 1" color="U"/>
  <box at="10 10 11" size="14 10 1" color="U"/>
  <box at="10 10 12" size="12 8 1" color="U"/>
  <box at="10 10 13" size="10 6 1" color="U"/>

  <!-- Fasce di ferro -->
  <box at="4 6 0" size="2 1 14" color="I"/>
  <box at="16 6 0" size="2 1 14" color="I"/>
  <box at="10 6 13" size="12 1 1" color="I"/>

  <!-- Serratura -->
  <box at="10 16 5" size="2 1 3" color="K"/>

  <!-- Azione di apertura -->
  <action name="open" label="Solleva il coperchio">
    <sequence>
      <!-- Nasconde il coperchio chiuso e mostra quello aperto (spostato sul retro) -->
      <all in="U" out="B"/>
      <all in="K" out="B"/>
      <box at="10 18 10" size="16 2 8" color="U"/>
    </sequence>
  </action>
</sequence>
