<!-- Fuori dalle stazioni, sulla roccia degli asteroidi e tra i relitti: arpeggi freddi e regolari, come una stella che pulsa piano. -->
<sequence name="Deriva" values="BNSAGKHCRTMPD" size="128 3 12" symmetry="()">
  <sound bpm="96" scale="phrygian" root="41" swing="0.02" cutoff="4400" space="0.6">
    <track y="0" instrument="lead" volume="0.5"/>
    <track y="1" instrument="pad" volume="0.62"/>
    <track y="2" instrument="bass" volume="0.66"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="T" value="ec4899" name="Testa degli accordi" hidden="True"/>
  <color symbol="M" value="10b981" name="Testa della melodia" hidden="True"/>
  <color symbol="P" value="64748b" name="Testa del ritmo" hidden="True"/>
  <color symbol="D" value="475569" name="Battuta" hidden="True"/>

  <!-- The heads, at the start of the cycle. -->
  <line at="0 0 4" to="0 0 4" r="0" color="M"/>
  <line at="0 1 2" to="0 1 2" r="0" color="T"/>
  <line at="0 2 0" to="0 2 0" r="0" color="P"/>

  <!-- The rhythm (y=2, height 0): a head marks the bars, each has its own pattern. -->
  <one in="PBBBBBBBBBBBBBBBB" out="DBBBBBBBBBBBBBBBP"/>
  <all in="P" out="D"/>
  <all>
    <rule in="DBBBBBBBBBBBBBBB" out="BBHBBBHBBBHBBBHB" p="2"/>
    <rule in="DBBBBBBBBBBBBBBB" out="KBHBBBHBKBHBBBHB" p="2"/>
    <rule in="DBBBBBBBBBBBBBBB" out="BBHBBBHBBBHBKBHB"/>
  </all>

  <!-- The harmony (y=1): the head walks from bar to bar and leaves a root. -->
  <one>
    <rule in="TBBBBBBBBBBBBBBBB" out="RBBBBBBBBBBBBBBBT" p="2"/>
    <rule in="BBBBBBBBBBBBBBBBB TBBBBBBBBBBBBBBBB" out="BBBBBBBBBBBBBBBBT RBBBBBBBBBBBBBBBB" p="2"/>
    <rule in="TBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB" out="RBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBT" p="2"/>
    <rule in="BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB TBBBBBBBBBBBBBBBB" out="BBBBBBBBBBBBBBBBT BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB RBBBBBBBBBBBBBBBB"/>
    <rule in="TBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB" out="RBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBB BBBBBBBBBBBBBBBBT"/>
  </one>
  <all in="T" out="R"/>
  <!-- The bass (y=2) plays the root of the chord. -->
  <all in="R/B" out="*/A"/>
  <!-- The pad: three notes per root, held; where the top is missing the root alone remains. -->
  <all in="B B B B R" out="N * N * N"/>
  <all in="R" out="N"/>
  <all in="NBBBBBBBBBBBB" out="NSSSSSSSSSSSS"/>
  <!-- The pattern of the bass in the bar. -->
  <all>
    <rule in="ABBBBBBBBBBBBBBB" out="ABBNBBNBABBNBBNB" p="2"/>
    <rule in="ABBBBBBBBBBBBBBB" out="ABNBABNBABNBABNB"/>
  </all>

  <!-- The melody (y=0): a head going forward in time and rising or falling by a degree. -->
  <one>
    <rule in="MBB" out="NBM" p="6"/>
    <rule in="MBBBB" out="NSSBM"/>
    <rule in="MBBBB" out="BBBBM"/>
    <rule in="BBB MBB" out="BBM NBB" p="3"/>
    <rule in="MBB BBB" out="NBB BBM" p="3"/>
    <rule in="BBB BBB MBB" out="BBM BBB NBB" p="2"/>
    <rule in="MBB BBB BBB" out="NBB BBB BBM" p="2"/>
  </one>
  <all in="M" out="B"/>
  <!-- A few accents. -->
  <one in="N/*/*" out="A/*/*" steps="10"/>
</sequence>
