<!-- Di giorno, lungo la strada maestra e al saloon: una melodia che cammina a passo di cavallo, minore armonica. -->
<sequence name="Strada maestra" values="BNSAGKHCRTMP" size="16 3 8" symmetry="()">
  <sound bpm="96" scale="harmonic_minor" root="52" swing="0.14" cutoff="4200" space="0.4">
    <track y="0" instrument="lead" volume="0.82"/>
    <track y="1" instrument="pad" volume="0.75"/>
    <track y="2" instrument="bass" volume="0.9"/>
  </sound>
  <color symbol="N" value="38bdf8" name="Nota" glow="True"/>
  <color symbol="S" value="0284c7" name="Sustain" alpha="0.85"/>
  <color symbol="A" value="f43f5e" name="Accento" glow="True"/>
  <color symbol="G" value="818cf8" name="Ghost" alpha="0.7"/>
  <color symbol="K" value="fbbf24" name="Kick" glow="True"/>
  <color symbol="H" value="fde047" name="Hi-hat" alpha="0.85"/>
  <color symbol="C" value="fb923c" name="Rullante" glow="True"/>
  <color symbol="R" value="a855f7" name="Radice" hidden="True"/>
  <color symbol="T" value="ec4899" name="Meta" hidden="True"/>
  <color symbol="M" value="10b981" name="Motivo" hidden="True"/>
  <color symbol="P" value="64748b" name="Passaggio" hidden="True"/>
  <union symbol="X" values="NSA"/>

  <!-- La melodia (y=0) si prepara: un piano di passaggi su cui il cammino può andare. -->
  <all in="B/B/B" out="P/B/B"/>
  <!-- Tre ancore di partenza e tre mete. -->
  <one in="P" out="R" steps="3"/>
  <one in="P" out="T" steps="3"/>
  <!-- Il cammino le unisce, e l'inerzia ne fa scale e arpeggi. -->
  <path from="R" to="T" on="P" color="N" steps="4" inertia="True" longest="True"/>
  <!-- Le ancore diventano accenti, le mete note; i passaggi rimasti spariscono. -->
  <all>
    <rule in="R" out="A"/>
    <rule in="T" out="N"/>
    <rule in="P" out="B"/>
  </all>
  <!-- Code di sustain e note fantasma lungo il tempo. -->
  <one steps="10">
    <rule in="NB" out="NS" p="2"/>
    <rule in="BN" out="GN" p="1"/>
  </one>
  <!-- Il pad (y=1): dove la melodia suona, fiorisce un accordo. -->
  <one steps="7">
    <rule in="XBB/BBB" out="*BB/NNS"/>
    <rule in="AB/BB" out="*B/NS"/>
  </one>
  <!-- Il ritmo (y=2): una riga di motivo sulla quota più bassa diventa cassa e hi-hat. -->
  <line at="0 2 0" to="15 2 0" r="0" color="M"/>
  <all in="MMMM" out="KBHB"/>
  <one steps="4">
    <rule in="KBHB" out="KBHC"/>
    <rule in="HB" out="HG"/>
  </one>
  <!-- Sopra la cassa, due quote più in alto, a volte una nota di basso. -->
  <prl in="* * K" out="N * *" p="0.65" steps="1"/>
</sequence>
