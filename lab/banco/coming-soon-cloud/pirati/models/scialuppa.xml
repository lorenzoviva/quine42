<!-- Scialuppa: a mano (Claude Code, Cantiere 9). Scafo a quattro remi tirato in secco, la chiglia nella sabbia; ogni seme cambia i remi sul bordo e le assi del fasciame. -->
<sequence values="BKHGPRA" size="20 20 20" symmetry="()" name="Scialuppa">
  <color symbol="K" value="5a3a20" name="chiglia"/>
  <color symbol="H" value="9a6a3a" name="fasciame"/>
  <color symbol="G" value="d8c8a0" name="bordo"/>
  <color symbol="P" value="6a4426" name="panche"/>
  <color symbol="R" value="b88a52" name="remo"/>
  <color symbol="A" value="7a5030" name="assi"/>
  <box at="10 10 0" size="4 16 2" color="K"/>
  <box at="10 10 2" size="8 18 2" color="H"/>
  <box at="10 10 4" size="12 18 3" color="H"/>
  <box at="10 10 5" size="8 16 2" color="B"/>
  <box at="10 10 7" size="12 18 1" color="G"/>
  <box at="10 10 7" size="10 16 1" color="B"/>
  <box at="10 7 5" size="8 1 2" color="P"/>
  <box at="10 13 5" size="8 1 2" color="P"/>
  <prl in="B G" out="R G" p="0.12" steps="1"/>
  <all steps="2">
    <rule in="B R" out="R R" p="0.6"/>
  </all>
  <prl in="BH" out="AH" p="0.05" steps="1"/>
</sequence>
