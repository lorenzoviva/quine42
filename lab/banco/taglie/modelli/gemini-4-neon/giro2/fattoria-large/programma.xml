  <color symbol="h" value="C8A27A" area="house" name="Pavimento casa"/>
  <color symbol="w" value="E6DCC8" name="Muro casa"/>
  <color symbol="j" value="CFC2AA" name="Tramezzo"/>
  <color symbol="s" value="8C6239" area="house" name="Zona scala"/>
