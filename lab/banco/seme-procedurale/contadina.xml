  <box at="12 10 17" size="1 2 2" color="E"/>
  <box at="10 10 15" size="2 1 1" color="K"/>
  <box at="6 8 16" size="1 2 3" color="H"/>
  <box at="14 8 16" size="1 2 3" color="H"/>
