  <box at="10 7 2" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="a"/>
    <rule in="m" out="b"/>
    <rule in="m" out="K"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="aK" out="aa"/>
    <rule in="a[pq]" out="aa"/>
    <rule in="bK" out="bb"/>
