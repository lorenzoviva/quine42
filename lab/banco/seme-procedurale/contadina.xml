  <all in="a" out="C"/>
  <all in="b" out="H"/>
  <all in="d" out="H"/>
  <all in="r" out="B"/>
  <!-- What she carries, one thing only: the basket at her side, the sack on her back, the jug on her head, or nothing -->
  <cylinder at="17 9 2" size="7 8 6" color="c" on="B"/>
  <box at="17 9 6" size="1 6 3" color="c" on="B"/>
  <ellipsoid at="10 2 6" size="12 5 12" color="u" on="B"/>
  <cylinder at="10 6 24" size="5 5 5" color="v" on="B"/>
  <box at="0 0 0" size="1 1 1" color="y"/>
  <box at="1 0 0" size="1 1 1" color="y"/>
  <one steps="1">
