  <box at="10 5 18" size="8 4 5" color="d" on="[BH]"/>
  <box at="10 6 22" size="6 6 1" color="d" on="B"/>
  <ellipsoid at="10 5 23" size="6 6 6" color="r" on="B"/>
  <box at="10 6 24" size="1 1 1" color="m"/>
  <one steps="1">
