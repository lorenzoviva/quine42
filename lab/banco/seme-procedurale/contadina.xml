  <!-- Shuffle: the generator starts again from a different point for every seed (see README) -->
  <box at="10 0 29" size="20 2 1" color="#0"/>
  <prl in="#0" out="B" p="0.5" steps="1"/>
  <all in="#0" out="B"/>
    <box at="8 7 0" size="3 4 2" color="G"/>
  <box at="12 7 0" size="3 4 2" color="G"/>
  <!-- The skirt: three widths -->
  <cone at="10 7 0" size="20 15 15" color="p" on="B"/>
