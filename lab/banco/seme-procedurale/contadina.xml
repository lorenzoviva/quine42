    <rule in="#2u" out="#2#2"/>
    <rule in="#3v" out="#3#3"/>
  </all>
  <all in="[cuvy]" out="B"/>
  <all in="#1" out="T"/>
  <all in="#2" out="F"/>
  <all in="#3" out="R"/>
  <prl in="B T" out="R *" p="0.3" steps="1"/>
  <!-- The apron at the front of the skirt -->
  <box at="10 11 2" size="8 2 8" color="W" on="[BK]"/>
  <prl steps="1" symmetry="()">
    <rule in="B/* */* W/B" out="B/* */* F/B" p="0.35"/>
    <rule in="B/* */* K/B" out="B/* */* M/B" p="0.3"/>
    <rule in="B/* */* C/B" out="B/* */* L/B" p="0.25"/>
  </prl>
  <prl steps="1">
    <rule in="B K" out="B R" p="0.4"/>
  </prl>
</sequence>
