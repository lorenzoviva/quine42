<!-- Smooth pebble, procedural (Cantiere 2): the same palette of the original. The seed picks where two or three lobes start on a hidden disc
     on the ground, how much they grow upwards and how much they widen: every pebble has another outline, smooth like the original. -->
<sequence values="BHLGDSVc" size="10 10 8" symmetry="(xy)" name="Sasso levigato">
  <color symbol="H" value="c4c9d4" name="pietra lucida"/>
  <color symbol="L" value="9ba0aa" name="pietra chiara"/>
  <color symbol="G" value="6e737d" name="pietra grigia"/>
  <color symbol="D" value="4b5059" name="pietra d'ombra"/>
  <color symbol="S" value="32353b" name="ombra profonda"/>
  <color symbol="V" hidden="True" name="dove può nascere un lobo"/>
  <color symbol="c" hidden="True" name="il centro"/>
  <!-- The choices: the disc of the lobes, the centre and two random lobes, perhaps a third -->
  <ellipsoid at="5 5 0" size="7 7 1" color="V"/>
  <box at="5 5 0" size="1 1 1" color="G"/>
  <one in="V" out="G" steps="2"/>
  <prl steps="1" in="V" out="c" p="0.08"/>
  <all in="V" out="B"/>
  <one in="cB" out="*G" steps="1"/>
  <all in="c" out="B"/>
  <!-- Growth: first round, then a little sideways; how much depends on the seed -->
  <one steps="70" symmetry="(xyz)" in="GB" out="GG"/>
  <prl steps="2" in="GB" out="GG" p="0.25"/>
  <convolution neighborhood="Moore" steps="1">
    <rule in="B" out="G" values="G" sum="14..26"/>
    <rule in="G" out="B" values="G" sum="1..7"/>
  </convolution>
  <all in="B G" out="B L"/>
  <all in="G G" out="G D"/>
  <all in="DB" out="GB"/>
  <prl steps="1" in="B L" out="B H" p="0.25"/>
  <prl steps="1" in="D" out="S" p="0.35"/>
</sequence>
