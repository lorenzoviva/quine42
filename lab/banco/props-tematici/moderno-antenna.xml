  <!-- Prima scelta: la cima; tutto ciò che sta sopra sparisce -->
  <box at="1 0 0" size="3 1 1" color="m"/>
  <prl steps="1" in="m" out="B"/>
  <one in="q" out="Q" steps="1"/>
  <all in="Qq" out="QQ" symmetry="(xyz)"/>
  <all in="[BPq] Q" out="k *" symmetry="()"/>
  <all in="k[BPq]" out="kk"/>
  <all in="[BPq] k" out="k k" symmetry="()"/>
  <all in="[kq]" out="B"/>
  <all in="B Q Q" out="* R *" symmetry="()"/>
  <all in="Q Q" out="* P" symmetry="()"/>
  <all in="Q" out="Z"/>
  <all in="R P" out="* K" symmetry="()"/>
  <!-- Seconda scelta: che cosa porta -->
  <box at="0 0 0" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="L"/>
    <rule in="m" out="D"/>
    <rule in="m" out="n"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="LB" out="LL"/>
    <rule in="DB" out="DD"/>
    <rule in="nB" out="nn"/>
  </all>
  <!-- due parabole sui loro bracci -->
  <line at="6 10 24" to="4 10 24" color="K" on="L"/>
  <ellipsoid at="3 10 20" size="3 9 9" color="V" on="L"/>
  <box at="1 10 24" size="1 1 1" color="K" on="L"/>
  <line at="10 13 30" to="10 15 30" color="K" on="L"/>
  <ellipsoid at="10 16 26" size="9 3 9" color="V" on="L"/>
  <box at="10 18 30" size="1 1 1" color="K" on="L"/>
  <!-- tre pannelli bianchi con le staffe -->
