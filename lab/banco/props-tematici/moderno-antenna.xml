  <box at="5 9.5 28" size="1 2 9" color="W" on="D"/>
  <box at="13 9.5 30" size="1 2 1" color="K" on="D"/>
  <box at="14 9.5 28" size="1 2 9" color="W" on="D"/>
  <box at="9.5 13 30" size="2 1 1" color="K" on="D"/>
  <box at="9.5 14 28" size="2 1 9" color="W" on="D"/>
