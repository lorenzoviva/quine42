  <color symbol="q" hidden="True" name="le cime possibili"/>
  <color symbol="Q" hidden="True" name="la cima scelta"/>
  <color symbol="k" hidden="True" name="ciò che sta sopra la cima"/>
  <color symbol="L" hidden="True" name="due parabole"/>
  <color symbol="D" hidden="True" name="tre pannelli"/>
  <color symbol="n" hidden="True" name="la cabina"/>
  <color symbol="a" hidden="True" name="dove può stare la luce di metà torre"/>
  <color symbol="b" hidden="True" name="la luce scelta"/>
  <!-- Il plinto e il traliccio intero, fino in cima alla scatola -->
  <box at="9.5 9.5 0" size="10 10 1" color="C"/>
