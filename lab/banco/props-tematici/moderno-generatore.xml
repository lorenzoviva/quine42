<!-- Generatore diesel (moderno): il gruppo elettrogeno dei cantieri, con il quadro comandi, lo scarico e il serbatoio. Il seme sceglie
     com'è fatto (cofanato giallo sul basamento, a telaio aperto con il motore, il radiatore e l'alternatore in vista, o arancio su un
     carrello con le ruote e il timone), che cosa gli sta accanto (il serbatoio coricato dietro, due taniche rosse o niente) e dove è
     appoggiata la cassetta degli attrezzi. -->
<sequence values="BKYyOoEeDSNHTJRtmXUVLnF" size="20 20 20" symmetry="(xy)" name="Generatore diesel">
  <color symbol="K" value="26282c" name="ferro nero"/>
  <color symbol="Y" value="e8b820" name="cofano giallo"/>
  <color symbol="y" value="8a6a10" name="feritoie"/>
  <color symbol="O" value="e0661e" name="cofano arancio"/>
  <color symbol="o" value="8a3a10" name="feritoie arancio"/>
  <color symbol="E" value="4a6a5a" name="motore"/>
  <color symbol="e" value="b83a2a" name="testata"/>
  <color symbol="D" value="5a6068" name="radiatore"/>
  <color symbol="S" value="a8aeb4" name="acciaio"/>
  <color symbol="N" value="2a5aa8" name="alternatore"/>
  <color symbol="H" value="7cf090" name="display" glow="True"/>
  <color symbol="T" value="9a9a90" name="serbatoio"/>
  <color symbol="J" value="c8241e" name="tanica rossa"/>
  <color symbol="R" value="303236" name="pneumatico"/>
  <color symbol="t" value="c83a30" name="cassetta degli attrezzi"/>
  <color symbol="m" hidden="True" name="il dado"/>
  <color symbol="X" hidden="True" name="cofanato"/>
  <color symbol="U" hidden="True" name="a telaio aperto"/>
  <color symbol="V" hidden="True" name="su carrello"/>
  <color symbol="L" hidden="True" name="il serbatoio"/>
  <color symbol="n" hidden="True" name="le taniche"/>
  <color symbol="F" hidden="True" name="niente accanto"/>
  <!-- Il dado si scuote prima di decidere -->
  <box at="1 0 0" size="3 1 1" color="m"/>
  <prl steps="1" in="m" out="B"/>
  <!-- Prima scelta: com'è fatto -->
  <box at="0 0 0" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="X"/>
    <rule in="m" out="U"/>
    <rule in="m" out="V"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="XB" out="XX"/>
    <rule in="UB" out="UU"/>
    <rule in="VB" out="VV"/>
  </all>
  <!-- cofanato: basamento, feritoie, cofano, quadro, scarico -->
  <box at="10 10 0" size="17 9 1" color="K" on="X"/>
  <box at="13 14 3" size="7 1 1" color="y" on="X"/>
  <box at="13 14 5" size="7 1 1" color="y" on="X"/>
  <box at="13 14 7" size="7 1 1" color="y" on="X"/>
  <box at="10 10 1" size="17 9 10" color="Y" on="X"/>
  <box at="5 15 3" size="3 1 5" color="K" on="X"/>
  <box at="5 16 6" size="1 1 1" color="H" on="X"/>
  <cylinder at="15 8 11" size="3 3 4" color="K" on="X"/>
  <box at="15 8 15" size="3 3 1" color="S" on="X"/>
  <box at="8 10 11" size="1 1 1" color="S" on="X"/>
  <!-- a telaio aperto: motore, testata, radiatore, alternatore, telaio e scarico -->
  <box at="10 10 0" size="17 9 1" color="K" on="U"/>
  <box at="11 10 1" size="8 5 7" color="E" on="U"/>
  <box at="11 10 8" size="6 3 2" color="e" on="U"/>
  <box at="3.5 10 1" size="2 7 9" color="D" on="U"/>
  <line at="15 10 4" to="17 10 4" r="2" color="N" on="U"/>
  <box at="2 6 1" size="1 1 11" color="S" on="U"/>
  <box at="18 6 1" size="1 1 11" color="S" on="U"/>
  <box at="2 14 1" size="1 1 11" color="S" on="U"/>
  <box at="18 14 1" size="1 1 11" color="S" on="U"/>
  <box at="10 6 12" size="17 1 1" color="S" on="U"/>
  <box at="10 14 12" size="17 1 1" color="S" on="U"/>
  <box at="5 14 5" size="3 1 4" color="K" on="U"/>
  <box at="5 15 7" size="1 1 1" color="H" on="U"/>
  <line at="12 8 10" to="12 7 15" color="K" on="U"/>
  <!-- su carrello: ruote, pianale, cofano arancio, timone e ruotino -->
  <ellipsoid at="10 4 0" size="7 3 7" color="R" on="V"/>
  <ellipsoid at="10 16 0" size="7 3 7" color="R" on="V"/>
  <box at="10 10 3" size="15 11 1" color="K" on="V"/>
  <box at="12 14 6" size="7 1 1" color="o" on="V"/>
  <box at="12 14 8" size="7 1 1" color="o" on="V"/>
  <box at="10 10 4" size="15 9 8" color="O" on="V"/>
  <box at="5 15 6" size="3 1 4" color="K" on="V"/>
  <box at="5 16 8" size="1 1 1" color="H" on="V"/>
  <line at="2 10 3" to="0 10 3" color="K" on="V"/>
  <box at="1 10 0" size="1 1 3" color="S" on="V"/>
  <cylinder at="15 8 12" size="3 3 3" color="K" on="V"/>
  <all in="[XUV]" out="B"/>
  <!-- Seconda scelta: che cosa gli sta accanto -->
  <box at="0 0 0" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="L"/>
    <rule in="m" out="n"/>
    <rule in="m" out="F"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="LB" out="LL"/>
    <rule in="nB" out="nn"/>
    <rule in="FB" out="FF"/>
  </all>
  <ellipsoid at="10 4 0" size="13 3 5" color="T" on="L"/>
  <box at="10 4 5" size="1 1 1" color="S" on="L"/>
  <box at="18.5 8 0" size="2 3 5" color="J" on="n"/>
  <box at="18.5 12 0" size="2 3 5" color="J" on="n"/>
  <box at="18.5 8 5" size="1 1 1" color="K" on="n"/>
  <box at="18.5 12 5" size="1 1 1" color="K" on="n"/>
  <all in="[LnF]" out="B"/>
  <all in="m" out="B"/>
  <!-- La cassetta degli attrezzi, appoggiata dove capita sopra -->
  <one steps="1" in="B [YOEeK]" out="t *" symmetry="()"/>
  <all in="tB" out="tt" symmetry="(x)" steps="1"/>
  <all in="B t" out="t t" symmetry="()" steps="1"/>
</sequence>
