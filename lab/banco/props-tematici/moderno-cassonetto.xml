<!-- Cassonetto e raccolta differenziata (moderno): l'isola dei rifiuti su una platea di cemento. Il seme sceglie che cosa c'è (il
     cassonetto verde con le ruote e il coperchio, i tre bidoni colorati della differenziata, o la campana del vetro con un bidoncino),
     che cosa è stato lasciato lì (sacchi neri davanti, quanti e quali, scatoloni impilati o niente) e dove è rimasta una lattina. -->
<sequence values="BCKQqYAGgSEeNOmXUVLDnszw" size="20 20 20" symmetry="(xy)" name="Cassonetto">
  <color symbol="C" value="9a9a94" name="cemento"/>
  <color symbol="K" value="222428" name="gomma nera"/>
  <color symbol="Q" value="2f6a46" name="plastica verde"/>
  <color symbol="q" value="1f4a30" name="coperchio verde"/>
  <color symbol="Y" value="e8c428" name="plastica gialla"/>
  <color symbol="A" value="2e6cc8" name="plastica blu"/>
  <color symbol="G" value="5a9a3a" name="plastica verde chiaro"/>
  <color symbol="g" value="7c8086" name="plastica grigia"/>
  <color symbol="S" value="a8adb2" name="acciaio"/>
  <color symbol="E" value="b48a58" name="cartone"/>
  <color symbol="e" value="8a6638" name="cartone in ombra"/>
  <color symbol="N" value="2a2a30" name="sacco nero"/>
  <color symbol="O" value="d8d8d0" name="adesivo"/>
  <color symbol="w" value="d8342c" name="lattina"/>
  <color symbol="m" hidden="True" name="il dado"/>
  <color symbol="X" hidden="True" name="il cassonetto"/>
  <color symbol="U" hidden="True" name="tre bidoni"/>
  <color symbol="V" hidden="True" name="la campana del vetro"/>
  <color symbol="L" hidden="True" name="sacchi"/>
  <color symbol="D" hidden="True" name="scatoloni"/>
  <color symbol="n" hidden="True" name="niente"/>
  <color symbol="s" hidden="True" name="dove può stare un sacco"/>
  <color symbol="z" hidden="True" name="un sacco"/>
  <!-- La platea -->
  <box at="10 10 0" size="19 13 1" color="C"/>
  <!-- Il dado si scuote prima di decidere -->
  <box at="1 0 0" size="3 1 1" color="m"/>
  <prl steps="1" in="m" out="B"/>
  <!-- Prima scelta: che cosa c'è sulla platea -->
  <box at="0 0 0" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="X"/>
    <rule in="m" out="U"/>
    <rule in="m" out="V"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="XB" out="XX"/>
    <rule in="UB" out="UU"/>
    <rule in="VB" out="VV"/>
  </all>
  <!-- il cassonetto: ruote, cassa, coperchio, pedale e maniglie -->
  <box at="4 7 1" size="3 3 1" color="K" on="X"/>
  <box at="16 7 1" size="3 3 1" color="K" on="X"/>
  <box at="4 13 1" size="3 3 1" color="K" on="X"/>
  <box at="16 13 1" size="3 3 1" color="K" on="X"/>
  <box at="10 15 6" size="5 1 3" color="O" on="X"/>
  <box at="10 10 2" size="15 9 10" color="Q" on="X"/>
  <box at="10 10 12" size="17 11 1" color="q" on="X"/>
  <box at="10 10 13" size="13 7 1" color="q" on="X"/>
  <box at="10 15 2" size="3 1 1" color="S" on="X"/>
  <box at="2 10 9" size="1 5 1" color="S" on="X"/>
  <box at="18 10 9" size="1 5 1" color="S" on="X"/>
  <!-- tre bidoni della differenziata con i coperchi -->
  <cylinder at="5 10 1" size="5 5 12" color="Y" on="U"/>
  <cylinder at="10 10 1" size="5 5 13" color="A" on="U"/>
  <cylinder at="15 10 1" size="5 5 11" color="G" on="U"/>
  <cylinder at="5 10 13" size="6 6 1" color="K" on="U"/>
  <cylinder at="10 10 14" size="6 6 1" color="K" on="U"/>
  <cylinder at="15 10 12" size="6 6 1" color="K" on="U"/>
  <!-- la campana del vetro con le bocche e il gancio, e il bidoncino -->
  <box at="7 15 7" size="3 1 2" color="K" on="V"/>
  <box at="2 10 7" size="1 3 2" color="K" on="V"/>
  <cylinder at="7 10 1" size="11 11 6" color="G" on="V"/>
  <ellipsoid at="7 10 1" size="11 11 15" color="G" on="V"/>
  <box at="7 10 15" size="1 1 2" color="S" on="V"/>
  <box at="7 10 17" size="5 1 1" color="S" on="V"/>
  <cylinder at="15.5 10 1" size="5 5 9" color="g" on="V"/>
  <cylinder at="15.5 10 10" size="6 6 1" color="A" on="V"/>
  <all in="[XUV]" out="B"/>
  <!-- Seconda scelta: che cosa è stato lasciato lì -->
  <box at="0 0 0" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="L"/>
    <rule in="m" out="D"/>
    <rule in="m" out="n"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="LB" out="LL"/>
    <rule in="DB" out="DD"/>
    <rule in="nB" out="nn"/>
  </all>
  <!-- i sacchi: tre posti davanti, ognuno pieno o vuoto -->
  <ellipsoid at="4 17 1" size="5 4 5" color="s" on="L"/>
  <ellipsoid at="10 17 1" size="5 4 6" color="s" on="L"/>
  <ellipsoid at="16 17 1" size="5 4 4" color="s" on="L"/>
  <prl steps="1" in="s" out="z" p="0.03"/>
  <one steps="1" in="s" out="z"/>
  <all in="zs" out="zz" symmetry="(xyz)"/>
  <all in="s" out="B"/>
  <all in="z" out="N"/>
  <!-- gli scatoloni -->
  <box at="17 5.5 1" size="5 4 5" color="E" on="D"/>
  <box at="17 5.5 6" size="3 3 3" color="e" on="D"/>
  <box at="17 5.5 3" size="5 4 1" color="e" on="D"/>
  <all in="[LDn]" out="B"/>
  <all in="m" out="B"/>
  <!-- Una lattina abbandonata sulla platea, dove capita -->
  <one steps="1" in="B C" out="w *" symmetry="()"/>
  <all in="B w" out="w w" symmetry="()" steps="1"/>
</sequence>
