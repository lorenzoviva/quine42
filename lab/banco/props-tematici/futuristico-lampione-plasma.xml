<!-- Lampione al plasma (ambientazione futuristica, sidera): un fusto di grafite su uno zoccolo di ceramica bianca, con in cima i bracci
     che reggono le sfere di plasma ciano chiuse nel vetro e una punta magenta. Il seme sceglie quanto è alto il fusto, quanti bracci
     ha (da uno a quattro) e quanto è lungo ciascuno. -->
<sequence values="BWwGgCMVhkrPaAL" size="20 20 60" symmetry="(xy)" name="Lampione al plasma">
  <color symbol="W" value="eef1f5" name="ceramica bianca"/>
  <color symbol="w" value="c3c9d3" name="ceramica in ombra"/>
  <color symbol="G" value="353a42" name="grafite"/>
  <color symbol="g" value="565d68" name="grafite chiara"/>
  <color symbol="C" value="5ff0ff" name="plasma ciano" glow="True"/>
  <color symbol="M" value="ff3ec8" name="punta magenta" glow="True"/>
  <color symbol="V" value="9fd8e6" name="vetro"/>
  <color symbol="h" hidden="True" name="quote possibili"/>
  <color symbol="k" hidden="True" name="la quota scelta"/>
  <color symbol="r" hidden="True" name="il fusto che sale"/>
  <color symbol="P" value="353a42" name="fusto"/>
  <color symbol="a" hidden="True" name="dove può nascere un braccio"/>
  <color symbol="A" hidden="True" name="un braccio che si allunga"/>
  <color symbol="L" hidden="True" name="una sfera di plasma"/>
  <!-- The plinth -->
  <cylinder at="10 10 0" size="9 9 2" color="W"/>
  <cylinder at="10 10 2" size="5 5 2" color="w"/>
  <!-- La quota della cima: una fra 38 e 55 -->
  <box at="0 0 38" size="1 1 18" color="h"/>
  <one in="h" out="k" steps="1"/>
  <all in="h" out="B"/>
  <all in="kB" out="kk"/>
  <box at="10 10 4" size="1 1 1" color="r"/>
  <one steps="60" symmetry="()">
    <rule in="B r" out="r P"/>
  </one>
  <all in="k" out="B"/>
  <!-- I bracci: almeno uno, gli altri a caso -->
  <all in="Br" out="ar"/>
  <one in="a" out="A" steps="1"/>
  <prl in="a" out="A" p="0.5" steps="1"/>
  <all in="a" out="B"/>
  <all in="B r" out="M *" symmetry="()"/>
  <all in="r" out="P"/>
  <all in="PAB" out="*GA" steps="1"/>
  <all in="GAB" out="*GA" steps="2"/>
  <prl in="GAB" out="*GA" p="0.5" steps="3"/>
  <!-- Sotto la punta di ogni braccio la sfera di plasma nel vetro -->
  <all in="A B" out="* L" symmetry="()"/>
  <all in="L B" out="* L" symmetry="()" steps="3"/>
  <all in="A" out="G"/>
  <all in="BL" out="CL"/>
  <all in="L" out="C"/>
  <all in="C B" out="* V" symmetry="()" steps="1"/>
  <all in="V B" out="* g" symmetry="()" steps="1"/>
  <!-- Il fusto si ispessisce, con le costole chiare -->
  <all in="BP" out="gP" steps="1"/>
  <all in="P" out="G"/>
</sequence>
