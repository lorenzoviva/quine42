<!-- Scrivania con terminale (moderno): il piano di laminato dell'ufficio e il computer. Il seme sceglie come sta in piedi la scrivania
     (quattro gambe d'acciaio, la cassettiera a destra, o la cassettiera a sinistra con il pannello sul retro), che cosa c'è sopra (il
     vecchio terminale a tubo con lo schermo verde, due schermi piatti con il computer sotto, o il portatile con la lampada e le carte)
     e dove è rimasta la tazza. -->
<sequence values="BDdPKkSWGYuhmXUJLEnF" size="20 20 20" symmetry="(xy)" name="Scrivania">
  <color symbol="D" value="c9c4b6" name="laminato"/>
  <color symbol="d" value="8e8a80" name="bordo del piano"/>
  <color symbol="P" value="7a8088" name="acciaio"/>
  <color symbol="K" value="2a2c30" name="plastica nera"/>
  <color symbol="k" value="d8d2bc" name="plastica beige"/>
  <color symbol="S" value="64f0a0" name="schermo verde" glow="True"/>
  <color symbol="W" value="9cd8ff" name="schermo azzurro" glow="True"/>
  <color symbol="G" value="f4f2ea" name="carta"/>
  <color symbol="Y" value="ffe08a" name="lampadina" glow="True"/>
  <color symbol="u" value="c8402c" name="tazza"/>
  <color symbol="h" value="5a6a7a" name="cassettiera"/>
  <color symbol="m" hidden="True" name="il dado"/>
  <color symbol="X" hidden="True" name="quattro gambe"/>
  <color symbol="U" hidden="True" name="cassettiera a destra"/>
  <color symbol="J" hidden="True" name="cassettiera a sinistra"/>
  <color symbol="L" hidden="True" name="il terminale"/>
  <color symbol="E" hidden="True" name="due schermi"/>
  <color symbol="n" hidden="True" name="il portatile"/>
  <color symbol="F" hidden="True" name="la tazza"/>
  <!-- Il piano -->
  <box at="10 9 9" size="19 9 1" color="D"/>
  <box at="10 13 9" size="19 1 1" color="d"/>
  <!-- Il dado si scuote prima di decidere -->
  <box at="1 0 0" size="3 1 1" color="m"/>
  <prl steps="1" in="m" out="B"/>
  <!-- Prima scelta: come sta in piedi -->
  <box at="0 0 0" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="X"/>
    <rule in="m" out="U"/>
    <rule in="m" out="J"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="XB" out="XX"/>
    <rule in="UB" out="UU"/>
    <rule in="JB" out="JJ"/>
  </all>
  <box at="2 6 0" size="1 1 9" color="P" on="X"/>
  <box at="18 6 0" size="1 1 9" color="P" on="X"/>
  <box at="2 12 0" size="1 1 9" color="P" on="X"/>
  <box at="18 12 0" size="1 1 9" color="P" on="X"/>
  <box at="15.5 9 0" size="6 9 9" color="h" on="U"/>
  <box at="15.5 14 7" size="2 1 1" color="P" on="U"/>
  <box at="15.5 14 4" size="2 1 1" color="P" on="U"/>
  <box at="15.5 14 1" size="2 1 1" color="P" on="U"/>
  <box at="2 6 0" size="1 1 9" color="P" on="U"/>
  <box at="2 12 0" size="1 1 9" color="P" on="U"/>
  <box at="4.5 9 0" size="6 9 9" color="h" on="J"/>
  <box at="4.5 14 7" size="2 1 1" color="P" on="J"/>
  <box at="4.5 14 3" size="2 1 1" color="P" on="J"/>
  <box at="12 5 2" size="13 1 7" color="d" on="J"/>
  <box at="18 6 0" size="1 1 9" color="P" on="J"/>
  <box at="18 12 0" size="1 1 9" color="P" on="J"/>
  <all in="[XUJ]" out="B"/>
  <!-- Seconda scelta: che cosa c'è sopra -->
  <box at="0 0 0" size="1 1 1" color="m"/>
  <one steps="1">
    <rule in="m" out="L"/>
    <rule in="m" out="E"/>
    <rule in="m" out="n"/>
  </one>
  <all symmetry="(xyz)">
    <rule in="LB" out="LL"/>
    <rule in="EB" out="EE"/>
    <rule in="nB" out="nn"/>
  </all>
  <!-- il terminale a tubo e la tastiera -->
  <box at="8 12 11" size="7 1 5" color="S" on="L"/>
  <box at="8 8 10" size="9 7 7" color="k" on="L"/>
  <box at="8 7 17" size="5 3 1" color="k" on="L"/>
  <box at="8 12.5 10" size="9 2 1" color="k" on="L"/>
  <box at="15 11 10" size="2 3 1" color="k" on="L"/>
  <!-- due schermi piatti, la tastiera e il computer sotto -->
  <box at="6 9 13" size="5 1 4" color="W" on="E"/>
  <box at="14 9 13" size="5 1 4" color="W" on="E"/>
  <box at="6 8 12" size="7 1 6" color="K" on="E"/>
  <box at="14 8 12" size="7 1 6" color="K" on="E"/>
  <box at="6 8 10" size="3 3 1" color="K" on="E"/>
  <box at="14 8 10" size="3 3 1" color="K" on="E"/>
  <box at="6 8 11" size="1 1 1" color="K" on="E"/>
  <box at="14 8 11" size="1 1 1" color="K" on="E"/>
  <box at="10 11.5 10" size="9 2 1" color="K" on="E"/>
  <box at="10 9 0" size="3 7 9" color="K" on="E"/>
  <box at="10 13 6" size="1 1 1" color="W" on="E"/>
  <!-- il portatile, la lampada e le carte -->
  <box at="9 9 12" size="5 1 3" color="W" on="n"/>
  <box at="9 8 11" size="7 1 5" color="P" on="n"/>
  <box at="9 10.5 10" size="7 5 1" color="P" on="n"/>
  <box at="16 7 10" size="3 3 1" color="K" on="n"/>
  <line at="16 7 11" to="16 8 17" color="K" on="n"/>
  <line at="16 8 17" to="14 10 16" color="K" on="n"/>
  <box at="14 10 14" size="3 3 2" color="K" on="n"/>
  <box at="14 10 13" size="1 1 1" color="Y" on="n"/>
  <box at="3.5 10 10" size="4 5 2" color="G" on="n"/>
  <box at="3.5 10 12" size="3 4 1" color="G" on="n"/>
  <all in="[LEn]" out="B"/>
  <all in="m" out="B"/>
  <!-- La tazza, dove è rimasta sul piano -->
  <one steps="1" in="B D" out="F *" symmetry="()"/>
  <all in="F" out="u"/>
  <all in="B u" out="u u" symmetry="()" steps="1"/>
</sequence>
