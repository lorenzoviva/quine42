<!-- Lampione a gas in ottone, steampunk (Cantiere 2, Parte B): uno zoccolo di ghisa, il fusto sottile con il collare e la
     sbarra per la scala del lampionaio, in cima le lanterne di vetro ambrato acceso sotto un cappello d'ottone. Il seme sceglie quanto
     è alto il fusto e la testa: una lanterna sola in cima, due appese a un braccio o quattro appese a una croce. -->
<sequence values="BGPOALhkst" size="20 20 60" symmetry="(xy)" name="Lampione a gas">
  <color symbol="G" value="3b3a3f" name="ghisa"/>
  <color symbol="P" value="a8862f" name="ottone brunito"/>
  <color symbol="O" value="c9a13b" name="ottone"/>
  <color symbol="A" value="f2b54a" name="vetro ambrato acceso" glow="True"/>
  <color symbol="L" value="e8c66a" name="pomo lucido"/>
  <color symbol="h" hidden="True" name="altezze possibili"/>
  <color symbol="k" hidden="True" name="la quota scelta"/>
  <color symbol="s" hidden="True" name="la cima del fusto"/>
  <color symbol="t" hidden="True" name="la cima scelta"/>
  <!-- Lo zoccolo a gradini e la base scanalata -->
  <cylinder at="10 10 0" size="9 9 2" color="G"/>
  <cylinder at="10 10 2" size="7 7 2" color="G"/>
  <box at="10 10 4" size="3 3 8" color="G"/>
  <box at="10 10 12" size="1 1 48" color="P"/>
  <box at="10 10 20" size="3 3 1" color="O"/>
  <!-- L'altezza del fusto: dalla quota scelta in su sparisce -->
  <box at="0 0 30" size="1 1 21" color="h"/>
  <one in="h" out="k" steps="1"/>
  <all in="h" out="B"/>
  <all in="kB" out="kk"/>
  <all in="k[P]" out="kk"/>
  <all in="[BPk] k" out="k k"/>
  <all in="k" out="B"/>
  <!-- La testa, scelta dal seme -->
  <all in="B P" out="t P"/>
  <all in="t" out="s"/>
