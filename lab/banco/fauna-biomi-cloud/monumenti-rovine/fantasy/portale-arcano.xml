<!-- Portale arcano (Cantiere 8, aurora): cornice e basamento a caso; rune e cristalli a caso. -->
<sequence values="BSDFRXxPQ7890u123456z" symmetry="(xy)" name="Portale arcano">
  <color symbol="S" value="6a6478" name="pietra runica"/>
  <color symbol="D" value="45405a" name="pietra scura"/>
  <color symbol="F" value="a87aff" name="pellicola di luce" alpha="0.55"/>
  <color symbol="R" value="9ff0ff" name="rune" glow="True"/>
  <color symbol="X" value="d8b0ff" name="cristalli" glow="True"/>
  <color symbol="x" hidden="True" name="marcatore"/>
  <color symbol="P" hidden="True" name="marcatore"/>
  <color symbol="Q" hidden="True" name="marcatore"/>
  <color symbol="7" hidden="True" name="marcatore"/>
  <color symbol="8" hidden="True" name="marcatore"/>
  <color symbol="9" hidden="True" name="marcatore"/>
  <color symbol="0" hidden="True" name="marcatore"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="1" hidden="True" name="marcatore"/>
  <color symbol="2" hidden="True" name="marcatore"/>
  <color symbol="3" hidden="True" name="marcatore"/>
  <color symbol="4" hidden="True" name="marcatore"/>
  <color symbol="5" hidden="True" name="marcatore"/>
  <color symbol="6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <!-- scelta «basamento»: gradini | cerchio | rocce -->
  <box at="25 25 0" size="50 30 6" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: gradini -->
  <box at="25 25 0" size="44 22 2" color="D" on="1"/>
  <box at="25 25 2" size="38 16 2" color="D" on="1"/>
  <box at="25 25 4" size="32 12 1" color="S" on="1"/>
  <!--   2: cerchio -->
  <cylinder at="25 25 0" size="44 26 4" color="D" on="2"/>
  <!--   3: rocce -->
  <ellipsoid at="12 25 0" size="20 20 8" color="D" on="3"/>
  <ellipsoid at="38 25 0" size="20 20 8" color="D" on="3"/>
  <box at="25 25 0" size="30 12 3" color="D" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <!-- scelta «cornice»: arco tondo | arco a punta | anello ritto | obelischi con architrave -->
  <box at="25 25 3" size="50 14 47" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/><rule in="u" out="4"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/><rule in="4u" out="*4"/></all>
  <!--   1: arco tondo -->
  <ellipsoid at="25 25 4" size="22 1 36" color="F" on="1"/>
  <ellipsoid at="25 25 4" size="22 9 36" color="x" on="1"/>
  <box at="25 25 3" size="34 6 24" color="S" on="1"/>
  <ellipsoid at="25 25 4" size="34 6 44" color="S" on="1"/>
  <!--   2: arco a punta -->
  <cone at="25 25 3" size="22 1 38" color="F" on="2"/>
  <cone at="25 25 3" size="22 9 38" color="x" on="2"/>
  <cone at="25 25 3" size="34 6 48" color="S" on="2"/>
  <!--   3: anello ritto -->
  <ellipsoid at="25 25 6" size="28 1 28" color="F" on="3"/>
  <ellipsoid at="25 25 6" size="28 9 28" color="x" on="3"/>
  <ellipsoid at="25 25 2" size="38 6 36" color="S" on="3"/>
  <box at="25 25 3" size="16 8 4" color="D" on="3"/>
  <!--   4: obelischi con architrave -->
  <box at="25 25 4" size="20 1 30" color="F" on="4"/>
  <box at="13 25 3" size="5 6 34" color="S" on="4"/>
  <box at="37 25 3" size="5 6 34" color="S" on="4"/>
  <box at="25 25 36" size="34 7 4" color="D" on="4"/>
  <cone at="13 25 40" size="5 6 6" color="S" on="4"/>
  <cone at="37 25 40" size="5 6 6" color="S" on="4"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/><rule in="4" out="B"/></prl>
  <prl in="x" out="B"/>
  <prl in="BS" out="*R" p="0.05" steps="1"/>
  <!-- 9 cristalli a caso sulla faccia alta di D: ognuno con la sua direzione e la sua lunghezza -->
  <one in="B D" out="P *" steps="9"/>
  <all symmetry="()"><rule in="P" out="Q"/><rule in="P" out="7"/><rule in="P" out="8"/><rule in="P" out="9"/><rule in="P" out="0"/></all>
  <prl steps="7" symmetry="()"><rule in="B Q" out="Q X" p="0.75"/><rule in="*B 7*" out="*7 X*" p="0.75"/><rule in="B* *8" out="8* *X" p="0.75"/><rule in="*/B 9/*" out="*/9 X/*" p="0.75"/><rule in="B/* */0" out="0/* */X" p="0.75"/></prl>
  <prl><rule in="Q" out="X"/><rule in="7" out="X"/><rule in="8" out="X"/><rule in="9" out="X"/><rule in="0" out="X"/></prl>
  <prl in="BX" out="X*" p="0.3" steps="1"/>
</sequence>
