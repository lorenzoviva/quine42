<!-- Monumento di piazza (Cantiere 8, neapolis): monumento, vasca e lampioni a caso; piccioni a caso. -->
<sequence values="BSDOAILGWu#1#2#3#4#5#6z" symmetry="(xy)" name="Monumento di piazza">
  <color symbol="S" value="c8c2b4" name="travertino"/>
  <color symbol="D" value="8f8a80" name="pietra scura"/>
  <color symbol="O" value="5a7a6a" name="bronzo verde"/>
  <color symbol="A" value="6aa8c8" name="acqua" alpha="0.6"/>
  <color symbol="I" value="2e2e30" name="ghisa"/>
  <color symbol="L" value="fff2b0" name="lampade" glow="True"/>
  <color symbol="G" value="9a9aa4" name="piccioni"/>
  <color symbol="W" value="8a6a4a" name="panchine"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="#1" hidden="True" name="marcatore"/>
  <color symbol="#2" hidden="True" name="marcatore"/>
  <color symbol="#3" hidden="True" name="marcatore"/>
  <color symbol="#4" hidden="True" name="marcatore"/>
  <color symbol="#5" hidden="True" name="marcatore"/>
  <color symbol="#6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <box at="25 25 0" size="48 48 1" color="S"/>
  <!-- scelta «vasca»: tonda | quadra | panchine -->
  <box at="25 25 1" size="44 44 4" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: tonda -->
  <cylinder at="25 25 1" size="36 36 2" color="A" on="#1"/>
  <cylinder at="25 25 1" size="40 40 3" color="D" on="#1"/>
  <!--   2: quadra -->
  <box at="25 25 1" size="34 34 2" color="A" on="#2"/>
  <box at="25 25 1" size="38 38 3" color="D" on="#2"/>
  <!--   3: panchine -->
  <box at="25 7 1" size="18 3 2" color="W" on="#3"/>
  <box at="25 43 1" size="18 3 2" color="W" on="#3"/>
  <box at="7 25 1" size="3 18 2" color="W" on="#3"/>
  <box at="43 25 1" size="3 18 2" color="W" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <box at="25 25 1" size="14 14 4" color="D"/>
  <box at="25 25 5" size="10 10 8" color="S"/>
  <box at="25 25 13" size="12 12 2" color="D"/>
  <!-- scelta «monumento»: figura col braccio alzato | obelisco | colonna col capitello | scultura di cubi -->
  <box at="25 25 15" size="30 30 35" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/><rule in="u" out="#4"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/><rule in="#4u" out="*#4"/></all>
  <!--   1: figura col braccio alzato -->
  <line at="23 25 15" to="23 25 26" r="1.5" color="O" on="#1"/>
  <line at="27 25 15" to="27 25 26" r="1.5" color="O" on="#1"/>
  <box at="25 25 26" size="7 5 9" color="O" on="#1"/>
  <ellipsoid at="25 25 35" size="5 5 5" color="O" on="#1"/>
  <line at="28 25 33" to="32 25 44" r="1" color="O" on="#1"/>
  <line at="22 25 33" to="20 27 27" r="1" color="O" on="#1"/>
  <!--   2: obelisco -->
  <box at="25 25 15" size="6 6 26" color="D" on="#2"/>
  <cone at="25 25 41" size="6 6 6" color="O" on="#2"/>
  <!--   3: colonna col capitello -->
  <cylinder at="25 25 15" size="6 6 22" color="S" on="#3"/>
  <box at="25 25 37" size="9 9 2" color="D" on="#3"/>
  <ellipsoid at="25 25 39" size="6 6 6" color="O" on="#3"/>
  <!--   4: scultura di cubi -->
  <box at="24 26 15" size="7 7 7" color="O" on="#4"/>
  <box at="27 24 22" size="6 6 6" color="D" on="#4"/>
  <box at="23 25 28" size="6 6 6" color="O" on="#4"/>
  <box at="26 27 34" size="5 5 5" color="D" on="#4"/>
  <box at="25 24 39" size="4 4 4" color="O" on="#4"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/><rule in="#4" out="B"/></prl>
  <!-- scelta «lampioni»: ai quattro angoli | due | un candelabro -->
  <box at="25 25 1" size="50 50 28" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: ai quattro angoli -->
  <line at="3 3 1" to="3 3 20" r="0.5" color="I" on="#1"/>
  <box at="3 3 20" size="3 3 2" color="L" on="#1"/>
  <line at="47 3 1" to="47 3 20" r="0.5" color="I" on="#1"/>
  <box at="47 3 20" size="3 3 2" color="L" on="#1"/>
  <line at="3 47 1" to="3 47 20" r="0.5" color="I" on="#1"/>
  <box at="3 47 20" size="3 3 2" color="L" on="#1"/>
  <line at="47 47 1" to="47 47 20" r="0.5" color="I" on="#1"/>
  <box at="47 47 20" size="3 3 2" color="L" on="#1"/>
  <!--   2: due -->
  <line at="3 25 1" to="3 25 24" r="0.5" color="I" on="#2"/>
  <box at="3 25 24" size="3 3 3" color="L" on="#2"/>
  <line at="47 25 1" to="47 25 24" r="0.5" color="I" on="#2"/>
  <box at="47 25 24" size="3 3 3" color="L" on="#2"/>
  <!--   3: un candelabro -->
  <line at="25 2 1" to="25 2 22" r="1" color="I" on="#3"/>
  <line at="19 2 22" to="31 2 22" r="0.5" color="I" on="#3"/>
  <box at="19 2 23" size="2 2 2" color="L" on="#3"/>
  <box at="31 2 23" size="2 2 2" color="L" on="#3"/>
  <box at="25 2 23" size="2 2 2" color="L" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <!-- i piccioni si posano dove capita -->
  <one in="B [SDOW]" out="G *" steps="7"/>
  <prl in="BG" out="*G" p="0.5" steps="1"/>
</sequence>
