  <box at="12 20 14" size="25 40 16" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/><rule in="u" out="4"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/><rule in="4u" out="*4"/></all>
  <!--   1: cupola di sensori -->
  <ellipsoid at="12 20 13" size="9 9 7" color="K" on="1"/>
  <box at="12 24 17" size="3 1 2" color="E" on="1"/>
  <box at="12 20 19" size="1 1 1" color="P" on="1"/>
  <!--   2: rotori spiegati -->
  <line at="12 20 15" to="3 9 18" r="1" color="G" on="2"/>
  <line at="12 20 15" to="21 9 18" r="1" color="G" on="2"/>
  <line at="12 20 15" to="3 31 18" r="1" color="G" on="2"/>
  <line at="12 20 15" to="21 31 18" r="1" color="G" on="2"/>
  <ellipsoid at="3 9 19" size="8 8 1" color="K" on="2"/>
  <ellipsoid at="21 9 19" size="8 8 1" color="K" on="2"/>
  <ellipsoid at="3 31 19" size="8 8 1" color="K" on="2"/>
  <ellipsoid at="21 31 19" size="8 8 1" color="K" on="2"/>
  <!--   3: torretta -->
  <box at="12 18 14" size="8 8 4" color="K" on="3"/>
  <line at="12 20 16" to="12 34 16" r="1" color="G" on="3"/>
  <box at="12 18 18" size="1 1 1" color="P" on="3"/>
  <!--   4: antenna -->
  <cylinder at="12 14 14" size="3 3 9" color="G" on="4"/>
  <box at="12 14 23" size="1 1 1" color="P" on="4"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/><rule in="4" out="B"/></prl>
  <!-- l'antenna cresce a rami -->
  <one steps="5">
    <rule in="B P" out="P G" p="2"/>
    <rule in="B* *P" out="P* *G" p="1"/>
    <rule in="B*B *P*" out="P*P *G*" p="0.5"/>
  </one>
  <prl in="P" out="G"/>
  <prl in="BW" out="*L" p="0.015" steps="1"/>
</sequence>
