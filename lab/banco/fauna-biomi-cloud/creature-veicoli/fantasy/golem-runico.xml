<!-- Golem runico (Cantiere 8, aurora): gambe, tronco, braccia e testa a caso; rune e muschio in posti a caso. -->
<sequence values="BSDMRu123456" symmetry="(xy)" name="Golem runico">
  <color symbol="S" value="8a8778" name="pietra"/>
  <color symbol="D" value="5f5d52" name="pietra scura"/>
  <color symbol="M" value="5f8f3e" name="muschio"/>
  <color symbol="R" value="7fe0ff" name="rune" glow="True"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="1" hidden="True" name="marcatore"/>
  <color symbol="2" hidden="True" name="marcatore"/>
  <color symbol="3" hidden="True" name="marcatore"/>
  <color symbol="4" hidden="True" name="marcatore"/>
  <color symbol="5" hidden="True" name="marcatore"/>
  <color symbol="6" hidden="True" name="marcatore"/>
  <!-- scelta «gambe»: divaricate | al passo | in ginocchio -->
  <box at="10 7 0" size="20 15 11" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: divaricate -->
  <box at="5 7 0" size="5 6 10" color="D" on="1"/>
  <box at="15 7 0" size="5 6 10" color="D" on="1"/>
  <!--   2: al passo -->
  <box at="6 10 0" size="5 5 10" color="D" on="2"/>
  <box at="14 4 0" size="5 5 10" color="D" on="2"/>
  <box at="10 7 7" size="12 8 3" color="D" on="2"/>
  <!--   3: in ginocchio -->
  <box at="6 9 0" size="5 9 5" color="D" on="3"/>
  <box at="14 5 0" size="5 5 10" color="D" on="3"/>
  <box at="6 7 3" size="5 5 7" color="D" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <!-- scelta «tronco»: a blocco | a botte | a gradoni -->
  <box at="10 7 8" size="20 15 16" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: a blocco -->
  <box at="10 7 9" size="14 10 12" color="S" on="1"/>
  <!--   2: a botte -->
  <ellipsoid at="10 7 8" size="16 12 14" color="S" on="2"/>
  <!--   3: a gradoni -->
  <box at="10 7 9" size="10 9 5" color="S" on="3"/>
  <box at="10 7 13" size="14 11 5" color="S" on="3"/>
  <box at="10 7 17" size="17 12 4" color="S" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <!-- scelta «braccia»: abbassate | alzate | una avanti -->
  <box at="10 7 0" size="20 15 30" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: abbassate -->
  <box at="2 7 3" size="4 5 16" color="D" on="1"/>
  <box at="18 7 3" size="4 5 16" color="D" on="1"/>
  <box at="2 7 2" size="4 6 4" color="S" on="1"/>
  <box at="18 7 2" size="4 6 4" color="S" on="1"/>
  <!--   2: alzate -->
  <line at="3 7 18" to="2 7 27" r="2" color="D" on="2"/>
  <line at="17 7 18" to="18 7 27" r="2" color="D" on="2"/>
  <box at="2 7 26" size="5 5 4" color="S" on="2"/>
  <box at="18 7 26" size="5 5 4" color="S" on="2"/>
  <!--   3: una avanti -->
  <box at="2 7 3" size="4 5 16" color="D" on="3"/>
  <line at="17 8 18" to="17 13 16" r="2" color="D" on="3"/>
  <box at="17 13 14" size="5 3 5" color="S" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <!-- scelta «testa»: a masso | a cuneo | affondata -->
  <box at="10 7 18" size="20 15 12" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: a masso -->
  <ellipsoid at="10 7 20" size="8 8 8" color="D" on="1"/>
  <!--   2: a cuneo -->
  <cone at="10 7 20" size="9 8 9" color="D" on="2"/>
  <!--   3: affondata -->
  <box at="10 8 19" size="8 6 5" color="D" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <!-- rune incise a caso sulle facce, muschio sulle facce in alto -->
  <prl in="BS" out="*R" p="0.05" steps="1"/>
  <prl in="BD" out="*R" p="0.03" steps="1"/>
  <prl in="B S" out="* M" p="0.45" steps="1"/>
  <prl in="B D" out="* M" p="0.3" steps="1"/>
</sequence>
