<!-- Lupo dei boschi (Cantiere 8, aurora): andatura, corpo, testa e coda scelti a caso; chiazze scure sul dorso. -->
<sequence values="BFDWGKEu123456" symmetry="(xy)" name="Lupo dei boschi">
  <color symbol="F" value="6e7484" name="pelliccia grigia"/>
  <color symbol="D" value="393c47" name="dorso scuro"/>
  <color symbol="W" value="c8cbda" name="petto chiaro"/>
  <color symbol="G" value="5b606d" name="zampe" part="gamba"/>
  <color symbol="K" value="1b1c22" name="tartufo e unghie"/>
  <color symbol="E" value="e29c22" name="occhi ambrati"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="1" hidden="True" name="marcatore"/>
  <color symbol="2" hidden="True" name="marcatore"/>
  <color symbol="3" hidden="True" name="marcatore"/>
  <color symbol="4" hidden="True" name="marcatore"/>
  <color symbol="5" hidden="True" name="marcatore"/>
  <color symbol="6" hidden="True" name="marcatore"/>
  <!-- scelta «andatura»: fermo | al trotto | acquattato -->
  <box at="12 20 0" size="21 38 14" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: fermo -->
  <box at="9 13 0" size="3 3 1" color="K" on="1"/>
  <box at="15 13 0" size="3 3 1" color="K" on="1"/>
  <box at="9 27 0" size="3 3 1" color="K" on="1"/>
  <box at="15 27 0" size="3 3 1" color="K" on="1"/>
  <cylinder at="9 13 0" size="3 3 13" color="G" on="1"/>
  <cylinder at="15 13 0" size="3 3 13" color="G" on="1"/>
  <cylinder at="9 27 0" size="3 3 13" color="G" on="1"/>
  <cylinder at="15 27 0" size="3 3 13" color="G" on="1"/>
  <!--   2: al trotto -->
  <line at="9 32 0" to="9 27 12" r="1" color="G" on="2"/>
  <line at="15 23 0" to="15 27 12" r="1" color="G" on="2"/>
  <line at="9 9 0" to="9 13 12" r="1" color="G" on="2"/>
  <line at="15 17 0" to="15 13 12" r="1" color="G" on="2"/>
  <!--   3: acquattato -->
  <line at="5 31 0" to="9 27 12" r="1" color="G" on="3"/>
  <line at="19 31 0" to="15 27 12" r="1" color="G" on="3"/>
  <line at="5 10 0" to="9 13 12" r="1" color="G" on="3"/>
  <line at="19 10 0" to="15 13 12" r="1" color="G" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <!-- scelta «corporatura»: magro | massiccio | lungo -->
  <box at="12 20 6" size="20 34 18" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: magro -->
  <ellipsoid at="12 20 9" size="11 26 10" color="F" on="1"/>
  <!--   2: massiccio -->
  <ellipsoid at="12 20 8" size="15 28 13" color="F" on="2"/>
  <!--   3: lungo -->
  <ellipsoid at="12 19 9" size="12 31 10" color="F" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <ellipsoid at="12 20 8" size="8 20 4" color="W" on="F"/>
  <ellipsoid at="12 20 15" size="8 22 6" color="D" on="F"/>
  <!-- scelta «testa»: in avanti | all'ululato | a fiutare il suolo -->
  <box at="12 33 0" size="25 14 30" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: in avanti -->
  <ellipsoid at="12 33 14" size="8 8 8" color="F" on="1"/>
  <box at="12 38 15" size="4 4 3" color="F" on="1"/>
  <box at="12 39 16" size="2 1 2" color="K" on="1"/>
  <box at="10 37 19" size="1 1 1" color="E" on="1"/>
  <box at="14 37 19" size="1 1 1" color="E" on="1"/>
  <line at="12 29 15" to="12 32 18" r="2" color="F" on="1"/>
  <cone at="10 33 21" size="3 3 4" color="F" on="1"/>
  <cone at="14 33 21" size="3 3 4" color="F" on="1"/>
  <!--   2: all'ululato -->
  <ellipsoid at="12 31 20" size="7 7 8" color="F" on="2"/>
  <line at="12 32 25" to="12 35 28" r="1" color="F" on="2"/>
  <box at="12 36 29" size="1 1 1" color="K" on="2"/>
  <line at="12 29 15" to="12 31 22" r="2" color="F" on="2"/>
  <cone at="10 29 27" size="3 3 3" color="F" on="2"/>
  <cone at="14 29 27" size="3 3 3" color="F" on="2"/>
  <!--   3: a fiutare il suolo -->
  <ellipsoid at="12 35 1" size="7 8 6" color="F" on="3"/>
  <box at="12 38 1" size="3 3 3" color="F" on="3"/>
  <box at="12 39 1" size="2 1 2" color="K" on="3"/>
  <line at="12 29 14" to="12 34 5" r="2" color="F" on="3"/>
  <cone at="10 34 7" size="3 3 3" color="F" on="3"/>
  <cone at="14 34 7" size="3 3 3" color="F" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <!-- scelta «coda»: bassa | alta e arricciata | tesa -->
  <box at="12 4 0" size="25 10 30" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/></all>
  <!--   1: bassa -->
  <line at="12 8 15" to="12 3 6" r="1.5" color="F" on="1"/>
  <!--   2: alta e arricciata -->
  <line at="12 8 16" to="12 4 23" r="1.5" color="F" on="2"/>
  <ellipsoid at="12 3 22" size="4 4 4" color="W" on="2"/>
  <!--   3: tesa -->
  <line at="12 8 15" to="12 1 16" r="1.5" color="F" on="3"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/></prl>
  <!-- chiazze più scure sul pelo che guarda in alto -->
  <prl in="B F" out="* D" p="0.25" steps="1"/>
</sequence>
