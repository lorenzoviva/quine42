<!-- Camino geotermico (Cantiere 8, orichalcum): massi, camini e vapore a caso. -->
<sequence values="BRYOISLgPu123456z" symmetry="(xy)" name="Camino geotermico">
  <color symbol="R" value="6a5040" name="roccia calda"/>
  <color symbol="Y" value="d8c040" name="zolfo"/>
  <color symbol="O" value="b88a2e" name="ottone"/>
  <color symbol="I" value="3a3633" name="ferro"/>
  <color symbol="S" value="e8ecef" name="vapore"/>
  <color symbol="L" value="ff7a2a" name="brace" glow="True"/>
  <color symbol="g" hidden="True" name="marcatore"/>
  <color symbol="P" hidden="True" name="marcatore"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="1" hidden="True" name="marcatore"/>
  <color symbol="2" hidden="True" name="marcatore"/>
  <color symbol="3" hidden="True" name="marcatore"/>
  <color symbol="4" hidden="True" name="marcatore"/>
  <color symbol="5" hidden="True" name="marcatore"/>
  <color symbol="6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <cone at="25 25 0" size="30 30 12" color="R"/>
  <!-- 7 massi nascono a caso sul terreno accanto a ciò che c'è già (R) e crescono di lato e in alto -->
  <box at="25 25 0" size="44 44 1" color="g" on="B"/>
  <one in="Rg" out="*R" steps="7"/>
  <prl steps="9"><rule in="R[Bg]" out="*R" p="0.5"/><rule in="B R" out="R *" p="0.4"/></prl>
  <prl in="g" out="B"/>
  <!-- scelta «camini»: uno grande | tre in fila | fascio storto | cupola con valvole -->
  <box at="25 25 4" size="44 44 32" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/><rule in="u" out="4"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/><rule in="4u" out="*4"/></all>
  <!--   1: uno grande -->
  <cylinder at="25 25 6" size="10 10 22" color="O" on="1"/>
  <cylinder at="25 25 26" size="13 13 3" color="I" on="1"/>
  <box at="25 25 29" size="1 1 1" color="P" on="1"/>
  <box at="25 31 12" size="3 1 3" color="L" on="1"/>
  <!--   2: tre in fila -->
  <cylinder at="15 25 6" size="6 6 16" color="O" on="2"/>
  <cylinder at="25 25 6" size="7 7 22" color="O" on="2"/>
  <cylinder at="35 25 6" size="6 6 19" color="O" on="2"/>
  <box at="15 25 22" size="1 1 1" color="P" on="2"/>
  <box at="25 25 28" size="1 1 1" color="P" on="2"/>
  <box at="35 25 25" size="1 1 1" color="P" on="2"/>
  <line at="15 25 14" to="35 25 14" r="1" color="I" on="2"/>
  <!--   3: fascio storto -->
  <line at="22 25 6" to="16 20 26" r="2.5" color="O" on="3"/>
  <line at="28 25 6" to="33 30 30" r="2.5" color="O" on="3"/>
  <line at="25 28 6" to="26 33 22" r="2" color="I" on="3"/>
  <box at="16 20 28" size="1 1 1" color="P" on="3"/>
  <box at="33 30 32" size="1 1 1" color="P" on="3"/>
  <box at="26 33 24" size="1 1 1" color="P" on="3"/>
  <!--   4: cupola con valvole -->
  <ellipsoid at="25 25 6" size="20 20 18" color="O" on="4"/>
  <cylinder at="20 22 20" size="3 3 6" color="I" on="4"/>
  <cylinder at="30 28 20" size="3 3 8" color="I" on="4"/>
  <box at="20 22 26" size="1 1 1" color="P" on="4"/>
  <box at="30 28 28" size="1 1 1" color="P" on="4"/>
  <box at="25 35 10" size="4 1 4" color="L" on="4"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/><rule in="4" out="B"/></prl>
  <!-- il vapore sale dalle bocche a rami e si gonfia -->
  <one steps="14">
    <rule in="B P" out="P S" p="3"/>
    <rule in="B* *P" out="P* *S" p="2"/>
    <rule in="B*B *P*" out="P*P *S*" p="0.8"/>
  </one>
  <prl in="P" out="S"/>
  <prl in="BS" out="*S" p="0.5" steps="2"/>
  <prl in="B R" out="* Y" p="0.12" steps="1"/>
</sequence>
