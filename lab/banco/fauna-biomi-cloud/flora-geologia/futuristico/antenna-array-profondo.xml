<!-- Antenna dello spazio profondo (Cantiere 8, sidera): strumento a caso; antenne a rami e luci a caso. -->
<sequence values="BSWIKREPu123456z" symmetry="(xy)" name="Antenna dello spazio profondo">
  <color symbol="S" value="c8ccd0" name="piattaforma"/>
  <color symbol="W" value="eef2f4" name="parabole"/>
  <color symbol="I" value="5a6068" name="tralicci"/>
  <color symbol="K" value="2a3140" name="pannelli"/>
  <color symbol="R" value="ff4040" name="luci" glow="True"/>
  <color symbol="E" value="6af0ff" name="ricevitori" glow="True"/>
  <color symbol="P" hidden="True" name="marcatore"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="1" hidden="True" name="marcatore"/>
  <color symbol="2" hidden="True" name="marcatore"/>
  <color symbol="3" hidden="True" name="marcatore"/>
  <color symbol="4" hidden="True" name="marcatore"/>
  <color symbol="5" hidden="True" name="marcatore"/>
  <color symbol="6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <box at="25 25 0" size="44 44 3" color="S"/>
  <!-- scelta «strumento»: una parabola grande | tre parabole | pannelli a fase | torre a griglia -->
  <box at="25 25 3" size="50 50 47" color="u" on="B"/>
  <one steps="1"><rule in="u" out="1"/><rule in="u" out="2"/><rule in="u" out="3"/><rule in="u" out="4"/></one>
  <all symmetry="(xyz)"><rule in="1u" out="*1"/><rule in="2u" out="*2"/><rule in="3u" out="*3"/><rule in="4u" out="*4"/></all>
  <!--   1: una parabola grande -->
  <cylinder at="25 25 3" size="8 8 14" color="I" on="1"/>
  <ellipsoid at="25 25 15" size="40 40 22" color="W" on="1"/>
  <ellipsoid at="25 25 20" size="36 36 22" color="B" on="W"/>
  <line at="25 25 17" to="25 25 34" r="0.5" color="I" on="1"/>
  <box at="25 25 34" size="3 3 3" color="E" on="1"/>
  <!--   2: tre parabole -->
  <line at="12 14 3" to="12 14 32" r="0.5" color="I" on="2"/>
  <box at="12 14 32" size="1 1 2" color="E" on="2"/>
  <line at="12 14 3" to="12 14 22" r="1" color="I" on="2"/>
  <ellipsoid at="12 14 20" size="16 16 10" color="W" on="2"/>
  <ellipsoid at="12 14 23" size="14 14 10" color="B" on="W"/>
  <line at="38 14 3" to="38 14 32" r="0.5" color="I" on="2"/>
  <box at="38 14 32" size="1 1 2" color="E" on="2"/>
  <line at="38 14 3" to="38 14 22" r="1" color="I" on="2"/>
  <ellipsoid at="38 14 20" size="16 16 10" color="W" on="2"/>
  <ellipsoid at="38 14 23" size="14 14 10" color="B" on="W"/>
  <line at="25 38 3" to="25 38 32" r="0.5" color="I" on="2"/>
  <box at="25 38 32" size="1 1 2" color="E" on="2"/>
  <line at="25 38 3" to="25 38 22" r="1" color="I" on="2"/>
  <ellipsoid at="25 38 20" size="16 16 10" color="W" on="2"/>
  <ellipsoid at="25 38 23" size="14 14 10" color="B" on="W"/>
  <!--   3: pannelli a fase -->
  <box at="12 25 3" size="2 30 26" color="K" on="3"/>
  <box at="38 25 3" size="2 30 26" color="K" on="3"/>
  <box at="25 12 3" size="22 2 34" color="K" on="3"/>
  <box at="25 25 3" size="4 4 40" color="I" on="3"/>
  <box at="25 25 43" size="2 2 3" color="E" on="3"/>
  <!--   4: torre a griglia -->
  <line at="16 16 3" to="23 23 44" r="0.5" color="I" on="4"/>
  <line at="34 16 3" to="27 23 44" r="0.5" color="I" on="4"/>
  <line at="16 34 3" to="23 27 44" r="0.5" color="I" on="4"/>
  <line at="34 34 3" to="27 27 44" r="0.5" color="I" on="4"/>
  <box at="25 25 12" size="13 13 1" color="I" on="4"/>
  <box at="25 25 22" size="11 11 1" color="I" on="4"/>
  <box at="25 25 32" size="8 8 1" color="I" on="4"/>
  <ellipsoid at="25 25 42" size="12 12 6" color="W" on="4"/>
  <prl><rule in="u" out="B"/><rule in="1" out="B"/><rule in="2" out="B"/><rule in="3" out="B"/><rule in="4" out="B"/></prl>
  <!-- antenne che crescono a rami dalla piattaforma -->
  <one in="B S" out="P *" steps="4"/>
  <one steps="40"><rule in="B P" out="P I" p="3"/><rule in="B* *P" out="P* *I" p="0.6"/><rule in="B*B *P*" out="P*P *I*" p="0.4"/></one>
  <prl in="P" out="R"/>
  <prl in="BS" out="*R" p="0.02" steps="1"/>
</sequence>
