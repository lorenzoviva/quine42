<!-- Albero bioluminescente (Cantiere 8, sidera): radici a caso; tronco, rami, baccelli e viticci a caso. -->
<sequence values="BTUAFVRHewsnu#1#2#3#4#5#6z" symmetry="(xy)" name="Albero bioluminescente">
  <color symbol="T" value="2a2f4a" name="corteccia blu notte"/>
  <color symbol="U" value="2a2f4a" name="corteccia alta"/>
  <color symbol="A" value="3a4060" name="rami"/>
  <color symbol="F" value="5af0d0" name="baccelli" glow="True"/>
  <color symbol="V" value="b07aff" name="viticci" glow="True"/>
  <color symbol="R" value="1f2338" name="radici"/>
  <color symbol="H" hidden="True" name="marcatore"/>
  <color symbol="e" hidden="True" name="marcatore"/>
  <color symbol="w" hidden="True" name="marcatore"/>
  <color symbol="s" hidden="True" name="marcatore"/>
  <color symbol="n" hidden="True" name="marcatore"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="#1" hidden="True" name="marcatore"/>
  <color symbol="#2" hidden="True" name="marcatore"/>
  <color symbol="#3" hidden="True" name="marcatore"/>
  <color symbol="#4" hidden="True" name="marcatore"/>
  <color symbol="#5" hidden="True" name="marcatore"/>
  <color symbol="#6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <!-- scelta «radici»: aeree | a disco | a tripode -->
  <box at="20 20 0" size="40 40 12" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: aeree -->
  <line at="20 20 10" to="33 20 0" r="1" color="R" on="#1"/>
  <line at="20 20 10" to="28 30 0" r="1" color="R" on="#1"/>
  <line at="20 20 10" to="17 33 0" r="1" color="R" on="#1"/>
  <line at="20 20 10" to="8 26 0" r="1" color="R" on="#1"/>
  <line at="20 20 10" to="8 14 0" r="1" color="R" on="#1"/>
  <line at="20 20 10" to="17 7 0" r="1" color="R" on="#1"/>
  <line at="20 20 10" to="28 10 0" r="1" color="R" on="#1"/>
  <!--   2: a disco -->
  <cylinder at="20 20 0" size="22 22 2" color="R" on="#2"/>
  <cone at="20 20 2" size="12 12 8" color="R" on="#2"/>
  <!--   3: a tripode -->
  <line at="20 20 9" to="32 20 0" r="2" color="R" on="#3"/>
  <line at="20 20 9" to="14 30 0" r="2" color="R" on="#3"/>
  <line at="20 20 9" to="14 10 0" r="2" color="R" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <cylinder at="20 20 0" size="5 5 12" color="T"/>
  <box at="20 20 12" size="1 1 1" color="H"/>
  <!-- il tronco cammina verso l'alto, dritto o di sbieco -->
  <one steps="18"><rule in="B H" out="H T" p="4"/><rule in="B* *H" out="H* *T" p="3"/></one>
  <one steps="18"><rule in="B H" out="H U" p="4"/><rule in="B* *H" out="H* *U" p="3"/></one>
  <all in="TB" out="*T" steps="1"/>
  <all in="UB" out="*U" steps="1"/>
  <!-- 9 rami nati a caso sui fianchi di U: ognuno va dalla sua parte e a volte sale -->
  <one steps="9" symmetry="()"><rule in="UB" out="*e"/><rule in="BU" out="w*"/><rule in="U/B" out="*/s"/><rule in="B/U" out="n/*"/></one>
  <prl steps="12" symmetry="()"><rule in="eB" out="Ae" p="0.8"/><rule in="*B e*" out="*e A*" p="0.45"/><rule in="Bw" out="wA" p="0.8"/><rule in="B* *w" out="w* *A" p="0.45"/><rule in="s/B" out="A/s" p="0.8"/><rule in="*/B s/*" out="*/s A/*" p="0.45"/><rule in="B/n" out="n/A" p="0.8"/><rule in="B/* */n" out="n/* */A" p="0.45"/></prl>
  <!-- le punte diventano foglie, che si gonfiano a caso in tutte le direzioni -->
  <prl><rule in="e" out="F"/><rule in="w" out="F"/><rule in="s" out="F"/><rule in="n" out="F"/><rule in="H" out="F"/></prl>
  <prl in="FB" out="*F" p="0.6" steps="2" symmetry="(xyz)"/>
  <!-- i viticci pendono accesi -->
  <one in="F B" out="* V" steps="14"/>
  <prl in="V B" out="V V" p="0.8" steps="16"/>
</sequence>
