<!--
VILLETTA CON GIARDINO: a country house.
PARTS
  x/k/r  main body, two storeys: living room below, bedrooms above; k its walls
  i/j    stair strip against a body wall, open above (u); front zone of 4+ rows stays free
  n/m    door of the kitchen wing: in a side wall (L plan) or in the back wall (T plan)
  h/l    low wing, one storey a little taller than the porch: the kitchen, 4+ cells deep
  P/p    porch across the front of the body (G: flat wooden roof, o posts);
         p is the passage in front of the door, left uncovered
  D/v    front door on the axis, hall behind it
  V      gravel path straight to the front edge
  O/t/S  hedge: starts beside the path, runs along the edge until a random stop,
         two cells thick; scattered bushes S in the open garden
  J/I    stone troughs to jump over, X chimney on a free wall
SEEDS CHANGE: depth of the body (and width at the large size), the side or back of the wing
  and its size, wall and direction of the stair, length of the hedge, bushes, troughs, chimney.
-->
<sequence values="BNE" symmetry="(xy)" ground="E" origin="bottom">
  <map scale="1/4 1/4 1/4" values="BNESgzxabckvDnmqhlPpVJXrofRFCHTIMyuijOtG">
    <rule in="E" out="E"/><rule in="N" out="N"/>

    <!-- ===== A. COMPOSITION ===== -->
    <prl in="***/*E*/***" out="***/*z*/***"/>
    <prl in="Ez" out="*g" steps="1"/>

    <!-- the body -->
    <all in="Nz" out="*a" symmetry="(x)" steps="1"/>
    <all in="z/N" out="b/*" symmetry="()" steps="1"/>
    <all in="N/z" out="*/c" symmetry="()" steps="1"/>
    <all in="[Nx]az" out="*xa" symmetry="(x)" steps="4"/>
    <prl symmetry="(x)" steps="2"><rule in="xazzzzzz" out="*xa*****" p="0.5"/></prl>
    <all in="z/b/[Nx]" out="b/x/*" symmetry="()" steps="3"/>
    <prl symmetry="()" steps="2"><rule in="z/b/x" out="b/x/*" p="0.5"/></prl>
    <all in="[Nx]/c/z" out="*/x/c" symmetry="()" steps="3"/>
    <prl symmetry="()" steps="1"><rule in="x/c/z" out="*/x/c" p="0.5"/></prl>
    <prl><rule in="a" out="x"/><rule in="b" out="x"/><rule in="c" out="x"/></prl>
    <all in="[Nx]z/*[Nx]" out="*x/**"/>
    <all in="xz" out="k*"/>

    <!-- hall and front door -->
    <all in="N/x" out="*/v" symmetry="()" steps="1"/>
    <all in="v/x" out="*/v" symmetry="()"/>
    <all in="v/k" out="*/D" symmetry="()"/>
    <all in="kDk" out="DDD" symmetry="()" steps="1"/>

    <!-- the stair strip: against a wall, 2 free cells before, 1 after -->
    <one in="kkkkkkkk/xxxxxxxx/xxxxxxxx/xxxxxxxx" out="********/**ijjjj*/**ijjjj*/**ijjjj*" steps="1"/>

    <!-- the kitchen door: side wall or back wall, 3 free rows behind, 5 free cells outside -->
    <one symmetry="(x)" steps="1">
      <rule in="xxxkzzzzz/xxxkzzzzz/xxxkzzzzz/xxxkzzzzz/xxxkzzzzz" out="*********/*********/***nm****/*********/*********"/>
      <rule in="zzzzz/zzzzz/zzzzz/zzzzz/zzzzz/kkkkk/xxxxx/xxxxx/xxxxx" out="*****/*****/*****/*****/**m**/**n**/*****/*****/*****"/>
    </one>
    <all in="k/n/k" out="n/n/n" steps="1"/>

    <!-- the wing -->
    <all in="mz" out="*q" steps="1"/>
    <all in="[mh]qz" out="*hq" steps="3"/>
    <prl steps="2"><rule in="hqz" out="*hq" p="0.5"/></prl>
    <prl><rule in="q" out="h"/><rule in="m" out="h"/></prl>
    <all in="hz/*h" out="*h/**"/>

    <!-- porch -->
    <all in="[kD]/z" out="*/P" symmetry="()" steps="1"/>
    <all in="P/z" out="*/P" symmetry="()" steps="2"/>

    <all in="h[zgSP]" out="l*"/>

    <!-- uncovered passage and path -->
    <all in="D/P" out="*/p" symmetry="()"/>
    <all in="p/P" out="*/p" symmetry="()"/>
    <all in="p/[zg]" out="*/V" symmetry="()"/>
    <all in="V/[zgE]" out="*/V" symmetry="()"/>

    <prl in="z" out="g"/>

    <!-- the hedge -->
    <one steps="2" symmetry="()">
      <rule in="E/g" out="O/*"/>
      <rule in="Eg" out="O*"/>
      <rule in="gE" out="*O"/>
    </one>
    <prl in="VE" out="*t"/>
    <all in="tE" out="St"/>
    <prl><rule in="t" out="S"/><rule in="O" out="g"/><rule in="E" out="g"/></prl>
    <prl in="Sg" out="*S" steps="1"/>

    <!-- troughs, bushes -->
    <one in="ggggggg/ggggggg/ggggggg/ggggggg/ggggggg" out="*******/*******/**JJ***/*******/*******" steps="3"/>
    <prl steps="1"><rule in="gggggg/gggggg/gggggg/gggggg/gggggg/gggggg" out="******/******/**SS**/**SS**/******/******" p="0.03"/></prl>

    <!-- porch posts -->
    <all in="Pg/gg" out="o*/**" symmetry="(x)"/>
    <all in="Pp/gV" out="o*/**" symmetry="(x)"/>

    <prl in="x" out="r"/>
    <prl><rule in="v" out="r"/><rule in="N" out="r"/></prl>
    <one in="[rij]kg" out="*Xg" steps="1"/>

    <!-- ===== B. HEIGHTS ===== -->
    <all in="B [ij]" out="u *" steps="1" symmetry="()"/>
    <all in="B u" out="u *" steps="15" symmetry="()"/>
    <all in="B u" out="C *" steps="1" symmetry="()"/>

    <all in="B r" out="r f" steps="1" symmetry="()"/>
    <all in="B r" out="r R" steps="7" symmetry="()"/>
    <all in="B r" out="r F" steps="1" symmetry="()"/>
    <all in="B r" out="r R" steps="8" symmetry="()"/>
    <prl in="r" out="C"/>

    <all in="B h" out="h f" steps="1" symmetry="()"/>
    <all in="B h" out="h R" steps="8" symmetry="()"/>
    <prl in="h" out="C"/>

    <all in="B P" out="P T" steps="1" symmetry="()"/>
    <all in="B P" out="P H" steps="7" symmetry="()"/>
    <prl in="P" out="G"/>
    <all in="B o" out="o *" steps="7" symmetry="()"/>
    <all in="B o" out="G *" steps="1" symmetry="()"/>

    <all in="B l" out="l *" steps="2" symmetry="()"/>
    <all in="B l" out="M *" steps="1" symmetry="()"/>
    <all in="B M" out="M *" steps="1" symmetry="()"/>
    <all in="B M" out="l *" steps="1" symmetry="()"/>
    <all in="B l" out="l *" steps="3" symmetry="()"/>
    <all in="B l" out="C *" steps="1" symmetry="()"/>

    <all in="B k" out="k *" steps="2" symmetry="()"/>
    <all in="B k" out="M *" steps="1" symmetry="()"/>
    <all in="B M" out="M *" steps="1" symmetry="()"/>
    <all in="B M" out="k *" steps="1" symmetry="()"/>
    <all in="B k" out="k *" steps="6" symmetry="()"/>
    <all in="B k" out="M *" steps="1" symmetry="()"/>
    <all in="B M" out="M *" steps="1" symmetry="()"/>
    <all in="B M" out="k *" steps="1" symmetry="()"/>
    <all in="B k" out="k *" steps="2" symmetry="()"/>

    <all in="B D" out="D f" steps="1" symmetry="()"/>
    <all in="B D" out="D R" steps="7" symmetry="()"/>
    <all in="B D" out="D k" steps="8" symmetry="()"/>
    <prl in="D" out="k"/>
    <all in="B n" out="n f" steps="1" symmetry="()"/>
    <all in="B n" out="n R" steps="7" symmetry="()"/>
    <all in="B n" out="n k" steps="8" symmetry="()"/>
    <prl in="n" out="k"/>
    <all in="B k" out="C *" steps="1" symmetry="()"/>

    <all in="B X" out="X *" symmetry="()"/>
    <all in="B S" out="S *" steps="2" symmetry="()"/>
    <all in="B J" out="I *" steps="1" symmetry="()"/>

    <prl in="*[BH]/[BH]M" out="**/*k"/>
    <prl in="[BH]M" out="*y"/>
    <prl in="M" out="k"/>
    <all symmetry="()"><rule in="yy yy" out="yk yk"/><rule in="y/y y/y" out="y/k y/k"/></all>

    <!-- ===== C. FULL SCALE ===== -->
    <map scale="4 4 4" values="BAWFCZLSgVJwKQseUYG">
      <rule in="S" out="SSSS/SSSS/SSSS/SSSS SSSS/SSSS/SSSS/SSSS SSSS/SSSS/SSSS/SSSS SSSS/SSSS/SSSS/SSSS"/>
      <rule in="g" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB gggg/gggg/gggg/gggg"/>
      <rule in="V" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB VVVV/VVVV/VVVV/VVVV"/>
      <rule in="J" out="JJJJ/JJJJ/JJJJ/JJJJ JJJJ/JJJJ/JJJJ/JJJJ JJJJ/JJJJ/JJJJ/JJJJ JJJJ/JJJJ/JJJJ/JJJJ"/>
      <rule in="I" out="BBBB/BBBB/BBBB/BBBB JJJJ/JwwJ/JwwJ/JJJJ JJJJ/JJJJ/JJJJ/JJJJ JJJJ/JJJJ/JJJJ/JJJJ"/>
      <rule in="f" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="T" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB ZZZZ/ZZZZ/ZZZZ/ZZZZ"/>
      <rule in="p" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB ZZZZ/ZZZZ/ZZZZ/ZZZZ"/>
      <rule in="i" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB ssss/ssss/ssss/ssss"/>
      <rule in="j" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB eeee/eeee/eeee/eeee"/>
      <rule in="R" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB"/>
      <rule in="H" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB"/>
      <rule in="u" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB"/>
      <rule in="F" out="BBBB/BBBB/BBBB/BBBB FFFF/FFFF/FFFF/FFFF FFFF/FFFF/FFFF/FFFF FFFF/FFFF/FFFF/FFFF"/>
      <rule in="C" out="CCCC/CCCC/CCCC/CCCC FFFF/FFFF/FFFF/FFFF FFFF/FFFF/FFFF/FFFF FFFF/FFFF/FFFF/FFFF"/>
      <rule in="G" out="GGGG/GGGG/GGGG/GGGG ZZZZ/ZZZZ/ZZZZ/ZZZZ ZZZZ/ZZZZ/ZZZZ/ZZZZ ZZZZ/ZZZZ/ZZZZ/ZZZZ"/>
      <rule in="k" out="WWWW/WWWW/WWWW/WWWW WWWW/WWWW/WWWW/WWWW WWWW/WWWW/WWWW/WWWW WWWW/WWWW/WWWW/WWWW"/>
      <rule in="l" out="WWWW/WWWW/WWWW/WWWW WWWW/WWWW/WWWW/WWWW WWWW/WWWW/WWWW/WWWW WWWW/WWWW/WWWW/WWWW"/>
      <rule in="y" out="ZLLZ/LLLL/LLLL/ZLLZ ZLLZ/LLLL/LLLL/ZLLZ ZLLZ/LLLL/LLLL/ZLLZ ZLLZ/LLLL/LLLL/ZLLZ"/>
      <rule in="o" out="BBBB/BZZB/BZZB/BBBB BBBB/BZZB/BZZB/BBBB BBBB/BZZB/BZZB/BBBB BBBB/BZZB/BZZB/BBBB"/>
      <rule in="X" out="KKKK/KKKK/KKKK/KKKK KKKK/KKKK/KKKK/KKKK KKKK/KKKK/KKKK/KKKK KKKK/KKKK/KKKK/KKKK"/>

      <all in="BBB sse" out="UY* ***" steps="1"/>
      <all in="*BB *B* UY*" out="*UY *Q* QQ*" steps="17"/>
      <all in="Q B" out="* Q" symmetry="()"/>

      <prl steps="12" symmetry="()">
        <rule in="***/*B*/*** *[CWK]*/[CWK]C[CWK]/*[CWK]*" out="***/*C*/*** ***/***/***"/>
      </prl>

      <prl><rule in="s" out="A"/><rule in="e" out="A"/><rule in="Y" out="Q"/><rule in="U" out="Q"/></prl>
    </map>
  </map>
