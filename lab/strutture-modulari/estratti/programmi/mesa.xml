  <!-- 1. the massing -->
  <sequence>
  <union symbol="~" values="SOUY"/>
  <!-- the front on the main street: small footprints whose front row touches the street, one at a time at random, a yard around them at
       once (so they never touch); then, fewer, some set back -->
  <markov>
    <all>
      <rule in="hU" out="*Y"/>
      <rule in="h*/*U" out="**/*Y"/>
    </all>
    <one>
      <rule in="SSSSS/~UUU~/~UUU~/~~~~~" out="*****/*hhh*/*hhh*/*****" p="1"/>
      <rule in="SSSS/~UU~/~UU~/~~~~" out="****/*hh*/*hh*/****" p="1"/>
    </one>
  </markov>
  <markov>
    <all>
      <rule in="hU" out="*Y"/>
      <rule in="h*/*U" out="**/*Y"/>
    </all>
    <one>
      <rule in="~~~~/~UU~/~UU~/~~~~" out="****/*hh*/*hh*/****" p="1"/>
    </one>
  </markov>
  <!-- the height of every building: none (the lot stays empty), one, two, three storeys -->
  <markov>
    <all>
      <rule in="zh" out="zz"/>
      <rule in="ah" out="aa"/>
      <rule in="bh" out="bb"/>
      <rule in="ch" out="cc"/>
    </all>
    <one>
      <rule in="h" out="z" p="0.3"/>
      <rule in="h" out="a" p="0.35"/>
      <rule in="h" out="b" p="0.25"/>
      <rule in="h" out="c" p="0.1"/>
    </one>
  </markov>
  <prl>
    <rule in="Z a" out="R H"/>
    <rule in="Z Z b" out="R B H"/>
    <rule in="Z Z Z c" out="R B B H"/>
  </prl>
  <prl>
    <rule in="U" out="S"/>
    <rule in="O" out="S"/>
    <rule in="Y" out="S"/>
    <rule in="z" out="S"/>
  </prl>
  </sequence>
  <!-- 2. the wave over the set: a bay a cell, its signature and, above it, the state the stitching starts from -->
  <wfc set="mesa/struttura-locanda" stage="sig" tries="100"/>
