<!-- ANIMAZIONE CICLICA "TRANSMETTE" (8 frame)                         -->
<!-- Scorrimento continuo della telemetria dati sul maxischermo curvo  -->
<!-- e lampeggio coordinato stroboscopico dei fari d'ostacolo          -->
<!-- ================================================================= -->
<animation name="trasmette" frames="8">
  <sequence>
    <!-- 1. Scorrimento dati orizzontale continuo su maxischermo (1..8) -->
    <all in="1" out="x"/>
    <all in="2" out="1"/>
    <all in="3" out="2"/>
    <all in="4" out="3"/>
    <all in="5" out="4"/>
    <all in="6" out="5"/>
    <all in="7" out="6"/>
    <all in="8" out="7"/>
    <all in="x" out="8"/>

    <!-- 2. Lampeggio stroboscopico fari d'ostacolo torre (j, k, l, p, q, r, t, u) -->
    <all in="j" out="y"/>
    <all in="k" out="j"/>
    <all in="l" out="k"/>
    <all in="p" out="l"/>
    <all in="q" out="p"/>
    <all in="r" out="q"/>
    <all in="t" out="r"/>
    <all in="u" out="t"/>
    <all in="y" out="u"/>
  </sequence>
</animation>
