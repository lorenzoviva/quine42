  <map scale="1/4 1/4 1/4" values="BNEaxWOTtGKkvrfRFCsedPpcijunbhHwzIlog">
    <rule in="E" out="E"/>
    <rule in="N" out="N"/>
    <!-- A. composition at a quarter of the scale: a cell is 4 voxels -->
    <!-- the lot: z where the courtyard may grow, five cells from the edge (walls and towers take the rest) -->
    <prl in="***/*E*/***" out="***/*z*/***"/>
    <prl in="Ez" out="*E" steps="4"/>


      <!-- the courtyard: a rectangle with random sides around the centre -->
      <all in="Nz" out="*a" steps="1"/>
      <!-- <all in="zzz/zNz/zzz" out="zzz/zaz/zzz" steps="1"/> -->
      <!-- (each arm goes on until it stops at random, or seven cells from the edge of the lot: the fort is as large as its box) -->
      <markov>
        <prl in="a" out="l" p="0.035"/>
        <all in="[Nx]azzzzzzz" out="*xa******"/>
      </markov>
      <prl in="l" out="a"/>
      <prl in="a" out="A"/>
      <all in="[Nx]z/*[Nx]" out="*x/**"/>

    <all in="Az" out="*a" steps="1"/>
      <!-- <all in="zzz/zNz/zzz" out="zzz/zaz/zzz" steps="1"/> -->
      <!-- (each arm goes on until it stops at random, or seven cells from the edge of the lot: the fort is as large as its box) -->
      <markov>
        <prl in="a" out="l" p="0.035"/>
        <all in="[Ax]azzzzzzz" out="*xa******"/>
              <all in="[Ax]z/*[Ax]" out="*x/**"/>

      </markov>
      
      <prl in="l" out="z"/>
      <prl in="a" out="x"/>
      <prl in="A" out="x"/>
      <!-- removes corridors smaller than 6 -->
      <all steps="1" in="xzx" out="xxx"/>
      <all steps="1" in="xzzx" out="xxxx"/>
      <all steps="1" in="xzzzx" out="xxxxx"/>
      <all steps="1" in="xzzzzx" out="xxxxxx"/>
      <all steps="1" in="xzzzzzx" out="xxxxxxx"/>

