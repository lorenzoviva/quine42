<!--
Drone logistico volante porta-dati (corona): corriere aereo autonomo per il trasporto di file e archivi tra gli edifici della corona.
Scatola aggiornata: 10 × 10 × 8 voxel (drone centrato con offset +1 su X e +1 su Y).
-->
<sequence values="BWwMmDSPVsIabcd#1#2#3#4GexyXYZfg" size="10 10 8" symmetry="()" name="Drone">
  <!-- Structural materials: aerodynamic white ceramic and dark cybernetic titanium -->
  <color symbol="W" value="fff1e8" name="cyber-ceramica bianca scocca"/>
  <color symbol="w" value="d8d0c8" name="sfumatura e biselli scocca chiara"/>
  <color symbol="M" value="20222a" name="titanio grafite scuro telaio"/>
  <color symbol="m" value="2e323f" name="titanio secondario biselli e alette"/>
  <color symbol="D" value="141418" name="carbonio ultra-scuro bracci"/>

  <!-- Mechanics, landing gear, arms and chrome finishes -->
  <color symbol="S" value="83769c" name="cromo satinato montanti carrello e bracci"/>
  <color symbol="s" value="c2c3c7" name="argento cromo lucido pinze e antenna"/>
  <color symbol="P" value="3a3a40" name="pattini carrello grafite anti-usura"/>

  <!-- Optical bay, visor and expressive sensor lenses -->
  <color symbol="V" value="1c2a3a" name="vano ottico vetro scuro visore"/>
  <color symbol="I" value="00ffff" glow="True" name="lente sensore occhio ciano"/>

  <!-- Four cyan plasma phases for the rotors' rotation (glow="True") -->
  <color symbol="a" value="ffffff" glow="True" name="lama plasma bianco-ciano laser"/>
  <color symbol="b" value="00ffff" glow="True" name="lama neon ciano puro"/>
  <color symbol="c" value="05d9e8" glow="True" name="lama neon ciano elettrico"/>
  <color symbol="d" value="29adff" glow="True" name="lama plasma azzurro cobalto"/>

  <!-- Four energy phases for the amber/gold data packet (glow="True") -->
  <color symbol="#1" value="ffa300" glow="True" name="flusso dati ambra dorata"/>
  <color symbol="#2" value="ffec27" glow="True" name="pacchetto dati oro brillante"/>
  <color symbol="#3" value="ffe27a" glow="True" name="picco dati bianco-oro"/>
  <color symbol="#4" value="ff7700" glow="True" name="plasma dati arancio denso"/>
  <color symbol="G" value="d8a878" name="staffa ambra isolante pacchetto"/>

  <!-- Telemetry and navigation beacon on top -->
  <color symbol="e" value="afe0e4" name="beacon navigazione spento"/>
  <color symbol="f" value="05e684" glow="True" name="beacon navigazione verde"/>
  <color symbol="g" value="ec4670" glow="True" name="beacon navigazione rosso"/>

  <!-- Animation buffers and stochastic markers for different seeds -->
  <color symbol="x" hidden="True" name="buffer animazione rotori"/>
  <color symbol="y" hidden="True" name="buffer animazione pacchetto dati"/>
  <color symbol="X" hidden="True" name="marker quantistico pacchetto dati"/>
  <color symbol="Y" hidden="True" name="marker circuito pacchetto dati"/>
  <color symbol="Z" hidden="True" name="marker carenatura dorsale"/>

  <!-- ======================================================== -->
  <!-- 1. SKID LANDING GEAR AND STRUTS (z = 0..1)               -->
  <!-- ======================================================== -->
  <!-- Left skid on the ground -->
  <box at="2 4.5 0" size="1 4 1" color="P"/>
  <box at="2 2 1" size="1 1 1" color="M"/>
  <box at="2 7 1" size="1 1 1" color="M"/>
  <box at="2 3 1" size="1 1 1" color="S"/>
  <box at="2 6 1" size="1 1 1" color="S"/>

  <!-- Right skid on the ground -->
  <box at="7 4.5 0" size="1 4 1" color="P"/>
  <box at="7 2 1" size="1 1 1" color="M"/>
  <box at="7 7 1" size="1 1 1" color="M"/>
  <box at="7 3 1" size="1 1 1" color="S"/>
  <box at="7 6 1" size="1 1 1" color="S"/>

  <!-- ======================================================== -->
  <!-- 2. CHROME CARGO GRIPPERS (z = 1..2)                      -->
  <!-- ======================================================== -->
  <box at="3 4.5 1" size="1 2 1" color="s"/>
  <box at="3 4.5 2" size="1 2 1" color="s"/>
  <box at="6 4.5 1" size="1 2 1" color="s"/>
  <box at="6 4.5 2" size="1 2 1" color="s"/>

  <!-- ======================================================== -->
  <!-- 3. CENTRAL GLOWING DATA PACKET (z = 0..1, x=4..5)        -->
  <!-- ======================================================== -->
  <!-- Lower layer of the packet (z=1) -->
  <box at="4 4 1" size="1 1 1" color="#3"/>
  <box at="5 4 1" size="1 1 1" color="#4"/>
  <box at="4 5 1" size="1 1 1" color="G"/>
  <box at="5 5 1" size="1 1 1" color="#1"/>

  <!-- Upper layer of the packet (z=2) -->
  <box at="4 4 2" size="1 1 1" color="#1"/>
  <box at="5 4 2" size="1 1 1" color="#2"/>
  <box at="4 5 2" size="1 1 1" color="X"/>
  <box at="5 5 2" size="1 1 1" color="Y"/>

  <!-- ======================================================== -->
  <!-- 4. VENTRAL DOCKING BAY AND CENTRAL HULL (z = 2)          -->
  <!-- ======================================================== -->

  <!-- ======================================================== -->
  <!-- 5. CENTRAL FUSELAGE AND OPTICAL VISOR (z = 3)            -->
  <!-- ======================================================== -->
  <!-- Central body in white ceramic -->
  <box at="4.5 4.5 3" size="2 2 1" color="W"/>

  <!-- Front optical visor (+y, y=6) with cyan sensor eyes -->
  <box at="4 6 3" size="1 1 1" color="I"/>
  <box at="5 6 3" size="1 1 1" color="I"/>
  <box at="4 5 3" size="1 1 1" color="V"/>
  <box at="5 5 3" size="1 1 1" color="V"/>

  <!-- Heat vent and rear exhaust (-y, y=3) -->
  <box at="4 3 3" size="1 1 1" color="m"/>
  <box at="5 3 3" size="1 1 1" color="m"/>

  <!-- Small diagonal arms supporting the nacelles at height z=3 -->
  <!-- Front-Left -->
  <box at="3 6 3" size="1 1 1" color="S"/>
  <box at="2 7 3" size="1 1 1" color="D"/>
  <box at="1 7 3" size="1 1 1" color="m"/>
  <box at="1 8 3" size="1 1 1" color="m"/>

  <!-- Front-Right -->
  <box at="6 6 3" size="1 1 1" color="S"/>
  <box at="7 7 3" size="1 1 1" color="D"/>
  <box at="8 7 3" size="1 1 1" color="m"/>
  <box at="8 8 3" size="1 1 1" color="m"/>

  <!-- Rear-Left -->
  <box at="3 3 3" size="1 1 1" color="S"/>
  <box at="2 2 3" size="1 1 1" color="D"/>
  <box at="1 2 3" size="1 1 1" color="m"/>
  <box at="1 1 3" size="1 1 1" color="m"/>

  <!-- Rear-Right -->
  <box at="6 3 3" size="1 1 1" color="S"/>
  <box at="7 2 3" size="1 1 1" color="D"/>
  <box at="8 2 3" size="1 1 1" color="m"/>
  <box at="8 1 3" size="1 1 1" color="m"/>

  <!-- ======================================================== -->
  <!-- 6. LAYER OF THE 4 VTOL ROTORS AND CANOPY (z = 4)          -->
  <!-- ======================================================== -->
  <!-- NACELLE 1: FRONT-LEFT (x in 1..2, y in 7..8) -->
  <box at="1 8 4" size="1 1 1" color="a"/>
  <box at="2 8 4" size="1 1 1" color="b"/>
  <box at="2 7 4" size="1 1 1" color="c"/>
  <box at="1 7 4" size="1 1 1" color="d"/>

  <!-- NACELLE 2: FRONT-RIGHT (x in 7..8, y in 7..8) -->
  <box at="7 8 4" size="1 1 1" color="a"/>
  <box at="7 7 4" size="1 1 1" color="b"/>
  <box at="8 7 4" size="1 1 1" color="c"/>
  <box at="8 8 4" size="1 1 1" color="d"/>

  <!-- NACELLE 3: REAR-LEFT (x in 1..2, y in 1..2) -->
  <box at="1 2 4" size="1 1 1" color="a"/>
  <box at="1 1 4" size="1 1 1" color="b"/>
  <box at="2 1 4" size="1 1 1" color="c"/>
  <box at="2 2 4" size="1 1 1" color="d"/>

  <!-- NACELLE 4: REAR-RIGHT (x in 7..8, y in 1..2) -->
  <box at="7 2 4" size="1 1 1" color="a"/>
  <box at="8 2 4" size="1 1 1" color="b"/>
  <box at="8 1 4" size="1 1 1" color="c"/>
  <box at="7 1 4" size="1 1 1" color="d"/>

  <!-- ======================================================== -->
  <!-- 7. TAPERED UPPER CANOPY ROOF (z = 5)                      -->
  <!-- ======================================================== -->
  <box at="3 4.5 4" size="1 10 1" color="m"/>    
  <box at="6 4.5 4" size="1 10 1" color="m"/>    
  
  <box at="4.5 3 4" size="10 1 1" color="m"/>    
  <box at="4.5 6 4" size="10 1 1" color="m"/>    
  <!-- ======================================================== -->
  <!-- 8. STABILISER FIN, MAST AND BEACON (z = 6)                -->
  <!-- ======================================================== -->
  <!-- Rear stabiliser fin -->
  <box at="4 3 4" size="1 1 1" color="m"/>
  <box at="5 3 4" size="1 1 1" color="m"/>
  <!-- Chrome antenna mast -->
  <box at="4 4 4" size="1 1 1" color="s"/>
  <!-- Cyan navigation telemetry beacon -->
  <box at="5 4 4" size="1 1 1" color="e"/>

  <!-- ======================================================== -->
  <!-- 9. GENERATIVE RULES: STOCHASTIC VARIANTS IN THE SEEDS     -->
  <!-- ======================================================== -->
  <!-- A) Quantum resolution of the data packet (X) -->
  <one steps="4">
    <rule in="X" out="#1" p="0.40"/>
    <rule in="X" out="#2" p="0.30"/>
    <rule in="X" out="#3" p="0.20"/>
    <rule in="X" out="#4" p="0.10"/>
  </one>
  <all in="X" out="#2" optional="True"/>

  <!-- B) Resolution of the circuits and the packet casing (Y) -->
  <one steps="4">
    <rule in="Y" out="#2" p="0.40"/>
    <rule in="Y" out="#3" p="0.30"/>
    <rule in="Y" out="G" p="0.30"/>
  </one>
  <all in="Y" out="#2" optional="True"/>

  <!-- C) Dorsal details of the canopy (Z) -->
  <one steps="2">
    <rule in="Z" out="W" p="0.50"/>
    <rule in="Z" out="w" p="0.30"/>
    <rule in="Z" out="m" p="0.20"/>
  </one>
  <all in="Z" out="W" optional="True"/>
</sequence>

<!-- ============================================================ -->
<!-- 10. PROPELLER ANIMATION (4 FRAMES): ROTATION AND DATA PULSE -->
<!-- ============================================================ -->
<animation name="elica" frames="4" symmetry="()">
  <sequence>
    <!-- 1. Continuous 360° rotation of the cyan plasma rotors -->
    <all in="a" out="x"/>
    <all in="b" out="a"/>
    <all in="c" out="b"/>
    <all in="d" out="c"/>
    <all in="x" out="d"/>

    <!-- 2. Rhythmic pulse of the energy data flow -->
    <all in="#1" out="y"/>
    <all in="#2" out="#1"/>
    <all in="#3" out="#2"/>
    <all in="#4" out="#3"/>
    <all in="y" out="#4"/>
    
    <prl in="f" out="e" p="0.8"/>  
    <prl in="g" out="e" p="0.8"/>
    <prl in="e" out="f" p="0.2"/>
    <prl in="e" out="g" p="0.2"/>
  </sequence>  
</animation>