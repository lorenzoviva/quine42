  <color symbol="s" value="e8edf7" alpha="0.1" name="Schermo dopo prima lettera"/>

<!-- 
x consecutiva: xxx matcha tre voxel "x" sull'asse x. Gli elementi vanno ordinati prima per X
y slash: y/y/y matcha tre voxel "y" sull'asse y. Gli elementi vanno ordinati per secondi per Y
z spazio: z z z matcha tre voxel "z" sull'asse z. Gli elementi vanno ordinati per terzi per Z

L'ordinamento per un cubo 3x3 è il seguente:
abc/def/ghi jkl/mno/pqr stu/vwx/yzù


-->

  <box at="0 4 0" size="1 8 20" color="S"/>  
  <animation name="scritta" frames="10">

          <one in="./S/S" out="./S/G" steps="1"/>


