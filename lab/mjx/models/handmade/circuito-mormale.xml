      <!-- <path from="a" to="u" on="E" color="G" inertia="longest" steps="1"/> -->
      <path from="a" to="u" on="E" color="G" inertia="True" steps="1"/>
      <all in="EG" out="tG" symmetry="(xyz)"/>
    </markov>
    <all in="u" out="a"/>
    <one in="tEtEtEtEt EEEEEEEEE tEtEtEtEt EEEEEEEEE tEtEtEtEt EEEEEEEEE tEtEtEtEt EEEEEEEEE tEtEtEtEt EEEEEEEEE tEtEtEtEt" 
