<!--
Neon, translucent tree of light (corona): futuristic street furniture for the campus of the corona.
Written by Gemini CLI (Gemini 3.8 Flash, subscription), task T50a.
Box: 2 × 2 × 3.5 tiles, 16 × 16 × 28 voxels, 8 voxels per tile (vpt: 8).
Role: tree.
A slender bionic trunk anchored on a round graphite plinth (M) with compact overhanging roots (z=0..2);
the trunk rises slim (z=2..12) run through by four vertical cyan optical-fibre channels (C)
set in graphite titanium (m) and girded by a sapphire collar (Z); at height z=11..13 opens
a wide generative chalice crown of fractal branches (m, C, Z), clad in highly translucent
glassy optical crystals in aqua and ethereal ice (V, T, G).
Glowing cyan hanging vines come down from the crown (H, glow="True").
Cyclic animation in 8 frames:
- the hanging vines lengthen and shorten organically;
- the crystals and gems of the crown sparkle and pulse sporadically.
-->
<sequence values="BXmMZCVTGLWH" size="16 16 28" symmetry="(xy)" name="Albero di luce">
  <!-- Base structural materials: dark graphite metal and titanium -->
  <color symbol="M" value="141418" name="grafite base"/>
  <color symbol="m" value="222634" name="titanio fusto"/>
  
  <!-- Invisible marker for the generative growth of the branches -->
  <color symbol="X" hidden="True" name="nodo di crescita"/>

  <!-- Optical-fibre veins and junction nodes -->
  <color symbol="C" value="05d9e8" name="fibra ciano"/>
  <color symbol="Z" value="29adff" alpha="0.45" name="zaffiro nodi"/>

  <!-- Glowing neon hanging vines: the only ones with an active glow -->
  <color symbol="H" value="00ffff" glow="True" name="liana neon pendente"/>

  <!-- Translucent optical crystals: bright aqua, deep indigo and ethereal ice -->
  <color symbol="V" value="162436" name="vetro indaco"/>
  <color symbol="T" value="3ea8c8" alpha="0.45" name="vetro aqua traslucido"/>
  <color symbol="G" value="b4f0ff" alpha="0.45" name="cristallo ghiaccio traslucido"/>

  <!-- Diffraction points of the crown: light-blue gems and translucent white sparks -->
  <color symbol="L" value="6fc3ff" alpha="0.45" name="gemma azzurra"/>
  <color symbol="W" value="ffffff" alpha="0.45" name="scintilla fotonica"/>

  <!-- Union of the crown materials from which the hanging vines can sprout -->
  <union symbol="K" values="TVmZ"/>

  <!-- ======================================================== -->
  <!-- 1. TECHNOLOGICAL BASE AND COMPACT ROOTS (z = 0..2)       -->
  <!-- ======================================================== -->
  <!-- Dark round plinth on the ground z=0 -->
  <cylinder at="7.5 7.5 0" size="4 4 2" color="M"/>
  <cylinder at="7.5 7.5 0" size="2 2 2" color="m"/>

  <!-- 4 technological roots branching out towards the quadrants -->
  <line at="7.5 7.5 1" to="4.5 4.5 0" r="0.7" color="M"/>
  <line at="7.5 7.5 1" to="10.5 4.5 0" r="0.7" color="M"/>
  <line at="7.5 7.5 1" to="4.5 10.5 0" r="0.7" color="M"/>
  <line at="7.5 7.5 1" to="10.5 10.5 0" r="0.7" color="M"/>

  <!-- ======================================================== -->
  <!-- 2. SLENDER TRUNK WITH FIBRES AND TWIST (z = 2..12)       -->
  <!-- ======================================================== -->
  <!-- Central trunk in graphite titanium -->
  <cylinder at="7.5 7.5 2" size="3 3 9" color="m"/>
  <cylinder at="7.5 7.5 2" size="3.5 3.5 2" color="M"/>

  <!-- 4 vertical channels of bright cyan optical fibre in view along the trunk -->
  <box at="5 7 3" size="1 2 7" color="C"/>
  <box at="9 7 3" size="1 2 7" color="C"/>
  <box at="7 5 3" size="2 1 7" color="C"/>
  <box at="7 9 3" size="2 1 7" color="C"/>

  <!-- Sapphire energy collar at height z=9 -->
  <cylinder at="7.5 7.5 9" size="4 4 1" color="Z"/>
  <!-- Joining crown and branch housing at height z=11 -->
  <cylinder at="7.5 7.5 11" size="4 4 1" color="m"/>
  <cylinder at="7.5 7.5 11" size="2 2 1" color="C"/>

  <!-- ======================================================== -->
  <!-- 3. SEEDING THE GENERATIVE BRANCHES (z = 12)              -->
  <!-- ======================================================== -->
  <!-- 4 initial branching nodes on solid integer coordinates -->
  <box at="6 6 12" size="1 1 1" color="X"/>
  <box at="9 6 12" size="1 1 1" color="X"/>
  <box at="6 9 12" size="1 1 1" color="X"/>
  <box at="9 9 12" size="1 1 1" color="X"/>

  <!-- ======================================================== -->
  <!-- 4. PRIMARY GENERATIVE GROWTH OF THE BRANCHES (z = 12..20) -->
  <!-- ======================================================== -->
  <!-- The branches rise widening into a diverging cup -->
  <one steps="32">
    <!-- Straight upward thrust with cyan fibre -->
    <rule in="B X" out="X C" p="1.6"/>
    <!-- Straight upward thrust with titanium trunk -->
    <rule in="B X" out="X m" p="1.2"/>
    <!-- Diagonal advance outwards (+x or +y, +z) -->
    <rule in="*B X*" out="*X *m" p="0.6"/>
    <!-- Corner diagonal advance (+x, +y, +z) -->
    <rule in="**/*B X*/**" out="**/*X *m/**" p="0.45"/>
    <!-- Sapphire veining along the branch -->
    <rule in="*B X*" out="*X *Z" p="0.35"/>
  </one>

  <!-- ======================================================== -->
  <!-- 5. FRACTAL FORKING AND UPPER CROWN (z = 19..25)          -->
  <!-- ======================================================== -->
  <!-- The branches fork and open the crown at the top -->
  <one steps="24">
    <!-- Final thrust towards the apex with sapphire -->
    <rule in="B X" out="X Z" p="1.4"/>
    <!-- Chalice split of the branch -->
    <rule in="B*B *X*" out="X*X *m*" p="0.25"/>
    <!-- Diverging secondary branch with a sapphire neon node -->
    <rule in="*B X*" out="*X *Z" p="0.5"/>
    <!-- Angled branch towards the vault with cyan fibre -->
    <rule in="**/*B X*/**" out="**/*X *C/**" p="0.4"/>
  </one>

  <!-- Final crystallisation of the X end fronts into sapphire nodes -->
  <all in="X" out="Z"/>

  <!-- ======================================================== -->
  <!-- 6. FORMING THE TRANSLUCENT CRYSTALS (V, T, G)            -->
  <!-- ======================================================== -->
  <!-- The indigo glass thickens around all the nodes and branches of the crown -->
  <prl steps="1">
    <rule in="B Z" out="V *" p="0.85"/>
    <rule in="ZB" out="*V" p="0.75"/>
    <rule in="Z/B" out="*/V" p="0.75"/>
    <rule in="B/Z" out="V/*" p="0.75"/>
    <rule in="B C" out="V *" p="0.45"/>
  </prl>

  <!-- Surface crystallisation in vivid translucent aqua glass (T) -->
  <prl steps="1">
    <rule in="B V" out="B T" p="0.7"/>
    <rule in="V B" out="T B" p="0.6"/>
  </prl>

  <!-- Organic fusion and inner welding of the prisms with NoCorners -->
  <convolution neighborhood="NoCorners" steps="1" optional="True">
    <rule in="B" out="T" values="V T" sum="8..16"/>
  </convolution>

  <!-- Reflecting facets in ethereal ice crystal (G) on the exposed faces -->
  <prl steps="1">
    <rule in="B T" out="B G" p="0.65"/>
    <rule in="B V" out="B T" p="0.5"/>
  </prl>

  <!-- ======================================================== -->
  <!-- 7. GLOWING HANGING NEON VINES (H)                        -->
  <!-- ======================================================== -->
  <!-- Vine nodes sprout under the vault of the crown -->
  <prl steps="1">
    <rule in="K B" out="* H" p="0.32"/>
  </prl>

  <!-- Downward growth of the glowing hanging vines -->
  <one steps="44">
    <!-- The vine goes down if there are at least two blocks of air below -->
    <rule in="H B B" out="* H *" p="1.0"/>
    <!-- Simple lengthening -->
    <rule in="H B" out="* H" p="0.4"/>
  </one>

  <!-- ======================================================== -->
  <!-- 8. END NEON GEMS (L) AND PHOTON SPARKS (W)               -->
  <!-- ======================================================== -->
  <!-- Light-blue neon points spread over the outer crystals -->
  <prl steps="1">
    <rule in="B G" out="B L" p="0.45"/>
    <rule in="B T" out="B L" p="0.30"/>
  </prl>

  <!-- Starry white photons on the tops of the neon gems -->
  <prl steps="1">
    <rule in="B L" out="B W" p="0.35"/>
  </prl>
</sequence>

<!-- ============================================================ -->
<!-- 9. CYCLIC LIFE ANIMATION (8 FRAMES): VINES AND SPARKLE      -->
<!-- ============================================================ -->
<animation name="vita" frames="8">
  <sequence>
    <!-- The hanging vines float: stochastic lengthening or retraction of the tip -->
    <prl steps="1">
      <!-- It lengthens downwards by one voxel if there is air below -->
      <rule in="H B B" out="* H *" p="0.30"/>
      <!-- It shortens by pulling the tip back one voxel (keeps its anchor to the crown) -->
      <rule in="H H B" out="* B *" p="0.22"/>
    </prl>

    <!-- Sporadic sparkle in the crown: gems that light up and turn back into crystal -->
    <prl steps="1">
      <!-- Some aqua crystals light up sporadically into light-blue neon gems -->
      <rule in="T" out="L" p="0.08"/>
      <!-- Some ice crystals light up into white photon sparks -->
      <rule in="G" out="W" p="0.06"/>
      <!-- The lit gems gently turn back into translucent crystal -->
      <rule in="L" out="T" p="0.32"/>
      <!-- The white photons turn back into ice crystal -->
      <rule in="W" out="G" p="0.38"/>
    </prl>
  </sequence>
</animation>