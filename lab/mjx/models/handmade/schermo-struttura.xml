    <one in="SSSSSS/StSSSS/SSSSSS/SSSSSS SSSSSS/SSSSSS/SSSSSS/SSSSSS BBBBBB/BBBBBB/BBBBBB/BBBBBB" out="SSSSSS/SttttS/SttSSS/SSSSSS SSSSSS/SSSSSS/SSSSSS/SSSSSS BBBBBB/BBBBBB/BBBBBB/BBBBBB" steps="1" symmetry="(xy)"/>
   
    <one in="SSSSS/ttSSS/SSSSS SSSSS/SSSSS/SSSSS BBBBB/BBBBB/BBBBB" out="SSSSS/rrrrS/SSSSS SSSSS/SSSSS/SSSSS BBBBB/BBBBB/BBBBB" steps="3" symmetry="(xy)"/>
    <!-- Phase I: first line -->
    <all in="S" out="a"/>
    <one in="aaaa/ataa/aaaa/aaaa" out="aaaa/atta/atta/aaaa" steps="4" simmetry="(xy)"/>

    <one steps="8">
          <!-- <rule in="aaaa/at*a/a**a/aaaa" out="aaaa/atta/atta/aaaa" steps="1" simmetry="(xy)"/> -->
