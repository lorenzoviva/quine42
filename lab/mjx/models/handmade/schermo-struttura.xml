          <rule in="aaaa/aaaa/aaaa/aaaa *aaa/*att/*att/*aaa" out="aaaa/atta/atta/aaaa *aaa/*att/*att/*aaa" steps="1" symmetry="(xy)"/>
          <rule in="aaaa/aaaa/aaaa/aaaa *aaa/*att/*att/*aaa" out="aaaa/atta/atta/aaaa *aaa/*att/*att/*aaa" steps="1" symmetry="(xy)"/>
    </one>
  
  <convolution neighborhood="Moore" steps="2" simmetry="(xyz)">
    <rule in="a" out="r" values="t" steps="4" sum="4..8"/>
    <rule in="a" out="r" values="r" steps="5" sum="3..5"/>
  </convolution>
    <all in="r" out="t"/>


    <one steps="12">
          <rule in="aaaa/aaaa/aaaa/aaaa aaaa/atta/atta/aaaa" out="aaaa/atta/atta/aaaa aaaa/atta/atta/aaaa" steps="1" symmetry="(xy)"/>
