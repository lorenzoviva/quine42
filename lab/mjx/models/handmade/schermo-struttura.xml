          <rule in="aaaa/aaaa/aaaa/aaaa *aaa/*att/*att/*aaa" out="aaaa/atta/atta/aaaa *aaa/*att/*att/*aaa" steps="1" symmetry="(xy)"/>
          <rule in="aaaa/aaaa/aaaa/aaaa atta/atta/aaaa/****" out="aaaa/atta/atta/aaaa atta/atta/aaaa/****" steps="1" symmetry="(xy)"/>
