    <one in="ar/aa" out="pp/aa" steps="5" simmetry="(xy)" />
    <one in="aa/ar" out="aa/pp" steps="5" simmetry="(xy)" />

    <one steps="70">

      
      <rule in="aaa/ppa/aaa" out="aaa/ppp/aaa" steps="1" p="0.3"/>
      <rule in="aaa/app/aaa" out="aaa/ppp/aaa" steps="1" p="0.3"/>
      <rule in="apa/apa/aaa" out="apa/apa/apa" steps="1" p="0.3"/>
      <rule in="aaa/apa/apa" out="apa/apa/apa" steps="1" p="0.3"/>


      <rule in="apa/aaa" out="apa/aap" steps="1" p="0.1"/>
      <rule in="apa/aaa" out="apa/paa" steps="1" p="0.1"/>
      <rule in="aaa/apa" out="paa/apa" steps="1" p="0.1"/>
      <rule in="aaa/apa" out="aap/apa" steps="1" p="0.1"/>


      <rule in="aa/aa/aa aa/ap/aa" out="aa/pa/aa aa/ap/aa" steps="1" p="0.6"/>
      <rule in="aa/aa/aa aa/pa/aa" out="aa/ap/aa aa/pa/aa" steps="1" p="0.6"/>
