<!--
corona-gerboa-scultore: Il Costruttore di Forme del Concilio (avatar della Corona).
Membro del Concilio in forma di Gerboa gigante costruttore (scala 20 vpt, anatomia base con orecchie in avanti).
Manto grigio grafite elegante con morbida pettorina e ventre ambrati caldi.
Indossa un caschetto protettivo da cantiere aerodinamico arancione vivo (#ffa65c, colore araldico dello Scultore)
con cresta di rinforzo longitudinale, calotta profilata tra le orecchie con asole sartoriali anatomiche,
spessa visiera scura sollevata a mezza fronte sopra gli occhioni, torcia/faretto LED montato sulla fronte
che emette un fascio brillante (glow="True"), sottogola di sicurezza, robusti guantini gommati arancioni
da lavoro sulle zampette anteriori, sciarpetta/bandana da lavoro arancione annodata al collo,
e cintura porta-attrezzi con mazzuolo/scalpello da modellazione voxel al fianco.
Scatola: 1.6 × 2.2 × 2.1 caselle, 32 × 44 × 42 voxel, 20 voxel per casella (vpt: 20).
Ruolo: npc.
-->
<sequence values="BFfDCcTtUuNWEZRrOoGgPpaAKkJIHhsVvMmyYlLQqx" size="32 44 42" symmetry="()" name="GerboaScultore">
  <!-- Elegant graphite-grey coat of the body and back -->
  <color symbol="F" value="343844" name="grafite base dorso"/>
  <color symbol="f" value="4c5262" name="grafite chiaro luce"/>
  <color symbol="D" value="20222a" name="grafite scuro ombra"/>

  <!-- Belly, chest and throat in a soft, warm, bright amber -->
  <color symbol="C" value="f5ad62" name="ambra caldo pettorina"/>
  <color symbol="c" value="d48032" name="ambra profondo sfumatura"/>

  <!-- Testa, musetto, tartufo e baffi (part="testa") -->
  <color symbol="T" value="343844" part="testa" name="testa grafite base"/>
  <color symbol="t" value="4c5262" part="testa" name="testa grafite chiaro guance"/>
  <color symbol="U" value="ffd099" part="testa" name="musetto e guance ambra chiaro"/>
  <color symbol="u" value="f5ad62" part="testa" name="sfumatura musetto ambra"/>
  <color symbol="N" value="181a20" part="testa" name="tartufo naso scuro"/>
  <color symbol="W" value="282a34" part="testa" name="baffetti vibrisse"/>
  <color symbol="E" value="141418" part="testa" name="occhi scuri profondi"/>
  <color symbol="Z" value="ffffff" glow="True" part="testa" name="riflesso occhi e torcia led"/>

  <!-- Grandi orecchie a conchiglia (part="testa") -->
  <color symbol="O" value="343844" part="testa" name="dorso orecchio grafite"/>
  <color symbol="o" value="4c5262" part="testa" name="bordo orecchio chiaro"/>
  <color symbol="R" value="ffaec0" part="testa" name="interno orecchio rosa"/>
  <color symbol="r" value="ffd2dc" part="testa" name="concavita orecchio rosa chiaro"/>

  <!-- Zampe posteriori bipedali piegate a Z (part="gamba") -->
  <color symbol="G" value="343844" part="gamba" name="coscia grafite"/>
  <color symbol="g" value="20222a" part="gamba" name="stinco e garretto"/>
  <color symbol="P" value="d48032" part="gamba" name="piede ambra dita"/>
  <color symbol="p" value="a85c18" part="gamba" name="polpastrelli unghie"/>

  <!-- Zampette anteriori e robusti guanti da lavoro (part="braccio") -->
  <color symbol="A" value="4c5262" part="braccio" name="braccino grafite"/>
  <color symbol="a" value="ff781f" part="braccio" name="guantino gommato arancione scultore"/>
  <color symbol="x" value="b84400" part="braccio" name="grip dita gommato"/>

  <!-- Coda sinuosa e pennacchio bicolore (part="coda") -->
  <color symbol="K" value="343844" part="coda" name="fusto coda grafite"/>
  <color symbol="k" value="20222a" part="coda" name="giunto fusto coda"/>
  <color symbol="J" value="181a20" part="coda" name="base pennacchio scura"/>
  <color symbol="I" value="ffd099" part="coda" name="punta pennacchio ambrata"/>

  <!-- Accessori dello Scultore: Caschetto cantiere, Visiera sollevata, Faretto LED, Sottogola (part="testa") -->
  <color symbol="H" value="ff781f" part="testa" name="elmetto cantiere arancio vivo"/>
  <color symbol="h" value="ffa24d" part="testa" name="elmetto luce e cresta"/>
  <color symbol="s" value="cc5500" part="testa" name="elmetto bordo e asole ombra"/>
  <color symbol="V" value="1e2430" part="testa" name="visiera policarbonato oscurato"/>
  <color symbol="v" value="344052" part="testa" name="riflesso visiera policarbonato"/>
  <color symbol="M" value="687282" part="testa" name="cerniere metallo visiera e fibbie"/>
  <color symbol="m" value="1c1e24" part="testa" name="corpo supporto torcia led"/>
  <color symbol="Y" value="ff781f" part="testa" name="fazzoletto collo arancio scultore"/>
  <color symbol="y" value="cc5500" part="testa" name="nodo fazzoletto ombra"/>

  <!-- Body accessories: belt and voxel sculpting tools -->
  <color symbol="L" value="382418" name="cintura cuoio da lavoro"/>
  <color symbol="l" value="c87624" name="fodero e manico scalpello legno"/>
  <color symbol="Q" value="8a96a8" name="acciaio scalpello modellazione"/>
  <color symbol="q" value="c8d6e8" name="filo lama scalpello luce"/>

  <!-- ======================================================== -->
  <!-- 1. LUNGHE ZAMPE POSTERIORI DA SALTATORE (part="gamba")   -->
  <!-- ======================================================== -->
  <!-- Big left foot on the ground (x=10..12, y=15..28, z=0..1) -->
  <box at="11 21.5 0" size="3 14 1" color="P"/>
  <box at="10 28 0" size="1 1 1" color="p"/>
  <box at="11 28 0" size="1 1 1" color="p"/>
  <box at="12 28 0" size="1 1 1" color="p"/>
  <box at="11 20 1" size="3 8 1" color="P"/>
  <box at="11 15.5 0" size="3 3 3" color="g"/>

  <!-- Big right foot on the ground (x=19..21, y=15..28, z=0..1) -->
  <box at="20 21.5 0" size="3 14 1" color="P"/>
  <box at="19 28 0" size="1 1 1" color="p"/>
  <box at="20 28 0" size="1 1 1" color="p"/>
  <box at="21 28 0" size="1 1 1" color="p"/>
  <box at="20 20 1" size="3 8 1" color="P"/>
  <box at="20 15.5 0" size="3 3 3" color="g"/>

  <!-- Long shins leaning forward from the hock to the knee (z=2..12) -->
  <line at="11 15.5 2" to="11 24.5 11.5" r="1.1" color="g"/>
  <line at="20 15.5 2" to="20 24.5 11.5" r="1.1" color="g"/>

  <!-- High muscular thighs bent in a Z joining knee and pelvis -->
  <ellipsoid at="11 20 9.5" size="5 9 10" color="G"/>
  <ellipsoid at="20 20 9.5" size="5 9 10" color="G"/>

  <!-- ======================================================== -->
  <!-- 2. LONG LEANING BODY AND AMBER BIB (z=10..22)               -->
  <!-- ======================================================== -->
  <!-- High hindquarters (welded to the thighs and the tail) -->
  <ellipsoid at="15.5 18 15" size="12 10 9" color="F"/>

  <!-- Long middle back (leaning down and forward) -->
  <ellipsoid at="15.5 24 14" size="11 10 8" color="F"/>

  <!-- Chest and front shoulders -->
  <ellipsoid at="15.5 29 14.5" size="10 8 8" color="F"/>

  <!-- Soft, warm amber belly and bib (+y and lower part) -->
  <ellipsoid at="15.5 24 11" size="8 9 5" color="C"/>
  <ellipsoid at="15.5 28 12.5" size="7 7 6" color="C"/>
  <ellipsoid at="15.5 31 14" size="6 5 5" color="c"/>

  <!-- ======================================================== -->
  <!-- 3. ZAMPETTE ANTERIORI E GUANTI DA LAVORO (part="braccio") -->
  <!-- ======================================================== -->
  <!-- Little left arm and rubberised orange glove with a cuff -->
  <line at="12 29 14" to="13.5 32 12" r="0.6" color="A"/>
  <box at="13.5 31.5 12" size="2 2 1" color="s"/>
  <box at="13.5 33.5 12" size="2 2 2" color="a"/>
  <box at="13.5 34 12" size="2 1 1" color="x"/>

  <!-- Little right arm and rubberised orange glove with a cuff -->
  <line at="19 29 14" to="17.5 32 12" r="0.6" color="A"/>
  <box at="17.5 31.5 12" size="2 2 1" color="s"/>
  <box at="17.5 33.5 12" size="2 2 2" color="a"/>
  <box at="17.5 34 12" size="2 1 1" color="x"/>

  <!-- ======================================================== -->
  <!-- 4. TESTA GRANDE, GUANCE, MUSETTO, OCCHI (part="testa")   -->
  <!-- ======================================================== -->
  <!-- Main graphite skull -->
  <ellipsoid at="15.5 31 19" size="13 11 10" color="T"/>

  <!-- Graphite forehead between the eyes -->
  <box at="15.5 34 21" size="4 4 4" color="T"/>
  <box at="15.5 36 22" size="2 2 2" color="t"/>

  <!-- Amber little cheeks at the sides of the muzzle -->
  <ellipsoid at="10.5 34 18.5" size="5 5 5" color="t"/>
  <ellipsoid at="20.5 34 18.5" size="5 5 5" color="t"/>
  <box at="10 35 18" size="3 3 3" color="U"/>
  <box at="21 35 18" size="3 3 3" color="U"/>

  <!-- Warm amber conical muzzle stretched forward -->
  <box at="15.5 37 18" size="5 4 3" color="U"/>
  <box at="15.5 39 18" size="3 3 2" color="U"/>
  <!-- Little dark nose -->
  <box at="15.5 40 19" size="2 1 1" color="N"/>

  <!-- Thin hints of side whiskers on the muzzle -->
  <box at="13 38 18" size="1 1 1" color="W"/>
  <box at="18 38 18" size="1 1 1" color="W"/>

  <!-- Big expressive dark eyes (3x2x3 voxels at z=20..22, y=34..35) -->
  <box at="11 34.5 20" size="3 2 3" color="E"/>
  <box at="20 34.5 20" size="3 2 3" color="E"/>

  <!-- White points of a lively reflection (Z, glow="True") at the top left -->
  <box at="10 35 22" size="1 1 1" color="Z"/>
  <box at="19 35 22" size="1 1 1" color="Z"/>

  <!-- ======================================================== -->
  <!-- 5. BANDANA / SCIARPETTA ARANCIO AL COLLO (part="testa")  -->
  <!-- ======================================================== -->
  <!-- Collar around the neck under the chin -->
  <cylinder at="15.5 32 16" size="8 7 1.8" color="Y"/>
  <!-- Building-site knot / kerchief under the throat -->
  <box at="15.5 35 15.5" size="3 1 2" color="y"/>
  <!-- Orange ends and drapery on the chest -->
  <box at="15 34.5 13.5" size="2 1 2.5" color="Y"/>
  <box at="16.5 34.5 12" size="1 1 2" color="y"/>

  <!-- ======================================================== -->
  <!-- 6. GIGANTESCHE ORECCHIE A CONCHIGLIA (part="testa", z=25..39) -->
  <!-- ======================================================== -->
  <!-- Left ear: graphite back/outer shell -->
  <ellipsoid at="9.5 29 25" size="8 4 15" color="O"/>
  <!-- Concave inner flesh-pink velvet auricle -->
  <ellipsoid at="9.5 30.5 26" size="6 3 13" color="R"/>
  <box at="9.5 31 27" size="4 1 8" color="r"/>
  <line at="6 30 28" to="9 30 38" r="0.5" color="o"/>

  <!-- Right ear: graphite back/outer shell -->
  <ellipsoid at="21.5 29 25" size="8 4 15" color="O"/>
  <!-- Concave inner flesh-pink velvet auricle -->
  <ellipsoid at="21.5 30.5 26" size="6 3 13" color="R"/>
  <box at="21.5 31 27" size="4 1 8" color="r"/>
  <line at="25 30 28" to="22 30 38" r="0.5" color="o"/>

  <!-- ======================================================== -->
  <!-- 7. CASCHETTO PROTETTIVO DA CANTIERE (part="testa")       -->
  <!-- ======================================================== -->
  <!-- Lower band and base with tailored slits for the ears -->
  <cylinder at="15.5 32 25" size="8 8 1" color="s"/>
  <!-- Integrated stiff front visor of the helmet (brim) -->
  <box at="15.5 36 25" size="10 4 1" color="H"/>
  <box at="15.5 37 25" size="8 2 1" color="h"/>
  <box at="15.5 38 24" size="6 1 1" color="s"/>
  <!-- Rear protective neck guard -->
  <box at="15.5 27 25" size="8 3 1" color="H"/>
  <!-- Side reinforcing edges of the ear slits -->
  <box at="11 31 25" size="1 3 1" color="s"/>
  <box at="20 31 25" size="1 3 1" color="s"/>

  <!-- Main aerodynamic rounded shell in bright orange -->
  <ellipsoid at="15.5 32 26" size="7.2 8.6 6.5" color="H"/>
  <ellipsoid at="15.5 32 27.5" size="6.4 7.6 5.5" color="h"/>

  <!-- Central aerodynamic lengthwise reinforcing ridge -->
  <line at="15.5 27 28.5" to="15.5 35 28.5" r="0.7" color="h"/>
  <line at="15.5 28.5 30" to="15.5 34 30" r="0.6" color="H"/>

  <!-- Safety chin strap with a metal buckle -->
  <line at="12 32 25" to="14 33 17" r="0.4" color="s"/>
  <line at="19 32 25" to="17 33 17" r="0.4" color="s"/>
  <box at="15.5 34 16" size="2 1 1" color="M"/>

  <!-- ======================================================== -->
  <!-- 8. THICK DARK VISOR RAISED TO MID-FOREHEAD               -->
  <!-- ======================================================== -->
  <!-- Side metal hinges for rotating the visor -->
  <box at="11 35 27" size="1 1 2" color="M"/>
  <box at="20 35 27" size="1 1 2" color="M"/>
  <box at="12 35 27" size="1 1 1" color="M"/>
  <box at="19 35 27" size="1 1 1" color="M"/>

  <!-- Arc of the raised visor in darkened polycarbonate -->
  <box at="15.5 36 27" size="8 1 1" color="V"/>
  <box at="15.5 36 28" size="6 1 2" color="v"/>
  <box at="15.5 36 30" size="6 1 1" color="V"/>

  <!-- ======================================================== -->
  <!-- 9. FRONT LED TORCH / SPOTLIGHT MOUNTED ON THE HELMET    -->
  <!-- ======================================================== -->
  <!-- Spotlight bracket mounted on the forehead above the visor -->
  <box at="15.5 35 30" size="2 1 2" color="m"/>
  <box at="15.5 36 31" size="2 1 1" color="M"/>
  <!-- Bright glowing LED lens mounted flush at the front -->
  <box at="15.5 37 31" size="2 1 1" color="Z"/>

  <!-- ======================================================== -->
  <!-- 10. WORK BELT AND VOXEL CHISEL AT THE SIDE               -->
  <!-- ======================================================== -->
  <!-- Carpenter's/sculptor's dark leather belt -->
  <line at="11 23 13" to="15.5 18 14" r="0.7" color="L"/>
  <line at="15.5 18 14" to="20 23 13" r="0.7" color="L"/>
  <line at="11 23 13" to="15.5 26 12" r="0.7" color="L"/>
  <line at="20 23 13" to="15.5 26 12" r="0.7" color="L"/>
  <!-- Metal buckle of the belt -->
  <box at="15.5 27 12" size="2 1 1" color="M"/>

  <!-- Sheath and modelling chisel/mallet at the right side -->
  <box at="20 21 13" size="3 3 2" color="l"/>
  <line at="20 18 11" to="20 23 17" r="0.6" color="l"/>
  <box at="20 24 17" size="3 1 2" color="Q"/>
  <box at="20 25 18" size="3 1 1" color="q"/>

  <!-- ======================================================== -->
  <!-- 11. LUNGHISSIMA CODA E PENNACCHIO BICOLORE (part="coda") -->
  <!-- ======================================================== -->
  <!-- Attachment to the high hindquarters (y=15, z=16) -->
  <line at="15.5 15 16" to="15.5 10 9" r="1.1" color="K"/>
  <!-- Sinuous descent towards the ground -->
  <line at="15.5 10 9" to="15.5 6 4" r="0.9" color="K"/>
  <line at="15.5 6 4" to="15.5 3.5 2.5" r="0.8" color="K"/>
  <!-- Rising upwards again -->
  <line at="15.5 3.5 2.5" to="15.5 2.5 5.5" r="0.8" color="k"/>
  <line at="15.5 2.5 5.5" to="15.5 2.5 9" r="0.8" color="k"/>

  <!-- Spectacular two-coloured plume: dark collar and an amber tuft -->
  <ellipsoid at="15.5 2.5 9" size="5 4 5" color="J"/>
  <ellipsoid at="15.5 2.5 12" size="6 5 6" color="I"/>
  <ellipsoid at="15.5 2.5 16" size="4 4 5" color="I"/>
  <box at="15.5 2.5 18" size="2 2 2" color="I"/>

  <!-- ======================================================== -->
  <!-- 12. GENERATIVE RULES: SHADES, FUR AND TEXTURE            -->
  <!-- ======================================================== -->
  <!-- Top lighting of the back and shoulders -->
  <prl steps="1" p="0.3" in="B F" out="B f"/>
  <!-- Natural shading in the lower folds of the back -->
  <prl steps="1" p="0.15" in="F/B" out="D/*"/>
  <!-- Soft transition between the amber belly and the graphite sides -->
  <prl steps="1" p="0.35" in="F/C" out="*/c"/>
  <prl steps="1" p="0.25" in="FC" out="Fc" symmetry="(x)"/>
  <!-- Delicate shading between the amber cheeks and the muzzle -->
  <prl steps="1" p="0.25" in="t U" out="u *"/>
</sequence>
