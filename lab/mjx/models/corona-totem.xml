<!--
Information totem / holographic sector sign (corona): street furniture and an information point for the avenues and crossings of the corona.
Written by Gemini CLI (Gemini 3.8 Flash, subscription), task T50a.
Box: 1 × 1 × 2.5 tiles, 8 × 8 × 20 voxels, 8 voxels per tile (vpt: 8).
Role: prop.
Design and sculptural concept:
- A slender technological stele anchored to the ground on an octagonal foundation plinth in graphite concrete and titanium (P, D)
  with four massive chrome bolts at the corners (s);
- A tapered plinth in dark cybernetic titanium (M, m) with cyan bus telemetry indicators (E) and an amber sector light (e);
- An ultra-dark graphite carbon metal post (D, M) rising to mid-height (z=7), with vertical heat-sink fins
  on the back (m, S) and chrome data bus channels on the sides (S);
- At z=6..7 the post widens into a fork cradle housing the lower laser emitter in dark glass (V)
  with an electric cyan photon projection slit (E, W, glow="True");
- A semi-transparent vertical volumetric holographic screen (z=8..15, x=2..5, y=3..4) held between two side
  magnetic confinement pylons (x=1 and x=6 in m, S):
  - The display uses a painterly technique of volumetric semi-transparency with a lattice of particles and tiny air gaps (B);
  - The patterns of circuits and the columns of binary runes / photon data are generated stochastically with MarkovJunior rules
    from markers (X, Y, Z): cyan scan lines (N, glow="True"), cobalt quantum bridges (C, glow="True")
    and white laser data packets / bits (W, glow="True");
  - Every seed (seed 1, 2, 3...) produces a clearly different configuration of data, diagrams and runic texts;
- Upper crowning (z=16..18):
  - An upper phase-scanning emitter crossbar (z=16) in titanium (m, M) with chrome joints (S);
  - A tapered dome of the telemetry sensor and scanning optics (z=17);
  - A needle-like transceiver antenna cusp in shiny chrome silver (s, z=18), topped by an omnidirectional
    golden amber sector beacon (e, glow="True");
  - The height z=19 is left free as an air margin to avoid cuts at the ceiling.
Animation "dati" (6 frames):
- The white photon bit packets (W) slide and vibrate along the circuit lines and the cyan/cobalt rune columns (N, C);
- The lower laser emitter and the scanning projector modulate their brightness (E, N);
- The antenna beacon (e) on the chrome cusp pulses regularly without interfering with the screen.
-->
<sequence values="BMmDPSsVTCNWEeXYZH" size="8 8 20" symmetry="(x)" name="Totem">
  <!-- Structural materials: dark cybernetic titanium, carbon and graphite plinth -->
  <color symbol="M" value="20222a" name="titanio scuro scocca"/>
  <color symbol="m" value="2e323f" name="titanio secondario biselli"/>
  <color symbol="D" value="141418" name="carbonio ultra-scuro montante"/>
  <color symbol="P" value="3a3a40" name="plinto fondazione grafite"/>

  <!-- Mechanics, joints, tie rods and chrome finishes -->
  <color symbol="S" value="83769c" name="cromo satinato giunti e bus"/>
  <color symbol="s" value="c2c3c7" name="argento cromo lucido antenna e bulloni"/>

  <!-- Optics, reflecting guides and holographic display -->
  <color symbol="V" value="1c2a3a" name="vano ottico vetro scuro"/>
  <color symbol="T" value="3d5a78" name="guida d'onda ardesia riflettente"/>

  <!-- Active light sources (glow="True") for the neon bloom -->
  <color symbol="C" value="29adff" glow="True" name="ologramma azzurro cobalto"/>
  <color symbol="N" value="00ffff" glow="True" name="fascio neon ciano puro"/>
  <color symbol="W" value="ffffff" glow="True" name="dati fotonici e rune bianche"/>
  <color symbol="E" value="05d9e8" glow="True" name="laser proiettore ciano elettrico"/>
  <color symbol="e" value="ffa300" glow="True" name="beacon antenna ambra dorata"/>

  <!-- Invisible markers for the generative rules -->
  <color symbol="X" hidden="True" name="marker circuito bus"/>
  <color symbol="Y" hidden="True" name="marker runa binaria"/>
  <color symbol="Z" hidden="True" name="marker matrice quantistica"/>
  <color symbol="H" hidden="True" name="marker aletta dissipatore"/>

  <!-- ======================================================== -->
  <!-- 1. OCTAGONAL FOUNDATION PLINTH ON THE GROUND (z = 0)     -->
  <!-- ======================================================== -->
  <!-- Octagonal base plate in graphite titanium concrete P     -->
  <box at="3.5 3.5 0" size="4 6 1" color="P"/>
  <box at="3.5 3.5 0" size="6 4 1" color="P"/>
  <!-- Central mass core in dark carbon D                       -->
  <box at="3.5 3.5 0" size="4 4 1" color="D"/>

  <!-- 4 hexagonal chrome anchor bolts at the corners           -->
  <box at="2 1 0" size="1 1 1" color="s"/>
  <box at="5 1 0" size="1 1 1" color="s"/>
  <box at="2 6 0" size="1 1 1" color="s"/>
  <box at="5 6 0" size="1 1 1" color="s"/>

  <!-- Side static discharge fins in titanium m                  -->
  <box at="1 3.5 0" size="1 2 1" color="m"/>
  <box at="6 3.5 0" size="1 2 1" color="m"/>

  <!-- ======================================================== -->
  <!-- 2. TAPERED PLINTH AND PLINTH TELEMETRY (z = 1)           -->
  <!-- ======================================================== -->
  <!-- Stepped plinth in cybernetic titanium M                   -->
  <box at="3.5 3.5 1" size="4 4 1" color="M"/>
  <!-- Tapered corner bevels in light titanium m                -->
  <box at="2 2 1" size="1 1 1" color="m"/>
  <box at="5 2 1" size="1 1 1" color="m"/>
  <box at="2 5 1" size="1 1 1" color="m"/>
  <box at="5 5 1" size="1 1 1" color="m"/>

  <!-- Front status telemetry lights (y=5)                      -->
  <box at="3 5 1" size="1 1 1" color="E"/>
  <box at="4 5 1" size="1 1 1" color="e"/>

  <!-- Rear cable duct space (y=2)                              -->
  <box at="3.5 2.0 1" size="2 1 1" color="V"/>

  <!-- ======================================================== -->
  <!-- 3. ANCHORING COLLAR OF THE PILLAR (z = 2)                -->
  <!-- ======================================================== -->
  <box at="3.5 3.5 2" size="4 2 1" color="m"/>
  <box at="3.5 3.5 2" size="2 4 1" color="m"/>
  <box at="3.5 3.5 2" size="2 2 1" color="M"/>
  <!-- Satin chrome joints and clamps S                        -->
  <box at="2 3.5 2" size="1 2 1" color="S"/>
  <box at="5 3.5 2" size="1 2 1" color="S"/>
  <box at="3.5 2.0 2" size="2 1 1" color="S"/>

  <!-- ======================================================== -->
  <!-- 4. VERTICAL PILLAR AND REAR HEAT SINKS (z = 3..5)        -->
  <!-- ======================================================== -->
  <!-- Central core of the pylon in ultra-black carbon D        -->
  <box at="3.5 3.5 3" size="2 2 3" color="D"/>

  <!-- Rear back with the heat-sink housing (y=2)               -->
  <box at="3.5 2.0 3" size="2 1 3" color="H"/>

  <!-- Side bus channels in satin chrome S (z=3..4)             -->
  <box at="2 3.5 3" size="1 2 2" color="S"/>
  <box at="5 3.5 3" size="1 2 2" color="S"/>

  <!-- Side fork supports in titanium m (z=5)                   -->
  <box at="2 3.5 5" size="1 2 1" color="m"/>
  <box at="5 3.5 5" size="1 2 1" color="m"/>

  <!-- Front of the post with a central groove (y=4)            -->
  <box at="3.5 4.0 3" size="2 1 3" color="M"/>
  <box at="3.5 4.0 4" size="2 1 1" color="m"/>

  <!-- ======================================================== -->
  <!-- 5. FORK CRADLE AND LASER PROJECTOR TRAY (z = 6..7)       -->
  <!-- ======================================================== -->
  <!-- Widened support shelf at z=6                             -->
  <box at="3.5 3.5 6" size="4 3 1" color="M"/>
  <box at="1 3.5 6" size="1 2 1" color="m"/>
  <box at="6 3.5 6" size="1 2 1" color="m"/>
  <box at="2 2 6" size="1 1 1" color="S"/>
  <box at="5 2 6" size="1 1 1" color="S"/>

  <!-- Optical tray of the lower laser emitter at z=7           -->
  <box at="3.5 3.5 7" size="4 2 1" color="V"/>
  <box at="3.5 3.5 7" size="2 2 1" color="E"/>
  <box at="3 3 7" size="1 1 1" color="W"/>
  <box at="4 4 7" size="1 1 1" color="W"/>
  <box at="2 3.5 7" size="1 2 1" color="m"/>
  <box at="5 3.5 7" size="1 2 1" color="m"/>
  <box at="1 3.5 7" size="1 2 1" color="m"/>
  <box at="6 3.5 7" size="1 2 1" color="m"/>

  <!-- ======================================================== -->
  <!-- 6. SIDE CONFINEMENT PYLONS (z = 8..15)                   -->
  <!-- ======================================================== -->
  <!-- Thin magnetic containment columns at x=1 and x=6         -->
  <box at="1 3.5 8" size="1 2 8" color="m"/>
  <box at="6 3.5 8" size="1 2 8" color="m"/>

  <!-- Satin chrome joints S at z=10 and z=13                   -->
  <box at="1 3.5 10" size="1 2 1" color="S"/>
  <box at="6 3.5 10" size="1 2 1" color="S"/>
  <box at="1 3.5 13" size="1 2 1" color="S"/>
  <box at="6 3.5 13" size="1 2 1" color="S"/>

  <!-- Cobalt field micro-emitters C on the pylons              -->
  <box at="1 4 10" size="1 1 1" color="C"/>
  <box at="6 4 10" size="1 1 1" color="C"/>
  <box at="1 4 13" size="1 1 1" color="C"/>
  <box at="6 4 13" size="1 1 1" color="C"/>

  <!-- ======================================================== -->
  <!-- 7. VERTICAL HOLOGRAPHIC SCREEN (z = 8..15, x = 2..5)      -->
  <!-- ======================================================== -->
  <!-- Rising photon projection base (z=8..9)                    -->
  <box at="3.5 3.5 8" size="2 2 2" color="N"/>
  <box at="2 3.5 8" size="1 2 2" color="C"/>
  <box at="5 3.5 8" size="1 2 2" color="C"/>
  <box at="3.5 4.0 8" size="2 1 1" color="W"/>

  <!-- Lattice of the semi-transparent central display (z=10..13) -->
  <!-- Back layer (y=3): waveguide substrate and reflections T, Z -->
  <box at="3.5 3.0 10" size="4 1 4" color="T"/>
  <box at="3.5 3.0 11" size="2 1 2" color="Z"/>
  <box at="2 3 12" size="1 1 1" color="B"/>
  <box at="5 3 12" size="1 1 1" color="B"/>

  <!-- Front layer (y=4): active matrix with markers X and Y    -->
  <box at="3.5 4.0 10" size="4 1 4" color="X"/>
  <box at="3.5 4.0 11" size="2 1 3" color="Y"/>
  <box at="2 4 10" size="1 1 1" color="N"/>
  <box at="5 4 10" size="1 1 1" color="N"/>
  <box at="3 4 13" size="1 1 1" color="W"/>
  <box at="4 4 13" size="1 1 1" color="W"/>
  <box at="2 4 12" size="1 1 1" color="B"/>
  <box at="5 4 12" size="1 1 1" color="B"/>

  <!-- Crowning of the hologram towards the emitter (z=14..15)  -->
  <box at="3.5 3.5 14" size="4 2 1" color="C"/>
  <box at="3.5 4.0 14" size="2 1 1" color="W"/>
  <box at="3.5 3.5 15" size="2 2 1" color="N"/>
  <box at="2 3.5 15" size="1 2 1" color="T"/>
  <box at="5 3.5 15" size="1 2 1" color="T"/>

  <!-- ======================================================== -->
  <!-- 8. UPPER PHASE-SCANNING CROSSBAR (z = 16)                 -->
  <!-- ======================================================== -->
  <box at="3.5 3.5 16" size="6 2 1" color="m"/>
  <box at="3.5 3.5 16" size="2 2 1" color="M"/>
  <box at="1 3.5 16" size="1 2 1" color="S"/>
  <box at="6 3.5 16" size="1 2 1" color="S"/>
  <box at="3.5 4.0 16" size="2 1 1" color="N"/>

  <!-- ======================================================== -->
  <!-- 9. TELEMETRY SENSOR AND ANTENNA CUSP (z = 17..18)        -->
  <!-- ======================================================== -->
  <!-- Pod of the telemetry sensor at z=17                      -->
  <box at="3.5 3.5 17" size="2 2 1" color="S"/>
  <box at="3 4 17" size="1 1 1" color="m"/>
  <box at="4 4 17" size="1 1 1" color="m"/>
  <box at="3.5 4.0 17" size="2 1 1" color="E"/>

  <!-- Antenna cusp and sector beacon at z=18                   -->
  <box at="3 3 18" size="1 1 1" color="s"/>
  <box at="4 3 18" size="1 1 1" color="s"/>
  <box at="3.5 4.0 18" size="2 1 1" color="e"/>

  <!-- ======================================================== -->
  <!-- 10. GENERATIVE RULES: STOCHASTIC VARIANTS IN THE SEEDS   -->
  <!-- ======================================================== -->
  <!-- A) Rear heat sink (H)                                    -->
  <one steps="3">
    <rule in="H" out="m" p="0.45"/>
    <rule in="H" out="S" p="0.30"/>
    <rule in="H" out="B" p="0.25"/>
  </one>
  <all in="H" out="m" optional="True"/>

  <!-- B) Resolution of the circuit bus on the display (X)      -->
  <!-- Forming horizontal circuit lines and junctions -->
  <prl steps="1" optional="True">
    <rule in="X X" out="N C" p="0.45"/>
    <rule in="X B" out="N *" p="0.30"/>
  </prl>
  <one steps="6">
    <rule in="X" out="N" p="0.45"/>
    <rule in="X" out="C" p="0.35"/>
    <rule in="X" out="W" p="0.20"/>
  </one>
  <all in="X" out="N" optional="True"/>

  <!-- C) Resolution of the binary runes and holographic texts (Y) -->
  <!-- Forming vertical sequences of runic bits (photon 1/0) -->
  <prl steps="1" optional="True">
    <rule in="Y Y" out="W B" p="0.40"/>
    <rule in="Y N" out="W *" p="0.30"/>
  </prl>
  <one steps="6">
    <rule in="Y" out="W" p="0.50"/>
    <rule in="Y" out="N" p="0.30"/>
    <rule in="Y" out="B" p="0.20"/>
  </one>
  <all in="Y" out="W" optional="True"/>

  <!-- D) Resolution of the waveguide and quantum density (Z)   -->
  <one steps="3">
    <rule in="Z" out="C" p="0.40"/>
    <rule in="Z" out="T" p="0.35"/>
    <rule in="Z" out="B" p="0.25"/>
  </one>
  <all in="Z" out="C" optional="True"/>

  <!-- E) Stochastic branching of the photon circuits            -->
  <prl steps="1" optional="True">
    <rule in="N B" out="N C" p="0.22"/>
    <rule in="C B" out="C T" p="0.18"/>
    <rule in="W N" out="W W" p="0.15"/>
  </prl>

  <!-- F) Thinning out to guarantee the volumetric semi-transparency -->
  <prl steps="1" optional="True">
    <rule in="C C C" out="* B *" p="0.18"/>
  </prl>
</sequence>

<!-- ============================================================ -->
<!-- 11. DATA ANIMATION (6 FRAMES): BIT FLOW AND PULSE            -->
<!-- ============================================================ -->
<animation name="dati" frames="6">
  <sequence>
    <!-- The white data packets W slide along the cyan N and cobalt C channels -->
    <prl steps="1">
      <rule in="W N" out="N W" p="0.40"/>
      <rule in="N W" out="W N" p="0.40"/>
      <rule in="W C" out="C W" p="0.35"/>
      <rule in="C W" out="W C" p="0.35"/>
    </prl>

    <!-- Modulation of the lower laser slit and of the holographic beam -->
    <prl steps="1">
      <rule in="E N" out="N E" p="0.30"/>
      <rule in="N E" out="E N" p="0.30"/>
    </prl>

    <!-- Telemetry pulse of the antenna cusp: only where the chrome rod s is below -->
    <!-- in="e s" means the upper layer and, above it, the lower layer s -->
    <prl steps="1">
      <rule in="e s" out="W *" p="0.35"/>
      <rule in="W s" out="e *" p="0.35"/>
    </prl>
  </sequence>
</animation>
