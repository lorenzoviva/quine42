<!-- ================================================================= -->
<!-- ANIMAZIONE CICLICA "ENERGIA" (8 frame, onda macroscopica deterministica) -->
<!-- Ogni anello e sezione luminosa pulsa all'unisono senza casualità:   -->
<!--   w (apice bianco-viola) -> T (viola brillante) ->                -->
<!--   t (porpora medio) -> u (viola profondo) -> w                     -->
<!-- ================================================================= -->
<animation name="energia" frames="8">
  <sequence>
    <!-- Passo 1: salva lo stato T nel buffer x -->
    <all in="T" out="x"/>
    <!-- Passo 2: w (apice) decade a T (alta energia) -->
    <all in="w" out="T"/>
    <!-- Passo 3: u (minimo) si carica ed esplode a w (apice bianco-viola) -->
    <all in="u" out="w"/>
    <!-- Passo 4: t (media energia) sfuma a u (minimo) -->
    <all in="t" out="u"/>
    <!-- Passo 5: il vecchio T salvato in x passa a t (media energia) -->
    <all in="x" out="t"/>
  </sequence>
</animation>
