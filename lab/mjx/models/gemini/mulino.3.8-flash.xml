<!-- Mulino a vento: scolpito da gemini-3.8-flash nello step 8.2B (lab/out/trial-3.8-flash-1, giro-1), voto del giudice gemini-3.8-flash 6/10 -->
<sequence values="BXDdWIiNnFfTtCcPpVvh" size="100 100 80" origin="False">
  <color symbol="X" hidden="True" name="struttura grezza"/>
  <color symbol="D" value="7e7a72" name="pietra base"/>
  <color symbol="d" value="54504a" name="pietra scura ombre"/>
  <color symbol="W" value="a6a096" name="pietra chiara risalti"/>
  <color symbol="I" hidden="True" name="scavo interno"/>
  <color symbol="i" value="634327" name="pavimento legno"/>
  <color symbol="N" value="5c3a1e" name="travi e bracci"/>
  <color symbol="n" value="8a5d35" name="tavole ballatoio"/>
  <color symbol="F" value="422610" name="ringhiera"/>
  <color symbol="f" value="2c1a0e" name="mozzo pale"/>
  <color symbol="T" value="9e462d" name="tegole cono"/>
  <color symbol="t" value="702c1b" name="tegole scure"/>
  <color symbol="C" value="f2ece1" name="tela vela"/>
  <color symbol="c" value="c2b8a7" name="tela ombra"/>
  <color symbol="P" value="dfd5be" name="sacco farina"/>
  <color symbol="p" value="ab9f82" name="ombra sacco"/>
  <color symbol="V" value="1d2f38" name="vano finestra"/>
  <color symbol="h" value="331e11" name="vano porta"/>

  <!-- 1. Torre principale in pietra (rastremata dal basso verso l'alto) -->
  <cylinder at="50 50 0" r="15" h="14" color="D"/>
  <cylinder at="50 50 14" r="14" h="14" color="D"/>
  <cylinder at="50 50 28" r="13" h="14" color="D"/>
  <cylinder at="50 50 42" r="12" h="10" color="D"/>

  <!-- 2. Interno calpestabile e vano torre -->
  <cylinder at="50 50 1" r="10" h="48" color="B"/>
  <cylinder at="50 50 0" r="10" h="1" color="i"/>

  <!-- 3. Tetto a cono marcato e sporgente in legno/tegole (z=52 a z=76) -->
  <cone at="50 50 52" r="14" h="24" color="T"/>
  <!-- Sporgenza della gronda del tetto -->
  <cylinder at="50 50 51" r="14" h="2" color="t"/>

  <!-- 4. Ballatoio anulare in legno con ringhiera a z=26 -->
  <!-- Assito sporgente del ballatoio -->
  <cylinder at="50 50 26" r="17" h="2" color="n"/>
  <cylinder at="50 50 26" r="13" h="2" color="D"/>
  <!-- Ringhiera del ballatoio -->
  <cylinder at="50 50 28" r="17" h="3" color="F"/>
  <cylinder at="50 50 28" r="16" h="3" color="B"/>

  <!-- 5. Porta ad arco frontale al piano terra (y grande, verso sud z=0..9) -->
  <box at="47 62 0" size="6 6 8" color="h"/>
  <box at="48 62 8" size="4 6 2" color="h"/>
  <box at="46 63 0" size="8 2 10" color="N" on="D"/>

  <!-- 6. Finestrelle aperte con cornice -->
  <!-- Finestra piano terra (retro) -->
  <box at="48 34 8" size="4 6 5" color="V"/>
  <!-- Finestra sopra il ballatoio (davanti) -->
  <box at="48 60 34" size="4 6 5" color="V"/>

  <!-- 7. Mozzo delle pale: sporge in avanti dal cornicione (z=50, y=60..67) -->
  <cylinder at="50 63 50" r="3" h="4" color="f"/>
  <box at="49 61 49" size="2 6 2" color="f"/>

  <!-- 8. Le quattro grandi pale a croce (centro x=50, y=67, z=50) -->
  <!-- Bracci portanti in legno (asse X e asse Z) -->
  <box at="26 67 49" size="48 2 2" color="N"/>
  <box at="49 67 26" size="2 2 48" color="N"/>

  <!-- Vele di tela montate sui bracci -->
  <!-- Pala orizzontale destra: x=53..73, z=51..57 -->
  <box at="53 66 51" size="20 1 7" color="C"/>
  <box at="53 66 57" size="20 1 1" color="N"/>
  <!-- Pala orizzontale sinistra: x=27..47, z=43..49 -->
  <box at="27 66 43" size="20 1 7" color="C"/>
  <box at="27 66 43" size="20 1 1" color="N"/>
  <!-- Pala verticale superiore: z=53..73, x=43..49 -->
  <box at="43 66 53" size="7 1 20" color="C"/>
  <box at="43 66 53" size="1 1 20" color="N"/>
  <!-- Pala verticale inferiore: z=27..47, x=51..57 -->
  <box at="51 66 27" size="7 1 20" color="C"/>
  <box at="57 66 27" size="1 1 20" color="N"/>

  <!-- 9. Dettaglio sacchi di farina accanto alla porta -->
  <box at="41 63 0" size="4 4 4" color="P"/>
  <box at="42 64 4" size="3 3 3" color="P"/>
  <box at="38 62 0" size="3 4 3" color="p"/>

  <!-- 10. Tessitura pulita e contrastata (clustering pixel art, non rumore) -->
  <!-- Pietra: blocchi chiaroscuri controllati -->
  <prl in="DD/DD" out="WW/WW" p="0.08" steps="1"/>
  <prl in="DD/DD" out="dd/dd" p="0.08" steps="1"/>
  <prl in="T" out="t" p="0.25" steps="1"/>
  <prl in="C" out="c" p="0.15" steps="1"/>
</sequence>
<animation name="vento" frames="4">
  <prl in="C" out="c" p="0.2" steps="1"/>
  <prl in="c" out="C" p="0.2" steps="1"/>
</animation>
