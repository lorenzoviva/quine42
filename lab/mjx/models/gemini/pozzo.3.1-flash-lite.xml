<!-- Pozzo: scolpito da gemini-3.1-flash-lite nello step 8.2A (lab/out/mjx-31-flash-lite-2), voti dell'Artista 4 → 5/10 -->
<sequence values="B D d G N n R r U K" size="50 50 50" origin="True" symmetry="(xy)">
  <color symbol="B" hidden="True"/>
  <color symbol="D" value="8a8478" name="pietra base"/>
  <color symbol="d" value="5e5a52" name="pietra ombra"/>
  <color symbol="G" value="4a6e3e" name="muschio"/>
  <color symbol="N" value="6b4528" name="legno chiaro"/>
  <color symbol="n" value="4a2e1a" name="legno scuro"/>
  <color symbol="R" value="a63737" name="tetto rosso"/>
  <color symbol="r" value="6b2424" name="tetto ombra"/>
  <color symbol="U" value="2a5a8a" name="acqua"/>
  <color symbol="K" value="8e8e8e" name="secchio"/>

  <!-- Base del pozzo: cilindro basso e largo, altezza 10 -->
  <cylinder at="25 25 0" size="22 22 10" color="D"/>
  <!-- Scavo interno -->
  <cylinder at="25 25 1" size="18 18 10" color="B"/>
  <!-- Acqua nel fondo -->
  <cylinder at="25 25 1" size="18 18 3" color="U"/>

  <!-- Pilastri di sostegno (2 pali robusti che partono dal bordo interno del pozzo) -->
  <box at="14 25 10" size="2 2 18" color="N"/>
  <box at="36 25 10" size="2 2 18" color="N"/>
  
  <!-- Trave orizzontale superiore che collega i pilastri -->
  <box at="25 25 28" size="24 2 2" color="N"/>

  <!-- Tetto a capanna centrato -->
  <box at="25 25 30" size="24 22 6" color="R"/>
  <all in="B R" out="R *" steps="6"/>
  <all in="R/B" out="R/R" steps="2"/>

  <!-- Secchio appeso al centro -->
  <box at="25 25 28" size="1 1 18" color="n"/>
  <box at="25 25 10" size="4 4 4" color="K"/>

  <!-- Texture: Muschio e crepe sulla pietra -->
  <prl in="D" out="G" p="0.15" steps="1"/>
  <prl in="D" out="d" p="0.2" steps="1"/>
  <all in="D/B" out="D/G" steps="1"/>

  <!-- Dettaglio legno: venature scure -->
  <prl in="N" out="n" p="0.4" steps="1"/>

  <!-- Ombre e rifiniture tetto -->
  <all in="R R" out="R r" p="0.3" symmetry="(x)"/>
  
  <!-- Decorazione: bordi del pozzo -->
  <all in="D/B" out="D/d" steps="1"/>
</sequence>
