<!-- Cervo reale (Cantiere 8, aurora): zampe, corpo e testa scelti a caso; i palchi crescono a rami da due punte sulla testa. -->
<sequence values="BFWGKAPu#1#2#3#4#5#6z" size="500 500 50" symmetry="(xy)" name="Cervo reale">
  <color symbol="F" value="a0643a" name="mantello fulvo"/>
  <color symbol="W" value="e8d6b4" name="ventre chiaro"/>
  <color symbol="G" value="7a4a2a" name="zampe" part="gamba"/>
  <color symbol="K" value="2a1d14" name="zoccoli e naso"/>
  <color symbol="A" value="efe3c8" name="palco d'osso"/>
  <color symbol="P" hidden="True" name="marcatore"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="#1" hidden="True" name="marcatore"/>
  <color symbol="#2" hidden="True" name="marcatore"/>
  <color symbol="#3" hidden="True" name="marcatore"/>
  <color symbol="#4" hidden="True" name="marcatore"/>
  <color symbol="#5" hidden="True" name="marcatore"/>
  <color symbol="#6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <!-- scelta «zampe»: ferma | al passo | in slancio -->
  <box at="12 20 0" size="19 38 15" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: ferma -->
  <box at="8 12 0" size="3 3 2" color="K" on="#1"/>
  <box at="16 12 0" size="3 3 2" color="K" on="#1"/>
  <box at="8 28 0" size="3 3 2" color="K" on="#1"/>
  <box at="16 28 0" size="3 3 2" color="K" on="#1"/>
  <cylinder at="8 12 0" size="3 3 14" color="G" on="#1"/>
  <cylinder at="16 12 0" size="3 3 14" color="G" on="#1"/>
  <cylinder at="8 28 0" size="3 3 14" color="G" on="#1"/>
  <cylinder at="16 28 0" size="3 3 14" color="G" on="#1"/>
  <!--   2: al passo -->
  <line at="8 32 0" to="8 28 13" r="1" color="G" on="#2"/>
  <line at="16 25 0" to="16 28 13" r="1" color="G" on="#2"/>
  <line at="8 8 0" to="8 12 13" r="1" color="G" on="#2"/>
  <line at="16 15 0" to="16 12 13" r="1" color="G" on="#2"/>
  <!--   3: in slancio -->
  <line at="8 37 1" to="8 28 13" r="1" color="G" on="#3"/>
  <line at="16 35 0" to="16 28 13" r="1" color="G" on="#3"/>
  <line at="8 3 0" to="8 12 13" r="1" color="G" on="#3"/>
  <line at="16 5 1" to="16 12 13" r="1" color="G" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <!-- scelta «corporatura»: snella | robusta | lunga -->
  <box at="12 20 7" size="18 32 16" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: snella -->
  <ellipsoid at="12 20 10" size="11 24 10" color="F" on="#1"/>
  <!--   2: robusta -->
  <ellipsoid at="12 20 9" size="15 26 12" color="F" on="#2"/>
  <!--   3: lunga -->
  <ellipsoid at="12 19 10" size="12 30 9" color="F" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <ellipsoid at="12 20 8" size="9 20 5" color="W" on="F"/>
  <ellipsoid at="12 8 13" size="3 4 4" color="W"/>
  <!-- scelta «portamento»: fiero | al pascolo | voltato | al bramito -->
  <box at="12 32 0" size="25 16 30" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/><rule in="u" out="#4"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/><rule in="#4u" out="*#4"/></all>
  <!--   1: fiero -->
  <ellipsoid at="12 33 21" size="6 7 6" color="F" on="#1"/>
  <box at="12 37 22" size="3 3 3" color="K" on="#1"/>
  <line at="12 27 15" to="12 32 22" r="2" color="F" on="#1"/>
  <box at="10 33 27" size="1 1 1" color="P" on="#1"/>
  <box at="14 33 27" size="1 1 1" color="P" on="#1"/>
  <!--   2: al pascolo -->
  <ellipsoid at="12 35 2" size="6 7 6" color="F" on="#2"/>
  <box at="12 38 2" size="3 2 3" color="K" on="#2"/>
  <line at="12 27 14" to="12 34 5" r="2" color="F" on="#2"/>
  <box at="10 35 8" size="1 1 1" color="P" on="#2"/>
  <box at="14 35 8" size="1 1 1" color="P" on="#2"/>
  <!--   3: voltato -->
  <ellipsoid at="6 33 20" size="6 7 6" color="F" on="#3"/>
  <box at="4 36 21" size="3 3 3" color="K" on="#3"/>
  <line at="12 27 15" to="7 32 21" r="2" color="F" on="#3"/>
  <box at="4 33 26" size="1 1 1" color="P" on="#3"/>
  <box at="8 33 26" size="1 1 1" color="P" on="#3"/>
  <!--   4: al bramito -->
  <ellipsoid at="12 32 22" size="6 6 7" color="F" on="#4"/>
  <box at="12 35 27" size="3 3 3" color="K" on="#4"/>
  <line at="12 27 15" to="12 31 22" r="2" color="F" on="#4"/>
  <box at="10 30 29" size="1 1 1" color="P" on="#4"/>
  <box at="14 30 29" size="1 1 1" color="P" on="#4"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/><rule in="#4" out="B"/></prl>
  <!-- i palchi: due punte salgono, piegano, si biforcano -->
  <one steps="22">
    <rule in="B P" out="P A" p="1"/>
    <rule in="B* *P" out="P* *A" p="2"/>
    <rule in="B*B *P*" out="P*P *A*" p="0.6"/>
  </one>
  <prl in="P" out="A"/>
</sequence>
