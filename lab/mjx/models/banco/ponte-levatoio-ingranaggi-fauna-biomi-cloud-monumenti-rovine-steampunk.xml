<!-- Ponte levatoio a ingranaggi (Cantiere 8, orichalcum): ponte, torri e ruote a caso; denti e ruggine a caso. -->
<sequence values="BKWIOZNu#1#2#3#4#5#6z" size="500 500 50" symmetry="(xy)" name="Ponte levatoio a ingranaggi">
  <color symbol="K" value="8a4a35" name="mattoni"/>
  <color symbol="W" value="6b4a2a" name="tavolato"/>
  <color symbol="I" value="3a3633" name="ferro"/>
  <color symbol="O" value="b88a2e" name="ruote d'ottone"/>
  <color symbol="Z" value="8a4a2a" name="ruggine"/>
  <color symbol="N" value="2a2826" name="catene"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="#1" hidden="True" name="marcatore"/>
  <color symbol="#2" hidden="True" name="marcatore"/>
  <color symbol="#3" hidden="True" name="marcatore"/>
  <color symbol="#4" hidden="True" name="marcatore"/>
  <color symbol="#5" hidden="True" name="marcatore"/>
  <color symbol="#6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <!-- scelta «torri»: tonde | quadre | a traliccio -->
  <box at="25 38 0" size="50 24 50" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: tonde -->
  <cylinder at="9 38 0" size="14 14 36" color="K" on="#1"/>
  <cylinder at="41 38 0" size="14 14 36" color="K" on="#1"/>
  <cone at="9 38 36" size="16 16 10" color="I" on="#1"/>
  <cone at="41 38 36" size="16 16 10" color="I" on="#1"/>
  <box at="25 38 26" size="24 8 10" color="K" on="#1"/>
  <!--   2: quadre -->
  <box at="9 38 0" size="13 13 38" color="K" on="#2"/>
  <box at="41 38 0" size="13 13 38" color="K" on="#2"/>
  <box at="9 38 38" size="15 15 2" color="I" on="#2"/>
  <box at="41 38 38" size="15 15 2" color="I" on="#2"/>
  <box at="25 38 28" size="24 8 10" color="K" on="#2"/>
  <!--   3: a traliccio -->
  <line at="4 33 0" to="8 37 36" r="1" color="I" on="#3"/>
  <line at="14 33 0" to="10 37 36" r="1" color="I" on="#3"/>
  <line at="4 43 0" to="8 39 36" r="1" color="I" on="#3"/>
  <line at="14 43 0" to="10 39 36" r="1" color="I" on="#3"/>
  <line at="36 33 0" to="40 37 36" r="1" color="I" on="#3"/>
  <line at="46 33 0" to="42 37 36" r="1" color="I" on="#3"/>
  <line at="36 43 0" to="40 39 36" r="1" color="I" on="#3"/>
  <line at="46 43 0" to="42 39 36" r="1" color="I" on="#3"/>
  <box at="25 38 34" size="42 8 4" color="I" on="#3"/>
  <line at="9 38 0" to="9 38 34" r="1" color="I" on="#3"/>
  <line at="41 38 0" to="41 38 34" r="1" color="I" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <box at="25 31 0" size="24 3 4" color="I" on="B"/>
  <!-- scelta «ponte»: abbassato | alzato | a metà -->
  <box at="25 18 0" size="24 36 38" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: abbassato -->
  <box at="25 15 3" size="18 30 2" color="W" on="#1"/>
  <box at="25 1 0" size="20 3 3" color="I" on="#1"/>
  <line at="16 2 5" to="12 33 30" r="0.5" color="N" on="#1"/>
  <line at="34 2 5" to="38 33 30" r="0.5" color="N" on="#1"/>
  <!--   2: alzato -->
  <box at="25 30 3" size="18 2 30" color="W" on="#2"/>
  <line at="16 30 32" to="12 34 32" r="0.5" color="N" on="#2"/>
  <line at="34 30 32" to="38 34 32" r="0.5" color="N" on="#2"/>
  <!--   3: a metà -->
  <line at="17 30 4" to="33 30 4" r="1" color="W" on="#3"/>
  <line at="17 28 6" to="33 28 6" r="1" color="W" on="#3"/>
  <line at="17 26 8" to="33 26 8" r="1" color="W" on="#3"/>
  <line at="17 24 10" to="33 24 10" r="1" color="W" on="#3"/>
  <line at="17 22 12" to="33 22 12" r="1" color="W" on="#3"/>
  <line at="17 20 14" to="33 20 14" r="1" color="W" on="#3"/>
  <line at="17 18 16" to="33 18 16" r="1" color="W" on="#3"/>
  <line at="17 16 18" to="33 16 18" r="1" color="W" on="#3"/>
  <line at="17 14 20" to="33 14 20" r="1" color="W" on="#3"/>
  <line at="16 14 20" to="12 33 30" r="0.5" color="N" on="#3"/>
  <line at="34 14 20" to="38 33 30" r="0.5" color="N" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <!-- scelta «ruote»: una grande per torre | due piccole | un treno di tre -->
  <box at="25 38 4" size="50 24 44" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: una grande per torre -->
  <ellipsoid at="1 38 16" size="2 16 16" color="O" on="#1"/>
  <ellipsoid at="49 38 16" size="2 16 16" color="O" on="#1"/>
  <line at="1 38 16" to="9 38 16" r="1" color="I" on="#1"/>
  <line at="49 38 16" to="41 38 16" r="1" color="I" on="#1"/>
  <!--   2: due piccole -->
  <ellipsoid at="1 34 10" size="2 9 9" color="O" on="#2"/>
  <ellipsoid at="1 42 22" size="2 9 9" color="O" on="#2"/>
  <ellipsoid at="49 34 10" size="2 9 9" color="O" on="#2"/>
  <ellipsoid at="49 42 22" size="2 9 9" color="O" on="#2"/>
  <line at="1 34 14" to="9 38 14" r="1" color="I" on="#2"/>
  <line at="1 42 26" to="9 38 26" r="1" color="I" on="#2"/>
  <line at="49 34 14" to="41 38 14" r="1" color="I" on="#2"/>
  <line at="49 42 26" to="41 38 26" r="1" color="I" on="#2"/>
  <!--   3: un treno di tre -->
  <ellipsoid at="25 42 30" size="12 2 12" color="O" on="#3"/>
  <ellipsoid at="15 42 34" size="8 2 8" color="O" on="#3"/>
  <ellipsoid at="35 42 34" size="8 2 8" color="O" on="#3"/>
  <box at="25 43 35" size="3 2 3" color="I" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <!-- denti delle ruote, rivetti, ruggine -->
  <prl in="BO" out="*O" p="0.25" steps="1"/>
  <prl in="BI" out="*Z" p="0.1" steps="1"/>
  <prl in="B K" out="* Z" p="0.1" steps="1"/>
</sequence>
