<!-- Alchemical bookcase (fantasy, aurora): a wooden shelf against the wall, with leather tomes and glowing phials on the shelves. The seed
     picks the shape (tall and narrow, wide and low with a divider, or medium with an alchemist's bench in front and an alembic), which
     shelves have books and how tall each tome is, where the phials stand and what is on the cornice on top. -->
<sequence values="BDWpKYyQGgCFVabo" size="20 20 20" symmetry="(xy)" name="Libreria alchemica">
  <color symbol="D" value="4a3020" name="legno scuro"/>
  <color symbol="W" value="6b4a2e" name="legno"/>
  <color symbol="p" value="8a6440" name="ripiano"/>
  <color symbol="K" value="5a3a22" name="cornice intagliata"/>
  <color symbol="Y" value="8c2f2a" name="tomo rosso"/>
  <color symbol="y" value="2f4f8c" name="tomo blu"/>
  <color symbol="Q" value="3f6b3a" name="tomo verde"/>
  <color symbol="G" value="6effc8" name="ampolla luminosa" glow="True"/>
  <color symbol="g" value="d080ff" name="elisir viola" glow="True"/>
  <color symbol="C" value="efe6cc" name="candela"/>
  <color symbol="F" value="ffc04a" name="fiamma" glow="True"/>
  <color symbol="V" hidden="True" name="lo spazio"/>
  <color symbol="a" hidden="True" name="alta e stretta"/>
  <color symbol="b" hidden="True" name="larga e bassa"/>
  <color symbol="o" hidden="True" name="media con il banco"/>
  <!-- The die of the shape -->
  <box at="10 10 0" size="20 20 20" color="a"/>
  <all in="a" out="V"/>
  <one steps="1"><rule in="V" out="a"/><rule in="V" out="b"/><rule in="V" out="o"/></one>
  <all symmetry="(xyz)"><rule in="aV" out="aa"/><rule in="bV" out="bb"/><rule in="oV" out="oo"/></all>
  <!-- Tall and narrow -->
  <box at="10 5 0" size="13 1 17" color="D" on="a"/>
  <box at="4 7 0" size="1 5 17" color="W" on="a"/>
  <box at="16 7 0" size="1 5 17" color="W" on="a"/>
  <box at="10 7 0" size="11 5 1" color="p" on="a"/>
  <box at="10 7 5" size="11 5 1" color="p" on="a"/>
  <box at="10 7 10" size="11 5 1" color="p" on="a"/>
  <box at="10 7 14" size="11 5 1" color="p" on="a"/>
  <box at="10 7 17" size="15 7 1" color="K" on="a"/>
  <box at="10 6 18" size="7 3 1" color="K" on="a"/>
  <!-- Wide and low, with a divider -->
  <box at="10 5 0" size="19 1 12" color="D" on="b"/>
  <box at="1 7 0" size="1 5 12" color="W" on="b"/>
  <box at="19 7 0" size="1 5 12" color="W" on="b"/>
  <box at="10 7 0" size="1 5 12" color="W" on="b"/>
  <box at="10 7 0" size="17 5 1" color="p" on="b"/>
  <box at="10 7 4" size="17 5 1" color="p" on="b"/>
  <box at="10 7 8" size="17 5 1" color="p" on="b"/>
  <box at="10 7 12" size="19 6 1" color="K" on="b"/>
  <!-- Medium, with the alchemist's bench -->
  <box at="10 5 0" size="15 1 15" color="D" on="o"/>
  <box at="3 7 0" size="1 5 15" color="W" on="o"/>
  <box at="17 7 0" size="1 5 15" color="W" on="o"/>
  <box at="10 7 0" size="13 5 1" color="p" on="o"/>
  <box at="10 7 5" size="13 5 1" color="p" on="o"/>
  <box at="10 7 10" size="13 5 1" color="p" on="o"/>
  <box at="10 7 15" size="17 7 1" color="K" on="o"/>
  <box at="4 13 0" size="1 1 5" color="W" on="o"/>
  <box at="16 13 0" size="1 1 5" color="W" on="o"/>
  <box at="4 10 0" size="1 1 5" color="W" on="o"/>
  <box at="16 10 0" size="1 1 5" color="W" on="o"/>
  <box at="10 12 5" size="15 5 1" color="p" on="o"/>
  <ellipsoid at="6 12 6" size="3 3 3" color="g" on="o"/>
  <line at="6 12 9" to="10 12 10" r="0" color="G" on="o"/>
  <line at="10 12 10" to="12 12 6" r="0" color="G" on="o"/>
  <!-- The phials and the tomes on the shelves: where and how tall is picked by the seed -->
  <prl steps="1" in="[abo] p" out="G *" p="0.05"/>
  <prl steps="1" in="[abo] p" out="Y *" p="0.55"/>
  <all steps="1" in="[abo] Y" out="Y *"/>
  <prl steps="2" in="[abo] Y" out="Y *" p="0.5"/>
  <prl steps="1" in="[abo] K" out="C *" p="0.03"/>
  <all steps="1" in="[abo] C" out="F *"/>
  <prl steps="1">
    <rule in="Y" out="y" p="0.3"/>
    <rule in="Y" out="Q" p="0.2"/>
  </prl>
  <all in="[Vabo]" out="B"/>
</sequence>
