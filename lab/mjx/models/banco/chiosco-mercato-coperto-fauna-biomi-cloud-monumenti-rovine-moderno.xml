<!-- Mercato coperto (Cantiere 8, neapolis): tetto, banchi e tende a caso; frutta e cassette a caso. -->
<sequence values="BSIRWTUYEGCPu#1#2#3#4#5#6z" size="500 500 50" symmetry="(xy)" name="Mercato coperto">
  <color symbol="S" value="b8b4aa" name="pavimento"/>
  <color symbol="I" value="4a5058" name="acciaio"/>
  <color symbol="R" value="c0c6cc" name="lamiera del tetto"/>
  <color symbol="W" value="8a6a4a" name="banchi"/>
  <color symbol="T" value="d04030" name="tende rosse"/>
  <color symbol="U" value="3a8a4a" name="tende verdi"/>
  <color symbol="Y" value="f2c94c" name="limoni"/>
  <color symbol="E" value="d8402a" name="pomodori"/>
  <color symbol="G" value="7ab040" name="mele verdi"/>
  <color symbol="C" value="b8875a" name="cassette"/>
  <color symbol="P" hidden="True" name="marcatore"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="#1" hidden="True" name="marcatore"/>
  <color symbol="#2" hidden="True" name="marcatore"/>
  <color symbol="#3" hidden="True" name="marcatore"/>
  <color symbol="#4" hidden="True" name="marcatore"/>
  <color symbol="#5" hidden="True" name="marcatore"/>
  <color symbol="#6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <box at="25 25 0" size="46 46 1" color="S"/>
  <line at="6 6 1" to="6 6 24" r="1" color="I"/>
  <line at="44 6 1" to="44 6 24" r="1" color="I"/>
  <line at="6 44 1" to="6 44 24" r="1" color="I"/>
  <line at="44 44 1" to="44 44 24" r="1" color="I"/>
  <line at="6 25 1" to="6 25 24" r="1" color="I"/>
  <line at="44 25 1" to="44 25 24" r="1" color="I"/>
  <!-- scelta «tetto»: a capanna | a volta | a ombrello | a dente di sega -->
  <box at="25 25 23" size="50 50 27" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/><rule in="u" out="#4"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/><rule in="#4u" out="*#4"/></all>
  <!--   1: a capanna -->
  <box at="25 25 24" size="48 46 2" color="R" on="#1"/>
  <box at="25 25 26" size="48 40 2" color="R" on="#1"/>
  <box at="25 25 28" size="48 34 2" color="R" on="#1"/>
  <box at="25 25 30" size="48 28 2" color="R" on="#1"/>
  <box at="25 25 32" size="48 22 2" color="R" on="#1"/>
  <box at="25 25 34" size="48 16 2" color="R" on="#1"/>
  <box at="25 25 36" size="48 10 2" color="R" on="#1"/>
  <box at="25 25 38" size="48 4 2" color="R" on="#1"/>
  <!--   2: a volta -->
  <ellipsoid at="25 25 6" size="48 48 44" color="x" on="#2"/>
  <ellipsoid at="25 25 4" size="50 50 48" color="R" on="#2"/>
  <box at="25 25 24" size="48 48 1" color="I" on="#2"/>
  <!--   3: a ombrello -->
  <cone at="25 25 24" size="50 50 20" color="R" on="#3"/>
  <line at="25 25 1" to="25 25 24" r="1.5" color="I" on="#3"/>
  <!--   4: a dente di sega -->
  <box at="25 25 23" size="48 46 1" color="I" on="#4"/>
  <box at="25 4 24" size="48 3 2" color="R" on="#4"/>
  <box at="25 5 26" size="48 3 2" color="R" on="#4"/>
  <box at="25 6 28" size="48 3 2" color="R" on="#4"/>
  <box at="25 7 30" size="48 3 2" color="R" on="#4"/>
  <box at="25 8 32" size="48 3 2" color="R" on="#4"/>
  <box at="25 9 24" size="48 1 10" color="I" on="#4"/>
  <box at="25 16 24" size="48 3 2" color="R" on="#4"/>
  <box at="25 17 26" size="48 3 2" color="R" on="#4"/>
  <box at="25 18 28" size="48 3 2" color="R" on="#4"/>
  <box at="25 19 30" size="48 3 2" color="R" on="#4"/>
  <box at="25 20 32" size="48 3 2" color="R" on="#4"/>
  <box at="25 21 24" size="48 1 10" color="I" on="#4"/>
  <box at="25 28 24" size="48 3 2" color="R" on="#4"/>
  <box at="25 29 26" size="48 3 2" color="R" on="#4"/>
  <box at="25 30 28" size="48 3 2" color="R" on="#4"/>
  <box at="25 31 30" size="48 3 2" color="R" on="#4"/>
  <box at="25 32 32" size="48 3 2" color="R" on="#4"/>
  <box at="25 33 24" size="48 1 10" color="I" on="#4"/>
  <box at="25 40 24" size="48 3 2" color="R" on="#4"/>
  <box at="25 41 26" size="48 3 2" color="R" on="#4"/>
  <box at="25 42 28" size="48 3 2" color="R" on="#4"/>
  <box at="25 43 30" size="48 3 2" color="R" on="#4"/>
  <box at="25 44 32" size="48 3 2" color="R" on="#4"/>
  <box at="25 45 24" size="48 1 10" color="I" on="#4"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/><rule in="#4" out="B"/></prl>
  <prl in="x" out="B"/>
  <!-- scelta «banchi»: due file | a U | uno lungo -->
  <box at="25 25 1" size="40 40 6" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: due file -->
  <box at="16 25 1" size="6 30 5" color="W" on="#1"/>
  <box at="34 25 1" size="6 30 5" color="W" on="#1"/>
  <!--   2: a U -->
  <box at="12 25 1" size="5 30 5" color="W" on="#2"/>
  <box at="38 25 1" size="5 30 5" color="W" on="#2"/>
  <box at="25 38 1" size="30 5 5" color="W" on="#2"/>
  <!--   3: uno lungo -->
  <box at="25 25 1" size="32 7 5" color="W" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <box at="25 6 21" size="40 1 1" color="I"/>
  <box at="25 44 21" size="40 1 1" color="I"/>
  <!-- scelta «tende»: rosse a strisce | verdi | nessuna -->
  <box at="25 25 18" size="50 50 6" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: rosse a strisce -->
  <box at="10 4 19" size="4 4 3" color="T" on="#1"/>
  <box at="18 4 19" size="4 4 3" color="T" on="#1"/>
  <box at="26 4 19" size="4 4 3" color="T" on="#1"/>
  <box at="34 4 19" size="4 4 3" color="T" on="#1"/>
  <box at="42 4 19" size="4 4 3" color="T" on="#1"/>
  <box at="10 46 19" size="4 4 3" color="T" on="#1"/>
  <box at="18 46 19" size="4 4 3" color="T" on="#1"/>
  <box at="26 46 19" size="4 4 3" color="T" on="#1"/>
  <box at="34 46 19" size="4 4 3" color="T" on="#1"/>
  <box at="42 46 19" size="4 4 3" color="T" on="#1"/>
  <!--   2: verdi -->
  <box at="25 4 19" size="36 4 3" color="U" on="#2"/>
  <box at="25 46 19" size="36 4 3" color="U" on="#2"/>
  <!--   3: nessuna -->
  <box at="25 4 22" size="40 1 1" color="I" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <!-- la frutta si posa a caso sui banchi, in tre colori -->
  <one in="B W" out="P *" steps="40"/>
  <all><rule in="P" out="Y"/><rule in="P" out="E"/><rule in="P" out="G"/></all>
  <prl><rule in="BY" out="*Y" p="0.6"/><rule in="BE" out="*E" p="0.6"/><rule in="BG" out="*G" p="0.6"/></prl>
  <!-- cassette impilate -->
  <one in="B S" out="C *" steps="5"/>
  <prl steps="6"><rule in="B C" out="C *" p="0.4"/><rule in="BC" out="CC" p="0.35"/></prl>
</sequence>
