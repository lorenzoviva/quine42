<!-- Cristalli di caverna (Cantiere 8, aurora): massi, cristallo madre e cristalli a caso. -->
<sequence values="BRDXYgPQ#7#8#9#0u#1#2#3#4#5#6z" size="500 500 50" symmetry="(xy)" name="Cristalli di caverna">
  <color symbol="R" value="4f4a56" name="roccia"/>
  <color symbol="D" value="35313b" name="roccia scura"/>
  <color symbol="X" value="b48cff" name="cristallo" glow="True"/>
  <color symbol="Y" value="e2d0ff" name="cristallo chiaro" glow="True"/>
  <color symbol="g" hidden="True" name="marcatore"/>
  <color symbol="P" hidden="True" name="marcatore"/>
  <color symbol="Q" hidden="True" name="marcatore"/>
  <color symbol="#7" hidden="True" name="marcatore"/>
  <color symbol="#8" hidden="True" name="marcatore"/>
  <color symbol="#9" hidden="True" name="marcatore"/>
  <color symbol="#0" hidden="True" name="marcatore"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="#1" hidden="True" name="marcatore"/>
  <color symbol="#2" hidden="True" name="marcatore"/>
  <color symbol="#3" hidden="True" name="marcatore"/>
  <color symbol="#4" hidden="True" name="marcatore"/>
  <color symbol="#5" hidden="True" name="marcatore"/>
  <color symbol="#6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <ellipsoid at="25 25 0" size="22 22 8" color="R"/>
  <!-- 6 massi nascono a caso sul terreno accanto a ciò che c'è già (R) e crescono di lato e in alto -->
  <box at="25 25 0" size="40 40 1" color="g" on="B"/>
  <one in="Rg" out="*R" steps="6"/>
  <prl steps="10"><rule in="R[Bg]" out="*R" p="0.5"/><rule in="B R" out="R *" p="0.35"/></prl>
  <prl in="g" out="B"/>
  <!-- scelta «cristallo madre»: dritto | inclinato | doppio | a ventaglio -->
  <box at="25 25 4" size="40 40 46" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/><rule in="u" out="#4"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/><rule in="#4u" out="*#4"/></all>
  <!--   1: dritto -->
  <line at="25 25 4" to="25 25 44" r="3.5" color="Y" on="#1"/>
  <cone at="25 25 44" size="7 7 5" color="Y" on="#1"/>
  <!--   2: inclinato -->
  <line at="25 25 4" to="15 30 38" r="3.5" color="Y" on="#2"/>
  <line at="15 30 38" to="13 31 44" r="2" color="Y" on="#2"/>
  <!--   3: doppio -->
  <line at="22 25 4" to="16 22 40" r="3" color="Y" on="#3"/>
  <line at="28 25 4" to="34 28 34" r="3" color="Y" on="#3"/>
  <!--   4: a ventaglio -->
  <line at="25 25 4" to="14 25 34" r="2.5" color="Y" on="#4"/>
  <line at="25 25 4" to="25 25 38" r="2.5" color="Y" on="#4"/>
  <line at="25 25 4" to="36 25 34" r="2.5" color="Y" on="#4"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/><rule in="#4" out="B"/></prl>
  <!-- 20 cristalli a caso sulla faccia alta di R: ognuno con la sua direzione e la sua lunghezza -->
  <one in="B R" out="P *" steps="20"/>
  <all symmetry="()"><rule in="P" out="Q"/><rule in="P" out="#7"/><rule in="P" out="#8"/><rule in="P" out="#9"/><rule in="P" out="#0"/></all>
  <prl steps="16" symmetry="()"><rule in="B Q" out="Q X" p="0.8"/><rule in="*B #7*" out="*#7 X*" p="0.8"/><rule in="B* *#8" out="#8* *X" p="0.8"/><rule in="*/B #9/*" out="*/#9 X/*" p="0.8"/><rule in="B/* */#0" out="#0/* */X" p="0.8"/></prl>
  <prl><rule in="Q" out="X"/><rule in="#7" out="X"/><rule in="#8" out="X"/><rule in="#9" out="X"/><rule in="#0" out="X"/></prl>
  <prl in="BX" out="X*" p="0.5" steps="1"/>
  <prl in="BR" out="*D" p="0.2" steps="1"/>
</sequence>
