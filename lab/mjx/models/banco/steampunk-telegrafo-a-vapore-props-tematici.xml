<!-- Telegrafo a vapore, steampunk (Cantiere 2, Parte B): un tavolino di legno scuro su una colonna di ghisa, con il tasto d'ottone,
     la campana del ricevitore, una piccola caldaia di rame col fischietto e la spia ambrata. Il seme sceglie quanto è alta la colonna
     e come è disposto il banco: caldaia a sinistra e bobina del nastro, caldaia a destra e l'antenna dei fili con gli isolatori, o
     una caldaia più alta in fondo fra due bobine; poi dove restano i fogli e le viti sul banco. -->
<sequence values="BEGDOCWAQhks" size="20 20 20" symmetry="(xy)" name="Telegrafo a vapore">
  <color symbol="E" value="3b3a3f" name="ghisa"/>
  <color symbol="G" value="e9dfb8" name="isolatore di porcellana"/>
  <color symbol="D" value="4a2f22" name="legno scuro"/>
  <color symbol="O" value="c9a13b" name="ottone"/>
  <color symbol="C" value="b8653a" name="rame"/>
  <color symbol="W" value="efe6cf" name="nastro di carta"/>
  <color symbol="A" value="f2b54a" name="spia ambrata" glow="True"/>
  <color symbol="Q" value="3b3a3f" name="ghisa della colonna"/>
  <color symbol="h" hidden="True" name="altezze possibili"/>
  <color symbol="k" hidden="True" name="la quota scelta"/>
  <color symbol="s" hidden="True" name="la cima della colonna"/>
  <!-- Il piede e la colonna, poi tagliata alla quota scelta -->
  <box at="10 10 0" size="9 9 1" color="E"/>
  <box at="10 10 1" size="5 5 1" color="E"/>
  <box at="10 10 2" size="3 3 17" color="E"/>
  <box at="10 10 4" size="5 5 1" color="O"/>
  <box at="10 10 2" size="1 1 17" color="Q"/>
  <box at="0 0 6" size="1 1 6" color="h"/>
  <one in="h" out="k" steps="1"/>
  <all in="h" out="B"/>
  <all in="kB" out="kk"/>
  <all in="k[EOQ]" out="kk"/>
  <all in="[BEOQk] k" out="k k"/>
  <all in="k" out="B"/>
  <!-- Il banco, scelto dal seme -->
  <all in="B Q" out="s Q"/>
  <all in="Q" out="E"/>
