<!--
TEMPIO A GRADONI
Pianta grossa (1 casella = 4 voxel):
  x  impronta del primo gradone: rettangolo intorno a N, mezzo lato 8..12 a caso (davanti 8..10)
  W  muro del primo gradone (8 strati); in cima O, la cornice con il parapetto; colonne sulle facce esterne
  G  porta sul davanti, sull'asse, larga 3, coperta;  o  strada scoperta fino al bordo
  q/p  scalinata: due rampe 3x5 ai lati della strada, contro la facciata, salgono verso l'esterno
  w  muro dietro le rampe: in cima V, senza parapetto (lo sbarco sulla terrazza)
  I  anello del secondo gradone (x ristretto di 4, 5 davanti): muro di due piani
  y  sala delle offerte al piano terra; sopra, la cella alta (8+8 strati)
  D  porta nell'anello I: vestibolo-sala sotto, cella alta-terrazza sopra
  g  pavimento libero dietro D;  i/j  scala interna 3x5 contro un muro di I
  P  tramezzi: dagli angoli anteriori di I al muro esterno, e uno sull'asse dietro
  h  vestibolo;  b  vestibolo con un braciere sulla terrazza ai lati della porta alta
  l  le due celle laterali a L;  d  le loro porte dal vestibolo;  k  una statua in fondo a ogni cella
  J  lucernario: buco di 3x6 nella terrazza sopra ogni cella laterale, da saltare
Sopra: terrazza a z=8, anello I fino a z=16 con bracieri agli angoli, piramide d'oro sul tetto della cella.
I semi cambiano i lati, la profondita' della sala, la scala, i lucernari, le porte, la piramide d'oro.
-->
<sequence values="BNE" size="500 500 50" symmetry="(xy)" ground="E" origin="bottom">
  <map scale="1/4 1/4 1/4" values="BNEzaxvWwGoqpyIDPhbldJgijkRFOVnuCKZLHTm">
    <rule in="E" out="E"/><rule in="N" out="N"/>

    <!-- il lotto: margine 2, davanti 4 -->
    <prl in="***/*E*/***" out="***/*z*/***"/>
    <prl in="Ez" out="*E" steps="1"/>
    <prl in="z/E" out="E/*" symmetry="()" steps="2"/>

    <!-- impronta del primo gradone -->
    <all in="Nz" out="*a" steps="1"/>
    <all in="[Nx]az" out="*xa" steps="7"/>
    <prl steps="4"><rule in="xaz" out="*xa" p="0.5"/></prl>
    <prl in="a" out="x"/>
    <all in="[Nx]z/*[Nx]" out="*x/**"/>
    <prl in="z" out="E"/>
    <prl in="Ex" out="*W"/>

    <!-- porta sul davanti -->
    <all in="N/x" out="*/v" symmetry="()" steps="1"/>
    <all in="v/x" out="*/v" symmetry="()"/>
    <all in="v/W" out="*/G" symmetry="()"/>
    <all in="WGW" out="GGG" symmetry="()" steps="1"/>
    <prl in="v" out="x"/>
    <all in="G/E" out="*/o" symmetry="()"/>
    <all in="o/E" out="*/o" symmetry="()"/>

    <!-- scalinata -->
    <all in="GWWWWW/oEEEEE/oEEEEE/oEEEEE" out="******/*qpppp/*qpppp/*qpppp" symmetry="(x)"/>
    <all in="W/[pq]" out="w/*" symmetry="()"/>

    <!-- secondo gradone -->
    <prl in="x" out="y"/>
    <prl in="[WwGx]y" out="*x" steps="3"/>
    <prl in="y/x" out="x/*" symmetry="()" steps="1"/>
    <prl in="xy" out="*I"/>

    <!-- porta della sala sull'asse -->
    <all in="N/y" out="*/v" symmetry="()" steps="1"/>
    <all in="v/y" out="*/v" symmetry="()"/>
    <all in="v/I" out="*/D" symmetry="()"/>
    <all in="IDI" out="DDD" symmetry="()" steps="1"/>
    <prl in="v" out="y"/>

    <!-- tramezzo sull'asse dietro la sala: divide le due celle laterali -->
    <all in="y/N" out="v/*" symmetry="()" steps="1"/>
    <all in="y/v" out="v/*" symmetry="()"/>
    <all in="x/I/v" out="P/*/*" symmetry="()"/>
    <all in="x/P" out="P/*" symmetry="()"/>
    <prl in="v" out="y"/>
    <prl in="N" out="y"/>

    <!-- tramezzi anteriori -->
    <all in="I/I/x" out="*/*/P" symmetry="()"/>
    <all in="P/x" out="*/P" symmetry="()"/>

    <!-- vestibolo e celle laterali -->
    <all in="x/G" out="h/*" symmetry="()"/>
    <all in="hx" out="*h"/>
    <prl in="x" out="l"/>
    <all in="hPl/hPl/hPl" out="*d*/*d*/*d*" steps="1"/>
    <all in="IDDDI/hhhhh" out="*****/b***b" symmetry="()" steps="1"/>

    <!-- pavimento libero dietro la porta della sala -->
    <all in="y/D" out="g/*" symmetry="()"/>
    <all in="y/g" out="g/*" symmetry="()" steps="2"/>

    <!-- statue in fondo alle celle laterali -->
    <all in="WW/lP/lP/lP/II" out="**/**/k*/**/**" symmetry="(x)"/>

    <!-- lucernari da saltare sulla terrazza -->
    <one in="WlllI/WlllI/WlllI/WlllI/WlllI/WlllI/WlllI/WlllI" out="*****/*JJJ*/*JJJ*/*JJJ*/*JJJ*/*JJJ*/*JJJ*/*****" symmetry="()" steps="1"/>
    <one in="IlllW/IlllW/IlllW/IlllW/IlllW/IlllW/IlllW/IlllW" out="*****/*JJJ*/*JJJ*/*JJJ*/*JJJ*/*JJJ*/*JJJ*/*****" symmetry="()" steps="1"/>

    <!-- scala interna contro un muro di I -->
    <one in="IIIIIIII/[yg][yg]yyyyy[yg]/[yg][yg]yyyyy[yg]/[yg][yg]yyyyy[yg]" out="********/**ijjjj*/**ijjjj*/**ijjjj*" steps="1"/>

    <!-- B. altezze -->
    <all in="B W" out="W *" steps="7" symmetry="()"/>
    <all in="B W" out="O *" steps="1" symmetry="()"/>
    <all in="B w" out="w *" steps="7" symmetry="()"/>
    <all in="B w" out="V *" steps="1" symmetry="()"/>
    <all in="B P" out="P *" steps="7" symmetry="()"/>
    <all in="B P" out="F *" steps="1" symmetry="()"/>
    <all in="B I" out="I *" steps="15" symmetry="()"/>
    <all in="B I" out="K *" steps="1" symmetry="()"/>

    <!-- il vano della scala -->
    <all in="B [ij]" out="u *" steps="1" symmetry="()"/>
    <all in="B u" out="u *" steps="14" symmetry="()"/>
    <all in="B u" out="C *" steps="1" symmetry="()"/>

    <!-- piano terra -->
    <all in="B [GDdhblJgy]" out="R *" steps="1" symmetry="()"/>
    <all in="B R" out="R *" steps="6" symmetry="()"/>
    <all in="B k" out="T *" steps="1" symmetry="()"/>
    <all in="B T" out="T *" steps="3" symmetry="()"/>
    <all in="B T" out="m *" steps="1" symmetry="()"/>
    <all in="B m" out="R *" steps="1" symmetry="()"/>
    <all in="B R m" out="R * *" steps="1" symmetry="()"/>
    <all in="B R R R R R R R J" out="n * * * * * * * *" symmetry="()"/>
    <all in="B R R R R R R R G" out="O * * * * * * * *" symmetry="()"/>
    <all in="B R" out="F *" steps="1" symmetry="()"/>

    <!-- cella alta -->
    <all in="B F R R R R R R R [ygD]" out="R * * * * * * * * *" symmetry="()"/>
    <all in="B R" out="R *" steps="6" symmetry="()"/>
    <all in="B R" out="C *" steps="1" symmetry="()"/>
    <all in="B F R R R R R R R b" out="H * * * * * * * * *" symmetry="()"/>

    <!-- finestre -->
    <all in="BBB/WWW BBB/WWW BBB/WWW EEE/WWW" out="***/*L* ***/*** ***/*** ***/***"/>
    <all in="BBB/III BBB/III BBB/III [Fn][Fn][Fn]/III" out="***/*L* ***/*** ***/*** ***/***"/>
    <all in="[WI] L" out="L *" steps="1" symmetry="()"/>

    <!-- piramide d'oro e bracieri agli angoli del secondo gradone -->
    <prl in="***/*B*/*** *C*/CCC/*C*" out="***/*Z*/*** ***/***/***" symmetry="()"/>
    <prl in="***/*B*/*** *Z*/ZZZ/*Z*" out="***/*Z*/*** ***/***/***" symmetry="()"/>
    <all in="***/*B*/*** *B*/BKK/*K*" out="***/*H*/*** ***/***/***"/>

    <!-- C. scala piena -->
    <map scale="4 4 4" values="BSAoseWIPKZLFOVCMXUYQcftT">
      <rule in="B" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB"/>
      <rule in="R" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB"/>
      <rule in="n" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB"/>
      <rule in="u" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB"/>
      <rule in="E" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB SSSS/SSSS/SSSS/SSSS"/>
      <rule in="o" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB oooo/oooo/oooo/oooo"/>
      <rule in="q" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB ssss/ssss/ssss/ssss"/>
      <rule in="i" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB ssss/ssss/ssss/ssss"/>
      <rule in="p" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB eeee/eeee/eeee/eeee"/>
      <rule in="j" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB eeee/eeee/eeee/eeee"/>
      <rule in="G" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="D" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="d" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="h" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="b" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="l" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="J" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="g" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
      <rule in="y" out="BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB BBBB/BBBB/BBBB/BBBB AAAA/AAAA/AAAA/AAAA"/>
