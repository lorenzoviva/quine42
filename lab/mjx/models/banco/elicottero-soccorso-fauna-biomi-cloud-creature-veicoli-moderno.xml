<!-- Elicottero di soccorso (Cantiere 8, neapolis): fusoliera, rotore e dotazione a caso. -->
<sequence values="BWRKVYLOu#1#2#3#4#5#6z" size="500 500 50" symmetry="(xy)" name="Elicottero di soccorso">
  <color symbol="W" value="eef0f0" name="fusoliera bianca"/>
  <color symbol="R" value="d52f2a" name="fascia rossa"/>
  <color symbol="K" value="2a2b2e" name="pale e pattini"/>
  <color symbol="V" value="5f8aa6" name="vetri"/>
  <color symbol="Y" value="f4c430" name="numeri di bordo"/>
  <color symbol="L" value="fff6c8" name="faro" glow="True"/>
  <color symbol="O" value="ff7a2a" name="galleggianti"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="#1" hidden="True" name="marcatore"/>
  <color symbol="#2" hidden="True" name="marcatore"/>
  <color symbol="#3" hidden="True" name="marcatore"/>
  <color symbol="#4" hidden="True" name="marcatore"/>
  <color symbol="#5" hidden="True" name="marcatore"/>
  <color symbol="#6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <line at="19 15 0" to="19 39 0" r="1" color="K"/>
  <line at="31 15 0" to="31 39 0" r="1" color="K"/>
  <line at="19 21 0" to="22 22 9" r="0.5" color="K"/>
  <line at="31 21 0" to="28 22 9" r="0.5" color="K"/>
  <line at="19 33 0" to="22 32 9" r="0.5" color="K"/>
  <line at="31 33 0" to="28 32 9" r="0.5" color="K"/>
  <!-- scelta «fusoliera»: grande | compatta | a goccia -->
  <box at="25 24 4" size="30 48 26" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: grande -->
  <box at="25 39 13" size="9 1 5" color="V" on="#1"/>
  <ellipsoid at="25 26 5" size="16 26 15" color="W" on="#1"/>
  <line at="25 14 13" to="25 1 16" r="2" color="W" on="#1"/>
  <box at="25 2 16" size="2 4 9" color="R" on="#1"/>
  <line at="25 2 21" to="25 2 21" r="2.5" color="K" on="#1"/>
  <!--   2: compatta -->
  <box at="25 35 13" size="7 1 4" color="V" on="#2"/>
  <ellipsoid at="25 27 6" size="13 18 13" color="W" on="#2"/>
  <line at="25 19 12" to="25 3 15" r="1.5" color="W" on="#2"/>
  <box at="25 4 14" size="2 3 7" color="R" on="#2"/>
  <box at="25 4 20" size="9 2 2" color="R" on="#2"/>
  <!--   3: a goccia -->
  <box at="25 37 12" size="9 1 6" color="V" on="#3"/>
  <ellipsoid at="25 28 5" size="15 20 15" color="W" on="#3"/>
  <line at="25 19 12" to="25 2 17" r="2" color="W" on="#3"/>
  <cone at="25 2 17" size="3 5 8" color="R" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <box at="25 26 10" size="30 12 2" color="R" on="W"/>
  <cylinder at="25 27 17" size="3 3 14" color="K"/>
  <!-- scelta «rotore»: quattro pale | a X | tre pale | cinque pale -->
  <box at="25 27 29" size="50 50 3" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/><rule in="u" out="#4"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/><rule in="#4u" out="*#4"/></all>
  <!--   1: quattro pale -->
  <line at="25 27 30" to="48 27 30" r="1" color="K" on="#1"/>
  <line at="25 27 30" to="25 50 30" r="1" color="K" on="#1"/>
  <line at="25 27 30" to="2 27 30" r="1" color="K" on="#1"/>
  <line at="25 27 30" to="25 4 30" r="1" color="K" on="#1"/>
  <!--   2: a X -->
  <line at="25 27 30" to="41 43 30" r="1" color="K" on="#2"/>
  <line at="25 27 30" to="9 43 30" r="1" color="K" on="#2"/>
  <line at="25 27 30" to="9 11 30" r="1" color="K" on="#2"/>
  <line at="25 27 30" to="41 11 30" r="1" color="K" on="#2"/>
  <!--   3: tre pale -->
  <line at="25 27 30" to="25 50 30" r="1" color="K" on="#3"/>
  <line at="25 27 30" to="5 16 30" r="1" color="K" on="#3"/>
  <line at="25 27 30" to="45 15 30" r="1" color="K" on="#3"/>
  <!--   4: cinque pale -->
  <line at="25 27 30" to="47 34 30" r="1" color="K" on="#4"/>
  <line at="25 27 30" to="25 50 30" r="1" color="K" on="#4"/>
  <line at="25 27 30" to="3 34 30" r="1" color="K" on="#4"/>
  <line at="25 27 30" to="11 9 30" r="1" color="K" on="#4"/>
  <line at="25 27 30" to="38 8 30" r="1" color="K" on="#4"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/><rule in="#4" out="B"/></prl>
  <!-- scelta «dotazione»: scaletta | verricello e barella | galleggianti | faro di ricerca -->
  <box at="25 30 0" size="50 40 24" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/><rule in="u" out="#4"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/><rule in="#4u" out="*#4"/></all>
  <!--   1: scaletta -->
  <line at="31 30 0" to="29 30 8" r="0.5" color="K" on="#1"/>
  <!--   2: verricello e barella -->
  <line at="30 30 14" to="41 30 16" r="1" color="K" on="#2"/>
  <line at="41 30 16" to="41 30 1" r="0" color="K" on="#2"/>
  <box at="41 30 0" size="5 14 2" color="O" on="#2"/>
  <box at="41 30 2" size="5 14 1" color="W" on="#2"/>
  <!--   3: galleggianti -->
  <ellipsoid at="15 27 0" size="6 24 6" color="O" on="#3"/>
  <ellipsoid at="35 27 0" size="6 24 6" color="O" on="#3"/>
  <!--   4: faro di ricerca -->
  <line at="25 36 6" to="25 41 3" r="1" color="K" on="#4"/>
  <ellipsoid at="25 42 0" size="6 5 5" color="L" on="#4"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/><rule in="#4" out="B"/></prl>
  <!-- numeri di bordo a caso sulle fiancate -->
  <prl in="BW" out="*Y" p="0.01" steps="1"/>
</sequence>
