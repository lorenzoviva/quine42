<!-- Faro portuale (Cantiere 8, neapolis): torre, lanterna e base a caso; scogli e alghe a caso. -->
<sequence values="BWRSKILNAgu#1#2#3#4#5#6z" size="500 500 50" symmetry="(xy)" name="Faro portuale">
  <color symbol="W" value="f0f0ec" name="bianco"/>
  <color symbol="R" value="d02a2a" name="rosso"/>
  <color symbol="S" value="b8b4aa" name="cemento"/>
  <color symbol="K" value="8a8680" name="pietra"/>
  <color symbol="I" value="2a2c30" name="ferro"/>
  <color symbol="L" value="fff2b0" name="lanterna" glow="True"/>
  <color symbol="N" value="6a665e" name="scogli"/>
  <color symbol="A" value="3f6a4a" name="alghe"/>
  <color symbol="g" hidden="True" name="marcatore"/>
  <color symbol="u" hidden="True" name="marcatore"/>
  <color symbol="#1" hidden="True" name="marcatore"/>
  <color symbol="#2" hidden="True" name="marcatore"/>
  <color symbol="#3" hidden="True" name="marcatore"/>
  <color symbol="#4" hidden="True" name="marcatore"/>
  <color symbol="#5" hidden="True" name="marcatore"/>
  <color symbol="#6" hidden="True" name="marcatore"/>
  <color symbol="z" hidden="True" name="marcatore"/>
  <!-- mescola: consuma le prime otto estrazioni del generatore, che per semi vicini (1, 2, 3…) danno numeri vicini -->
  <box at="3 0 0" size="7 1 1" color="z" on="B"/>
  <box at="0 1 0" size="1 1 1" color="z" on="B"/>
  <one in="z" out="B" steps="8"/>
  <!-- scelta «base»: molo di cemento | rocce | piattaforma con la casetta -->
  <box at="25 25 0" size="44 44 8" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: molo di cemento -->
  <box at="25 25 0" size="24 40 5" color="S" on="#1"/>
  <box at="25 25 5" size="16 16 1" color="S" on="#1"/>
  <!--   2: rocce -->
  <ellipsoid at="25 25 0" size="34 34 12" color="K" on="#2"/>
  <!--   3: piattaforma con la casetta -->
  <box at="25 25 0" size="30 30 4" color="S" on="#3"/>
  <box at="34 34 4" size="8 8 6" color="W" on="#3"/>
  <box at="34 34 10" size="9 9 1" color="R" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <!-- 8 massi nascono a caso sul terreno accanto a ciò che c'è già ([SKN]) e crescono di lato e in alto -->
  <box at="25 25 0" size="48 48 1" color="g" on="B"/>
  <one in="[SKN]g" out="*N" steps="8"/>
  <prl steps="7"><rule in="N[Bg]" out="*N" p="0.5"/><rule in="B N" out="N *" p="0.35"/></prl>
  <prl in="g" out="B"/>
  <!-- scelta «torre»: a strisce | ottagonale bianca | a traliccio | quadra di pietra -->
  <box at="25 25 4" size="22 22 36" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/><rule in="u" out="#4"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/><rule in="#4u" out="*#4"/></all>
  <!--   1: a strisce -->
  <cylinder at="25 25 12" size="11 11 5" color="R" on="#1"/>
  <cylinder at="25 25 22" size="10 10 5" color="R" on="#1"/>
  <cylinder at="25 25 32" size="9 9 4" color="R" on="#1"/>
  <cone at="25 25 4" size="12 12 70" color="W" on="#1"/>
  <!--   2: ottagonale bianca -->
  <cylinder at="25 25 4" size="11 11 34" color="W" on="#2"/>
  <box at="25 25 4" size="10 10 34" color="W" on="#2"/>
  <box at="25 31 20" size="2 1 3" color="I" on="#2"/>
  <!--   3: a traliccio -->
  <line at="17 17 4" to="22 22 38" r="1" color="I" on="#3"/>
  <line at="33 17 4" to="28 22 38" r="1" color="I" on="#3"/>
  <line at="17 33 4" to="22 28 38" r="1" color="I" on="#3"/>
  <line at="33 33 4" to="28 28 38" r="1" color="I" on="#3"/>
  <cylinder at="25 25 4" size="3 3 34" color="R" on="#3"/>
  <box at="25 25 12" size="13 13 1" color="I" on="#3"/>
  <box at="25 25 22" size="11 11 1" color="I" on="#3"/>
  <box at="25 25 32" size="8 8 1" color="I" on="#3"/>
  <!--   4: quadra di pietra -->
  <box at="25 25 4" size="12 12 30" color="K" on="#4"/>
  <box at="25 25 34" size="14 14 4" color="K" on="#4"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/><rule in="#4" out="B"/></prl>
  <cylinder at="25 25 38" size="14 14 1" color="I"/>
  <!-- scelta «lanterna»: tonda | a cupola | a gabbia -->
  <box at="25 25 39" size="16 16 11" color="u" on="B"/>
  <one steps="1"><rule in="u" out="#1"/><rule in="u" out="#2"/><rule in="u" out="#3"/></one>
  <all symmetry="(xyz)"><rule in="#1u" out="*#1"/><rule in="#2u" out="*#2"/><rule in="#3u" out="*#3"/></all>
  <!--   1: tonda -->
  <cylinder at="25 25 39" size="7 7 6" color="L" on="#1"/>
  <cylinder at="25 25 45" size="9 9 2" color="R" on="#1"/>
  <!--   2: a cupola -->
  <cylinder at="25 25 39" size="7 7 5" color="L" on="#2"/>
  <ellipsoid at="25 25 43" size="9 9 7" color="R" on="#2"/>
  <!--   3: a gabbia -->
  <box at="25 25 39" size="5 5 5" color="L" on="#3"/>
  <line at="21 21 39" to="21 21 46" r="0.5" color="I" on="#3"/>
  <line at="29 21 39" to="29 21 46" r="0.5" color="I" on="#3"/>
  <line at="21 29 39" to="21 29 46" r="0.5" color="I" on="#3"/>
  <line at="29 29 39" to="29 29 46" r="0.5" color="I" on="#3"/>
  <box at="25 25 46" size="10 10 1" color="I" on="#3"/>
  <line at="25 25 46" to="25 25 49" r="0.5" color="I" on="#3"/>
  <prl><rule in="u" out="B"/><rule in="#1" out="B"/><rule in="#2" out="B"/><rule in="#3" out="B"/></prl>
  <prl in="B N" out="* A" p="0.25" steps="1"/>
  <prl in="BN" out="*A" p="0.1" steps="1"/>
</sequence>
